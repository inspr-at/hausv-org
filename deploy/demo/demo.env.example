# Demo login for a public host: the login form asks for the shared access code from
# secrets.env (DEMO_LOGIN_ACCESS_CODE) and then shows the magic link inline. Fixture
# data only; never enable this on an instance that holds real data.
DEMO_LOGIN_ENABLED=true
DEMO_SEED_DIR=/seed
# Google Ads for the public demo host (hausv.agm.ng): the tag on every public page,
# the "Submit lead form" conversion on the page after a successful demo login
# request. Plain configuration, not a secret; empty = off (default for every
# other instance).
# Loaded only after the visitor grants "marketing" in the consent bar (HAUSV-742).
GOOGLE_ADS_TAG_ID=AW-18425188397
GOOGLE_ADS_LEAD_CONVERSION=AW-18425188397/sEB6CJKVjvEcEK2g6NFE
# Replace this placeholder with the public HTTPS URL before starting the demo.
BASE_URL=https://demo.hausv.example
# Required for a public BASE_URL: the exact address the reverse proxy connects
# from, as seen inside the container (the compose network gateway, e.g.
# 172.30.98.1/32). deploy-remote.sh fills this in. Leave empty for a local
# BASE_URL, where the loopback default applies.
TRUSTED_PROXY_CIDRS=
ROOT_DOMAIN=localhost
ADDR=:8080

# Persistent SQLite, JSON stores, and blobs: all live in the named /data volume.
DB_PATH=/data/hausv.db
PARKING_DATA_PATH=/data/parking.json
ANNOUNCE_DATA_PATH=/data/announcements.json
ANNOUNCE_READ_DATA_PATH=/data/announcement_reads.json
EVENT_DATA_PATH=/data/events.json
DOC_DATA_PATH=/data/documents.json
DOC_FILE_DIR=/data/documents
VOTE_DATA_PATH=/data/votes.json
HANDOVER_DATA_PATH=/data/handovers.json
NOTIFICATION_PREF_DATA_PATH=/data/notification_prefs.json
PROFILE_DATA_PATH=/data/profile_overlays.json
TENANT_DATA_PATH=/data/tenant_overrides.json
TENANT_HERO_DIR=/data/tenant-heroes
INVITE_DATA_PATH=/data/invites.json
ACTIVITY_DATA_PATH=/data/activity.json
AUDIT_DATA_PATH=/data/audit.jsonl
UNIT_DATA_PATH=/data/units.json
UNIT_PAYMENT_STATUS_DATA_PATH=/data/unit_payment_status.json
CONTACT_DATA_PATH=/data/contacts.json
ATTACHMENT_DATA_PATH=/data/attachments.json
ATTACHMENT_FILE_DIR=/data/attachments
ISSUE_DATA_PATH=/data/issues.json
ISSUE_ATTACHMENT_DIR=/data/issue-attachments
TELEGRAM_DATA_PATH=/data/telegram.json

# SESSION_KEY= belongs in secrets.env; use a high-entropy value, never a committed value.
AI_BASE_URL=https://openrouter.ai/api/v1
# Alternatives: anthropic/claude-opus-5, qwen/qwen3.8-max, deepseek/deepseek-v4-pro-0813
AI_MODEL=google/gemini-3.8-flash
AI_TIMEOUT=45s
AI_PROVIDER_LABEL=Cloud (OpenRouter)
AI_APP_TITLE=HAUSV Demo

# Keep this self-contained: do not contact Home Assistant, SMTP, OIDC, or Telegram.
HA_BASE_URL=
HA_TOKEN=
MAIL_OUTBOX_DIR=/data/outbox
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=

# E-Mail-Eingang je Verwaltung (HAUSV-604). Ein Objekt je Organisation; das Passwort
# nur als Datei- oder Umgebungsreferenz, nie im Klartext im JSON.
#
# Die Demo pollt ihr eigenes Postfach (HAUSV-633): der Sidecar hausv-demo-mailbox
# aus demselben Image, plain IMAP nur im Compose-Netz ("insecure" ist hier
# deshalb richtig und für ein echtes Postfach falsch). Das Konto ist ein
# Fixture-Wert wie der Demo-Zugangscode, kein Geheimnis. Ein echtes Postfach
# bekommt host/port 993 ohne "insecure" und das Passwort als password_env aus
# der Secrets-Datei.
INTAKE_MAIL_JSON={"musterstadt":{"host":"hausv-demo-mailbox","port":143,"username":"post@musterstadt.example","password_env":"DEMO_MAILBOX_PASSWORD","folder":"INBOX","interval":"30s","insecure":true}}
INTAKE_MAIL_DIR=/data/attachments/intake-mail
DEMO_MAILBOX_USER=post@musterstadt.example
DEMO_MAILBOX_PASSWORD=demo-postfach
