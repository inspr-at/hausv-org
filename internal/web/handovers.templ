package web

import (
	"fmt"
	"strings"

	"github.com/inspr-at/hausv-org/internal/view"
)

type HandoverRoom struct {
	Name, Condition, Defects string
}

type HandoverMeter struct {
	Label, Value, Unit string
}

type HandoverKey struct {
	Label string
	Count int
}

type HandoverConfirmation struct {
	Role, Name, Email, Status, StatusClass string
	ConfirmedAt                           string
	HasConfirmed                          bool
}

type HandoverItem struct {
	ID, Title, Type, UnitLabel, ScheduledAt, Status, StatusClass string
	NextStep, NextStepDetail, Outgoing, Incoming, Notes          string
	ProtocolURL, FileURL, FiledDocumentURL, CreatedAt, UpdatedAt string
	ConfirmedCount, ConfirmationCount                            int
	HasUnit, HasScheduledAt, IsReady, IsFiled                    bool
	CanFile, CanChangeFiles, CanManageDocuments                  bool
	HasFiledDocument                                             bool
	Rooms                                                        []HandoverRoom
	Meters                                                       []HandoverMeter
	Keys                                                         []HandoverKey
	Confirmations                                                []HandoverConfirmation
	Attachments                                                  []view.AttachmentView
}

type HandoverSection struct {
	Title, Description string
	Items              []HandoverItem
	Open               bool
}

type HandoversPageData struct {
	Portal                                                    PortalPageData
	AssetVersion, NowInput, Message                           string
	MessageOK, HasHandovers, CanManageBuilding                bool
	OpenCount, ReadyCount, FiledCount                         int
	Sections                                                  []HandoverSection
	Empty                                                     view.EmptyStateView
	UnitOptions                                               []view.SelectOption
}

templ HandoversPage(data HandoversPageData) {
	@PortalDocument(data.Portal.Title, data.AssetVersion, []string{"attachments.js"}, HandoversStyles(), templ.Attributes{"data-templ-handovers": true}) {
			@PortalShell(data.Portal, "Übergaben", HandoversContent(data))
			@HandoverCreateDialog(data.NowInput, data.UnitOptions)
	}
}

templ HandoversContent(data HandoversPageData) {
	@PortalSectionLanding(
		PortalSectionLandingData{
			Portal: data.Portal,
			PageLabel: "Übergaben",
			Class: "handovers-main",
			Identity: PortalSectionIdentityData{Label: "Verwaltung", Icon: "handover"},
		},
		PortalSectionTitle("Übergaben"),
		PortalSectionLede("Überblick und nächste Schritte."),
		HandoverHeaderAction(data),
		nil,
		nil,
		HandoversBody(data),
	)
}

templ HandoverHeaderAction(data HandoversPageData) {
	if data.HasHandovers {
		<button class="button" type="button" data-dialog="handover-create" aria-haspopup="dialog" aria-controls="handover-create">Übergabe anlegen</button>
	}
}

templ HandoversBody(data HandoversPageData) {
	<section class="handover-page">
		<p class="handover-scope"><span aria-hidden="true">ⓘ</span> Zustand und Bestätigungen – ohne Kautions- oder Schadenabrechnung.</p>
		if data.Message != "" {
			<p class={ "flash", templ.KV("ok", data.MessageOK) }>{ data.Message }</p>
		}
		if data.HasHandovers {
			<div class="handover-metrics" aria-label="Übergabeübersicht"><div><strong>{ data.OpenCount }</strong><span>Offen</span></div><div class="ready"><strong>{ data.ReadyCount }</strong><span>Ablagebereit</span></div><div class="done"><strong>{ data.FiledCount }</strong><span>Abgelegt</span></div></div>
			<div class="handover-sections">
				for _, section := range data.Sections {
					if len(section.Items) > 0 {
						<details class="handover-section" open?={ section.Open }><summary><span><strong>{ section.Title }</strong><small>{ section.Description }</small></span><span class="handover-section-count">{ len(section.Items) }</span>
							@DisclosureChevron()
						</summary><div class="handover-list">
							for _, item := range section.Items {
								@HandoverCard(item)
							}
						</div></details>
					}
				}
			</div>
		} else {
			@HandoverBlank(data.Empty, data.CanManageBuilding)
		}
	</section>
}

templ HandoverCard(item HandoverItem) {
	<article class="panel handover-card" id={ "handover-" + item.ID }>
		<header class="handover-head"><div><div class="handover-meta"><span class={ "pill", item.StatusClass }>{ item.Status }</span><span>{ item.Type }</span></div><h3>{ item.Title }</h3><p class="handover-place">
			if item.HasUnit {
				<span class="handover-unit">@UnitLabel(item.UnitLabel)</span>
			}
			if item.HasScheduledAt {
				<span class="handover-date">@PortalIcon("calendar"){ item.ScheduledAt }</span>
			}
		</p></div>
		if len(item.Confirmations) > 0 {
			<div class="handover-confirm-progress" aria-label={ handoverConfirmationLabel(item) }><strong>{ item.ConfirmedCount }/{ item.ConfirmationCount }</strong><span>bestätigt</span></div>
		}
		</header>
		<div class="handover-parties"><div><span>Ausziehend</span><strong>{ item.Outgoing }</strong></div><div><span>Einziehend</span><strong>{ item.Incoming }</strong></div></div>
		<div class={ "handover-next", templ.KV("ready", item.IsReady), templ.KV("done", item.IsFiled) }><div><span>Als Nächstes</span><strong>{ item.NextStep }</strong><small>{ item.NextStepDetail }</small></div>
			if item.HasFiledDocument {
				<a class="button primary small" href={ templ.SafeURL(item.FiledDocumentURL) }>Dokument öffnen</a>
			} else if item.CanFile && item.CanManageDocuments {
				<form method="post" action={ templ.SafeURL(item.FileURL) }><input type="hidden" name="id" value={ item.ID }/><button class="button primary small" type="submit">Jetzt ablegen</button></form>
			}
		</div>
		<details class="handover-details"><summary><strong>Details</strong><small>{ handoverDetailsLabel(item) }</small>
			@DisclosureChevron()
		</summary>
			<div class="handover-detail-grid">
				<section class="handover-detail"><h4>Räume</h4>
					if len(item.Rooms) > 0 {
						<ul>
						for _, room := range item.Rooms {
								<li><strong>{ room.Name }</strong>
									if room.Condition != "" {
										<span>{ room.Condition }</span>
									}
									if room.Defects != "" {
										<em>{ room.Defects }</em>
									}
								</li>
							}
						</ul>
					} else {
						<p>Keine Räume erfasst.</p>
					}
				</section>
				<section class="handover-detail"><h4>Zählerstände</h4>
					if len(item.Meters) > 0 {
						<ul>
							for _, meter := range item.Meters {
								<li><strong>{ meter.Label }</strong><span>{ meter.Value }
									if meter.Unit != "" {
										{ " " + meter.Unit }
									}
								</span></li>
							}
						</ul>
					} else {
						<p>Keine Zählerstände erfasst.</p>
					}
				</section>
				<section class="handover-detail"><h4>Schlüssel</h4>
					if len(item.Keys) > 0 {
						<ul>
							for _, key := range item.Keys {
								<li><strong>{ key.Label }</strong><span>{ key.Count } Stk.</span></li>
							}
						</ul>
					} else {
						<p>Keine Schlüssel erfasst.</p>
					}
				</section>
				<section class="handover-detail"><h4>Bestätigungen</h4>
					if len(item.Confirmations) > 0 {
						<ul>
							for _, confirmation := range item.Confirmations {
								<li><strong>{ confirmation.Role }</strong><span>{ handoverConfirmationParty(confirmation) }</span><span class={ "pill", confirmation.StatusClass }>{ confirmation.Status }</span></li>
							}
						</ul>
					} else {
						<p>Keine externen Bestätigungen vorgesehen.</p>
					}
				</section>
			</div>
			if item.Notes != "" {
				<div class="handover-note"><strong>Notiz</strong><p>{ item.Notes }</p></div>
			}
			@HandoverAttachments(item.Attachments)
			if item.CanChangeFiles {
				<form class="handover-add-files" method="post" action="/app/uebergaben/attachments" enctype="multipart/form-data"><input type="hidden" name="id" value={ item.ID }/><label for={ "handover-files-" + item.ID }>Fotos oder PDF ergänzen<span class="file-control"><input id={ "handover-files-" + item.ID } type="file" name="attachments" accept="image/jpeg,image/png,image/webp,image/gif,application/pdf" multiple required/><span>Dateien auswählen</span></span></label><button class="button small" type="submit">Dateien ergänzen</button></form>
			}
			<footer class="handover-detail-actions"><a class="button small ghost" href={ templ.SafeURL(item.ProtocolURL) }>PDF exportieren</a><span>Angelegt { item.CreatedAt } · Aktualisiert { item.UpdatedAt }</span></footer>
		</details>
	</article>
}

templ HandoverAttachments(attachments []view.AttachmentView) {
	if len(attachments) > 0 {
		<div class="attachment-strip" aria-label="Anhänge">
			for _, attachment := range attachments {
				<div class="attachment-item">
					if attachment.IsImage {
						<button class="attachment-open" type="button" data-lightbox-src={ attachment.PreviewURL } data-lightbox-full={ attachment.URL } data-lightbox-caption={ attachment.Filename }><img src={ attachment.ThumbURL } alt={ attachment.Filename } loading="lazy" decoding="async"/><span class="attachment-name">{ attachment.Filename }</span></button>
					} else {
						<a class="attachment-open" href={ templ.SafeURL(attachment.URL) } target="_blank" rel="noopener"><span class="attachment-file-icon">{ handoverAttachmentKind(attachment) }</span><span class="attachment-name">{ attachment.Filename }</span></a>
					}
					if attachment.CanDelete {
						<form class="attachment-delete" method="post" action={ templ.SafeURL(attachment.DeleteURL) } data-confirm="Diesen Anhang entfernen?"><input type="hidden" name="id" value={ attachment.ID }/>
							if attachment.DeleteRedirect != "" {
								<input type="hidden" name="redirect" value={ attachment.DeleteRedirect }/>
							}
							<button type="submit" aria-label="Anhang entfernen">×</button>
						</form>
					}
				</div>
			}
		</div>
	}
}

templ HandoverBlank(empty view.EmptyStateView, canManageBuilding bool) {
	<section class="handover-blank" aria-labelledby="handover-blank-title"><div class="handover-blank-main"><div class="handover-blank-lead"><span class="handover-blank-icon" aria-hidden="true">@PortalIcon("handover")</span><h2 id="handover-blank-title">{ empty.Title }</h2><p>Räume, Zählerstände, Schlüssel und Fotos an einem Ort. Beide Parteien bestätigen über ihren persönlichen Link.</p></div><div class="handover-blank-actions">@HandoverCreateButton("Erste Übergabe anlegen")
		if canManageBuilding {
			<a class="button ghost" href="/app/settings/building?section=units" title="Einheiten in den Gebäude-Einstellungen öffnen">Einheiten prüfen</a>
		}
	</div></div><aside class="handover-blank-side"><h2>In drei Schritten</h2><ol class="handover-blank-steps"><li><strong>Erfassen</strong><span>Einheit und Zustand festhalten.</span></li><li><strong>Bestätigen</strong><span>Persönliche Links an beide Parteien senden.</span></li><li><strong>Ablegen</strong><span>Als PDF in den Dokumenten sichern.</span></li></ol></aside></section>
}

templ HandoverCreateButton(label string) {
	<button class="button primary" type="button" data-dialog="handover-create" aria-haspopup="dialog" aria-controls="handover-create"><span aria-hidden="true">＋</span>{ label }</button>
}

templ HandoverCreateDialog(nowInput string, units []view.SelectOption) {
	<dialog id="handover-create" class="dialog handover-dialog" aria-labelledby="handover-create-title" aria-describedby="handover-create-intro"><form method="post" action="/app/uebergaben" enctype="multipart/form-data"><div class="dialog-head"><div><h2 id="handover-create-title">Übergabe anlegen</h2><p id="handover-create-intro">Einheit, Titel und einen Raum erfassen. Alles Weitere ist optional.</p></div><button class="dialog-close" type="button" data-close-dialog aria-label="Schließen">×</button></div><div class="dialog-body"><div class="handover-form-columns"><section class="handover-form-group" aria-labelledby="handover-basics-title"><div class="handover-form-step"><span>1</span><div><strong id="handover-basics-title">Übergabe</strong><small>Einheit, Anlass und Termin</small></div></div><div class="dialog-grid"><label for="handover-unit">Einheit<select id="handover-unit" name="unit_id" required>
		for _, unit := range units {
			<option value={ unit.Value } selected?={ unit.Selected }>{ unit.Label }</option>
		}
	</select></label><label for="handover-type">Anlass<select id="handover-type" name="handover_type"><option>Nutzerwechsel</option><option>Einzug</option><option>Auszug</option></select></label><label class="full" for="handover-title">Titel<input id="handover-title" name="title" required maxlength="160" placeholder="Nutzerwechsel Einheit 12"/></label><label class="full" for="handover-time">Termin<input id="handover-time" type="datetime-local" name="scheduled_at" value={ nowInput }/></label></div></section><section class="handover-form-group" aria-labelledby="handover-condition-title"><div class="handover-form-step"><span>2</span><div><strong id="handover-condition-title">Zustand</strong><small>Raum | Zustand | Mangel · eine Zeile pro Raum</small></div></div><label for="handover-rooms">Räume<textarea id="handover-rooms" name="rooms_text" required placeholder="Wohnzimmer | gut | keine Mängel"></textarea></label></section></div>
	<details class="dialog-optional"><summary>Personen für Bestätigung
		@DisclosureChevron()
	</summary><p class="dialog-optional-copy">Eine E-Mail-Adresse erzeugt den persönlichen Bestätigungslink.</p><div class="dialog-optional-grid"><label for="handover-out-name">Ausziehend – Name<input id="handover-out-name" name="outgoing_name" autocomplete="name"/></label><label for="handover-out-email">Ausziehend – E-Mail<input id="handover-out-email" type="email" name="outgoing_email" autocomplete="email"/></label><label for="handover-in-name">Einziehend – Name<input id="handover-in-name" name="incoming_name" autocomplete="name"/></label><label for="handover-in-email">Einziehend – E-Mail<input id="handover-in-email" type="email" name="incoming_email" autocomplete="email"/></label></div></details>
	<details class="dialog-optional"><summary>Zähler, Schlüssel und Notiz
		@DisclosureChevron()
	</summary><div class="dialog-optional-grid"><label class="full" for="handover-meters">Zählerstände <small>Bezeichnung | Wert | Einheit</small><textarea id="handover-meters" name="meters_text" placeholder="Strom | 12345,6 | kWh"></textarea></label><label class="full" for="handover-keys">Schlüssel <small>Bezeichnung | Anzahl</small><textarea id="handover-keys" name="keys_text" placeholder="Wohnungsschlüssel | 3"></textarea></label><label class="full" for="handover-notes">Notiz<textarea id="handover-notes" name="notes" placeholder="Zusätzliche Beobachtungen"></textarea></label></div></details>
	<details class="dialog-optional"><summary>Fotos und PDF
		@DisclosureChevron()
	</summary><div class="dialog-optional-grid"><label class="full" for="handover-attachments">Dateien<span class="file-control"><input id="handover-attachments" type="file" name="attachments" accept="image/jpeg,image/png,image/webp,image/gif,application/pdf" multiple/><span>Bis zu 10 Dateien auswählen</span></span></label></div></details></div><footer class="dialog-footer handover-dialog-submit"><span>Bestätigungslinks entstehen nur für angegebene E-Mail-Adressen.</span><button class="button primary" type="submit">Übergabe anlegen</button></footer></form></dialog>
}

func handoverConfirmationLabel(item HandoverItem) string { return fmt.Sprintf("%d von %d Bestätigungen", item.ConfirmedCount, item.ConfirmationCount) }
func handoverConfirmationParty(item HandoverConfirmation) string { if item.Name != "" { return item.Name }; return item.Email }
func handoverAttachmentKind(item view.AttachmentView) string { if item.IsPDF { return "PDF" }; return "Datei" }
func handoverDetailsLabel(item HandoverItem) string {
	parts := make([]string, 0, 4)
	if len(item.Rooms) > 0 { word := "Räume"; if len(item.Rooms) == 1 { word = "Raum" }; parts = append(parts, fmt.Sprintf("%d %s", len(item.Rooms), word)) }
	if len(item.Meters) > 0 { parts = append(parts, fmt.Sprintf("%d Zähler", len(item.Meters))) }
	if len(item.Keys) > 0 { parts = append(parts, fmt.Sprintf("%d Schlüssel", len(item.Keys))) }
	if len(item.Attachments) > 0 { word := "Dateien"; if len(item.Attachments) == 1 { word = "Datei" }; parts = append(parts, fmt.Sprintf("%d %s", len(item.Attachments), word)) }
	return strings.Join(parts, " · ")
}

templ HandoversStyles() {
	<style>a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible{outline:2px solid var(--gold-light);outline-offset:2px}h1,h2,h3,h4,p{margin:0}h1,h2,h3,h4{font-family:var(--font-serif);font-weight:600}
		.handovers-main{min-width:0;padding:var(--space-6)}.page{max-width:1180px;margin:var(--space-5) auto 0}.handover-page{display:grid;gap:var(--space-5)}.handover-scope,.handover-note{border:1px solid var(--line);border-radius:var(--radius-sm);padding:var(--space-3) var(--space-4);background:var(--panel-soft);color:var(--muted);font-size:13px;line-height:1.45}.handover-note strong{color:var(--ink)}.handover-note p{margin-top:var(--space-1);overflow-wrap:anywhere}.button.primary{background:var(--gold);color:var(--panel)}.button.ghost{border-color:var(--line);color:var(--muted)}.button.small{min-height:34px;padding:var(--space-1) var(--space-3)}.flash{padding:var(--space-3) var(--space-4);border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel-soft);font-size:13px}.flash.ok{border-color:var(--gold)}
		.handover-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-3)}.handover-metrics>div{border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel);padding:var(--space-4);box-shadow:var(--shadow-panel)}.handover-metrics strong{display:block;font-family:var(--font-serif);font-size:27px}.handover-metrics span{display:block;margin-top:var(--space-1);color:var(--muted);font-size:12px;font-weight:750}.handover-sections,.handover-list{display:grid;gap:var(--space-3)}.handover-section{border-top:1px solid var(--line)}.handover-section>summary{min-height:62px;display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:var(--space-3);cursor:pointer;list-style:none}.handover-section>summary::-webkit-details-marker{display:none}.handover-section>summary>span:first-child{display:grid;gap:3px}.handover-section>summary strong{font-family:var(--font-serif);font-size:21px}.handover-section>summary small{color:var(--muted);font-size:12px}.handover-section-count{min-width:32px;height:32px;display:grid;place-items:center;border:1px solid var(--line);border-radius:var(--radius-pill);background:var(--panel-soft);color:var(--gold-ink);font-weight:900}
		.panel{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius-md);box-shadow:var(--shadow-panel)}.handover-card{display:grid;gap:var(--space-3);padding:18px}.handover-head{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:var(--space-4);align-items:center}.handover-meta{display:flex;flex-wrap:wrap;gap:var(--space-2);align-items:center;color:var(--soft);font-size:12px;font-weight:800}.pill{display:inline-flex;padding:3px var(--space-2);border:1px solid var(--line);border-radius:var(--radius-pill);background:var(--panel-soft);color:var(--muted);font-size:11px;font-weight:800}.pill.ok{border-color:var(--leaf);color:var(--leaf)}.pill.unread{border-color:var(--gold);color:var(--gold-ink)}.handover-card h3{margin-top:var(--space-1);font-size:27px;overflow-wrap:anywhere}.handover-place{display:flex;flex-wrap:wrap;gap:var(--space-2) var(--space-3);margin-top:var(--space-1);color:var(--muted);font-size:13px;font-weight:700}.handover-place span+span::before{content:"·";margin-right:var(--space-3);color:var(--soft)}.handover-confirm-progress{min-width:74px;display:grid;justify-items:end;gap:2px}.handover-confirm-progress strong{font-family:var(--font-serif);font-size:22px}.handover-confirm-progress span{color:var(--muted);font-size:11px}.handover-next{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:var(--space-4);align-items:center;border:1px solid var(--line);border-radius:var(--radius-sm);padding:var(--space-3) var(--space-4);background:var(--panel-soft)}.handover-next div{display:grid;gap:2px}.handover-next span{color:var(--gold-ink);font-size:11px;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.handover-next strong{font-size:14px}.handover-next small{color:var(--muted);font-size:12px}.handover-next form{margin:0}
		.handover-details{border-top:1px solid var(--line);padding-top:var(--space-2)}.handover-details>summary{min-height:44px;display:flex;align-items:center;gap:var(--space-2);cursor:pointer;color:var(--gold-ink);font-size:13px;font-weight:850}.handover-details>summary small{color:var(--muted);font-size:11px}.handover-details[open]>summary{margin-bottom:var(--space-3)}.handover-parties{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-2);margin-bottom:var(--space-3)}.handover-parties div,.handover-detail{border:1px solid var(--line);border-radius:var(--radius-xs);padding:var(--space-3);background:var(--panel-soft);min-width:0}.handover-parties span{display:block;color:var(--soft);font-size:11px;font-weight:850;text-transform:uppercase;letter-spacing:.06em}.handover-parties strong{display:block;margin-top:3px;font-size:12px;overflow-wrap:anywhere}.handover-detail-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--space-2)}.handover-detail h4{font-size:15px}.handover-detail ul{list-style:none;padding:0;margin:var(--space-2) 0 0;display:grid;gap:var(--space-2)}.handover-detail li{display:grid;gap:3px;color:var(--muted);font-size:13px;line-height:1.35;overflow-wrap:anywhere}.handover-detail li strong{color:var(--ink);font-size:14px}.handover-detail li em{color:var(--gold-ink);font-style:normal}.handover-detail p{margin-top:var(--space-2);color:var(--muted);font-size:13px}.handover-note{margin-top:var(--space-3)}
