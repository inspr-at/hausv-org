package web

import (
	"net/url"
	"strings"

	"github.com/inspr-at/hausv-org/internal/view"
)

type EventsMonth struct {
	Label  string
	Events []view.HouseEventView
}

type EventsPageData struct {
	SearchQuery            string
	SelectedStatus         string
	CurrentCount, PastCount int
	Portal             PortalPageData
	AssetVersion       string
	NowInput           string
	CalendarFeedURL    string
	Message            string
	MessageOK          bool
	CanManageEvents    bool
	CanManageIssues    bool
	Upcoming           []view.HouseEventView
	Months             []EventsMonth
	Past               []view.HouseEventView
}

templ EventsPage(data EventsPageData) {
	@PortalDocument(data.Portal.Title, data.AssetVersion, []string{"announcements.js", "attachments.js"}, EventsStyles(), templ.Attributes{"data-templ-events": true}) {
			@PortalShell(data.Portal, "Termine", EventsContent(data))
			if data.CanManageEvents {
				@EventCreateDialog(data.NowInput, data.Portal.HouseName, data.Portal.Address)
			}
	}
}

templ EventsStyles() {
	<style>.events-main{min-width:0;padding:var(--space-6)}
		.events-main .page{max-width:1180px;margin:var(--space-5) auto 0}
		.events-main .flash{margin-top:var(--space-4);padding:var(--space-3) var(--space-4);border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel-soft);font-size:13px}
		.events-main .flash.ok{border-color:var(--gold)}
		.events-main .events-layout{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:var(--space-5);margin-top:var(--space-5);align-items:start}
		.events-main .events-column,.events-main .events-aside{min-width:0;display:grid;gap:var(--space-4)}
		.events-main .panel{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius-md);box-shadow:var(--shadow-panel)}
		.events-main .agenda-panel{padding:var(--space-5)}
		.events-main .section-head{display:flex;align-items:start;justify-content:space-between;gap:var(--space-4);padding-bottom:var(--space-4)}
		.events-main .kicker{color:var(--gold-ink);font-size:11px;font-weight:850;letter-spacing:.13em;text-transform:uppercase}
		.events-main .section-head h2{margin-top:var(--space-1);font-size:26px}
		.events-main .section-head p{margin-top:var(--space-2);color:var(--muted);font-size:12px}
		.events-main .count{color:var(--muted);font-size:11px;white-space:nowrap}
		.events-main .event-month{margin-top:var(--space-5)}
		.events-main .event-month:first-child{margin-top:0}
		.events-main .month-head{display:flex;align-items:baseline;justify-content:space-between;gap:var(--space-3);margin-bottom:var(--space-3)}
		.events-main .month-head h3{color:var(--gold-ink);font-family:var(--font-sans);font-size:11px;font-weight:850;letter-spacing:.11em;text-transform:uppercase}
		.events-main .month-head span{color:var(--soft);font-size:11px}
		.events-main .agenda-list{display:grid;gap:var(--space-3)}
		.events-main .event-card{display:grid;grid-template-columns:60px minmax(0,1fr);gap:var(--space-4);padding:var(--space-4);border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel)}
		.events-main .event-card.past{opacity:.65}
		.events-main .date-badge{width:60px;height:60px;display:grid;place-content:center;border-radius:var(--radius-sm);background:var(--leaf);color:var(--panel);text-align:center}
		.events-main .event-card.past .date-badge{background:var(--muted)}
		.events-main .date-badge strong{font-family:var(--font-serif);font-size:24px;line-height:.85}
		.events-main .date-badge span{margin-top:6px;font-size:11px;font-weight:850;letter-spacing:.05em;text-transform:uppercase}
		.events-main .event-copy{min-width:0;display:flex;flex-direction:column;gap:var(--space-2)}
		.events-main .event-card-head{display:flex;align-items:start;gap:var(--space-3);flex-wrap:wrap}
		.events-main .event-title-group{display:flex;flex-direction:column;gap:var(--space-1);flex:1;min-width:0}
		.events-main .next-label{display:inline-block;color:var(--gold);font-size:11px;font-weight:850;letter-spacing:.1em;text-transform:uppercase}
		.events-main .event-card-head h3{font-size:19px;line-height:1.3}
		.events-main .event-category{display:inline-flex;padding:4px 10px;border:1px solid var(--line);border-radius:var(--radius-pill);background:var(--panel-soft);color:var(--ink);font-size:11px;font-weight:700;white-space:nowrap}
		.events-main .event-meta{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-2);color:var(--muted);font-size:12px}
		.events-main .event-meta>span{white-space:nowrap}
		.events-main :is(.section-head,.event-copy,.aside-panel) :is(h2,h3,p){margin-bottom:0}.events-main .event-details{margin-top:var(--space-1);border:0;border-top:1px solid var(--line);border-radius:0;background:transparent}
		.events-main .event-details>summary{min-height:44px;display:flex;align-items:center;padding:0;cursor:pointer;color:var(--muted);font-size:11px;font-weight:800}
		.events-main .event-details-body{display:grid;gap:var(--space-3);padding:0 var(--space-3) var(--space-3);border-top:1px solid var(--line)}
		.events-main .entry-body{padding-top:var(--space-3);font-size:13px;line-height:1.55;white-space:normal}
		.events-main .event-actions{display:flex;gap:var(--space-2);margin-top:var(--space-2)}
		.events-main .event-actions form{margin:0}
		.events-main .history{border-top:1px solid var(--line)}
		.events-main .history>summary{min-height:48px;display:flex;align-items:center;cursor:pointer;color:var(--muted);font-size:12px;font-weight:800}
		.events-main .blank{min-height:320px;display:grid;place-content:center;justify-items:center;gap:var(--space-4);padding:var(--space-6);text-align:center}
		.events-main .blank-icon{width:52px;height:52px;display:grid;place-items:center;border:1px solid var(--line);border-radius:var(--radius-pill);color:var(--gold-ink)}
		.events-main .blank h2{font-size:27px}
		.events-main .blank p{max-width:48ch;color:var(--muted);font-size:13px;line-height:1.5}
		.events-main .blank-actions{display:flex;flex-wrap:wrap;justify-content:center;gap:var(--space-2)}
		.events-main .aside-panel{display:grid;gap:var(--space-3);padding:var(--space-4)}
		.events-main .aside-panel h2{margin-top:var(--space-1);font-size:17px}
		.events-main .aside-panel>p{color:var(--muted);font-size:11px;line-height:1.5}
		
		.events-main .feed-note{padding:var(--space-2) var(--space-3);border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel-soft);color:var(--soft);font-size:11px;line-height:1.4}
		.events-main .guide>summary{cursor:pointer;list-style:none}
		.events-main .guide>summary::-webkit-details-marker{display:none}
		.events-main .guide .kicker{font-size:11px}
		.events-main .guide h2{font-size:14px}
		.events-main .legend{display:grid;gap:var(--space-2);margin:0;padding:var(--space-3) 0 0;list-style:none;border-top:1px solid var(--line)}
		.events-main .legend li{display:grid;gap:var(--space-1)}
		.events-main .legend li .tag{font-size:11px}
		.events-main .legend li>span:last-child{color:var(--muted);font-size:11px;line-height:1.4}
		.events-main .attachment-strip{display:grid;grid-template-columns:repeat(auto-fill,minmax(112px,1fr));gap:var(--space-2)}
		.events-main .attachment-item{position:relative;min-width:0}
		.events-main .attachment-open{width:100%;min-height:100%;display:grid;gap:6px;border:1px solid var(--line);border-radius:var(--radius-sm);padding:7px;background:var(--panel);color:var(--ink);text-align:left}
		.events-main .attachment-open img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:var(--radius-xs);background:var(--line)}
		.events-main .attachment-file-icon{width:100%;aspect-ratio:4/3;display:grid;place-items:center;border-radius:var(--radius-xs);background:var(--panel-soft);color:var(--gold-ink);font-size:11px;font-weight:900}
		.events-main .attachment-name{min-width:0;color:var(--muted);font-size:11px;font-weight:700;overflow-wrap:anywhere}
		.events-main .attachment-delete{position:absolute;top:var(--space-1);right:var(--space-1);margin:0}
		.events-main .attachment-delete button{width:30px;height:30px;border:1px solid var(--line);border-radius:var(--radius-xs);background:var(--panel);color:var(--ink)}
		:is(.events-main,.event-dialog) .attachment-picker{display:none;gap:var(--space-2);padding:var(--space-3);border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel-soft)}
		:is(.events-main,.event-dialog) .attachment-picker.has-files{display:grid}
		:is(.events-main,.event-dialog) .attachment-picker-head,:is(.events-main,.event-dialog) .attachment-picker-item{display:flex;align-items:center;justify-content:space-between;gap:var(--space-2);color:var(--muted);font-size:11px}
		:is(.events-main,.event-dialog) .attachment-picker-list{display:grid;gap:var(--space-2)}
		:is(.events-main,.event-dialog) .attachment-picker-thumb{width:42px;height:42px;display:grid;place-items:center;border:1px solid var(--line);border-radius:var(--radius-xs);overflow:hidden}
		:is(.events-main,.event-dialog) .attachment-picker-thumb img{width:100%;height:100%;object-fit:cover}
		:is(.events-main,.event-dialog) .attachment-picker-copy{min-width:0;display:grid;flex:1}
		:is(.events-main,.event-dialog) .attachment-picker-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
		:is(.events-main,.event-dialog) .attachment-picker-meta{color:var(--soft)}
		:is(.events-main,.event-dialog) .attachment-picker-remove{width:34px;height:34px;border:1px solid var(--line);border-radius:var(--radius-xs);background:var(--panel);color:var(--ink)}
		:is(.events-main,.event-dialog) .attachment-picker-progress{display:none}
		.events-main .attachment-lightbox{position:fixed;inset:0;z-index:300;display:none;grid-template-columns:48px minmax(0,1fr) 48px;grid-template-rows:48px minmax(0,1fr) auto;align-items:center;gap:var(--space-3);padding:var(--space-4);background:var(--nav);color:var(--panel)}
		.events-main .attachment-lightbox.open{display:grid}
		.events-main .attachment-lightbox figure{grid-column:2;grid-row:2;display:grid;place-items:center;gap:var(--space-3);min-width:0;min-height:0;margin:0}
		.events-main .attachment-lightbox img{max-width:100%;max-height:calc(100vh - 150px);object-fit:contain;border-radius:var(--radius-sm);background:var(--nav-2)}
		.events-main .attachment-lightbox figcaption{text-align:center;font-size:12px;overflow-wrap:anywhere}
		.events-main .lightbox-close,.events-main .lightbox-prev,.events-main .lightbox-next{border:1px solid var(--muted);border-radius:var(--radius-xs);background:var(--nav-2);color:var(--panel)}
		.events-main .lightbox-close{grid-column:3;grid-row:1;width:42px;height:42px}
		.events-main .lightbox-prev,.events-main .lightbox-next{width:46px;height:70px;font-size:26px}
		.events-main .lightbox-prev{grid-column:1;grid-row:2}
		.events-main .lightbox-next{grid-column:3;grid-row:2}
		.event-dialog{width:min(640px,calc(100vw - 32px));max-width:none;max-height:calc(100dvh - 32px);margin:auto;padding:0;overflow:hidden;border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--panel);color:var(--ink);box-shadow:var(--shadow-dialog)}
		.event-dialog form{min-width:0;max-height:inherit;margin:0}
		.event-dialog .dialog-head{display:flex;align-items:flex-start;justify-content:space-between;gap:var(--space-4);padding:var(--space-6);border-bottom:1px solid var(--line)}
		.event-dialog .dialog-head h2{margin:0;font-family:var(--font-serif);font-size:28px;line-height:1.2}
		.event-dialog .dialog-head p{margin:var(--space-2) 0 0;color:var(--muted);font-size:13px;line-height:1.5;overflow-wrap:break-word}
		.event-dialog .dialog-close{flex:0 0 auto;width:44px;height:44px;border:1px solid var(--line);border-radius:var(--radius-sm);background:transparent;color:var(--ink);font-size:24px}
		.event-dialog .dialog-body{min-width:0;min-height:0;padding:var(--space-6);overflow:auto;overscroll-behavior:contain}
		.event-dialog .dialog-grid,.event-dialog .dialog-optional-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--space-4)}
		.event-dialog label{min-width:0;display:grid;gap:var(--space-2);color:var(--ink);font-size:13px;font-weight:700}
		.event-dialog input,.event-dialog select,.event-dialog textarea{box-sizing:border-box;min-width:0;width:100%;max-width:100%;min-height:48px;border:1px solid var(--line);border-radius:var(--radius-sm);padding:var(--space-2) var(--space-4);background:var(--panel);color:var(--ink);font-size:16px;font-weight:400}
		.event-dialog textarea{min-height:112px;resize:vertical}
		.event-dialog .dialog-optional{min-width:0;border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel-soft)}
		.event-dialog .dialog-optional>summary{min-height:48px;display:flex;align-items:center;padding:var(--space-4) 40px var(--space-4) var(--space-4);cursor:pointer;font-size:13px;font-weight:700}
		.event-dialog .dialog-optional-grid{padding:var(--space-4);border-top:1px solid var(--line)}
		.event-dialog .file-control{position:relative;min-height:48px;display:flex;align-items:center;border:1px solid var(--line);border-radius:var(--radius-sm);padding:var(--space-2) var(--space-4);background:var(--panel);color:var(--gold-ink)}
		.event-dialog .file-control input{position:absolute;inset:0;opacity:0;cursor:pointer}
		.event-dialog :is(input,select,textarea,button,summary):focus-visible,.event-dialog .file-control:focus-within{outline:2px solid var(--gold-ink);outline-offset:3px}
		.event-dialog .dialog-footer{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:var(--space-2);padding:var(--space-4) var(--space-6);border-top:1px solid var(--line);background:var(--panel)}
		.event-dialog .dialog-footer .button{min-height:48px;margin:0;padding:var(--space-2) var(--space-4)}
		.event-dialog .button.primary{background:var(--gold);color:var(--nav)}
		.event-dialog .button.ghost{border-color:transparent;background:transparent;color:var(--muted)}
		@media(max-width:520px){.event-dialog .dialog-head,.event-dialog .dialog-body,.event-dialog .dialog-footer{padding:var(--space-4)}.event-dialog .dialog-head h2{font-size:24px}.event-dialog .dialog-footer .button{flex:1 1 auto}}
		@media(max-width:1050px){.events-main .events-layout{grid-template-columns:minmax(0,1fr)}.events-main .events-aside{grid-template-columns:repeat(2,minmax(0,1fr));align-items:start}}
		@media(max-width:760px){.events-main{padding:var(--space-4)}.events-main .page{margin-top:0}.events-main .events-layout{margin-top:var(--space-4);gap:var(--space-3)}.events-main .events-aside{grid-template-columns:minmax(0,1fr);gap:var(--space-3)}.events-main .agenda-panel{padding:var(--space-4)}.events-main .section-head{display:grid}.events-main .event-month{margin-top:var(--space-4)}.events-main .event-card{grid-template-columns:50px minmax(0,1fr);gap:var(--space-3);padding:var(--space-3)}.events-main .date-badge{width:50px;height:50px}.events-main .date-badge strong{font-size:20px}.events-main .event-card-head{flex-wrap:wrap}.events-main .event-card-head h3{font-size:17px}.events-main .blank{min-height:0;padding:var(--space-6) var(--space-4)}.events-main .blank-actions{width:100%;display:grid}}
		.events-toolbar{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:16px;margin-top:24px;padding:16px;border:1px solid var(--line);border-radius:var(--radius-md);background:var(--panel)}
		.sr-only{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}.event-search{display:flex;min-width:0;min-height:48px;border:1px solid var(--line);border-radius:var(--radius-sm);overflow:hidden;background:var(--panel)}
		.event-search input{min-width:0;width:100%;border:0;padding:8px 16px;background:transparent;color:var(--ink);font-size:14px}
		.event-search button{flex:none;border:0;border-left:1px solid var(--line);padding:8px 16px;background:var(--panel-soft);color:var(--gold-ink);font-weight:750}
		.event-segments{display:flex;min-width:0;min-height:48px;border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--paper)}
		.event-segments a{display:flex;justify-content:center;align-items:center;gap:8px;padding:8px 16px;font-size:12px;color:var(--muted);border-radius:var(--radius-sm);white-space:nowrap}
		.event-segments a[aria-current=page]{background:var(--nav);color:var(--panel);font-weight:750}
		.event-segments a span{min-width:24px;padding:2px 4px;border-radius:var(--radius-pill);background:rgba(128,128,128,.12);font-variant-numeric:tabular-nums;text-align:center}
		@media(max-width:1100px){.events-toolbar{grid-template-columns:minmax(0,1fr)}.event-segments a{flex:1}}
		@media(max-width:480px){.events-toolbar{padding:8px;gap:8px}.event-segments a{gap:4px;padding:8px;font-size:11px}.event-search button{padding-inline:8px}}
        /* Reset native heading margins within event content, not the shared shell. */
        .events-main :is(.section-head,.event-copy,.aside-panel,.month-head) :is(h2,h3,p){margin:0}
        .events-main .section-head{align-items:center;gap:12px;padding-bottom:0}
        .events-main .section-head p{margin-top:8px}
        .events-main .event-month{margin-top:24px}
        .events-main .event-card-head h3{overflow-wrap:normal;word-break:normal}
        .events-main .event-title-group{flex-basis:220px}
        .events-main .event-category{max-width:100%;white-space:normal;line-height:1.4}
        .events-main .event-meta>span{min-width:0;max-width:100%;white-space:normal;overflow-wrap:normal;line-height:1.5}
        .events-main .event-actions{flex-wrap:wrap;margin-top:0}
        .events-main .event-details>summary{padding-block:8px}
        .events-main .event-details-body{padding:0 0 12px}
        .events-main .history{margin-top:16px}
        body[data-authenticated-app] .events-main :is(.button,.button.small){min-height:44px}
        .events-main .event-segments a{min-height:44px}
        .events-main .event-copy,.events-main .section-head>div,.events-main .aside-panel>*{min-width:0}
        @media(max-width:760px){.events-main .section-head{display:flex;flex-wrap:wrap}.events-main .event-title-group{flex-basis:100%}.events-main .event-card{gap:12px}.events-main .aside-panel{gap:12px}}

	</style>
}


templ EventsContent(data EventsPageData) {
	@PortalSectionLanding(
		PortalSectionLandingData{
			Portal: data.Portal,
			PageLabel: "Termine",
			Class: "events-main",
			Hero: true,
			Identity: PortalSectionIdentityData{Label: "Termine", Icon: "calendar"},
		},
		PortalSectionTitle("Termine"),
		PortalSectionLede("Was als Nächstes in der Liegenschaft ansteht – mit Zeitpunkt, Ort und allen nötigen Details."),
		EventHeaderAction(data),
		nil,
		nil,
		EventsBody(data),
	)
}

templ EventHeaderAction(data EventsPageData) {
	if data.CanManageEvents {
		<button class="button primary" type="button" data-dialog="event-create" aria-haspopup="dialog" aria-controls="event-create"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>Termin erstellen</button>
	}
}

templ EventsBody(data EventsPageData) {
	if data.Message != "" {
		<p class={ "flash", templ.KV("ok", data.MessageOK) }>{ data.Message }</p>
	}
	@EventsToolbar(data)
	<div class="events-layout">
		<div class="events-column">
					if len(data.Upcoming) > 0 {
						<section class="panel agenda-panel" aria-labelledby="events-upcoming-title">
							<header class="section-head"><div><h2 id="events-upcoming-title">Kommende Termine</h2><p>Der nächste Termin steht zuerst.</p></div><span class="count">{ len(data.Upcoming) } geplant</span></header>
							for _, month := range data.Months {
								<section class="event-month"><header class="month-head"><h3>{ month.Label }</h3><span>{ len(month.Events) } { eventCountWord(len(month.Events)) }</span></header><div class="agenda-list">
									for _, event := range month.Events {
										@EventCard(event)
									}
								</div></section>
							}
							if len(data.Past) > 0 {
								@EventHistory(data.Past)
							}
						</section>
					} else if len(data.Past) > 0 {
						<section class="panel agenda-panel"><header class="section-head"><h2>Abgelaufene Termine</h2><span class="count">{ len(data.Past) } Termine</span></header><div class="agenda-list">
							for _, event := range data.Past {
								@EventCard(event)
							}
						</div></section>
					} else if data.SearchQuery != "" || data.SelectedStatus == "past" {
						<section class="panel blank"><h2>Keine passenden Termine</h2><p>Für diese Suche und diesen Zeitraum sind keine Termine vorhanden.</p><a class="button" href="/app/events?status=all">Alle Termine ansehen</a></section>
					} else {
						<section class="panel blank" aria-label="Termine der Liegenschaft"><span class="blank-icon" aria-hidden="true">◇</span><h2>Noch keine kommenden Termine</h2><p>Geplante Versammlungen, Wartungen und Fristen erscheinen hier.</p><div class="blank-actions">
							if data.CanManageEvents {
								@EventCreateButton("Ersten Termin erstellen")
							} else {
								<a class="button primary" href="/app/announcements">Aushang ansehen</a>
								<a class="button ghost" href={ templ.SafeURL(eventsIssuesURL(data.CanManageIssues)) }>Anliegen melden</a>
							}
						</div></section>
					}
		</div>
		<aside class="events-aside" aria-label="Hinweise zu Terminen">
					if data.CalendarFeedURL != "" {
						<section class="panel aside-panel" aria-labelledby="events-feed-title"><div><span class="kicker">Eigener Kalender</span><h2 id="events-feed-title">Einmal abonnieren</h2></div><p>Neue und geänderte Termine der Liegenschaft erscheinen danach automatisch in Ihrem Kalender – ohne weiteres Zutun.</p><a class="button" href={ templ.SafeURL(data.CalendarFeedURL) }>Kalender abonnieren</a><p class="feed-note">Der Link ist persönlich. Bitte nicht weitergeben.</p></section>
					}
					<details class="panel aside-panel guide" aria-labelledby="events-legend-title"><summary><span class="kicker">Was hier erscheint</span><h2 id="events-legend-title">Termine in der Liegenschaft</h2>
						@DisclosureChevron()
					</summary><ul class="legend"><li><span class="tag">Eigentümerversammlung</span><span>Beschlüsse der Gemeinschaft. Teilnahme oder Vollmacht einplanen.</span></li><li><span class="tag">Wartung</span><span>Lift, Heizung oder Technik. Zugang kann kurz eingeschränkt sein.</span></li><li><span class="tag">Ablesung</span><span>Zählerstände. Meist ist Zutritt zur Einheit nötig.</span></li><li><span class="tag">Frist</span><span>Letzter Tag für eine Rückmeldung oder Zahlung.</span></li><li><span class="tag">Reinigung</span><span>Wiederkehrende Arbeiten in Haus, Hof und Grünflächen.</span></li></ul></details>
		</aside>
	</div>
}

templ EventsToolbar(data EventsPageData) {
	<div class="events-toolbar">
		<form class="event-search" method="get" action="/app/events" role="search"><input type="hidden" name="status" value={ data.SelectedStatus }/><label class="sr-only" for="event-search">Termine suchen</label><input id="event-search" type="search" name="q" value={ data.SearchQuery } placeholder="Termine suchen"/><button type="submit">Suchen</button></form>
		<nav class="event-segments" aria-label="Zeitraum der Termine">
			@EventSegment("Aktuell", "current", data.CurrentCount, data)
			@EventSegment("Abgelaufen", "past", data.PastCount, data)
			@EventSegment("Alle", "all", data.CurrentCount + data.PastCount, data)
		</nav>
	</div>
}

templ EventSegment(label, status string, count int, data EventsPageData) {
	<a href={ templ.SafeURL(eventFilterURL(status, data.SearchQuery)) } aria-current={ portalAriaCurrent(data.SelectedStatus == status || (data.SelectedStatus == "" && status == "all")) }>{ label }<span>{ count }</span></a>
}

func eventFilterURL(status, query string) string {
	params := url.Values{"status": {status}}
	if query != "" { params.Set("q", query) }
	return "/app/events?" + params.Encode()
}

templ EventCreateButton(label string) {
	<button class="button primary" type="button" data-dialog="event-create" aria-haspopup="dialog" aria-controls="event-create"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>{ label }</button>
}

templ EventHistory(events []view.HouseEventView) {
	<details class="history"><summary>Vergangene Termine · { len(events) }
		@DisclosureChevron()
	</summary><div class="agenda-list">
		for _, event := range events {
			@EventCard(event)
		}
	</div></details>
}

templ EventCard(event view.HouseEventView) {
	<article id={ "event-" + event.ID } class={ "event-card", templ.KV("past", event.Past) }>
		<time class="date-badge"><strong>{ event.DateBadgeDay }</strong><span>{ event.DateBadgeMonth }</span></time>
		<div class="event-copy"><header class="event-card-head"><div class="event-title-group">
			if event.IsNext {
				<span class="next-label">Als Nächstes</span>
			}
			<h3>{ event.Title }</h3></div>if event.Category != "" && event.Category != "Termin" {
				<span class="event-category">{ event.Category }</span>
			}
			if event.Status != "" && event.Status != "Geplant" {
				<span class="tag">{ event.Status }</span>
			}
		</header><div class="event-meta"><span>{ event.TimeRange }</span>
			if event.HasLocation {
				<span>{ event.Location }</span>
			}
		</div>
		if event.HasBody || event.HasAttachments {
			<details class="event-details"><summary>Details
				if event.HasAttachments {
					<span>&nbsp;&amp; Anhänge</span>
				}
				@DisclosureChevron()
			</summary><div class="event-details-body">
				if event.HasBody {
					<div class="entry-body">@templ.Raw(string(event.BodyHTML))</div>
				}
				@EventAttachments(event.Attachments)
			</div></details>
		}
		if event.CanManage {
			<div class="event-actions"><button class="button small" type="button" data-dialog={ event.EditDialogID } aria-haspopup="dialog" aria-controls={ event.EditDialogID }>Bearbeiten</button><form method="post" action="/app/events/delete" data-confirm={ event.DeleteConfirmLabel }><input type="hidden" name="id" value={ event.ID }/><button class="button small ghost" type="submit">Löschen</button></form></div>
		}
		</div>
	</article>
	if event.CanManage {
		@EventEditDialog(event)
	}
}

templ EventAttachments(attachments []view.AttachmentView) {
	if len(attachments) > 0 {
		<div class="attachment-strip" aria-label="Anhänge">
			for _, attachment := range attachments {
				<div class="attachment-item">
					if attachment.IsImage {
						<button class="attachment-open" type="button" data-lightbox-src={ attachment.PreviewURL } data-lightbox-full={ attachment.URL } data-lightbox-caption={ attachment.Filename }>
							<img src={ attachment.ThumbURL } alt={ attachment.Filename } loading="lazy" decoding="async"/>
							<span class="attachment-name">{ attachment.Filename }</span>
						</button>
					}
					if !attachment.IsImage {
						<a class="attachment-open" href={ templ.SafeURL(attachment.URL) } target="_blank" rel="noopener"><span class="attachment-file-icon">
							if attachment.IsPDF {
								<span>PDF</span>
							}
							if !attachment.IsPDF {
								<span>Datei</span>
							}
						</span><span class="attachment-name">{ attachment.Filename }</span></a>
					}
					if attachment.CanDelete {
						<form class="attachment-delete" method="post" action={ templ.SafeURL(attachment.DeleteURL) } data-confirm="Diesen Anhang entfernen?"><input type="hidden" name="id" value={ attachment.ID }/>
							if attachment.DeleteRedirect != "" {
								<input type="hidden" name="redirect" value={ attachment.DeleteRedirect }/>
							}
						<button type="submit" aria-label="Anhang entfernen">×</button></form>
					}
				</div>
			}
		</div>
	}
}

templ EventCreateDialog(nowInput, houseName, address string) {
	<dialog id="event-create" class="dialog event-dialog" aria-labelledby="event-create-title" aria-describedby="event-create-house">
		<form method="post" action="/app/events" enctype="multipart/form-data">
			<header class="dialog-head"><div><h2 id="event-create-title">Neuer Termin</h2><p id="event-create-house">
					if eventDialogRepeatsHouse(houseName, address) {
						{ address }
					} else {
						{ houseName }<br/>{ address }
					}
				</p></div><button class="dialog-close" type="button" data-close-dialog aria-label="Schließen">×</button></header>
			<div class="dialog-body">@EventFormFields(view.HouseEventView{StartsAtInput: nowInput}, false)</div>
			<footer class="dialog-footer"><button class="button ghost" type="button" data-close-dialog>Abbrechen</button><button class="button primary" type="submit">Termin veröffentlichen</button></footer>
		</form>
	</dialog>
}

templ EventEditDialog(event view.HouseEventView) {
	<dialog id={ event.EditDialogID } class="dialog event-dialog" aria-labelledby={ event.EditDialogID + "-title" }>
		<form method="post" action="/app/events/edit" enctype="multipart/form-data">
			<input type="hidden" name="id" value={ event.ID }/>
			<header class="dialog-head"><h2 id={ event.EditDialogID + "-title" }>Termin bearbeiten</h2><button class="dialog-close" type="button" data-close-dialog aria-label="Schließen">×</button></header>
			<div class="dialog-body">@EventFormFields(event, true)</div>
			<footer class="dialog-footer"><button class="button ghost" type="button" data-close-dialog>Abbrechen</button><button class="button primary" type="submit">Änderungen speichern</button></footer>
		</form>
	</dialog>
}

templ EventFormFields(event view.HouseEventView, editing bool) {
	<div class="dialog-grid"><label class="full" for={ eventFieldID("event-title", event.ID, editing) }>Titel<input id={ eventFieldID("event-title", event.ID, editing) } data-autofocus name="title" value={ event.Title } required autofocus maxlength="140" placeholder="Was findet statt?"/></label><label for={ eventFieldID("event-category", event.ID, editing) }>Kategorie<select id={ eventFieldID("event-category", event.ID, editing) } name="category">@EventCategoryOptions(event.Category)</select></label><label for={ eventFieldID("event-start", event.ID, editing) }>Beginn · Datum und Uhrzeit<input id={ eventFieldID("event-start", event.ID, editing) } type="datetime-local" name="starts_at" value={ event.StartsAtInput } required/></label><label class="full" for={ eventFieldID("event-location", event.ID, editing) }>Ort (optional)<input id={ eventFieldID("event-location", event.ID, editing) } name="location" value={ event.Location } maxlength="160" placeholder="Ort hinzufügen"/></label><details class="dialog-optional full"><summary>Ende, Details oder Anhang
		@DisclosureChevron()
	</summary><div class="dialog-optional-grid"><label class="full" for={ eventFieldID("event-end", event.ID, editing) }>Ende optional<input id={ eventFieldID("event-end", event.ID, editing) } type="datetime-local" name="ends_at" value={ event.EndsAtInput }/></label><label class="full" for={ eventFieldID("event-body", event.ID, editing) }>Details<textarea id={ eventFieldID("event-body", event.ID, editing) } name="body" placeholder="Was müssen Bewohner wissen?">{ event.Body }</textarea></label><label class="full" for={ eventFieldID("event-attachments", event.ID, editing) }>
		if editing {
			<span>Anhänge ergänzen</span>
		}
		if !editing {
			<span>Anhänge</span>
		}
		<span class="file-control"><input id={ eventFieldID("event-attachments", event.ID, editing) } type="file" name="attachments" accept="image/jpeg,image/png,image/webp,image/gif,application/pdf" multiple/><span>Fotos oder PDF auswählen</span></span></label></div></details></div>
}

templ EventCategoryOptions(selected string) {
	<option value="Eigentümerversammlung" selected?={ selected == "" || selected == "Eigentümerversammlung" }>Eigentümerversammlung</option>
	<option value="Reinigung" selected?={ selected == "Reinigung" }>Reinigung</option>
	<option value="Wartung" selected?={ selected == "Wartung" }>Wartung</option>
	<option value="Ablesung" selected?={ selected == "Ablesung" }>Ablesung</option>
	<option value="Frist" selected?={ selected == "Frist" }>Frist</option>
	<option value="Sonstiges" selected?={ selected == "Sonstiges" }>Sonstiges</option>
}

func eventCountWord(count int) string {
	if count == 1 { return "Termin" }
	return "Termine"
}

func eventsIssuesURL(canManage bool) string {
	if canManage { return "/app/anliegen/board" }
	return "/app/anliegen"
}

func eventFieldID(base, id string, editing bool) string {
	if editing { return base + "-" + id }
	return base
}

// eventDialogRepeatsHouse is true when the house has no display name of its
// own and falls back to its address, so the dialog would print it twice.
func eventDialogRepeatsHouse(houseName, address string) bool {
	name := strings.TrimSpace(houseName)
	return name == "" || strings.HasPrefix(strings.TrimSpace(address), name)
}
