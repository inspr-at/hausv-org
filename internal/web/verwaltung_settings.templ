package web

import "fmt"

func VerwaltungSettingsPage(shell PortalPageData, data VerwaltungSettingsData) templ.Component {
	return verwaltungSettingsPage(shell, data)
}

type VerwaltungSettingsCategory struct { Key, Label, Level string }

type VerwaltungSettingsData struct {
	ValorisationMode, ValorisationReviewPolicy, ValorisationSender string
	ValorisationFourEyes bool
	Categories []VerwaltungSettingsCategory
	OrganisationName string
	Members []VerwaltungSettingsMember
	MembersAvailable bool
	MailConfigured bool
	MailMailbox string
	MailInterval string
	MailLastRun string
	MailLastSuccess string
	MailLastError string
	MailTotal int
	OrganisationHouses int
	ContactName string
	ContactAddress string
	ContactEmail string
	ContactPhone string
	Threshold int
	AutoEnabled bool
	ProviderLabel string
	AIHost string
	AIModel string
	AITimeout string
	AIProvider string
	AIConfigured bool
	AIBaseURLOverride string
	AIModelOverride string
	AITestResult string
	AITestOK bool
	DemoResetAvailable bool
	Approved int
	Edited int
	Rejected int
	Auto int
	UnchangedShare int
	Flash string
}

type VerwaltungSettingsMember struct {
	Email string
	Name string
	RoleLabel string
	Houses int
	Since string
}

// verwaltungSettingsScripts loads demo-init.js only when the demo card is on the
// page: the script exists to open that card's dialog and has nothing to do
// otherwise.
func verwaltungSettingsScripts(data VerwaltungSettingsData) []string {
	if !data.DemoResetAvailable {
		return nil
	}
	return []string{"demo-init.js"}
}

templ verwaltungSettingsPage(shell PortalPageData, data VerwaltungSettingsData) {
	@PortalOrganisationPage(shell, "Einstellungen", verwaltungSettingsLede(), nil, verwaltungSettingsScripts(data), VerwaltungSettingsContent(data))
}

templ VerwaltungSettingsContent(data VerwaltungSettingsData) {
	<style>
		.verwaltung-settings{min-width:0;display:grid;gap:var(--space-5)}.verwaltung-settings h1,.verwaltung-settings h2{margin:0;font-family:var(--font-serif);font-weight:550}.verwaltung-settings h1{font-size:34px}.verwaltung-settings h2{font-size:24px}.settings-form{min-width:0;display:grid;gap:var(--space-5)}.settings-card{min-width:0;display:grid;gap:var(--space-4);padding:var(--space-5);border:1px solid var(--line);border-radius:var(--radius-md);background:var(--panel);box-shadow:var(--shadow-panel)}.settings-card p{margin:0}.trust-table{width:100%;border-collapse:collapse}.trust-table th,.trust-table td{padding:var(--space-3);border-bottom:1px solid var(--line);text-align:left;font-size:12px;vertical-align:middle}.trust-table th{color:var(--muted);font-size:10px;text-transform:uppercase}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.member-table th:nth-child(2),.member-table td:nth-child(2),.member-table th:nth-child(3),.member-table td:nth-child(3),.member-table th:nth-child(4),.member-table td:nth-child(4),.member-table th:nth-child(5),.member-table td:nth-child(5){width:1%;white-space:nowrap}.member-table td:nth-child(5){text-align:right}.member-table td span{display:block;margin-top:2px;color:var(--muted);font-size:11px}.trust-choice,.provider-choice{display:flex;flex-wrap:wrap;gap:var(--space-3)}.trust-choice label,.provider-choice label{display:flex;align-items:center;gap:5px}.settings-options{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:var(--space-4);margin-top:var(--space-5)}.settings-options label,.ai-fields label{min-width:0;display:grid;gap:6px;color:var(--muted);font-size:11px;font-weight:750}.settings-input-group{min-width:0;display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:var(--space-2)}.settings-input-group>span{color:var(--ink);font-size:12px;font-weight:650}.settings-options input[type=number],.ai-fields input{min-width:0;width:100%;padding:10px;border:1px solid var(--line);border-radius:var(--radius-xs);font:inherit}.settings-options .check{display:flex;align-items:center}.ai-fields{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:var(--space-4)}.member-add{display:grid;gap:0}.member-add-fields{display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:var(--space-4)}.member-add-fields label{min-width:0;display:grid;gap:6px;color:var(--muted);font-size:11px;font-weight:750}.member-add-fields input,.member-add-fields select{min-width:0;width:100%;height:48px;padding:0 12px;border:1px solid var(--line);border-radius:var(--radius-xs);background:var(--panel);color:var(--ink);font:inherit;font-size:13px}.member-add-fields select{appearance:none;-webkit-appearance:none;background-image:linear-gradient(45deg,transparent 50%,var(--muted) 50%),linear-gradient(135deg,var(--muted) 50%,transparent 50%);background-position:calc(100% - 18px) calc(50% - 3px),calc(100% - 13px) calc(50% - 3px);background-size:5px 5px,5px 5px;background-repeat:no-repeat;padding-right:32px}.settings-hint{display:block;margin-top:var(--space-4);color:var(--muted);font-size:12px;line-height:1.5}.member-add .settings-actions{margin-top:var(--space-4)}.settings-note,.active-provider,.settings-balance>p{color:var(--muted);font-size:12px}.settings-result{padding:var(--space-3);border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel-soft)}.settings-technical{margin-top:var(--space-2);color:var(--muted);font-size:12px}.settings-technical>summary{position:relative;min-height:32px;display:flex;align-items:center;padding-right:28px;cursor:pointer;list-style:none}.settings-technical>summary::-webkit-details-marker{display:none}.settings-technical code{display:block;margin-top:var(--space-2);padding:var(--space-2) var(--space-3);border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel-soft);font-size:11px;overflow-wrap:anywhere}.settings-result[data-ok=true] .status-dot{background:var(--gold)}.status-dot{display:inline-block;width:8px;height:8px;margin-right:7px;border-radius:50%;background:var(--muted)}.settings-counters{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:var(--space-2)}.settings-counters div{min-width:0;padding:var(--space-3);border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel-soft);text-align:center}.settings-counters strong{display:block;font-family:var(--font-serif);font-size:24px}.settings-counters span{display:block;overflow-wrap:anywhere;color:var(--muted);font-size:9px;text-transform:uppercase}.settings-actions{display:flex;flex-wrap:wrap;gap:var(--space-3);align-items:center}.settings-form>.settings-actions{justify-content:flex-end}.settings-save,.settings-secondary{display:inline-flex;min-height:42px;padding:0 var(--space-4);align-items:center;justify-content:center;border:1px solid var(--gold);border-radius:var(--radius-sm);font:inherit;font-weight:800;text-decoration:none}.settings-save{background:var(--gold);color:var(--panel)}.settings-secondary{background:transparent;color:var(--ink)}@media(max-width:1023px){.trust-table thead{display:none}.trust-table,.trust-table tbody,.trust-table tr,.trust-table td{display:block}.trust-table tr{padding:var(--space-3) 0}.trust-table td{border:0;padding:4px 0}.member-add{grid-template-columns:minmax(0,1fr)}.settings-counters{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:760px){.settings-options,.ai-fields{grid-template-columns:minmax(0,1fr)}.settings-counters{grid-template-columns:repeat(2,minmax(0,1fr))}.settings-card{padding:var(--space-4)}.settings-form>.settings-actions{display:grid}.settings-save{width:100%}.member-add-fields{grid-template-columns:minmax(0,1fr)}.member-table td[data-label]{display:flex;justify-content:space-between;align-items:center;gap:var(--space-3);text-align:right}.member-table td[data-label]::before{content:attr(data-label);flex:0 0 auto;color:var(--muted);font-size:10px;font-weight:750;text-transform:uppercase;text-align:left}}

		.demo-init-dialog{width:min(560px,calc(100vw - 32px));padding:var(--space-5);border:1px solid var(--line);border-radius:var(--radius-md);background:var(--panel);color:var(--ink);box-shadow:var(--shadow-dialog)}.demo-init-dialog::backdrop{background:var(--portal-backdrop);-webkit-backdrop-filter:var(--portal-backdrop-filter);backdrop-filter:var(--portal-backdrop-filter)}.demo-init-dialog form{display:grid;gap:var(--space-4)}.demo-init-dialog p{margin:0;color:var(--muted);font-size:13px;line-height:1.5}@media(max-width:760px){.demo-init-dialog{padding:var(--space-4)}.demo-init-dialog .settings-actions{display:grid}}
		.settings-card-head{min-width:0;display:flex;flex-wrap:wrap;align-items:flex-start;justify-content:space-between;gap:var(--space-3)}.settings-card-head>div{min-width:0;display:grid;gap:var(--space-2)}.ai-fields select{min-width:0;width:100%;min-height:44px;padding:0 12px;border:1px solid var(--line);border-radius:var(--radius-xs);background:var(--panel);color:var(--ink);font:inherit;font-size:13px;font-weight:500}.ai-fields input{min-height:44px;color:var(--ink);font-size:13px;font-weight:500}.settings-check{min-height:44px;display:flex;align-items:center;gap:var(--space-2);color:var(--ink);font-size:13px;font-weight:600}.settings-check input{flex:0 0 auto;width:18px;height:18px;margin:0}
		.automation-explanation{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:24px;align-items:start}.automation-explanation .settings-options{margin-top:0;grid-template-columns:minmax(0,1fr);gap:16px}.automation-note{display:grid;gap:8px;padding:16px;border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel-soft);line-height:1.6}@media(max-width:760px){.automation-explanation{grid-template-columns:minmax(0,1fr);gap:16px}}
	</style>
	<section class="verwaltung-settings">
		if data.Flash != "" {
			<p class="settings-card" role="status">{ data.Flash }</p>
		}
		<form class="settings-form" method="post">
			<section class="settings-card" id="hausverwaltung"><h2>Hausverwaltung</h2><p>Name und Kontakt dieser Verwaltung. Sie erscheinen in der Seitenleiste, im Briefkopf neuer Abrechnungsläufe und in Antworten an Bewohner.</p>
				<div class="ai-fields"><label>Name<input type="text" name="organisation_name" value={ data.OrganisationName } required/></label><label>Ansprechperson<input type="text" name="contact_name" value={ data.ContactName } placeholder="optional"/></label></div>
				<div class="ai-fields"><label>Anschrift<input id="organisation-contact-address" type="text" name="contact_address" value={ data.ContactAddress } maxlength="500" autocomplete="street-address"/></label></div>
				<div class="ai-fields"><label>E-Mail<input type="email" name="contact_email" value={ data.ContactEmail } placeholder="optional"/></label><label>Telefon<input type="tel" name="contact_phone" value={ data.ContactPhone } placeholder="optional"/></label></div>
				<p class="settings-note">{ fmt.Sprintf("%d Liegenschaften gehören zu dieser Verwaltung.", data.OrganisationHouses) } Wer welche davon betreut, entscheidet weiterhin die Rolle je Liegenschaft.</p>
			</section>
			<section class="settings-card" id="wertsicherung"><header class="settings-card-head"><div><h2>Wertsicherung</h2><p class="settings-note">Mietzinse der betreuten Liegenschaften prüfen und freigeben.</p></div><a class="button" href="/app/verwaltung/wertsicherung">Wertsicherung öffnen</a></header>
				<input type="hidden" name="valorisation_present" value="1"/>
				<div class="ai-fields"><label>Wirksamwerden<select name="valorisation_mode"><option value="cautious" selected?={ data.ValorisationMode != "contractual" }>Vorsichtig: nach endgültiger Veröffentlichung</option><option value="contractual" selected?={ data.ValorisationMode == "contractual" }>Vertraglich vorgesehener Termin</option></select></label><label>Ungeprüfte Klauseln<select name="valorisation_review"><option value="block" selected?={ data.ValorisationReviewPolicy != "warn" }>Freigabe sperren</option><option value="warn" selected?={ data.ValorisationReviewPolicy == "warn" }>Mit Warnung zulassen</option></select></label></div>
				<div class="ai-fields"><label>Absenderzeile im Anpassungsschreiben<input type="text" name="valorisation_sender" value={ data.ValorisationSender } maxlength="240" placeholder="Leer = Name der Hausverwaltung"/></label></div>
				<label class="check settings-check"><input type="checkbox" name="valorisation_four_eyes" value="1" checked?={ data.ValorisationFourEyes }/> Vier-Augen-Freigabe: eine andere berechtigte Person muss freigeben</label>
				<p class="settings-note">Geänderte Regeln gelten für neu berechnete Läufe. Gesetzliche Fristen bleiben verbindlich.</p>
			</section>
			<section class="settings-card"><h2>Automatisierung</h2><table class="trust-table"><thead><tr><th>Kategorie</th><th>Stufe</th></tr></thead><tbody>
				for _, category := range data.Categories {
					<tr><td><strong>{ category.Label }</strong></td><td><div class="trust-choice"><label><input type="radio" name={ "trust_" + category.Key } value="manual" checked?={ category.Level == "manual" }/> Manuell</label><label><input type="radio" name={ "trust_" + category.Key } value="propose" checked?={ category.Level == "propose" }/> Vorschlag</label><label><input type="radio" name={ "trust_" + category.Key } value="auto" checked?={ category.Level == "auto" }/> Automatisch</label></div></td></tr>
				}
			</tbody></table>
				<div class="automation-explanation"><div class="settings-options"><label>Schwellwert für Automatisch<span class="settings-input-group"><input type="number" name="threshold" min="50" max="100" value={ fmt.Sprint(data.Threshold) }/><span>Prozent</span></span></label><label class="check"><input type="checkbox" name="auto_enabled" value="1" checked?={ data.AutoEnabled }/> Automatisch erledigen aktiv</label></div><aside class="settings-note automation-note" aria-label="Automatisierungs-Status"><p>Die Stufe je Kategorie bestimmt, ob neue Eingänge manuell bearbeitet, als KI-Vorschlag vorbereitet oder automatisch erledigt werden.</p><p>Bei „Vorschlag“ wartet der Entwurf im Posteingang auf Ihre Prüfung und Freigabe; bei „Automatisch“ wird der Eingang ohne Freigabe erledigt, sofern die Funktion aktiv ist, ein KI-Vorschlag vorliegt und dessen Sicherheit den Schwellwert erreicht – andernfalls bleibt er zur Bearbeitung.</p><p>Das Ergebnis und die ausgeführten Schritte sehen Sie später am Eingang und im Verlauf (Audit).</p></aside></div>
			</section>
			<section class="settings-card settings-balance"><h2>Bilanz seit Start</h2><p>„Ohne Änderung freigegeben“ zeigt den Anteil der freigegebenen KI-Vorschläge, deren Text unverändert übernommen wurde.</p><div class="settings-counters"><div><strong>{ fmt.Sprint(data.Approved) }</strong><span>freigegeben</span></div><div><strong>{ fmt.Sprint(data.Edited) }</strong><span>geändert</span></div><div><strong>{ fmt.Sprint(data.Rejected) }</strong><span>verworfen</span></div><div><strong>{ fmt.Sprint(data.Auto) }</strong><span>automatisch</span></div><div><strong>{ fmt.Sprintf("%d %%", data.UnchangedShare) }</strong><span>ohne Änderung freigegeben</span></div></div></section>
			<section class="settings-card"><h2>KI-Anbieter</h2>
				if data.AIConfigured {
					<p class="active-provider"><strong>Aktiv:</strong> { data.ProviderLabel } · { data.AIHost } · Zeitlimit { data.AITimeout }</p>
				} else {
					<p class="active-provider" data-provider-state="nicht eingerichtet"><strong>KI-Vorschläge sind in dieser Umgebung nicht eingerichtet</strong></p>
				}
				<div class="provider-choice"><label><input type="radio" name="ai_provider" value="environment" checked?={ data.AIProvider == "environment" }/> Umgebung</label><label><input type="radio" name="ai_provider" value="cloud" checked?={ data.AIProvider == "cloud" }/> Cloud (OpenRouter)</label><label><input type="radio" name="ai_provider" value="local" checked?={ data.AIProvider == "local" }/> Lokal (OpenAI-kompatibel)</label></div>
				<div class="ai-fields"><label>Basis-URL<input type="url" name="ai_base_url" value={ data.AIBaseURLOverride } placeholder="Leer lassen = Standard der Plattform"/></label><label>Modell<input type="text" name="ai_model" value={ data.AIModelOverride } placeholder="Leer lassen = Standard der Plattform"/></label></div>
				<p class="settings-note">Die Wahl gilt für den nächsten Vorschlag; ein lokaler Endpunkt muss vom Server erreichbar sein. Leer lassen = Standard der Plattform.</p>
			</section>
			<div class="settings-actions"><button class="settings-save" type="submit">Einstellungen speichern</button></div>
		</form>
		if data.MembersAvailable {
			<section class="settings-card"><h2>Mitarbeiter</h2><p>Wer hier steht, betreut alle Liegenschaften dieser Verwaltung. Beim Entfernen werden genau die dadurch vergebenen Rollen wieder zurückgenommen.</p>
				if len(data.Members) == 0 {
					<p class="settings-note">Noch niemand aufgenommen.</p>
				} else {
					<table class="trust-table member-table"><thead><tr><th>Person</th><th>Rolle</th><th>Liegenschaften</th><th>Seit</th><th class="sr-only">Aktion</th></tr></thead><tbody>
						for _, member := range data.Members {
							<tr>
								<td>
									if member.Name != "" {
										<strong>{ member.Name }</strong><br/>
									}
									<span>{ member.Email }</span>
								</td>
								<td data-label="Rolle">{ member.RoleLabel }</td>
								<td data-label="Liegenschaften">{ fmt.Sprint(member.Houses) }</td>
								<td data-label="Seit">{ member.Since }</td>
								<td><form method="post" action="/app/verwaltung/einstellungen/mitarbeiter/entfernen"><input type="hidden" name="member_email" value={ member.Email }/><button class="settings-secondary" type="submit">Entfernen</button></form></td>
							</tr>
						}
					</tbody></table>
				}
				<form class="member-add" method="post" action="/app/verwaltung/einstellungen/mitarbeiter">
					<div class="member-add-fields"><label>E-Mail<input type="email" name="member_email" required placeholder="person@example.com"/></label><label>Rolle<select name="member_role"><option value="sachbearbeiter">Sachbearbeiter</option><option value="admin">Verwaltungs-Admin</option></select></label></div>
					<small class="settings-hint">Die Person muss bereits in einer Liegenschaft angelegt sein. Ein Verwaltungs-Admin erhält die Adminrolle je Liegenschaft, ein Sachbearbeiter die Verwalterrolle.</small>
					<div class="settings-actions"><button class="settings-secondary" type="submit">Mitarbeiter aufnehmen</button></div>
				</form>
			</section>
		}
		<form class="settings-card" method="post" action="/app/verwaltung/einstellungen/ki-test"><h2>KI-Verbindung</h2><p>Prüft die aktive Konfiguration mit einer kurzen, synthetischen Anfrage.</p>
			if data.AITestResult != "" {
				<p class="settings-result" role="status" data-ok={ fmt.Sprint(data.AITestOK) }><span class="status-dot"></span>{ data.AITestResult }</p>
			}
			<div class="settings-actions"><button class="settings-secondary" type="submit">Verbindung testen</button></div>
		</form>
		<section class="settings-card"><h2>E-Mail-Eingang</h2>
			if data.MailConfigured {
				<p class="active-provider"><strong>Aktiv:</strong> { data.MailMailbox } · alle { data.MailInterval }</p>
				if data.MailLastError != "" {
					<p class="settings-result" role="status" data-ok="false"><span class="status-dot"></span>{ mailIntakeFailureText(data) }</p>
					<details class="settings-technical"><summary>Technische Details
						@DisclosureChevron()
					</summary><p><code>{ data.MailLastError }</code></p></details>
				} else if data.MailLastRun != "" {
					<p class="settings-result" role="status" data-ok="true"><span class="status-dot"></span>{ fmt.Sprintf("Zuletzt abgerufen %s · %d Mails seit Start übernommen", data.MailLastRun, data.MailTotal) }</p>
				}
				<p class="settings-note">Ungelesene Mails werden abgeholt, Liegenschaft und Person aus Absender, Betreff und Text vorgeschlagen, Anhänge übernommen. Antworten tragen die Anliegen-Nummer im Betreff, damit Rückantworten beim Anliegen landen.</p>
			} else {
				<p class="active-provider" data-provider-state="nicht konfiguriert"><strong>Kein Postfach konfiguriert</strong></p>
				<p class="settings-note">Ein Postfach je Verwaltung wird über die Serverkonfiguration angebunden (INTAKE_MAIL_JSON, Zugangsdaten als Datei- oder Umgebungsreferenz). Bis dahin nehmen Portal und Telefonnotiz Anliegen auf.</p>
			}
		</section>
		if data.DemoResetAvailable {
			<section class="settings-card" id="demodaten"><h2>{ demoInitTitle }</h2><p>Spielt die gebündelten Demodaten mit dem heutigen Datum neu ein: Anliegen, Organisationsdaten, Ankündigungen und Termine werden ersetzt, Ihre Anmeldung bleibt gültig.</p><div class="settings-actions"><a class="settings-secondary" href="/app/verwaltung/einstellungen/demo" data-demo-init-open aria-haspopup="dialog" aria-controls="demo-init-dialog">{ demoInitTitle + " …" }</a></div></section>
			@VerwaltungDemoInitDialog()
		}
	</section>
}

// mailIntakeFailureText keeps the raw poll error out of the customer-facing
// status line (HAUSV-655): the sentence names the situation and the last
// successful poll; the technical text stays in the disclosure below.
func mailIntakeFailureText(data VerwaltungSettingsData) string {
	if data.MailLastSuccess != "" {
		return "Postfach derzeit nicht erreichbar · letzter erfolgreicher Abruf " + data.MailLastSuccess
	}
	return "Postfach derzeit nicht erreichbar · noch kein erfolgreicher Abruf seit dem Start"
}


templ verwaltungSettingsLede() { <p>Hausverwaltung, Kommunikation und Automatisierung.</p> }
