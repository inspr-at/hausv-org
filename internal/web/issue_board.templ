package web

import (
	"net/url"
	"strconv"
	"strings"
	"unicode"

	"github.com/inspr-at/hausv-org/internal/view"
)

// IssueBoardPageData carries the management view of /app/anliegen/board. It is
// the manager counterpart to IssuesPageData and deliberately reuses the card,
// pill and attachment components from issues.templ so both views of the same
// object keep one visual language.
type IssueBoardPageData struct {
	Portal                  PortalPageData
	AssetVersion            string
	ActorEmail              string
	BoardAction             string
	CalendarFeedURL         string
	CanCreateIssue          bool
	CanManageAnnouncements  bool
	IsServiceProvider       bool
	Filters                 view.IssueBoardFilterView
	ServiceProviderContacts []view.ContactOptionView
	Issues                  []view.IssueView
	TotalIssueCount         int
	OpenIssueCount          int
	UrgentIssueCount        int
	NewIssueCount int
	ProgressIssueCount int
	AssignedIssueCount int
	Message string
	MessageOK bool
	IssuesEmpty             view.EmptyStateView
}

// IssueTriagePageData carries /app/anliegen/board/{id}, the two-step triage and
// the follow-up steps that come after it.
type IssueTriagePageData struct {
	Portal       PortalPageData
	AssetVersion string
	ActorEmail   string
	Issue        view.IssueView
	TriageStep   string
	Assignees []view.SelectOption
}

templ IssueBoardPage(data IssueBoardPageData) {
	@PortalDocument(data.Portal.Title, data.AssetVersion, []string{"attachments.js", "issues.js", "issue-board.js"}, IssueBoardStyles(), templ.Attributes{"data-templ-issue-board": true}) {
		@PortalShell(data.Portal, "Anliegen", IssueBoardContent(data))
	}
}

templ IssueTriagePage(data IssueTriagePageData) {
	@PortalDocument(data.Portal.Title, data.AssetVersion, []string{"attachments.js"}, IssueTriageStyles(), templ.Attributes{"data-templ-issue-triage": true}) {
		@PortalShell(data.Portal, "Anliegen", IssueTriageContent(data))
	}
}

templ IssueBoardStyles() {
	@IssuesStyles()
	@IssueBoardBlock()
}

templ IssueTriageStyles() {
	@IssuesStyles()
	@IssueTriageBlock()
}

templ IssueBoardBlock() {
	<style>.board-filter-blank{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:var(--space-4);align-items:center;padding:var(--space-5);border:1px solid var(--line);border-radius:var(--radius-md);background:var(--panel-soft)}.board-filter-blank h2{font-size:21px}.board-filter-blank p{margin-top:var(--space-1);max-width:62ch;color:var(--muted);font-size:13px;line-height:1.5}
		.board-blank{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(286px,.9fr);gap:var(--space-4)}.board-blank-main{display:grid;align-content:center;gap:var(--space-5);padding:clamp(22px,3.2vw,36px);border:1px solid var(--line);border-radius:var(--radius-md);background:var(--panel);box-shadow:var(--shadow-panel)}.board-blank-lead{display:grid;justify-items:start;gap:var(--space-3)}.board-blank-main h2{font-size:clamp(25px,3vw,31px)}.board-blank-main p{max-width:56ch;color:var(--muted);font-size:14px;line-height:1.55}.board-blank-actions{display:flex;flex-wrap:wrap;gap:var(--space-2)}.board-blank-actions .button{min-height:44px}
		.board-blank-side{display:grid;align-content:start;gap:var(--space-3);padding:var(--space-5);border:1px solid var(--line);border-radius:var(--radius-md);background:var(--panel-soft)}.board-blank-side h2{font-family:var(--font-sans);color:var(--gold-ink);font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.board-blank-steps{display:grid;gap:var(--space-3);margin:0;padding:0;list-style:none;counter-reset:board-step}.board-blank-steps li{display:grid;grid-template-columns:24px minmax(0,1fr);gap:2px var(--space-3);align-items:start;counter-increment:board-step}.board-blank-steps li::before{content:counter(board-step);grid-row:1/span 2;width:24px;height:24px;display:grid;place-items:center;border-radius:var(--radius-pill);background:var(--ink);color:var(--panel);font-size:12px;font-weight:800}.board-blank-steps strong{grid-column:2;font-size:13px}.board-blank-steps span{grid-column:2;color:var(--muted);font-size:12px;line-height:1.4}.board-blank-note{padding-top:var(--space-3);border-top:1px solid var(--line);color:var(--muted);font-size:12px;line-height:1.5}
		.board-blank-facts{display:grid;grid-column:1/-1;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-4);margin:0;padding:0;list-style:none}.board-blank-facts li{display:grid;gap:var(--space-1);padding-top:var(--space-3);border-top:2px solid var(--ink)}.board-blank-facts strong{font-size:13px}.board-blank-facts span{color:var(--muted);font-size:12px;line-height:1.5}

.portal-section-landing.portal-section-wide.issue-board-main,.portal-section-landing.issue-board-main{--portal-content-width:100%}
body[data-authenticated-app] .issue-board-main:is(.portal-section-landing) :is(.portal-section-header,.portal-section-context,.portal-section-content){padding-inline:32px}
.issue-board-main .portal-section-context{--context-bar-h:40px;min-height:40px;height:40px;padding-block:0;display:flex;align-items:center}
.issue-board-main .portal-section-context a{min-height:44px;display:inline-flex;align-items:center}
.issue-board-main .portal-section-header-action{min-width:0}
.issue-board-main .portal-section-header-action .button{background:transparent;color:var(--ink);border-color:var(--line)}
.board-header-tools{display:flex;flex-wrap:wrap;gap:12px;align-items:center;min-width:0}
.board-view-switch{display:flex;gap:4px}body[data-authenticated-app] .issue-board-main .board-view-switch .button{min-height:44px;padding-inline:16px}
.board-view-switch [aria-current=page]{border-color:var(--gold)!important}
.board-search{display:none;min-width:0;max-width:240px}
.issue-board-main:has(.is-enhanced) .board-search{display:block}
.board-search input{min-height:44px;width:100%;min-width:0;border:1px solid var(--line);border-radius:8px;padding:10px 12px;background:var(--panel);font:inherit}
.board-workspace{display:grid;gap:20px;min-width:0;width:100%}
.board-toolbar{min-width:0;display:grid;gap:12px}
.board-summary{display:flex;flex-wrap:wrap;gap:8px;color:var(--muted)}
.board-quick{display:flex;flex-wrap:wrap;gap:8px;grid-row:1}
.board-quick a{min-height:44px;display:inline-flex;align-items:center;gap:8px;padding:8px 14px;border:1px solid var(--line);border-radius:24px;background:var(--panel);font-size:12px;color:var(--muted)}
.board-quick a[aria-current=true]{border-color:var(--gold);background:var(--panel-soft);color:var(--ink)}
.board-quick a span{font-variant-numeric:tabular-nums}
.board-tools{border-block:1px solid var(--line)}
.board-tools>summary{min-height:44px;display:flex;align-items:center;gap:12px;list-style:none;cursor:pointer;font-size:12px}
.board-tools>summary::-webkit-details-marker{display:none}
.board-tools>summary>span{color:var(--muted)}
.board-filter{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));align-items:end;gap:12px;padding:16px 0}
.board-filter label{display:grid;gap:8px;min-width:0;font-size:12px}
.board-filter :is(input,select){width:100%;min-width:0;min-height:44px;padding:8px;border:1px solid var(--line);border-radius:6px;background:var(--panel);font:inherit}
.board-filter-actions{display:flex;flex-wrap:wrap;gap:8px;grid-column:1/-1}
.board-filter-actions :is(button,a){display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:8px 16px;border:1px solid var(--line);border-radius:6px;background:var(--panel);color:var(--ink);font:inherit;font-size:12px}
.board-layout{display:grid;grid-template-columns:minmax(0,1fr);gap:20px;min-width:0;align-items:start}
.board-layout:has(.board-panel:not([hidden])){grid-template-columns:minmax(0,1fr) 360px}.board-layout:has(.board-panel:not([hidden])) .board-columns{grid-template-columns:repeat(5,minmax(200px,1fr))}
.board-columns{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;min-width:0;width:100%;overflow-x:auto;overscroll-behavior-x:contain;align-items:start;padding:2px 2px 16px}
.board-column{min-width:0;background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:8px;min-height:190px}
.board-column-head{display:flex;gap:4px;align-items:center;justify-content:space-between;min-height:56px;padding-bottom:8px}
.board-column-head h2{font:600 12px/1.3 var(--font-sans);overflow-wrap:anywhere}
.board-column-head .pill{padding:3px 6px;min-width:24px;flex:none}
.board-column .issue-list{display:grid;gap:8px;min-height:108px}
.board-column-empty{margin:0;min-height:108px;display:grid;place-items:center;border:1px dashed var(--line);border-radius:8px;color:var(--muted);font-size:12px;text-align:center}
.board-column-empty[hidden],.board-panel[hidden],[data-board-transition][hidden],[data-board-card][hidden]{display:none}
.board-column.is-drop-target{outline:2px dashed var(--gold);outline-offset:-2px;background:var(--panel-soft)}
.board-column .issue-work-card{position:relative;display:grid;grid-template-columns:minmax(0,1fr);gap:8px;min-width:0;padding:12px 10px 10px 32px;border:1px solid var(--line);border-radius:8px;background:var(--panel);box-shadow:none;cursor:pointer}
.issue-work-card h3{min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font:600 13px/1.4 var(--font-sans)}
.board-card-meta{display:flex;flex-wrap:wrap;gap:4px 6px;min-width:0;align-items:center;font-size:12px;overflow:hidden}
.board-card-meta .pill{flex:0 1 auto;font-size:11px;padding:2px 8px;min-height:20px;max-width:100%;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.issue-work-card .issue-location{min-width:0;flex:1 1 100%;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:12px;color:var(--muted);margin:0}
.issue-priority{display:inline-flex;align-items:center;gap:5px;font-size:11px;color:var(--muted)}
.issue-priority i{width:6px;height:6px;flex:none;border-radius:50%;background:var(--soft)}
.issue-priority[data-priority=Hoch] i,.issue-priority[data-priority=Dringend] i{background:var(--gold)}
.issue-work-card .board-card-foot{display:flex;align-items:center;justify-content:space-between;gap:4px;color:var(--muted);font-size:11px}
.issue-assignee-avatar{width:26px;height:26px;flex:none;display:grid;place-items:center;border-radius:50%;background:var(--paper);font-size:11px;font-weight:700;border:1px solid var(--line)}
.issue-assignee-avatar.is-unassigned{border-style:dashed;background:transparent}
.board-drag-handle{display:none;position:absolute;left:-10px;top:2px;width:44px;min-width:44px;height:44px;min-height:44px;padding:14px;border:0;background:transparent;color:var(--muted);cursor:grab;touch-action:none;user-select:none;-webkit-user-select:none}
.is-enhanced .board-drag-handle{display:flex;align-items:center;justify-content:center}
.board-drag-handle :is(svg,img){width:16px;height:16px;max-width:none}
.is-enhanced noscript{display:none}
.board-card-fallback{min-height:44px;display:inline-flex;align-items:center}
.issue-work-card.is-selected{border-color:var(--gold);box-shadow:0 0 0 1px var(--gold)}
.issue-work-card.is-pending{border-style:dashed;background:var(--panel-soft)}
.issue-work-card.is-dragging{opacity:.55}
.issue-work-card[aria-busy=true]{opacity:.65;cursor:progress}
.issue-board-main :is(a,button,input,select,[tabindex]):focus-visible{outline:2px solid var(--gold);outline-offset:2px}
.board-panel{position:sticky;top:var(--board-panel-top,16px);display:grid;gap:20px;min-width:0;width:360px;max-height:calc(100dvh - var(--board-panel-top,16px) - 16px);overflow-y:auto;overscroll-behavior:contain;padding:24px;border:1px solid var(--line);border-radius:12px;background:var(--panel);box-shadow:var(--shadow-panel);overflow-wrap:anywhere}
.board-panel-head{display:flex;align-items:start;justify-content:space-between;gap:8px}
.board-panel h2{font:500 28px/1.15 var(--font-serif);margin-top:6px}
.board-panel .kicker{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--gold-ink)}
.board-panel-close{min-width:44px;min-height:44px;display:grid;place-items:center;flex:none;border:1px solid var(--line);border-radius:8px;background:transparent;color:var(--ink)}
.board-panel-close :is(svg,img){width:18px;height:18px}
.board-panel-meta{display:flex;flex-wrap:wrap;gap:6px}
.board-panel-description{white-space:pre-wrap;font-size:14px;line-height:1.6}
.board-panel .muted{font-size:12px;line-height:1.5}
.board-panel section{display:grid;gap:12px;padding-top:16px;border-top:1px solid var(--line)}
.board-panel h3{font:600 12px/1.5 var(--font-sans);color:var(--gold-ink)}
.board-panel form,.board-panel label{display:grid;gap:8px;min-width:0;font-size:12px}
.board-panel :is(select,input:not([type=hidden]),button,.button){min-height:44px;max-width:100%;min-width:0;padding:10px;border:1px solid var(--line);border-radius:6px;background:var(--panel);color:var(--ink);font:inherit;font-size:12px}
.board-panel select{width:100%}
body[data-authenticated-app] .board-panel .board-edit{min-height:44px;border-color:var(--gold);background:transparent;justify-content:center}
.board-panel-actions{position:sticky;bottom:-24px;z-index:2;display:grid;gap:8px;margin:0 -24px -24px;padding:10px 24px 16px;border-top:1px solid var(--line);background:var(--panel)}.board-panel-actions form{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px 8px;align-items:center}.board-panel-actions form label{grid-column:1/-1;font-size:12px;color:var(--muted)}.board-panel-actions form select{min-height:44px}.board-panel-actions form button{min-height:44px;padding-inline:16px}.board-panel-actions .board-edit{min-height:44px}
.board-panel-actions button{flex:1}
.board-panel [data-board-transition]{padding:16px;border:1px dashed var(--gold);border-radius:8px;background:var(--panel-soft)}
.board-history{display:grid;gap:16px;list-style:none;margin:0;padding:0;font-size:12px}
.board-history li{display:grid;gap:4px}
.board-history span{color:var(--muted)}
.board-feedback:not(:empty),.board-panel-feedback:not(:empty){padding:12px 16px;border:1px solid var(--line);border-radius:8px;background:var(--panel-soft);font-size:13px}
.board-feedback:empty,.board-panel-feedback:empty{display:none}
[data-error=true]{color:var(--gold-ink)}
.board-touch-preview{position:fixed;z-index:110;pointer-events:none;max-width:260px;padding:16px;border:1px solid var(--gold);border-radius:8px;background:var(--panel);box-shadow:var(--shadow-panel);overflow-wrap:anywhere;opacity:.9}
@media(max-width:1100px){.board-filter{grid-template-columns:repeat(2,minmax(0,1fr))}.board-blank{grid-template-columns:minmax(0,1fr)}}
@media(max-width:899px){.board-columns,.board-layout:has(.board-panel:not([hidden])) .board-columns{grid-template-columns:minmax(0,1fr);overflow-x:visible}.board-blank-facts{grid-template-columns:minmax(0,1fr)}}
@media(max-width:759px){body[data-authenticated-app] .issue-board-main:is(.portal-section-landing) :is(.portal-section-header,.portal-section-context,.portal-section-content){padding-inline:16px}.board-layout:has(.board-panel:not([hidden])){grid-template-columns:minmax(0,1fr)}.board-panel{position:fixed;inset:0;z-index:120;width:100%;height:100dvh;max-height:none;border-radius:0;padding:20px;padding-bottom:max(20px,env(safe-area-inset-bottom))}body:has(.board-panel:not([hidden])){overflow:hidden}.board-filter{grid-template-columns:minmax(0,1fr)}.board-filter-blank{grid-template-columns:minmax(0,1fr)}.board-header-tools{width:100%}.board-search{flex:1 1 150px}.board-blank-main,.board-blank-side{padding:16px}}
</style>
}

templ IssueTriageBlock() {
	<style>.triage-page{max-width:1120px;margin:0 auto;display:grid;gap:var(--space-5)}.issue-triage-context{display:grid;gap:var(--space-3);padding-bottom:var(--space-5);border-bottom:1px solid var(--line)}.issue-triage-back{width:max-content;min-height:44px;display:inline-flex;align-items:center;color:var(--muted);font-size:12px;font-weight:800}.issue-triage-back:hover{color:var(--ink)}.issue-triage-context h1{font-size:clamp(34px,4.4vw,50px);line-height:1.05}.issue-triage-context>p{max-width:72ch;color:var(--muted);font-size:14px;line-height:1.6}.issue-triage-facts{display:flex;flex-wrap:wrap;gap:var(--space-1) var(--space-5);color:var(--muted);font-size:12px;font-weight:700}
		.issue-triage-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(286px,330px);gap:var(--space-5);align-items:start}.issue-triage-main{min-width:0;display:grid;gap:var(--space-5)}.issue-triage-card{width:min(780px,100%);display:grid;gap:var(--space-6);padding:clamp(20px,3.4vw,36px);border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--panel);box-shadow:var(--shadow-panel)}
		.issue-triage-progress{display:flex;align-items:center;justify-content:space-between;gap:var(--space-4);color:var(--gold-ink);font-size:11px;font-weight:800}.issue-triage-progress>span:last-child{display:flex;gap:6px}.issue-triage-progress i{width:26px;height:4px;border-radius:var(--radius-pill);background:var(--line)}.issue-triage-progress i.active{background:var(--gold)}
		.issue-triage-card select{width:100%;min-width:0;min-height:44px;padding:10px;border:1px solid var(--line);border-radius:6px;background:var(--panel);color:var(--ink);font:inherit}.issue-triage-card fieldset{min-width:0;display:grid;gap:var(--space-3);padding:0;border:0}.issue-triage-card legend{margin-bottom:var(--space-5);color:var(--ink);font-family:var(--font-serif);font-size:clamp(25px,3.2vw,34px);font-weight:600;line-height:1.15}
		.issue-triage-choice{position:relative;min-width:0;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:var(--space-4);align-items:center;padding:var(--space-4);border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel);color:var(--ink);cursor:pointer}.issue-triage-choice:hover{border-color:var(--gold)}.issue-triage-choice:has(input:checked){border-color:var(--leaf);background:var(--panel-soft)}.issue-triage-choice.urgent:has(input:checked){border-color:var(--gold);background:var(--panel-soft)}.issue-triage-choice.calm:has(input:checked){border-color:var(--muted)}.issue-triage-choice>span{min-width:0;display:grid;gap:3px}.issue-triage-choice strong{font-size:15px}.issue-triage-choice small{color:var(--muted);font-size:12px;font-weight:600;line-height:1.4}.issue-triage-choice input{grid-column:2;grid-row:1;width:20px;height:20px;margin:0;accent-color:var(--leaf)}
		.issue-triage-actions{display:flex;align-items:center;justify-content:space-between;gap:var(--space-3);padding-top:var(--space-5);border-top:1px solid var(--line)}.issue-triage-actions>a:not(.button){color:var(--muted);font-size:12px;font-weight:800}.issue-triage-actions button{min-width:132px;min-height:44px;padding:var(--space-2) var(--space-4);border:1px solid var(--ink);border-radius:var(--radius-xs);background:var(--ink);color:var(--panel);font-weight:800}.issue-triage-actions button.ghost{background:transparent;border-color:var(--line);color:var(--ink)}
		.issue-triage-done{grid-template-columns:auto minmax(0,1fr);align-items:start}.issue-triage-done-mark{width:46px;height:46px;display:grid;place-items:center;border:1px solid var(--leaf);border-radius:var(--radius-pill);color:var(--leaf);font-size:20px;font-weight:800}.issue-triage-done .kicker{color:var(--gold-ink);font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.issue-triage-done h2{margin-top:var(--space-2);font-size:clamp(23px,2.8vw,31px)}.issue-triage-done p{margin-top:var(--space-2);color:var(--muted);font-size:13px;line-height:1.5}.issue-triage-done .issue-triage-actions{grid-column:1/-1;width:100%}
		.issue-message-form{display:grid;gap:var(--space-5)}.issue-message-body{display:grid;gap:var(--space-2);color:var(--gold-ink);font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.issue-message-body textarea{min-height:130px;padding:var(--space-3);border:1px solid var(--line);border-radius:var(--radius-xs);background:var(--panel);color:var(--ink);font-size:13px;font-weight:500;letter-spacing:0;line-height:1.5;text-transform:none;resize:vertical}.issue-resolution-propose{display:flex;align-items:center;justify-content:space-between;gap:var(--space-5);padding-top:var(--space-5);border-top:1px solid var(--line)}.issue-resolution-propose>span{display:grid;gap:3px;font-size:13px}.issue-resolution-propose small{color:var(--muted);font-size:12px}.issue-resolution-propose button{min-height:44px;padding:var(--space-2) var(--space-4);border:1px solid var(--line);border-radius:var(--radius-xs);background:transparent;color:var(--ink);font-weight:800}
		.issue-triage-aside{min-width:0;display:grid;align-content:start;gap:var(--space-3)}.issue-triage-state{display:grid;gap:var(--space-3);padding:var(--space-4);border:1px solid var(--line);border-radius:var(--radius-md);background:var(--panel);box-shadow:var(--shadow-panel)}.issue-triage-state h2{font-family:var(--font-sans);color:var(--gold-ink);font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.issue-triage-state dl{display:grid;margin:0}.issue-triage-state dl>div{min-width:0;display:grid;grid-template-columns:84px minmax(0,1fr);gap:var(--space-3);align-items:baseline;padding:var(--space-2) 0;border-top:1px solid var(--line)}.issue-triage-state dl>div:first-child{align-items:center;padding-top:0;border-top:0}.issue-triage-state dt{color:var(--muted);font-size:11px;font-weight:750}.issue-triage-state dd{min-width:0;margin:0;font-size:13px;font-weight:750;overflow-wrap:anywhere}.issue-triage-state-line{color:var(--muted);font-size:12px;line-height:1.45}.issue-triage-state-line strong{color:var(--ink)}.issue-triage-state-next{padding-top:var(--space-3);border-top:1px solid var(--line);color:var(--muted);font-size:12px;line-height:1.45}
		.issue-triage-more{border:1px solid var(--line);border-radius:var(--radius-md);background:var(--panel)}.issue-triage-more>summary{min-height:44px;display:flex;align-items:center;padding:var(--space-3) var(--space-4);color:var(--muted);cursor:pointer;font-size:12px;font-weight:800;list-style:none}.issue-triage-more>summary::-webkit-details-marker{display:none}.issue-triage-more-body{display:grid;gap:var(--space-4);padding:var(--space-4);border-top:1px solid var(--line)}
		.issue-details-edit{display:grid;gap:var(--space-4)}.issue-details-edit label{display:grid;gap:var(--space-2);color:var(--gold-ink);font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase}.issue-details-edit textarea,.issue-details-edit input{width:100%;min-height:42px;padding:var(--space-2) var(--space-3);border:1px solid var(--line);border-radius:var(--radius-xs);background:var(--panel);color:var(--ink)}.issue-details-edit textarea{min-height:110px;resize:vertical}.issue-details-edit button{min-height:44px;padding:var(--space-2) var(--space-4);border:1px solid var(--ink);border-radius:var(--radius-xs);background:var(--ink);color:var(--panel);font-weight:800}.issue-location-type{display:grid;gap:var(--space-2)}.issue-field-label{color:var(--gold-ink);font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase}
		@media(max-width:1050px){.issue-triage-layout{grid-template-columns:minmax(0,1fr)}.issue-triage-state dl{grid-template-columns:repeat(auto-fit,minmax(164px,1fr));gap:0 var(--space-5)}.issue-triage-state dl>div{grid-template-columns:minmax(0,1fr);gap:2px;align-items:start;padding:var(--space-2) 0;border-top:0;border-bottom:1px solid var(--line)}.issue-triage-state dl>div:first-child{align-items:start;padding-top:var(--space-2)}}
		@media(max-width:760px){.triage-page{gap:var(--space-4)}.issue-triage-context{gap:var(--space-2);padding-bottom:var(--space-4)}.issue-triage-context h1{font-size:32px}.issue-triage-card{gap:var(--space-5);padding:var(--space-4)}.issue-triage-card legend{margin-bottom:var(--space-4);font-size:25px}.issue-triage-choice{gap:var(--space-3);padding:var(--space-3)}.issue-triage-actions{align-items:stretch;display:grid}.issue-triage-actions button,.issue-triage-actions .button{min-width:0;width:100%}.issue-triage-done{grid-template-columns:minmax(0,1fr)}.issue-triage-done .issue-triage-actions{grid-column:1}.issue-resolution-propose{align-items:stretch;flex-direction:column}.issue-resolution-propose button{width:100%}}
	</style>
}

templ IssueBoardContent(data IssueBoardPageData) {
	@PortalSectionLanding(
		PortalSectionLandingData{
			Wide: true,
			Portal: data.Portal,
			PageLabel: "Anliegen",
			Class: "issues-main issue-board-main",
			Identity: PortalSectionIdentityData{Label: "Verwaltung", Icon: "issue"},
		},
		PortalSectionTitle("Anliegen bearbeiten"),
		PortalSectionLede("Offene Meldungen priorisieren und in den nächsten Schritt bringen."),
		IssueBoardHeaderAction(data),
		nil,
		IssueBoardContext(),
		IssueBoardBody(data),
	)
}

templ IssueBoardHeaderAction(data IssueBoardPageData) {
	<div class="board-header-tools">
		<label class="board-search"><span class="sr-only">Anliegen durchsuchen</span><input type="search" data-board-search placeholder="Anliegen suchen …" aria-label="Anliegen durchsuchen"/></label>
		<nav class="board-view-switch" aria-label="Ansicht"><a class="button" href="/app/anliegen/board" aria-current="page">Board</a><a class="button" href="/app/anliegen">Liste</a></nav>
	</div>
	if data.IsServiceProvider && data.CalendarFeedURL != "" {
		<a class="button" href={ templ.SafeURL(data.CalendarFeedURL) }>Kalender abonnieren</a>
	}
}

templ IssueBoardContext() {
	<a href="/app/anliegen">← Zurück zu Anliegen</a>
}

templ IssueBoardBody(data IssueBoardPageData) {
	if len(data.ServiceProviderContacts) > 0 {
		<datalist id="service-provider-contacts">
			for _, contact := range data.ServiceProviderContacts {
				<option value={ contact.Email }>{ contact.Label }</option>
			}
		</datalist>
	}
	<section class="board-workspace" id="issue-manage" aria-label="Anliegen in der Liegenschaft" data-issue-board>
		<p class="board-feedback" role="status" aria-live="polite" aria-atomic="true" data-board-feedback data-error={ strconv.FormatBool(!data.MessageOK) }>{ data.Message }</p>
		if data.TotalIssueCount > 0 {
			@IssueBoardToolbar(data)
		}
		<div class="board-layout">
		if len(data.Issues) > 0 {
			<div class="board-columns" role="region" aria-label="Anliegen nach Status" tabindex="0">
				for index, column := range issueBoardColumns(data.Filters.StatusOptions, data.Issues) {
					<section class="board-column" data-board-status={ column.Status } aria-labelledby={ "board-column-" + strconv.Itoa(index) }>
						<header class="board-column-head"><h2 id={ "board-column-" + strconv.Itoa(index) }>{ column.StatusLabel }</h2><span class="pill" data-board-count>{ len(column.Issues) }</span></header>
						<div class="issue-list">
							for _, issue := range column.Issues {
								@IssueWorkCard(issue)
							}
							<p class="board-column-empty" hidden?={ len(column.Issues) > 0 }>Hierher ziehen</p>
						</div>
					</section>
				}
			</div>
		} else if data.TotalIssueCount > 0 {
			@IssueBoardFilterBlank(data)
		} else {
			@IssueBoardBlank(data)
		}
		<aside class="board-panel" data-board-panel aria-label="Anliegen" tabindex="-1" hidden></aside>
		</div>
	</section>
}

templ IssueBoardToolbar(data IssueBoardPageData) {
	<div class="board-toolbar">
		<div class="board-summary" aria-label="Anliegen-Überblick"><span class="pill">{ strconv.Itoa(data.OpenIssueCount) } offen</span>
			if data.UrgentIssueCount > 0 {
				<span class="pill dringend">{ strconv.Itoa(data.UrgentIssueCount) } dringend</span>
			}
			<span class="pill">{ strconv.Itoa(data.TotalIssueCount) } gesamt</span>
		</div>
		<details class="board-tools" open?={ data.Filters.HasActive }>
			<summary><strong>Filter &amp; Sortierung</strong><span>{ boardFilterState(data.Filters) }</span>
				@DisclosureChevron()
			</summary>
			<form class="board-filter" method="get" action={ templ.SafeURL(data.BoardAction) }>
				<label>Status<select name="status">
					for _, option := range data.Filters.StatusOptions {
						<option value={ option.Value } selected?={ option.Selected }>{ option.Label }</option>
					}
				</select></label>
				<label>Priorität<select name="priority">
					for _, option := range data.Filters.PriorityOptions {
						<option value={ option.Value } selected?={ option.Selected }>{ option.Label }</option>
					}
				</select></label>
				<label>Kategorie<select name="category">
					for _, option := range data.Filters.CategoryOptions {
						<option value={ option.Value } selected?={ option.Selected }>{ option.Label }</option>
					}
				</select></label>
				<label class="assignee">Zuständig
					if len(data.ServiceProviderContacts) > 0 {
						<input type="email" name="assignee" value={ data.Filters.Assignee } placeholder="name@example.com" list="service-provider-contacts"/>
					} else {
						<input type="email" name="assignee" value={ data.Filters.Assignee } placeholder="name@example.com"/>
					}
				</label>
				<label class="sort">Sortierung<select name="sort">
					for _, option := range data.Filters.SortOptions {
						<option value={ option.Value } selected?={ option.Selected }>{ option.Label }</option>
					}
				</select></label>
				<div class="board-filter-actions"><button type="submit">Anwenden</button>
					if data.Filters.HasActive {
						<a href={ templ.SafeURL(data.BoardAction) }>Zurücksetzen</a>
					}
				</div>
			</form>
		</details>
		<nav class="board-quick" aria-label="Schnellauswahl">
			<a href={ templ.SafeURL(data.BoardAction) } aria-current={ boardQuickCurrent(!data.Filters.HasActive) }>Alle <span>{ data.TotalIssueCount }</span></a>
			<a href={ templ.SafeURL(data.BoardAction + "?status=Neu") } aria-current={ boardQuickCurrent(data.Filters.Status == "Neu") }>Neu <span>{ data.NewIssueCount }</span></a>
			<a href={ templ.SafeURL(data.BoardAction + "?status=In+Bearbeitung") } aria-current={ boardQuickCurrent(data.Filters.Status == "In Bearbeitung") }>In Arbeit <span>{ data.ProgressIssueCount }</span></a>
			<a href={ templ.SafeURL(data.BoardAction + "?priority=Dringend") } aria-current={ boardQuickCurrent(data.Filters.Priority == "Dringend") }>Dringend <span>{ data.UrgentIssueCount }</span></a>
			<a href={ templ.SafeURL(data.BoardAction + "?assignee=" + url.QueryEscape(data.ActorEmail)) } aria-current={ boardQuickCurrent(data.Filters.Assignee == data.ActorEmail) }>Mir zugewiesen <span>{ data.AssignedIssueCount }</span></a>
		</nav>
	</div>
}

templ IssueWorkCard(issue view.IssueView) {
	<article class={ "issue-card", "issue-work-card", issue.StatusClass } id={ "issue-" + issue.ID } draggable="true" data-board-card data-issue-status={ issue.Status } data-issue-id={ issue.ID } data-assignee={ issue.AssigneeEmail } data-has-appointment={ strconv.FormatBool(issue.HasServiceAppointment) } tabindex="0" role="button" aria-label={ issue.Title + " · " + issue.Status }>
		<button class="board-drag-handle" type="button" tabindex="-1" aria-label={ "Karte ziehen: " + issue.Title } title="Karte ziehen" data-board-drag>@PortalAssetIcon("grip-vertical")</button>
		<h3 title={ issue.Title }>{ issue.Title }</h3>
		<div class="board-card-meta"><span class="issue-priority" data-priority={ issue.Priority }><i aria-hidden="true"></i>{ issue.Priority }</span><span class="pill">{ issueCategoryLabel(issue.Category) }</span><span class="issue-location" title={ issue.Location }>{ issue.Location }</span></div>
		<div class="board-card-foot"><span title={ issue.CreatedAt }>{ issueBoardAge(issue) }</span><span class={ "issue-assignee-avatar", templ.KV("is-unassigned", !issue.HasAssignee) } title={ issueBoardAssigneeLabel(issue) } aria-label={ issueBoardAssigneeLabel(issue) }>{ issueBoardInitials(issue) }</span></div>
		<noscript><a class="board-card-fallback" href={ templ.SafeURL("/app/anliegen/board/" + issue.ID + "/panel") }>Anliegen öffnen</a></noscript>
	</article>
}

type IssueBoardHistoryView struct { Action string; Actor string; Age string }
type IssueBoardPanelData struct { Issue view.IssueView; ActorEmail string; Assignees []view.SelectOption; History []IssueBoardHistoryView }

templ IssueBoardPanel(data IssueBoardPanelData) {
	<header class="board-panel-head"><div><span class="kicker">Anliegen</span><h2>{ data.Issue.Title }</h2></div><a class="board-panel-close" href="/app/anliegen/board" data-board-close aria-label="Anliegen schließen">@PortalAssetIcon("x")</a></header>
	<p class="board-panel-feedback" role="status" data-board-panel-feedback></p>
	<div class="board-panel-meta"><span class={ "pill", data.Issue.StatusClass } data-board-panel-status>{ data.Issue.StatusLabel }</span><span class="pill">{ data.Issue.Priority }</span><span class="pill">{ issueCategoryLabel(data.Issue.Category) }</span></div>
	<p class="muted">{ data.Issue.Location }</p>
	<p class="board-panel-description">{ data.Issue.Body }</p>
	<p class="muted">Gemeldet von { data.Issue.Author } · { issueBoardAge(data.Issue) }</p>
	<section data-board-transition hidden role="group" aria-label="Angaben zum Verschieben"></section>
	<section><h3>Zuständig</h3><form method="post" action="/app/anliegen/workflow" data-board-assign>
		@IssueBoardWorkflowFields(data.Issue)
		<input type="hidden" name="status" value={ data.Issue.Status }/>
		<label>Zuständige Person<select name="assignee_email" required>
			if !data.Issue.HasAssignee {
				<option value="" selected>Noch nicht zugewiesen</option>
			}
			for _, option := range data.Assignees {
				<option value={ option.Value } selected?={ data.Issue.HasAssignee && option.Selected }>{ option.Label }</option>
			}
		</select></label><button type="submit">Zuständigkeit speichern</button>
	</form></section>
	<section><h3>Aktionen</h3><p class="muted">{ data.Issue.NextStep }</p>
		if data.Issue.HasServiceAppointment {
			<p class="muted">Termin: { data.Issue.ServiceAppointment }</p>
		}
		if data.Issue.HasServiceProposal {
			<p class="muted">{ data.Issue.ServiceProposal }</p>
		}
	</section>
	<section><h3>Verlauf</h3><ol class="board-history">
		for _, entry := range data.History {
			<li><strong>{ entry.Action }</strong><span>{ entry.Actor } · { entry.Age }</span></li>
		}
		<li><strong>Anliegen gemeldet</strong><span>{ data.Issue.Author } · { issueBoardAge(data.Issue) }</span></li>
	</ol></section>
	<noscript>
		<section><h3>Termin vereinbaren</h3><form method="post" action="/app/anliegen/workflow">
			@IssueBoardWorkflowFields(data.Issue)
			<input type="hidden" name="status" value="Termin vereinbart"/>
			<input type="hidden" name="assignee_email" value={ data.Issue.AssigneeEmail }/>
			<input type="hidden" name="service_proposal" value={ data.Issue.ServiceProposal }/>
			<label>Start<input type="datetime-local" name="service_start" value={ data.Issue.ServiceStartInput } required/></label>
			<label>Ende (optional)<input type="datetime-local" name="service_end" value={ data.Issue.ServiceEndInput }/></label>
			<button type="submit">Termin speichern und verschieben</button>
		</form></section>
	</noscript>

	<template data-board-assignee-options>
		<select name="assignee_email" required aria-label="Wer übernimmt?">
			for _, option := range data.Assignees {
				<option value={ option.Value } selected?={ option.Value == data.ActorEmail }>{ option.Label }</option>
			}
		</select>
	</template>
	<template data-board-appointment-fields>
		<label>Start<input type="datetime-local" name="service_start" value={ data.Issue.ServiceStartInput } required/></label>
		<label>Ende (optional)<input type="datetime-local" name="service_end" value={ data.Issue.ServiceEndInput }/></label>
		<input type="hidden" name="service_proposal" value={ data.Issue.ServiceProposal }/>
	</template>
	<footer class="board-panel-actions" data-board-panel-actions>
		<form method="post" action="/app/anliegen/workflow" data-board-move>
			@IssueBoardWorkflowFields(data.Issue)
			<input type="hidden" name="assignee_email" value={ data.Issue.AssigneeEmail }/>
			<label for={ "board-target-" + data.Issue.ID }>Verschieben nach …</label><select id={ "board-target-" + data.Issue.ID } name="status" required>
				for _, option := range view.IssueBoardFilterOptions(view.IssueBoardFilterView{}).StatusOptions {
					if option.Value != "" {
						<option value={ option.Value } selected?={ option.Value == data.Issue.Status }>{ option.Label }</option>
					}
				}
			</select><button type="submit">Verschieben</button>
		</form>
		<a class="button ghost board-edit" href={ templ.SafeURL("/app/anliegen/board/" + data.Issue.ID) }>Bearbeiten</a>
	</footer>
}

templ IssueBoardWorkflowFields(issue view.IssueView) {
	<input type="hidden" name="id" value={ issue.ID }/>
	<input type="hidden" name="priority" value={ issue.Priority }/>
	<input type="hidden" name="redirect" value="/app/anliegen/board"/>
}

templ IssueBoardFilterBlank(data IssueBoardPageData) {
	<div class="board-filter-blank">
		<div><h2>Kein Anliegen passt zu dieser Auswahl</h2><p>In der Liegenschaft sind { strconv.Itoa(data.TotalIssueCount) } Anliegen erfasst, davon { strconv.Itoa(data.OpenIssueCount) } offen. Setzen Sie die Auswahl zurück oder wählen Sie einen anderen Filter.</p></div>
		<a class="button primary" href={ templ.SafeURL(data.BoardAction) }>Auswahl zurücksetzen</a>
	</div>
}

templ IssueBoardBlank(data IssueBoardPageData) {
	<section class="board-blank" aria-labelledby="board-blank-title">
		<div class="board-blank-main">
			<div class="board-blank-lead">
				<h2 id="board-blank-title">{ data.IssuesEmpty.Title }</h2>
				<p>Sobald jemand in der Liegenschaft etwas meldet, erscheint hier eine Karte mit Titel, Priorität, Kategorie, Ort und Zuständigkeit. Öffnen Sie die Karte für alle Details und den nächsten Schritt.</p>
			</div>
			if data.CanCreateIssue || data.CanManageAnnouncements {
				<div class="board-blank-actions">
					if data.CanCreateIssue {
						<a class="button primary" href="/app/anliegen?new=1">Anliegen selbst anlegen</a>
					}
					if data.CanManageAnnouncements {
						<a class="button" href="/app/announcements">Meldeweg am Aushang erklären</a>
					}
				</div>
			}
		</div>
		<aside class="board-blank-side">
			<h2>Der Weg eines Anliegens</h2>
			<ol class="board-blank-steps">
				<li><strong>Neu</strong><span>Die Meldung ist eingegangen. Erster Schritt: Dringlichkeit festlegen.</span></li>
				<li><strong>Angenommen</strong><span>Die Zuständigkeit ist vergeben, die Bearbeitung übernommen.</span></li>
				<li><strong>Termin vereinbart</strong><span>Ein Termin mit Bewohnerschaft oder Dienstleister steht fest.</span></li>
				<li><strong>In Arbeit</strong><span>Die Arbeit läuft. Informationen und Rückfragen gehen von hier an die meldende Person.</span></li>
				<li><strong>Erledigt</strong><span>Die Lösung geht zur Prüfung; bestätigt wird von der meldenden Person.</span></li>
			</ol>
			<p class="board-blank-note">Meldungen, die nicht bearbeitet werden, schließen Sie als „Abgelehnt“ oder „Duplikat“.</p>
		</aside>
		<ul class="board-blank-facts">
			<li><strong>Reihenfolge</strong><span>Standard ist „zuletzt aktualisiert“. Ab dem ersten Anliegen stehen zusätzlich Älteste zuerst, Priorität, Status, Kategorie und Zuständigkeit als Sortierung bereit.</span></li>
			<li><strong>Priorität</strong><span>Dringend, Hoch, Mittel und Niedrig. Der erste Triage-Schritt setzt sie; die Zählung über der Liste zeigt offene und dringende Anliegen.</span></li>
			<li><strong>Zuständigkeit</strong><span>Der zweite Schritt ordnet das Anliegen Ihnen, einem Mitarbeiter oder Dienstleister zu. Danach lässt sich die Liste auf Ihre eigenen Fälle einschränken.</span></li>
		</ul>
	</section>
}

templ IssueTriageContent(data IssueTriagePageData) {
	<main class="issues-main" id="main-content" tabindex="-1">
		<section class="triage-page">
			<header class="issue-triage-context">
				<a class="issue-triage-back" href="/app/anliegen/board">← Zurück zur Liste</a>
				<h1>{ data.Issue.Title }</h1>
				<div class="issue-triage-facts"><span>{ data.Issue.Author }</span><span>{ data.Issue.Location }</span><span>{ data.Issue.CreatedAt }</span><span>{ issueCategoryLabel(data.Issue.Category) }</span></div>
				<p>{ data.Issue.Body }</p>
			</header>
			<div class="issue-triage-layout">
				<div class="issue-triage-main">
					switch data.TriageStep {
						case "1":
							@IssueTriagePriorityStep(data)
						case "2":
							@IssueTriageAssigneeStep(data)
						case "done":
							@IssueTriageSaved(data)
						case "message":
							@IssueTriageMessage(data)
						case "sent":
							@IssueTriageMessageSent(data)
						default:
							@IssueTriageResolutionSent(data)
					}
				</div>
				@IssueTriageAside(data)
			</div>
		</section>
	</main>
}

templ IssueTriagePriorityStep(data IssueTriagePageData) {
	<form class="issue-triage-card" method="post" action="/app/anliegen/workflow">
		<input type="hidden" name="id" value={ data.Issue.ID }/>
		<input type="hidden" name="status" value={ data.Issue.Status }/>
		<input type="hidden" name="assignee_email" value={ data.Issue.AssigneeEmail }/>
		<input type="hidden" name="redirect" value={ "/app/anliegen/board/" + data.Issue.ID + "?step=2" }/>
		<div class="issue-triage-progress"><span>Schritt 1 von 2</span><span aria-hidden="true"><i class="active"></i><i></i></span></div>
		<fieldset>
			<legend>Wie dringend ist das Anliegen?</legend>
			<label class="issue-triage-choice urgent"><input type="radio" name="priority" value="Dringend" checked?={ data.Issue.Priority == "Dringend" } required/><span><strong>Heute kümmern</strong><small>Sicherheitsrisiko oder akuter Schaden</small></span></label>
			<label class="issue-triage-choice"><input type="radio" name="priority" value="Hoch" checked?={ data.Issue.Priority == "Hoch" } required/><span><strong>Diese Woche</strong><small>Bald bearbeiten, aber nicht akut</small></span></label>
			<label class="issue-triage-choice calm"><input type="radio" name="priority" value="Niedrig" checked?={ data.Issue.Priority == "Niedrig" } required/><span><strong>Kann warten</strong><small>Bei Gelegenheit einplanen</small></span></label>
		</fieldset>
		<div class="issue-triage-actions"><a href="/app/anliegen/board">Abbrechen</a><button type="submit">Weiter</button></div>
	</form>
}

templ IssueTriageAssigneeStep(data IssueTriagePageData) {
	<form class="issue-triage-card" method="post" action="/app/anliegen/workflow">
		<input type="hidden" name="id" value={ data.Issue.ID }/>
		<input type="hidden" name="status" value="In Bearbeitung"/>
		<input type="hidden" name="priority" value={ data.Issue.Priority }/>
		<input type="hidden" name="redirect" value={ "/app/anliegen/board/" + data.Issue.ID + "?step=done" }/>
		<div class="issue-triage-progress"><span>Schritt 2 von 2</span><span aria-hidden="true"><i class="active"></i><i class="active"></i></span></div>
		<fieldset>
			<legend>Wer kümmert sich als Nächstes?</legend>
			<label>Zuständige Person<select name="assignee_email" required>
				for _, option := range data.Assignees {
					<option value={ option.Value } selected?={ option.Selected }>{ option.Label }</option>
				}
			</select></label>
		</fieldset>
		<div class="issue-triage-actions"><a href={ templ.SafeURL("/app/anliegen/board/" + data.Issue.ID) }>Zurück</a><button type="submit">Bearbeitung starten</button></div>
	</form>
}

templ IssueTriageSaved(data IssueTriagePageData) {
	<section class="issue-triage-card issue-triage-done">
		<div class="issue-triage-done-mark" aria-hidden="true">✓</div>
		<div><span class="kicker">Gespeichert</span><h2>Der nächste Schritt ist festgelegt.</h2><p><strong>{ data.Issue.Priority }</strong>
			if data.Issue.HasAssignee {
				<span> · Zuständig: { data.Issue.AssigneeEmail }</span>
			} else {
				<span> · Zuständigkeit noch offen</span>
			}
		</p></div>
		<div class="issue-triage-actions"><a href={ templ.SafeURL("/app/anliegen/board/" + data.Issue.ID) }>Entscheidung ändern</a><a class="button primary" href={ templ.SafeURL("/app/anliegen/board/" + data.Issue.ID + "?step=message") }>Bewohner kontaktieren</a></div>
	</section>
}

templ IssueTriageMessage(data IssueTriagePageData) {
	<section class="issue-triage-card issue-message-card">
		<div class="issue-triage-progress"><span>Nächster Schritt</span></div>
		<form class="issue-message-form" method="post" action="/app/anliegen/comment" enctype="multipart/form-data">
			<input type="hidden" name="id" value={ data.Issue.ID }/>
			<input type="hidden" name="redirect" value={ "/app/anliegen/board/" + data.Issue.ID + "?step=sent" }/>
			<fieldset>
				<legend>Was soll der Bewohner wissen?</legend>
				<label class="issue-triage-choice calm"><input type="radio" name="message_type" value="information" checked required/><span><strong>Information senden</strong><small>Nur informieren, keine Antwort nötig</small></span></label>
				<label class="issue-triage-choice"><input type="radio" name="message_type" value="question" required/><span><strong>Rückfrage stellen</strong><small>Der Bewohner erhält eine klare Antwort-Aufgabe</small></span></label>
			</fieldset>
			<label class="issue-message-body">Nachricht<textarea name="body" maxlength="3000" required placeholder="Kurz und konkret formulieren" aria-label="Nachricht an Bewohner"></textarea></label>
			<label class="comment-upload"><span class="file-control"><input type="file" name="attachments" accept="image/jpeg,image/png,image/webp,image/gif,application/pdf" multiple/><span>Datei optional hinzufügen</span></span></label>
			<div class="issue-triage-actions"><a href="/app/anliegen/board">Zur Liste</a><button type="submit">Nachricht senden</button></div>
		</form>
		if data.Issue.Status != "Erledigt" {
			<form class="issue-resolution-propose" method="post" action="/app/anliegen/workflow">
				<input type="hidden" name="id" value={ data.Issue.ID }/>
				<input type="hidden" name="status" value="Erledigt"/>
				<input type="hidden" name="priority" value={ data.Issue.Priority }/>
				<input type="hidden" name="assignee_email" value={ data.Issue.AssigneeEmail }/>
				<input type="hidden" name="redirect" value={ "/app/anliegen/board/" + data.Issue.ID + "?step=resolution-sent" }/>
				<span><strong>Arbeit abgeschlossen?</strong><small>Der Bewohner prüft und bestätigt die Lösung.</small></span>
				<button class="ghost" type="submit">Lösung zur Prüfung senden</button>
			</form>
		}
	</section>
}

templ IssueTriageMessageSent(data IssueTriagePageData) {
	<section class="issue-triage-card issue-triage-done">
		<div class="issue-triage-done-mark" aria-hidden="true">✓</div>
		<div><span class="kicker">Nachricht gesendet</span>
			if data.Issue.HasOpenQuestion {
				<h2>Der Bewohner sieht jetzt „Antworten“.</h2><p>Bis zur Antwort ist keine weitere Aktion nötig.</p>
			} else {
				<h2>Die Information ist im Verlauf sichtbar.</h2><p>Der Bewohner muss darauf nicht reagieren.</p>
			}
		</div>
		<div class="issue-triage-actions"><a href={ templ.SafeURL("/app/anliegen/board/" + data.Issue.ID + "?step=message") }>Weitere Nachricht</a><a class="button primary" href="/app/anliegen/board">Zur Liste</a></div>
	</section>
}

templ IssueTriageResolutionSent(data IssueTriagePageData) {
	<section class="issue-triage-card issue-triage-done">
		<div class="issue-triage-done-mark" aria-hidden="true">✓</div>
		<div><span class="kicker">Lösung vorgeschlagen</span><h2>Der Bewohner prüft jetzt das Ergebnis.</h2><p>Er kann „Ja, erledigt“ bestätigen oder das Anliegen wieder öffnen.</p></div>
		<div class="issue-triage-actions"><a href={ templ.SafeURL("/app/anliegen/board/" + data.Issue.ID + "?step=message") }>Nachricht senden</a><a class="button primary" href="/app/anliegen/board">Zur Liste</a></div>
	</section>
}

templ IssueTriageAside(data IssueTriagePageData) {
	<aside class="issue-triage-aside">
		<section class="issue-triage-state">
			<h2>Stand des Anliegens</h2>
			<dl>
				<div><dt>Status</dt><dd><span class={ "pill", data.Issue.StatusClass }>{ data.Issue.StatusLabel }</span></dd></div>
				<div><dt>Priorität</dt><dd>{ data.Issue.Priority }</dd></div>
				<div><dt>Zuständig</dt><dd>
					if data.Issue.HasAssignee {
						{ data.Issue.AssigneeEmail }
					} else {
						noch offen
					}
				</dd></div>
				<div><dt>Kategorie</dt><dd>{ issueCategoryLabel(data.Issue.Category) }</dd></div>
				<div><dt>Gemeldet</dt><dd>{ data.Issue.CreatedAt }</dd></div>
			</dl>
			if data.Issue.HasServiceAppointment {
				<p class="issue-triage-state-line"><strong>Termin:</strong> { data.Issue.ServiceAppointment }</p>
			}
			if data.Issue.HasServiceProposal {
				<p class="issue-triage-state-line"><strong>Hinweis:</strong> { data.Issue.ServiceProposal }</p>
			}
			<p class="issue-triage-state-next">{ data.Issue.NextStep }</p>
		</section>
		<details class="issue-triage-more">
			<summary>Details bearbeiten
				@DisclosureChevron()
			</summary>
			<div class="issue-triage-more-body">
				<form class="issue-details-edit" method="post" action="/app/anliegen/workflow"><input type="hidden" name="id" value={ data.Issue.ID }/><input type="hidden" name="status" value={ data.Issue.Status }/><input type="hidden" name="priority" value={ data.Issue.Priority }/><input type="hidden" name="assignee_email" value={ data.Issue.AssigneeEmail }/><input type="hidden" name="update_details" value="1"/><label>Beschreibung<textarea name="body" maxlength="4000" placeholder="Was ist das Problem?" required>{ data.Issue.Body }</textarea><span class="hint">Max. 4000 Zeichen</span></label><div class="issue-location-type"><span class="issue-field-label">Bereich</span><div class="issue-location-options"><label class="issue-location-choice"><input type="radio" name="location_type" value="common" required checked?={ data.Issue.LocationType == "common" }/><strong>Gemeinschaftsbereich</strong><span>Stiegenhaus, Keller oder Garage</span></label><label class="issue-location-choice"><input type="radio" name="location_type" value="own-unit" required checked?={ data.Issue.LocationType == "own-unit" }/><strong>Eigene Einheit</strong><span>Wohnung oder eigener Nebenraum</span></label></div></div><label>Wo genau?<input type="text" name="location_detail" value={ data.Issue.LocationDetail } maxlength="160" placeholder="Zum Beispiel: Heizungsraum"/><span class="hint">Nur Ort, weitere Details in die Beschreibung · Max. 160 Zeichen</span></label><button type="submit">Details speichern</button></form>
			</div>
		</details>
		<details class="issue-triage-more">
			<summary>{ issueTriageMoreSummary(data.Issue) }
				@DisclosureChevron()
			</summary>
			<div class="issue-triage-more-body">
				@IssueAttachments(data.Issue.Attachments)
				if data.Issue.HasComments {
					<div class="comment-thread">
						for _, comment := range data.Issue.Comments {
							@IssueComment(comment)
						}
					</div>
				} else {
					<p class="muted">Noch keine Rückmeldung.</p>
				}
				@IssueEstimate(data.Issue)
			</div>
		</details>
	</aside>
}

func boardQuickCurrent(active bool) string {
	if active {
		return "true"
	}
	return "false"
}

func boardFilterState(filters view.IssueBoardFilterView) string {
	if filters.HasActive {
		return "Aktive Auswahl"
	}
	return "Alle Anliegen · zuletzt aktualisiert"
}

func issueTriageMoreSummary(issue view.IssueView) string {
	label := "Verlauf und Unterlagen"
	if issue.HasComments {
		label += " · " + strconv.Itoa(len(issue.Comments))
		if len(issue.Comments) == 1 {
			label += " Beitrag"
		} else {
			label += " Beiträge"
		}
	}
	if issue.HasPhotos {
		label += " · " + strconv.Itoa(issue.PhotoCount) + " Foto"
		if issue.PhotoCount != 1 {
			label += "s"
		}
	}
	return label
}

// Use the handler's status order and retain every filtered issue in its lane.
// Status stays the stored value (it is the bucket key); StatusLabel is the
// short German word shown in the column heading.
type issueBoardColumn struct { Status string; StatusLabel string; Issues []view.IssueView }
func issueBoardColumns(options []view.SelectOption, issues []view.IssueView) []issueBoardColumn {
	columns := make([]issueBoardColumn, 0, len(options))
	indices := map[string]int{}
	for _, option := range options {
		if option.Value == "" || option.Value == "Abgelehnt" || option.Value == "Duplikat" { continue }
		if _, exists := indices[option.Value]; exists { continue }
		indices[option.Value] = len(columns)
		columns = append(columns, issueBoardColumn{Status: option.Value, StatusLabel: option.Value})
	}
	for _, issue := range issues {
		status := issue.Status
		if status == "Abgelehnt" || status == "Duplikat" { status = "Erledigt" }
		index, exists := indices[status]
		if !exists { index = len(columns); indices[issue.Status] = index; columns = append(columns, issueBoardColumn{Status: issue.Status, StatusLabel: view.IssueStatusLabel(issue.Status)}) }
		columns[index].Issues = append(columns[index].Issues, issue)
	}
	return columns
}
// issueCategoryLabel turns seed/legacy category keys such as "betriebskosten"
// into readable German labels; known labels pass through unchanged.
func issueCategoryLabel(category string) string {
	category = strings.TrimSpace(category)
	if category == "" {
		return "Sonstiges"
	}
	for _, known := range view.IssueCategories() {
		if strings.EqualFold(known, category) {
			return known
		}
	}
	words := strings.Fields(strings.NewReplacer("_", " ", "-", " ").Replace(category))
	for i, word := range words {
		runes := []rune(word)
		runes[0] = unicode.ToUpper(runes[0])
		words[i] = string(runes)
	}
	return strings.Join(words, " ")
}

func issueBoardInitials(issue view.IssueView) string {
	if !issue.HasAssignee { return "" }
	return contactInitials(issueAssigneeLabel(issue))
}
func issueBoardAge(issue view.IssueView) string { if issue.Age != "" { return issue.Age }; return issue.CreatedAt }

func issueBoardAssigneeLabel(issue view.IssueView) string { if !issue.HasAssignee { return "Noch nicht zugewiesen" }; return "Zuständig: " + issueAssigneeLabel(issue) }
