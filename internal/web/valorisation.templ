package web

import (
	"fmt"
	"github.com/inspr-at/hausv-org/internal/store"
	"sort"
)

type ValorisationPageData struct {
	CanRefreshIndices bool
	IndexRefreshURL, IndexRefreshStatus string
	IndexImports []store.IndexImport
	Portal       PortalPageData
	EffectiveOn  string
	Houses       []ValorisationHouseView
	Runs         []ValorisationRunView
	Previews     []ValorisationRunView
	New          bool
	Organisation bool
}
type ValorisationHouseView struct {
	Slug, Name string
	Selected   bool
}
type ValorisationRunView struct {
	Run          store.ValorisationRun
	URL          string
	CanApprove   bool
	Groups       []ValorisationGroupView
	Deliveries   []store.ValorisationDelivery
	Foreign      bool
	SwitchTenant string
	SwitchRole   string
	OpenPath     string
}
type ValorisationGroupView struct {
	Key, Label string
	Items      []store.ValorisationItem
}

func ValorisationGroups(run store.ValorisationRun) []ValorisationGroupView {
	groups := []ValorisationGroupView{{Key: "ready", Label: "Bereit"}, {Key: "unchanged", Label: "Unverändert"}, {Key: "exception", Label: "Ausnahmen"}}
	for _, item := range run.Items {
		for j := range groups {
			if groups[j].Key == item.Group {
				groups[j].Items = append(groups[j].Items, item)
			}
		}
	}
	for j := range groups {
		sort.SliceStable(groups[j].Items, func(a, b int) bool {
			return store.UnitLess(store.Unit{Label: groups[j].Items[a].UnitLabel, ID: groups[j].Items[a].UnitID}, store.Unit{Label: groups[j].Items[b].UnitLabel, ID: groups[j].Items[b].UnitID})
		})
	}
	return groups
}

func valorisationDeliveryStatus(status string) string {
	switch status {
	case "pending":
		return "Versand läuft"
	case "sent":
		return "Versandt"
	case "failed":
		return "Fehlgeschlagen"
	}
	return status
}

// valorisationNewIsPrimary keeps one filled action per view: "Neuer Lauf" is the
// primary only while no preview, new-run form or open run carries its own primary.
func valorisationNewIsPrimary(data ValorisationPageData) bool {
	if data.New || len(data.Previews) > 0 {
		return false
	}
	for _, run := range data.Runs {
		if run.Run.Status == "draft" || run.Run.Status == "approved" {
			return false
		}
	}
	return true
}

func valorisationStatus(status string) string {
	switch status {
	case "draft":
		return "Entwurf"
	case "approved":
		return "Freigegeben"
	case "sent":
		return "Versandt"
	case "cancelled":
		return "Storniert"
	}
	return status
}

templ ValorisationPage(data ValorisationPageData) {
	@SettingsFrame(data.Portal, "Wertsicherung", nil, ValorisationBody(data))
}

templ ValorisationBody(data ValorisationPageData) {
	<main class="settings-main valorisation-page">
		<style>
			/* HAUSV-765 r3: calm run cards, aligned money, status chips, 44 px targets. */
			.valorisation-page {
				display: grid;
				gap: var(--space-5);
				min-width: 0;
			}
			.valorisation-page h1,
			.valorisation-page h2,
			.valorisation-page h3 {
				font-family: var(--font-serif);
				font-weight: 600;
				margin: 0;
			}
			.valorisation-page h2 {
				font-size: 22px;
				line-height: 1.25;
			}
			.valorisation-page h3 {
				display: flex;
				align-items: center;
				gap: var(--space-2);
				font-size: 18px;
			}
			.valorisation-page h4 {
				margin: var(--space-4) 0 var(--space-2);
				font-size: var(--text-sm);
				font-weight: 750;
			}
			.valorisation-page p {
				margin: 0;
			}
			.valorisation-page .portal-section-header {
				width: 100%;
				text-align: left;
				margin: 0;
				padding-top: 24px;
			}
			.valorisation-page .vr-item table {
				max-width: 760px;
			}
			.valorisation-page > *,
			.valorisation-page .vr-card > *,
			.valorisation-page .vr-history > *,
			.valorisation-page [data-group] > * {
				min-width: 0;
			}
			.valorisation-page .vr-card {
				display: grid;
				gap: var(--space-4);
				padding: var(--space-5);
				border: 1px solid var(--line);
				border-radius: var(--radius-md);
				background: var(--panel);
				box-shadow: var(--shadow-panel);
				min-width: 0;
			}
			.valorisation-page .vr-card-head {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: space-between;
				gap: var(--space-2) var(--space-3);
			}
			.valorisation-page .vr-card-head > div {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: var(--space-2);
			}
			.valorisation-page .vr-chip {
				display: inline-flex;
				align-items: center;
				min-height: 26px;
				padding: 2px 10px;
				border: 1px solid var(--line);
				border-radius: var(--radius-pill);
				background: var(--panel-soft);
				color: var(--muted);
				font-size: var(--text-xs);
				font-weight: 750;
				white-space: nowrap;
			}
			.valorisation-page .vr-chip.is-draft,
			.valorisation-page .vr-chip.is-pending {
				border-color: rgba(200, 153, 63, 0.45);
				background: rgba(200, 153, 63, 0.12);
				color: var(--gold-ink);
			}
			.valorisation-page .vr-chip.is-approved,
			.valorisation-page .vr-chip.is-sent {
				border-color: rgba(47, 107, 74, 0.3);
				background: rgba(47, 107, 74, 0.08);
				color: var(--leaf);
			}
			.valorisation-page .vr-chip.is-cancelled,
			.valorisation-page .vr-chip.is-failed {
				border-color: rgba(140, 52, 52, 0.3);
				background: rgba(140, 52, 52, 0.07);
				color: #8c3434;
			}
			.valorisation-page .vr-count {
				display: inline-grid;
				place-items: center;
				min-width: 22px;
				height: 22px;
				padding: 0 6px;
				border-radius: var(--radius-pill);
				background: var(--panel-soft);
				border: 1px solid var(--line);
				color: var(--muted);
				font-family: var(--font-sans, inherit);
				font-size: var(--text-2xs);
				font-weight: 750;
				font-variant-numeric: tabular-nums;
			}
			.valorisation-page .vr-revision {
				color: var(--muted);
				font-size: var(--text-xs);
			}
			.valorisation-page .vr-actions {
				display: flex;
				flex-wrap: wrap;
				gap: var(--space-3);
				align-items: center;
				padding-top: var(--space-4);
				border-top: 1px solid var(--line);
			}
			.valorisation-page .vr-actions form {
				margin: 0;
			}
			.valorisation-page label {
				display: grid;
				gap: 6px;
				min-width: 0;
				color: var(--muted);
				font-size: var(--text-xs);
				font-weight: 700;
			}
			.valorisation-page
				:is(input:not([type="checkbox"]):not([type="radio"]), select) {
				width: 100%;
				min-width: 0;
				max-width: 100%;
				min-height: 44px;
				padding: 8px 12px;
				border: 1px solid var(--line);
				border-radius: var(--radius-xs);
				background: var(--panel);
				color: var(--ink);
				font-size: var(--text-md);
				font-weight: 500;
			}
			.valorisation-page .vr-check {
				display: flex;
				gap: var(--space-2);
				align-items: center;
				min-height: 44px;
				color: var(--ink);
				font-size: var(--text-md);
				font-weight: 500;
			}
			.valorisation-page .vr-new {
				display: grid;
				gap: var(--space-4);
				max-width: 640px;
			}
			.valorisation-page .vr-new > label {
				max-width: 240px;
			}
			.valorisation-page fieldset {
				min-width: 0;
				margin: 0;
				padding: var(--space-3) var(--space-4);
				border: 1px solid var(--line);
				border-radius: var(--radius-sm);
			}
			.valorisation-page legend {
				padding-inline: var(--space-1);
				color: var(--muted);
				font-size: var(--text-xs);
				font-weight: 700;
			}
			.valorisation-page .vr-new button {
				justify-self: start;
			}
			.valorisation-page .vr-table {
				overflow-x: auto;
				min-width: 0;
				margin: var(--space-3) 0;
			}
			.valorisation-page table {
				border-collapse: collapse;
				width: 100%;
				font-size: var(--text-sm);
			}
			.valorisation-page th,
			.valorisation-page td {
				text-align: left;
				padding: 9px 10px;
				border-bottom: 1px solid var(--line);
				vertical-align: top;
			}
			.valorisation-page thead th {
				padding-top: 6px;
				color: var(--muted);
				font-size: var(--text-2xs);
				font-weight: 750;
				white-space: nowrap;
			}
			.valorisation-page tbody th {
				font-weight: 650;
			}
			.valorisation-page th:first-child,
			.valorisation-page td:first-child {
				padding-left: 0;
			}
			.valorisation-page th:last-child,
			.valorisation-page td:last-child {
				padding-right: 0;
			}
			.valorisation-page .num {
				white-space: nowrap;
				text-align: right;
				font-variant-numeric: tabular-nums;
			}
			.valorisation-page caption {
				text-align: left;
				padding: 0 0 var(--space-2);
				font-size: var(--text-sm);
				font-weight: 750;
			}
			.valorisation-page td p {
				margin-top: 4px;
				color: var(--muted);
				font-size: var(--text-xs);
			}
			.valorisation-page details > summary {
				cursor: pointer;
				text-align: left;
			}
			.valorisation-page [data-group] {
				display: grid;
				gap: 0;
			}
			.valorisation-page [data-group] > h3 {
				padding-bottom: var(--space-2);
			}
			.valorisation-page .vr-item {
				border-top: 1px solid var(--line);
			}
			.valorisation-page .vr-item:last-child {
				border-bottom: 1px solid var(--line);
			}
			.valorisation-page .vr-item > summary {
				display: grid;
				grid-template-columns: minmax(10rem, 15rem) minmax(0, 1fr) 13rem 9rem;
				grid-template-areas: "label reason money letter";
				gap: var(--space-2) var(--space-4);
				align-items: center;
				min-height: 52px;
				padding: var(--space-2) 0;
				list-style: none;
				font-size: var(--text-md);
			}
			.valorisation-page .vr-item > summary::-webkit-details-marker {
				display: none;
			}
			.valorisation-page .vr-item > summary > * {
				min-width: 0;
				overflow-wrap: anywhere;
			}
			.valorisation-page .vr-item > summary > strong {
				grid-area: label;
				display: flex;
				align-items: baseline;
				gap: var(--space-2);
				font-size: var(--text-md);
			}
			.valorisation-page .vr-item > summary > strong::before {
				content: "";
				flex: 0 0 auto;
				width: 7px;
				height: 7px;
				border-right: 1.6px solid var(--muted);
				border-bottom: 1.6px solid var(--muted);
				transform: translateY(-2px) rotate(-45deg);
				transition: transform 0.15s;
			}
			.valorisation-page .vr-item[open] > summary > strong::before {
				transform: translateY(-3px) rotate(45deg);
			}
			.valorisation-page .vr-item > summary > span:nth-of-type(1) {
				grid-area: reason;
				color: var(--muted);
				font-size: var(--text-sm);
			}
			.valorisation-page .vr-item > summary .vr-money {
				grid-area: money;
				text-align: right;
				font-variant-numeric: tabular-nums;
				font-weight: 700;
				white-space: nowrap;
			}
			.valorisation-page .vr-item > summary .vr-letter {
				grid-area: letter;
				text-align: right;
			}
			.valorisation-page .vr-item[open] > summary {
				margin-bottom: var(--space-2);
			}
			.valorisation-page .vr-item > :not(summary) {
				margin-left: 15px;
			}
			.valorisation-page .vr-item[open] {
				padding-bottom: var(--space-4);
			}
			.valorisation-page .vr-item > p {
				margin-top: var(--space-2);
				font-size: var(--text-sm);
			}
			.valorisation-page .vr-item ol {
				margin: 0;
				padding-left: 1.2rem;
				color: var(--muted);
				font-size: var(--text-sm);
				line-height: 1.55;
			}
			.valorisation-page .vr-index-history,
			.valorisation-page .vr-manual {
				margin-top: var(--space-2);
			}
			.valorisation-page .vr-index-history > summary,
			.valorisation-page .vr-manual > summary {
				display: inline-flex;
				align-items: center;
				min-height: 44px;
				color: var(--gold-ink);
				font-size: var(--text-sm);
				font-weight: 650;
			}
			.valorisation-page .vr-form-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				align-items: end;
				gap: var(--space-3);
				margin-top: var(--space-3);
				max-width: 640px;
			}
			.valorisation-page .vr-form-grid button {
				justify-self: start;
				min-height: 44px;
			}
			.valorisation-page .vr-link {
				min-height: 44px;
				border: 0;
				background: transparent;
				padding: 0;
				color: var(--gold-ink);
				text-decoration: underline;
				text-underline-offset: 3px;
				font: inherit;
				font-size: var(--text-sm);
				font-weight: 650;
				cursor: pointer;
			}
			.valorisation-page .vr-danger {
				color: #8c3434;
			}
			.valorisation-page .vr-actions .vr-cancel {
				border: 0;
				padding: 0;
				margin-left: auto;
			}
			.valorisation-page .vr-cancel > summary {
				display: inline-flex;
				align-items: center;
				min-height: 44px;
				font-size: var(--text-sm);
				font-weight: 650;
			}
			.valorisation-page .vr-cancel[open] {
				flex-basis: 100%;
				margin: 0;
			}
			.valorisation-page .vr-cancel[open] > p {
				margin: var(--space-2) 0;
				color: var(--muted);
				font-size: var(--text-sm);
			}
			.valorisation-page .vr-exception,
			.valorisation-page .vr-deadline {
				padding: var(--space-3) var(--space-4);
				border: 1px solid var(--line);
				border-left: 3px solid var(--gold);
				border-radius: var(--radius-sm);
				background: var(--panel-soft);
				font-size: var(--text-sm);
				line-height: 1.5;
			}
			.valorisation-page .vr-exception {
				border-left-color: #8c3434;
			}
			.valorisation-page .vr-item > .vr-exception,
			.valorisation-page .vr-item > .vr-deadline {
				margin-top: var(--space-3);
			}
			.valorisation-page p,
			.valorisation-page li,
			.valorisation-page code {
				overflow-wrap: anywhere;
			}
			.valorisation-page .vr-meta {
				color: var(--muted);
				font-size: var(--text-xs);
			}
			.valorisation-page details.vr-meta > summary {
				display: inline-flex;
				align-items: center;
				min-height: 44px;
			}
			.valorisation-page .vr-note {
				color: var(--muted);
				font-size: var(--text-sm);
			}
			.valorisation-page .vr-excluded > summary {
				opacity: 0.6;
			}
			.valorisation-page .vr-history {
				display: grid;
				gap: var(--space-4);
			}
			.valorisation-page .vr-empty {
				color: var(--muted);
				font-size: var(--text-sm);
			}
			.valorisation-page button {
				max-width: 100%;
			}
			@media (max-width: 1100px) {
				.valorisation-page .vr-item > summary {
					grid-template-columns: minmax(0, 1fr) auto;
					grid-template-areas: "label money" "reason letter";
				}
			}
			@media (max-width: 600px) {
				.valorisation-page .vr-card {
					padding: var(--space-4);
				}
				.valorisation-page .vr-item > summary {
					grid-template-columns: minmax(0, 1fr);
					grid-template-areas: "label" "money" "reason" "letter";
					gap: 4px;
					padding: var(--space-3) 0;
				}
				.valorisation-page .vr-item > summary .vr-money,
				.valorisation-page .vr-item > summary .vr-letter {
					text-align: left;
					padding-left: 15px;
				}
				.valorisation-page .vr-item > summary > span:nth-of-type(1) {
					padding-left: 15px;
				}
				.valorisation-page .vr-item > :not(summary) {
					margin-left: 0;
				}
				.valorisation-page .vr-form-grid {
					grid-template-columns: minmax(0, 1fr);
				}
				.valorisation-page .vr-form-grid button {
					justify-self: stretch;
				}
				.valorisation-page .vr-actions {
					align-items: stretch;
					flex-direction: column;
				}
				.valorisation-page .vr-actions .vr-cancel {
					margin-left: 0;
				}
				.valorisation-page .vr-actions .button {
					width: 100%;
				}
				.valorisation-page table {
					font-size: var(--text-xs);
				}
				.valorisation-page th,
				.valorisation-page td {
					padding: 8px 6px;
				}
				.valorisation-page thead th {
					white-space: normal;
				}
			}
		</style>
		@PortalSectionHeader(PortalSectionIdentityData{Label: "Einstellungen", URL: "/app/settings"}, PortalSectionTitle("Wertsicherung"), PortalSectionLede("Vertragliche Anpassung prüfen, freigeben und verständigen."), ValorisationNewAction(valorisationNewIsPrimary(data)))
		<p class="vr-note"><a href="/app/hilfe#recht-wirksamwerden">Warum?</a> · Rechtliche Grundlagen zum Wirksamwerden</p>
		if data.Organisation {
			@ValorisationIndexRefresh(data)
		}
		if data.New {
			<section class="vr-card">
				<h2>Neuer Lauf</h2>
				<form method="get" class="vr-new">
					<input type="hidden" name="new" value="1"/>
					<label>Wirksamkeitsdatum<input type="date" name="effective_on" value={ data.EffectiveOn } required/></label>
					<fieldset>
						<legend>Liegenschaften</legend>
						for _,house:=range data.Houses {
							<label class="vr-check">
								<input type="checkbox" name="house" value={ house.Slug } checked?={ house.Selected }/>{ house.Name }
							</label>
						}
					</fieldset>
					<button class="button primary" type="submit" name="preview" value="1">Vorschau berechnen</button>
				</form>
			</section>
		}
		for _,preview:=range data.Previews {
			@ValorisationRun(preview, true)
		}
		<section class="vr-history">
			<h2>Läufe</h2>
			if len(data.Runs)==0 {
				<p class="vr-empty">Noch kein Lauf. Erstellen Sie eine Vorschau für Ihre Liegenschaft.</p>
			}
			for _,run:=range data.Runs {
				@ValorisationRun(run, false)
			}
		</section>
	</main>
}

templ ValorisationRun(view ValorisationRunView, preview bool) {
	<article class="vr-card" id={ "run-" + view.Run.ID } data-run-id={ view.Run.ID }>
		<header class="vr-card-head">
			<h2>
				{ view.Run.Input.House } · Stichtag { LeaseDate(view.Run.EffectiveOn) }
			</h2>
			<div>
				if preview {
					<span class="vr-chip">Vorschau</span>
				} else {
					<span class={ "vr-chip", "is-" + view.Run.Status }>{ valorisationStatus(view.Run.Status) }</span>
				}
				<span class="vr-revision">{ fmt.Sprintf("Revision %d",view.Run.Revision) }</span>
			</div>
		</header>
		if view.Run.IndexRevised {
			<p class="vr-exception" data-index-status="index_revised"><strong>Neu berechnen empfohlen</strong> · Ein verwendeter Indexwert wurde revidiert. Freigegebene Beträge und Schreiben bleiben unverändert.</p>
		}
		if view.Run.IndexDisputed {
			<p class="vr-exception" data-index-status="index_disputed"><strong>Indexwert prüfen</strong> · Ein endgültiger Wert weicht von einer neueren Veröffentlichung ab. Der bisherige Wert bleibt Grundlage dieses Laufs. Prüfen Sie die Abweichung im Importverlauf vor der Freigabe.</p>
		}
		for _,deadline := range view.Run.NoticeDeadlines() {
			@ValorisationDeadline(deadline)
		}
		if view.Foreign {
			@HouseOpenForm(view.SwitchTenant, view.SwitchRole, view.OpenPath, "In Liegenschaft öffnen")
		} else if preview {
			<form method="post" action={ templ.SafeURL(view.URL + "/runs") }><input type="hidden" name="effective_on" value={ view.Run.EffectiveOn }/><button class="button primary" type="submit">Lauf anlegen</button></form>
		}
		for _,group:=range view.Groups {
			<section data-group={ group.Key }>
				<h3>
					{ group.Label }
					<span class="vr-count">
						{ fmt.Sprint(len(group.Items)) }
					</span>
				</h3>
				for _,item:=range group.Items {
					<details id={ "item-" + item.ID } class={ "vr-item", templ.KV("vr-excluded", item.Excluded) } data-lease-id={ item.LeaseID }>
						<summary>
							<strong>
								{ item.Label() }
							</strong>
							<span>
								{ item.Reason }
							</span>
							<span class="vr-money">
								if item.OldCents > 0 {
									{ LeaseMoney(item.OldCents) } → { LeaseMoney(item.NewCents) }
								} else {
									Kein Hauptmietzins
								}
							</span>
							<span class="vr-letter">
								if !preview && !view.Foreign && item.LetterDocumentID != "" {
									<a class="button small" href={ templ.SafeURL(view.URL + "/runs/" + view.Run.ID + "/items/" + item.ID + "/pdf") }>Schreiben (PDF)</a>
								}
							</span>
						</summary>
						if item.Excluded {
							<p>
								Ausgeschlossen: { item.ExcludeReason }
							</p>
						}
						for _,code:=range item.Exceptions {
							<p class="vr-exception">
								{ store.ValorisationExceptionLabels[code] }
							</p>
						}
						if item.NoticeDeadline!="" {
							@ValorisationDeadline(item)
						}
						<p class="vr-note">
							{ item.Lease.Notes }
						</p>
						if !view.Foreign {
							<p class="vr-note"><a href={ templ.SafeURL("/app/settings/building/units/" + item.UnitID + "/lease") }>Mietvertrag bearbeiten</a></p>
						}
						if item.ContractCents > 0 {
							<div class="vr-table">
								<table>
									<caption>Vertrags- und Deckelkurve</caption><thead><tr><th>Stichtag</th><th class="num">Vertrag</th><th class="num">MieWeG</th><th class="num">Vorgeschrieben</th></tr></thead>
									<tbody>
										<tr>
											<td>
												{ LeaseDate(view.Run.EffectiveOn) }
											</td>
											<td class="num">
												{ LeaseMoney(item.ContractCents) }
											</td>
											<td class="num">
												if item.MieWeG {
													{ LeaseMoney(item.CapCents) }
												} else {
													entfällt
												}
											</td>
											<td class="num">
												{ LeaseMoney(item.NewCents) }
											</td>
										</tr>
									</tbody>
								</table>
							</div>
						}
						if item.OldCents > 0 {
							<div class="vr-table">
								<table>
									<thead><tr><th>Monatlicher HMZ</th><th class="num">Netto</th><th class="num">USt</th><th class="num">Brutto</th></tr></thead>
									<tbody>
										<tr>
											<th>Bisher</th>
											<td class="num">
												{ LeaseMoney(item.OldCents) }
											</td>
											<td class="num">
												{ LeaseMoney(item.OldVATCents) }
											</td>
											<td class="num">
												{ LeaseMoney(item.OldGrossCents) }
											</td>
										</tr>
										<tr>
											<th>Neu</th>
											<td class="num">
												{ LeaseMoney(item.NewCents) }
											</td>
											<td class="num">
												{ LeaseMoney(item.NewVATCents) }
											</td>
											<td class="num">
												{ LeaseMoney(item.NewGrossCents) }
											</td>
										</tr>
									</tbody>
								</table>
							</div>
						}
						if item.WirksamOn != "" {
							<p class="vr-note">
								if !item.TimingInput.ContractSchedule {
									Indexmonat: { LeaseMonthName(string(item.TimingInput.TriggerMonth)) }<br/>
									Endgültige Veröffentlichung: { item.TimingInput.FinalPublishedOn.Format("02.01.2006") }<br/>
								}
								Wirksamwerden (angenommen): { LeaseDate(item.WirksamOn) } · { store.ValorisationTimingLabel(string(item.Timing.Mode)) }
								if item.Lease.UsesValorisationTimingMode() {
									if item.Lease.WirksamwerdenMode == "" {
											<span> · Organisationsstandard</span>
										} else {
											<span> · Vertragsauswahl</span>
										}
								}
								<br/>Erster zahlbarer Zinstermin (bei angenommenem Zugang): { LeaseDate(item.CollectableFrom) }
								if !item.TimingInput.NoticeIssuedOn.IsZero() {
									<br/>Schreibendatum bei Freigabe: { item.TimingInput.NoticeIssuedOn.Format("02.01.2006") }
									<br/>Zugang (bei Freigabe angenommen): { item.TimingInput.NoticeReceivedOn.Format("02.01.2006") }
								} else {
										<br/>Versand und Zugang: noch nicht erfolgt; Zinstermin bei rechtzeitigem Zugang.
									}
							</p>
						}
						<h4>Wie kommt dieser Betrag zustande?</h4>
						<ol>
							for _,step:=range item.Explanation {
								<li>
									{ step }
								</li>
							}
						</ol>
						@ValorisationIndexTable(item.UsedIndices(), "Verwendete Indexwerte")
						<details class="vr-index-history">
							<summary>Alle Indexwerte anzeigen</summary>
							@ValorisationIndexTable(item.Indices, "Geprüfte Monatsreihe und Jahresmittel")
						</details>
						if item.OverrideCents!=nil {
							<p>
								Manuelle Entscheidung: { item.OverrideReason } · { item.OverrideBy }
							</p>
						}
						if !preview && !view.Foreign {
							if item.LetterDocumentID!="" || item.Group=="ready" {
								<p><a class="button" href={ templ.SafeURL(view.URL + "/runs/" + view.Run.ID + "/items/" + item.ID + "/pdf") }>Anpassungsschreiben PDF</a></p>
							}
							if view.Run.Status=="draft" {
								<details class="vr-manual">
									<summary>Manuell entscheiden</summary>
									<form method="post" action={ templ.SafeURL(view.URL + "/runs/" + view.Run.ID + "/items/" + item.ID) } class="vr-form-grid">
										<label>Begründung für Ausschluss<input type="text" name="reason" required maxlength="4000"/></label>
										<button class="button" type="submit" name="action" value="exclude">Ausschließen</button>
									</form>
									if view.CanApprove && item.Group=="ready" {
										<form method="post" action={ templ.SafeURL(view.URL + "/runs/" + view.Run.ID + "/items/" + item.ID) } class="vr-form-grid">
											<label>Manueller Nettobetrag (€)<input type="text" name="amount" inputmode="decimal" required/></label>
											<label>Begründung für Betrag<input type="text" name="reason" required maxlength="4000"/></label>
											<button class="button" type="submit" name="action" value="override">Betrag übernehmen</button>
										</form>
									}
								</details>
								if item.ClauseID!="" {
									<form method="post" action={ templ.SafeURL(view.URL + "/runs/" + view.Run.ID + "/items/" + item.ID) }>
										<input type="hidden" name="reason" value="Klausel im Wertsicherungslauf geprüft."/>
										<button class="vr-link" type="submit" name="action" value="review">Klausel geprüft · neu berechnen</button>
									</form>
								}
							}
						}
					</details>
				}
			</section>
		}
		if !preview && !view.Foreign {
			if len(view.Deliveries)>0 {
				<div class="vr-table">
					<table>
						<caption>Versandverlauf</caption><thead><tr><th>Einheit / Empfänger</th><th class="num">Versuch</th><th>Status</th></tr></thead>
						<tbody>
							for _,delivery:=range view.Deliveries {
								<tr>
									<td>{ view.Run.DeliveryLabel(delivery.UnitID) }<br/>{ delivery.Recipient }</td>
									<td class="num">{ fmt.Sprint(delivery.Attempt) }</td>
									<td>
										<span class={ "vr-chip", "is-" + delivery.Status }>{ valorisationDeliveryStatus(delivery.Status) }</span>
										if delivery.Status == "sent" {
											<p>Versand: { delivery.SentAt.Format("02.01.2006 15:04") } UTC</p>
											if delivery.ReceivedOn != "" {
												<p>Zugang: { LeaseDate(delivery.ReceivedOn) } · Erster zahlbarer Zinstermin: { LeaseDate(delivery.ReceiptDueOn) }</p>
											} else {
												<p>Zugang nicht bestätigt</p>
											}
											if view.Run.Status == "approved" || view.Run.Status == "sent" {
												<form method="post" action={ templ.SafeURL(view.URL + "/runs/" + view.Run.ID + "/deliveries/" + delivery.ID + "/receipt") }>
													<label>Zugang des Schreibens<input type="date" name="received_on" value={ delivery.ReceivedOn } required/></label>
													<button class="button" type="submit">Zugang speichern</button>
												</form>
											}
										}
										if delivery.Error!="" {
											<p>{ delivery.Error }</p>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			<div class="vr-actions">
				if view.Run.Status=="draft" {
					if view.CanApprove {
						<form method="post" action={ templ.SafeURL(view.URL + "/runs/" + view.Run.ID + "/approve") }><button class="button primary" type="submit">Freigeben und archivieren</button></form>
					}
					<form method="post" action={ templ.SafeURL(view.URL + "/runs") }><input type="hidden" name="effective_on" value={ view.Run.EffectiveOn }/><button class="button" type="submit">Neu berechnen</button></form>
				}
				if view.Run.Status=="approved" {
					<form method="post" action={ templ.SafeURL(view.URL + "/runs/" + view.Run.ID + "/send") }><button class="button primary" type="submit">Schreiben versenden · Fehlversuche erneut versuchen</button></form>
				}
				if view.Run.Status!="cancelled" {
					<details class="vr-cancel">
						<summary class="vr-danger">Lauf stornieren</summary>
						<p>Den Lauf wirklich stornieren? Bereits gebuchte Mietzinse und versandte Schreiben bleiben bestehen.</p>
						<form method="post" action={ templ.SafeURL(view.URL + "/runs/" + view.Run.ID + "/cancel") } class="vr-form-grid"><label>Stornogrund<input name="reason" required maxlength="4000"/></label><button class="button danger" type="submit">Stornierung bestätigen</button></form>
					</details>
				}
			</div>
			if view.Run.Status=="cancelled" {
				<p class="vr-note">Storniert: { view.Run.CancelReason }. Bereits gebuchte Mietzinse und versandte Schreiben bleiben bestehen. Korrekturen sind gesondert vorzunehmen.</p>
			}
			<p class="vr-meta">Erstellt von { view.Run.CreatedBy }</p>
			<details class="vr-meta"><summary>Prüfsumme</summary><p>Eingaben SHA-256 <code>{ view.Run.InputsSHA256 }</code></p></details>
		}
	</article>
}

templ ValorisationNewAction(primary bool) {
	<a class={ "button", templ.KV("primary", primary) } href="?new=1">Neuer Lauf</a>
}

templ ValorisationDeadline(item store.ValorisationItem) {
	<p class="vr-deadline">Schreiben bis <strong>{ LeaseDate(item.NoticeDeadline) }</strong> versenden, damit der erhöhte Mietzins ab <strong>{ LeaseDate(item.CollectableFrom) }</strong> fällig wird (§ 16 Abs 9 MRG).</p>
}

templ ValorisationIndexTable(indices []store.ValorisationIndex, caption string) {
	if len(indices)>0 {
		<div class="vr-table">
			<table>
				<caption>{ caption }</caption><thead><tr><th>Reihe / Zeitraum</th><th class="num">Messzahl</th><th>Status</th><th>Endgültigkeit belegt am</th></tr></thead>
				<tbody>
					for _,index:=range indices {
						<tr>
							<td><a href={ templ.SafeURL(index.Source) } rel="noreferrer" target="_blank">{ index.SeriesLabel() } · { index.Period }</a></td>
							<td class="num">{ store.ValorisationNumber(index.Value, 1) }</td>
							<td>{ index.StatusLabel() }</td>
							<td>
								if index.PublishedOn != "" {
									<a href={ templ.SafeURL(index.PublicationSource) } rel="noreferrer" target="_blank">{ LeaseDate(index.PublishedOn) }</a>
								} else {
									Nachweis fehlt
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}


templ ValorisationIndexRefresh(data ValorisationPageData) {
	<section class="vr-card" aria-labelledby="index-refresh-title">
		<h2 id="index-refresh-title">Verbraucherpreisindex</h2>
		<p>Datenquelle: <a href="https://data.statistik.gv.at/" target="_blank" rel="noreferrer">Statistik Austria</a>, <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noreferrer">CC BY 4.0</a></p>
		<p class="vr-meta">Gesamtindex und Jahresmittel; Zeiträume und Zahlen vereinheitlicht, Status aus den amtlichen Periodenbezeichnungen ergänzt. Vorläufige Werte werden erst nach Bestätigung für Berechnungen verwendet.</p>
		if data.CanRefreshIndices {
			<form method="post" action={ templ.SafeURL(data.IndexRefreshURL) } class="vr-actions"><button class="button" type="submit">VPI aktualisieren</button></form>
		}
		if data.IndexRefreshStatus == "ok" {
			<p role="status">VPI-Abfrage abgeschlossen. Unveränderte Veröffentlichungen werden nicht erneut importiert.</p>
		} else if data.IndexRefreshStatus == "partial" {
			<p role="status" class="vr-exception">Nicht alle Reihen konnten aktualisiert werden. Erfolgreiche Importe sind unten dokumentiert; vorhandene Werte bleiben verfügbar.</p>
		} else if data.IndexRefreshStatus == "failed" {
			<p role="status" class="vr-exception">VPI-Abfrage derzeit nicht möglich. Bitte später erneut versuchen. Vorhandene Werte bleiben verfügbar.</p>
		}
		if len(data.IndexImports) == 0 {
			<p>Noch kein Online-Import. Der mitgelieferte Indexstand ist verfügbar.</p>
		} else {
			<p>Letzter Import: { data.IndexImports[0].SeriesLabel() } · { data.IndexImports[0].FetchedAt.UTC().Format("02.01.2006, 15:04") } UTC · { fmt.Sprintf("%d neu · %d revidiert · %d zur Prüfung",data.IndexImports[0].RowsAdded,data.IndexImports[0].RowsRevised,data.IndexImports[0].RowsFlagged) }</p>
			<details>
				<summary>Importverlauf · neue und revidierte Zeiträume</summary>
				for _,item := range data.IndexImports {
					<div>
						<p><a href={ templ.SafeURL(item.URL) } target="_blank" rel="noreferrer">{ item.SeriesLabel() } · { item.FetchedAt.UTC().Format("02.01.2006, 15:04") } UTC</a> · { fmt.Sprintf("%d neu · %d revidiert · %d zur Prüfung",item.RowsAdded,item.RowsRevised,item.RowsFlagged) }</p>
						if len(item.Changes)>0 {
							<ul>
								for _,change := range item.Changes {
									<li>{ change.Series } · { change.Period }: { store.ValorisationNumber(change.Before,1) } → { store.ValorisationNumber(change.After,1) }
										if change.Kind=="final_conflict" {
											<strong> · Endgültiger Wert abweichend; bisheriger Wert bleibt aktiv. Prüfung erforderlich.</strong>
										} else if change.AfterStatus=="final" {
											<span> · endgültig</span>
										} else {
											<span> · vorläufig</span>
										}
									</li>
								}
							</ul>
						}
					</div>
				}
			</details>
		}
	</section>
}
