		.energy-tariff-settings>summary{min-height:40px;display:flex;align-items:center;gap:var(--space-2);color:var(--gold-ink);cursor:pointer;font-size:11px;font-weight:800;list-style:none}.energy-tariff-settings>summary::-webkit-details-marker{display:none}.energy-tariff-settings>summary span{color:var(--soft);font-weight:600}.energy-tariff-forms{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:var(--space-4);margin-top:var(--space-3)}.energy-target-form{display:grid;gap:6px;justify-items:start;padding:var(--space-4);border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel-soft)}.energy-target-form label{width:100%;display:grid;gap:5px}.energy-target-form input{width:100%;min-height:42px;padding:var(--space-2) var(--space-3);border:1px solid var(--line);border-radius:var(--radius-xs);background:var(--panel);color:var(--ink)}.onboarding-legend{color:var(--muted);font-size:11px;font-weight:800}
