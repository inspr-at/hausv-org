package web

import "github.com/inspr-at/hausv-org/internal/view"

templ SettingsHubPage(data SettingsHubPageData) {
	@SettingsFrame(data.Portal, "Einstellungen", []string{"profile-picture.js"}, SettingsHubContent(data))
}

templ SettingsHubContent(data SettingsHubPageData) {
	@PortalSectionLanding(
		PortalSectionLandingData{
			Portal: data.Portal,
			PageLabel: "Einstellungen",
			Class: "settings-main",
			Identity: PortalSectionIdentityData{Label: "Persönlich & verwaltet", Icon: "settings"},
		},
		PortalSectionTitle("Einstellungen"),
		PortalSectionLede("Konto und Kommunikation für " + data.Portal.Address + "."),
		nil,
		nil,
		nil,
		SettingsHubBody(data),
	)
}

templ SettingsHubBody(data SettingsHubPageData) {
	<div class="settings-body" data-templ-settings-hub>
		<section class="identity-card panel" data-templ-profile-picture>
			<span class={ "identity-icon", templ.KV("identity-avatar", data.HasProfilePicture) }>
				if data.HasProfilePicture {
					<img class="identity-avatar-image" src={ data.ProfilePictureURL } alt="" width="58" height="58" decoding="async"/>
				} else {
					@PortalIcon("users")
				}
			</span>
			<div>
				<h2>{ data.SettingsDisplayName }</h2>
				<p>{ data.Email }</p>
				if data.ProfilePictureMsg != "" {
					<p class={ "flash", templ.KV("ok", data.ProfilePictureOK), templ.KV("bad", !data.ProfilePictureOK) } role="status">{ data.ProfilePictureMsg }</p>
				}
				<p class="flash bad" role="alert" hidden data-profile-picture-error></p>
			</div>
			<div class="identity-actions">
				<form method="post" action="/app/settings/profilbild" enctype="multipart/form-data" data-profile-picture-form>
					<label class="button small profile-picture-choose">
						<span>{ settingsProfilePictureLabel(data.HasProfilePicture) }</span>
						<input type="file" name="profile_picture" accept="image/*" data-profile-picture-input/>
					</label>
					<button class="button small primary" type="submit" data-profile-picture-submit>Hochladen</button>
				</form>
				if data.HasProfilePicture {
					<form method="post" action="/app/settings/profilbild/entfernen"><button class="button small ghost" type="submit">Profilbild entfernen</button></form>
				}
			</div>
		</section>
		@SettingsProfilePictureDialog()
		<div class="settings-grid">
			if data.CanManageHomeIdentity {
				<section class="settings-group panel span-all"><header><div><h2>Mein Zuhause</h2><p>Anzeigename, Art und zugeordnete Einheit.</p></div><span class="scope personal">Nur Sie</span></header><nav class="settings-links">
					if data.HomeIdentity.HasDisplayName {
						<a href={ templ.SafeURL(data.SettingsHomeURL) } data-home-identity="settings" aria-label={ data.HomeIdentity.AriaLabel + " bearbeiten" }><span class="link-icon">@PortalIcon("home")</span><span><strong data-home-display-name>{ data.HomeIdentity.DisplayName }</strong>
							if data.HomeIdentity.HasUnit {
								<small class="settings-home-unit" data-home-unit-label>@UnitLabel(data.HomeIdentity.UnitLabel)</small>
							}
							<small>Anzeigename und Zuordnung bearbeiten</small></span><b>›</b></a>
					} else {
						<a href={ templ.SafeURL(data.SettingsHomeURL) }><span class="link-icon">@PortalIcon("home")</span><span><strong>{ settingsHomeTitle(data.HomeIdentity) }</strong><small>{ settingsHomeDetail(data.HomeIdentity) }</small></span><b>›</b></a>
					}
					if data.SettingsCanManageEnergyData {
						<a href="/app/settings/energy-data"><span class="link-icon">@PortalIcon("energy")</span><span><strong>Energiedaten &amp; Datenschutz</strong><small>Gespeicherte Daten ansehen, exportieren oder löschen</small></span><b>›</b></a>
					}
				</nav></section>
			}
			<section class="settings-group panel"><header><div><h2>Mein Konto</h2><p>Persönliche Angaben und Sichtbarkeit.</p></div><span class="scope personal">Nur Sie</span></header><nav class="settings-links"><a href="/app/settings/profile"><span class="link-icon">@PortalIcon("users")</span><span><strong>Profil</strong><small>Name, Telefon und Sichtbarkeit verwalten</small></span><b>›</b></a>
				if data.Portal.Modules.Audit && data.CanViewAudit && !settingsHasAdministrativeManagement(data) {
					@SettingsLink("audit", "Aktivitätsverlauf", "Änderungen nachvollziehen", "/app/audit")
				}
			</nav></section>
			<section class="settings-group panel"><header><div><h2>Kommunikation</h2><p>Was automatisch in Ihrem Postfach ankommt.</p></div><span class="scope personal">Nur Sie</span></header><nav class="settings-links"><a href="/app/settings/notifications"><span class="link-icon">@PortalIcon("announcement")</span><span><strong>Benachrichtigungen</strong><small>{ data.SettingsNotificationSummary }</small></span><b>›</b></a>
				if data.HasCalendarFeedURL {
					<a href={ templ.SafeURL(data.CalendarFeedURL) }><span class="link-icon">@PortalIcon("calendar")</span><span><strong>Kalender-Abo</strong><small>Termine der Liegenschaft im eigenen Kalender</small></span><b>›</b></a>
				}
			</nav></section>
			if settingsHasManagement(data) {
				<section class="settings-group panel span-all"><header><div><h2>Verwaltung</h2><p>Nur Bereiche, für die Sie berechtigt sind. Änderungen wirken für die ganze Liegenschaft.</p></div><span class="scope management">Verwaltungsrechte</span></header><nav class="settings-links management-links">
					if data.CanManageLeases {
						@SettingsLink("document", "Wertsicherung", "Mietzinse prüfen, freigeben und verständigen", "/app/settings/valorisation")
					}
					if data.CanManageBuilding {
						@SettingsLink("home", "Gebäude & Einheiten", "Liegenschaftsdaten und Einheiten pflegen", "/app/settings/building")
						@SettingsLink("document", "Jahresabrechnung", "Grunddaten, Kostenarten, Einheiten und Abrechnungsperiode", "/app/settings/annual-statement")
						@SettingsLink("settings", "Portalbereiche", "Menüpunkte und Funktionen ein- oder ausblenden", "/app/settings/modules")
					}
					if data.Portal.Modules.Users && data.Portal.CanManageUsers {
						@SettingsLink("users", "Benutzer & Rechte", "Einladungen und Rollen verwalten", "/app/settings/users")
					}
					if data.Portal.Modules.Parking && data.Portal.CanManageUsers {
						@SettingsLink("parking", "Parkplatz-Zugriff", "Nutzung freigeben oder entziehen", "/app/settings/parking-access")
					}
					if data.Portal.Modules.Documents && data.CanManageDocuments {
						@SettingsLink("document", "Dokumente", "Unterlagen verwalten", "/app/dokumente")
					}
					if data.CanManageBuilding {
						@SettingsLink("document", "Datenübergabe", "Ausgewählte Rohdaten sicher weitergeben", "/app/settings/data-export")
					}
					if data.Portal.Modules.Handovers && data.CanManageHandovers {
						@SettingsLink("handover", "Übergaben", "Protokolle vorbereiten und ablegen", "/app/uebergaben")
					}
					if data.Portal.Modules.Audit && data.CanViewAudit {
						@SettingsLink("audit", "Aktivitätsverlauf", "Änderungen nachvollziehen", "/app/audit")
					}
					if data.Portal.Modules.Parking && data.IsAdmin {
						@SettingsLink("parking", "Parkplatz-Abrechnung", "Tarife und Abrechnungswerte", "/app/parking/settings")
					}
				</nav></section>
			}
		</div>
		<details class="note panel"><summary>Berechtigungen erklärt
			@DisclosureChevron()
		</summary><div><strong>Nur Sie</strong><p>Persönliche Einstellungen wirken allein auf Ihren Zugang.</p>
			if data.CanManageLeases || data.CanManageBuilding || data.Portal.CanManageUsers || data.CanManageDocuments || data.CanManageHandovers || data.IsAdmin {
				<strong>Verwaltungsrechte</strong><p>Änderungen gelten für die ganze Liegenschaft und werden im Verlauf festgehalten.</p>
			}
		</div></details>
	</div>
}

// SettingsProfilePictureDialog is the crop step between choosing a file and
// uploading it. The whole dialog is inert without JavaScript — the form next to
// it still uploads the chosen file, and the server centre-crops it — so the
// dialog is an enhancement rather than the only way through.

templ SettingsProfilePictureDialog() {
	<dialog class="user-dialog profile-picture-dialog" data-profile-picture-dialog aria-labelledby="profile-picture-dialog-title">
		<div class="dialog-head">
			<h2 id="profile-picture-dialog-title">Profilbild zuschneiden</h2>
			<p>Ausschnitt mit der Maus verschieben, Grösse mit dem Regler oder dem Mausrad wählen.</p>
		</div>
		<div class="dialog-body">
			<div class="crop-stage">
				<canvas class="crop-canvas" width="320" height="320" data-profile-picture-canvas aria-label="Bildausschnitt"></canvas>
				<span class="crop-mask" aria-hidden="true"></span>
			</div>
			<label class="crop-zoom">Grösse<input type="range" min="100" max="320" step="1" value="100" autofocus data-profile-picture-zoom/></label>
			<p class="crop-hint">Gespeichert wird ein quadratisches Bild mit 512 × 512 Pixeln.</p>
			<p class="flash bad" role="alert" hidden data-profile-picture-dialog-error></p>
		</div>
		<div class="dialog-footer">
			<button class="button ghost" type="button" data-profile-picture-cancel>Abbrechen</button>
			<button class="button primary" type="button" data-profile-picture-save>Profilbild speichern</button>
		</div>
	</dialog>
}

func settingsProfilePictureLabel(hasPicture bool) string {
	if hasPicture {
		return "Profilbild ändern"
	}
	return "Profilbild wählen"
}

templ SettingsLink(icon, title, detail, url string) {
	<a href={ templ.SafeURL(url) }><span class="link-icon">@PortalIcon(icon)</span><span><strong>{ title }</strong><small>{ detail }</small></span><b>›</b></a>
}

func settingsHomeTitle(home view.HomeIdentityView) string {
	if home.HasDisplayName { return home.DisplayName }
	return "Mein Zuhause einrichten"
}

func settingsHomeDetail(home view.HomeIdentityView) string {
	if home.HasUnit { return home.UnitLabel + " · Anzeigename und Zuordnung bearbeiten" }
	if home.HasDisplayName { return "Anzeigename und Zuordnung bearbeiten" }
	return "Name, Art und Zuordnung festlegen"
}

func settingsHasAdministrativeManagement(data SettingsHubPageData) bool {
	return data.CanManageLeases || data.CanManageBuilding || (data.Portal.Modules.Users && data.Portal.CanManageUsers) || (data.Portal.Modules.Documents && data.CanManageDocuments) || (data.Portal.Modules.Handovers && data.CanManageHandovers) || (data.Portal.Modules.Parking && data.IsAdmin)
}

func settingsHasManagement(data SettingsHubPageData) bool {
	return settingsHasAdministrativeManagement(data)
}
