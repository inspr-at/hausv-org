package web

import (
	"strconv"

	"github.com/inspr-at/hausv-org/internal/view"
)

type SettingsHubPageData struct {
	Portal                      PortalPageData
	Email                       string
	SettingsDisplayName         string
	SettingsNotificationSummary string
	SettingsHomeURL             string
	CalendarFeedURL             string
	HasCalendarFeedURL          bool
	SettingsCanManageEnergyData bool
	CanManageHomeIdentity       bool
	CanManageBuilding           bool
	CanManageDocuments          bool
	CanManageHandovers          bool
	CanViewAudit                bool
	IsAdmin                     bool
	HomeIdentity                view.HomeIdentityView
	// Profilbild (HAUSV-675). ProfilePictureURL is empty exactly when the
	// person has none; the card then shows the neutral icon it always showed.
	ProfilePictureURL    string
	HasProfilePicture    bool
	ProfilePictureMsg    string
	ProfilePictureOK     bool
}

type SettingsProfile struct {
	Title, FirstName, LastName, Phone string
	DirectoryOptIn                    bool
}

type ProfileSettingsPageData struct {
	EffectiveRights []EffectiveRight
	RightsTenant string
	Portal         PortalPageData
	Email          string
	Profile        SettingsProfile
	ProfileMsg     string
	ProfileOK      bool
	PermissionList []string
	AuthList       []string
	Units          []view.ProfileUnitView
}

type NotificationSettingsPageData struct {
	Portal                    PortalPageData
	Email                     string
	NotifyMsg                 string
	NotifyOK                  bool
	EmailNotificationsEnabled bool
	NotificationEvents        []view.NotificationEventOption
	NotificationEnabledCount  int
	NotificationEventCount    int
}

type BuildingTenant struct {
	Name, Address, BrandIcon, BrandAbbreviation                       string
	ContactName, ContactAddress, ContactEmail, ContactPhone            string
	EmergencyName, EmergencyPhone                                     string
	CaretakerName, CaretakerEmail, CaretakerPhone, HeroImageURL        string
	MapLatitude, MapLongitude                                          float64
}

type BuildingSettingsPageData struct {
	Portal                  PortalPageData
	Tenant                  BuildingTenant
	AssetVersion            string
	BuildingMsg             string
	BuildingOK              bool
	BuildingSection         string
	BrandIconOptions        []view.SelectOption
	BrandIconLabel          string
	BrandIconIsLucide       bool
	LucideIconNamesJSON     string
	HeroMsg                 string
	HeroOK                  bool
	HasCustomHero           bool
	Units                    []view.BuildingUnitView
	NewUnitTypeOptions      []view.SelectOption
	NewUnitPaymentOptions   []view.SelectOption
	UnitTotal               int
	BillableUnits           string
	BillableLabel           string
	FairUseFreeUnits        int
	FairUseExceeded         bool
	UnitsEmpty              view.EmptyStateView
	UnitMsg                 string
	UnitOK                  bool
	PaymentMsg              string
	PaymentOK               bool
	HasHomeProfile          bool
	HomeProfileName         string
	HomeProfileType         string
	HasHomeProfileUnit      bool
	HomeProfileSaved        bool
	MapConfigured           bool
}

type UserSettingsPageData struct {
	Rights UserRightsData
	RightsSaved bool
	Portal                       PortalPageData
	AssetVersion                 string
	Users                        []view.UserRow
	UserCount                    int
	ActiveUserCount              int
	InvitedUserCount             int
	DisabledUserCount            int
	UsersEmpty                   view.EmptyStateView
	InviteMsg                    string
	InviteOK                     bool
	IsAdmin                      bool
	ServiceProviderAccessEnabled bool
}

templ SettingsFrame(portal PortalPageData, label string, extraScripts []string, body templ.Component) {
	@PortalDocument(portal.Title, portalAssetVersion(), extraScripts, SettingsStyles(), templ.Attributes{"data-templ-settings": true}) {
			@PortalShell(portal, label, body)
	}
}

templ SettingsHubPage(data SettingsHubPageData) {
	@SettingsFrame(data.Portal, "Einstellungen", []string{"profile-picture.js"}, SettingsHubContent(data))
}

templ SettingsHubContent(data SettingsHubPageData) {
	@PortalSectionLanding(
		PortalSectionLandingData{
			Portal: data.Portal,
			PageLabel: "Einstellungen",
			Class: "settings-main",
			Identity: PortalSectionIdentityData{Label: "Persönlich & verwaltet", Icon: "settings"},
		},
		PortalSectionTitle("Einstellungen"),
		PortalSectionLede("Konto und Kommunikation für " + data.Portal.Address + "."),
		nil,
		nil,
		nil,
		SettingsHubBody(data),
	)
}

templ SettingsHubBody(data SettingsHubPageData) {
	<div class="settings-body" data-templ-settings-hub>
		<section class="identity-card panel" data-templ-profile-picture>
			<span class={ "identity-icon", templ.KV("identity-avatar", data.HasProfilePicture) }>
				if data.HasProfilePicture {
					<img class="identity-avatar-image" src={ data.ProfilePictureURL } alt="" width="58" height="58" decoding="async"/>
				} else {
					@PortalIcon("users")
				}
			</span>
			<div>
				<h2>{ data.SettingsDisplayName }</h2>
				<p>{ data.Email }</p>
				if data.ProfilePictureMsg != "" {
					<p class={ "flash", templ.KV("ok", data.ProfilePictureOK), templ.KV("bad", !data.ProfilePictureOK) } role="status">{ data.ProfilePictureMsg }</p>
				}
				<p class="flash bad" role="alert" hidden data-profile-picture-error></p>
			</div>
			<div class="identity-actions">
				<form method="post" action="/app/settings/profilbild" enctype="multipart/form-data" data-profile-picture-form>
					<label class="button small profile-picture-choose">
						<span>{ settingsProfilePictureLabel(data.HasProfilePicture) }</span>
						<input type="file" name="profile_picture" accept="image/*" data-profile-picture-input/>
					</label>
					<button class="button small primary" type="submit" data-profile-picture-submit>Hochladen</button>
				</form>
				if data.HasProfilePicture {
					<form method="post" action="/app/settings/profilbild/entfernen"><button class="button small ghost" type="submit">Profilbild entfernen</button></form>
				}
			</div>
		</section>
		@SettingsProfilePictureDialog()
		<div class="settings-grid">
			if data.CanManageHomeIdentity {
				<section class="settings-group panel span-all"><header><div><h2>Mein Zuhause</h2><p>Anzeigename, Art und zugeordnete Einheit.</p></div><span class="scope personal">Nur Sie</span></header><nav class="settings-links">
					if data.HomeIdentity.HasDisplayName {
						<a href={ templ.SafeURL(data.SettingsHomeURL) } data-home-identity="settings" aria-label={ data.HomeIdentity.AriaLabel + " bearbeiten" }><span class="link-icon">@PortalIcon("home")</span><span><strong data-home-display-name>{ data.HomeIdentity.DisplayName }</strong>
							if data.HomeIdentity.HasUnit {
								<small class="settings-home-unit" data-home-unit-label>{ data.HomeIdentity.UnitLabel }</small>
							}
							<small>Anzeigename und Zuordnung bearbeiten</small></span><b>›</b></a>
					} else {
						<a href={ templ.SafeURL(data.SettingsHomeURL) }><span class="link-icon">@PortalIcon("home")</span><span><strong>{ settingsHomeTitle(data.HomeIdentity) }</strong><small>{ settingsHomeDetail(data.HomeIdentity) }</small></span><b>›</b></a>
					}
					if data.SettingsCanManageEnergyData {
						<a href="/app/settings/energy-data"><span class="link-icon">@PortalIcon("energy")</span><span><strong>Energiedaten &amp; Datenschutz</strong><small>Gespeicherte Daten ansehen, exportieren oder löschen</small></span><b>›</b></a>
					}
				</nav></section>
			}
			<section class="settings-group panel"><header><div><h2>Mein Konto</h2><p>Persönliche Angaben und Sichtbarkeit.</p></div><span class="scope personal">Nur Sie</span></header><nav class="settings-links"><a href="/app/settings/profile"><span class="link-icon">@PortalIcon("users")</span><span><strong>Profil</strong><small>Name, Telefon und Sichtbarkeit verwalten</small></span><b>›</b></a>
				if data.Portal.Modules.Audit && data.CanViewAudit && !settingsHasAdministrativeManagement(data) {
					@SettingsLink("audit", "Aktivitätsverlauf", "Änderungen nachvollziehen", "/app/audit")
				}
			</nav></section>
			<section class="settings-group panel"><header><div><h2>Kommunikation</h2><p>Was automatisch in Ihrem Postfach ankommt.</p></div><span class="scope personal">Nur Sie</span></header><nav class="settings-links"><a href="/app/settings/notifications"><span class="link-icon">@PortalIcon("announcement")</span><span><strong>Benachrichtigungen</strong><small>{ data.SettingsNotificationSummary }</small></span><b>›</b></a>
				if data.HasCalendarFeedURL {
					<a href={ templ.SafeURL(data.CalendarFeedURL) }><span class="link-icon">@PortalIcon("calendar")</span><span><strong>Kalender-Abo</strong><small>Termine der Liegenschaft im eigenen Kalender</small></span><b>›</b></a>
				}
			</nav></section>
			if settingsHasManagement(data) {
				<section class="settings-group panel span-all"><header><div><h2>Verwaltung</h2><p>Nur Bereiche, für die Sie berechtigt sind. Änderungen wirken für die ganze Liegenschaft.</p></div><span class="scope management">Verwaltungsrechte</span></header><nav class="settings-links management-links">
					if data.CanManageBuilding {
						@SettingsLink("home", "Gebäude & Einheiten", "Liegenschaftsdaten und Einheiten pflegen", "/app/settings/building")
						@SettingsLink("document", "Jahresabrechnung", "Grunddaten, Kostenarten, Einheiten und Abrechnungsperiode", "/app/settings/annual-statement")
						@SettingsLink("settings", "Portalbereiche", "Menüpunkte und Funktionen ein- oder ausblenden", "/app/settings/modules")
					}
					if data.Portal.Modules.Users && data.Portal.CanManageUsers {
						@SettingsLink("users", "Benutzer & Rechte", "Einladungen und Rollen verwalten", "/app/settings/users")
					}
					if data.Portal.Modules.Parking && data.Portal.CanManageUsers {
						@SettingsLink("parking", "Parkplatz-Zugriff", "Nutzung freigeben oder entziehen", "/app/settings/parking-access")
					}
					if data.Portal.Modules.Documents && data.CanManageDocuments {
						@SettingsLink("document", "Dokumente", "Unterlagen verwalten", "/app/dokumente")
					}
					if data.CanManageBuilding {
						@SettingsLink("document", "Datenübergabe", "Ausgewählte Rohdaten sicher weitergeben", "/app/settings/data-export")
					}
					if data.Portal.Modules.Handovers && data.CanManageHandovers {
						@SettingsLink("handover", "Übergaben", "Protokolle vorbereiten und ablegen", "/app/uebergaben")
					}
					if data.Portal.Modules.Audit && data.CanViewAudit {
						@SettingsLink("audit", "Aktivitätsverlauf", "Änderungen nachvollziehen", "/app/audit")
					}
					if data.Portal.Modules.Parking && data.IsAdmin {
						@SettingsLink("parking", "Parkplatz-Abrechnung", "Tarife und Abrechnungswerte", "/app/parking/settings")
					}
				</nav></section>
			}
		</div>
		<details class="note panel"><summary>Berechtigungen erklärt
			@DisclosureChevron()
		</summary><div><strong>Nur Sie</strong><p>Persönliche Einstellungen wirken allein auf Ihren Zugang.</p>
			if data.CanManageBuilding || data.Portal.CanManageUsers || data.CanManageDocuments || data.CanManageHandovers || data.IsAdmin {
				<strong>Verwaltungsrechte</strong><p>Änderungen gelten für die ganze Liegenschaft und werden im Verlauf festgehalten.</p>
			}
		</div></details>
	</div>
}

// SettingsProfilePictureDialog is the crop step between choosing a file and
// uploading it. The whole dialog is inert without JavaScript — the form next to
// it still uploads the chosen file, and the server centre-crops it — so the
// dialog is an enhancement rather than the only way through.

templ SettingsProfilePictureDialog() {
	<dialog class="user-dialog profile-picture-dialog" data-profile-picture-dialog aria-labelledby="profile-picture-dialog-title">
		<div class="dialog-head">
			<h2 id="profile-picture-dialog-title">Profilbild zuschneiden</h2>
			<p>Ausschnitt mit der Maus verschieben, Grösse mit dem Regler oder dem Mausrad wählen.</p>
		</div>
		<div class="dialog-body">
			<div class="crop-stage">
				<canvas class="crop-canvas" width="320" height="320" data-profile-picture-canvas aria-label="Bildausschnitt"></canvas>
				<span class="crop-mask" aria-hidden="true"></span>
			</div>
			<label class="crop-zoom">Grösse<input type="range" min="100" max="320" step="1" value="100" autofocus data-profile-picture-zoom/></label>
			<p class="crop-hint">Gespeichert wird ein quadratisches Bild mit 512 × 512 Pixeln.</p>
			<p class="flash bad" role="alert" hidden data-profile-picture-dialog-error></p>
		</div>
		<div class="dialog-footer">
			<button class="button ghost" type="button" data-profile-picture-cancel>Abbrechen</button>
			<button class="button primary" type="button" data-profile-picture-save>Profilbild speichern</button>
		</div>
	</dialog>
}

func settingsProfilePictureLabel(hasPicture bool) string {
	if hasPicture {
		return "Profilbild ändern"
	}
	return "Profilbild wählen"
}

templ SettingsLink(icon, title, detail, url string) {
	<a href={ templ.SafeURL(url) }><span class="link-icon">@PortalIcon(icon)</span><span><strong>{ title }</strong><small>{ detail }</small></span><b>›</b></a>
}

func settingsHomeTitle(home view.HomeIdentityView) string {
	if home.HasDisplayName { return home.DisplayName }
	return "Mein Zuhause einrichten"
}

func settingsHomeDetail(home view.HomeIdentityView) string {
	if home.HasUnit { return home.UnitLabel + " · Anzeigename und Zuordnung bearbeiten" }
	if home.HasDisplayName { return "Anzeigename und Zuordnung bearbeiten" }
	return "Name, Art und Zuordnung festlegen"
}

func settingsHasAdministrativeManagement(data SettingsHubPageData) bool {
	return data.CanManageBuilding || (data.Portal.Modules.Users && data.Portal.CanManageUsers) || (data.Portal.Modules.Documents && data.CanManageDocuments) || (data.Portal.Modules.Handovers && data.CanManageHandovers) || (data.Portal.Modules.Parking && data.IsAdmin)
}

func settingsHasManagement(data SettingsHubPageData) bool {
	return settingsHasAdministrativeManagement(data)
}

templ ProfileSettingsPage(data ProfileSettingsPageData) {
	@SettingsFrame(data.Portal, "Profil", nil, ProfileSettingsContent(data))
}

templ ProfileSettingsContent(data ProfileSettingsPageData) {
	@PortalSectionLanding(
		PortalSectionLandingData{
			Portal: data.Portal,
			PageLabel: "Profil",
			Class: "settings-main",
			Identity: PortalSectionIdentityData{Label: "Einstellungen", Icon: "users", URL: "/app/settings"},
		},
		PortalSectionTitle("Profil"),
		PortalSectionLede("Persönliche Angaben und Sichtbarkeit. Änderungen gelten nur für Ihren Zugang."),
		nil,
		nil,
		nil,
		ProfileSettingsBody(data),
	)
}

templ ProfileSettingsBody(data ProfileSettingsPageData) {
	<div data-templ-profile-settings>
		<div class="two-column"><section class="panel form-card">
			if data.ProfileMsg != "" {
				<p class={ "flash", templ.KV("ok", data.ProfileOK) } role="status">{ data.ProfileMsg }</p>
			}
			<form method="post" action="/app/settings/profile">
				<fieldset><legend>Name</legend><p>So werden Sie im Portal angesprochen.</p><div class="form-grid three"><label><span>Titel <small>optional</small></span><input name="title" value={ data.Profile.Title } maxlength="40" autocomplete="honorific-prefix" placeholder="z. B. Dr."/></label><label>Vorname<input name="first_name" value={ data.Profile.FirstName } maxlength="120" autocomplete="given-name"/></label><label>Nachname<input name="last_name" value={ data.Profile.LastName } maxlength="120" autocomplete="family-name"/></label></div></fieldset>
				<fieldset><legend>Kontakt &amp; Sichtbarkeit</legend><p>Ihre Anmeldung bleibt unverändert.</p><div class="form-grid"><label>E-Mail<span class="readonly">{ data.Email }</span></label><label><span>Telefon <small>optional</small></span><input name="phone" value={ data.Profile.Phone } maxlength="80" autocomplete="tel"/></label></div><label class="check-card"><input type="checkbox" name="directory_opt_in" checked?={ data.Profile.DirectoryOptIn }/><span><strong>Im Kontakte-Verzeichnis anzeigen</strong><small>Name, E-Mail und Telefon werden für die Hausgemeinschaft sichtbar. Die Freigabe ist freiwillig.</small></span></label></fieldset>
				<footer class="form-actions"><a class="button ghost" href="/app/settings">Abbrechen</a><button class="button primary" type="submit">Profil speichern</button></footer>
			</form>
		</section><aside class="aside-stack">
			<details class="note panel" open><summary>Was andere sehen
				@DisclosureChevron()
			</summary><div><ul class="facts"><li><strong>Name</strong><span>Steht an Ihren Beiträgen, Anliegen und Stimmabgaben.</span></li><li><strong>E-Mail und Telefon</strong><span>Nur sichtbar, wenn Sie den Verzeichniseintrag freigeben.</span></li><li><strong>Verzeichniseintrag</strong><span>{ settingsDirectoryStatus(data.Profile.DirectoryOptIn) }</span></li></ul><a class="text-link" href="/app/kontakte">Kontakte ansehen</a></div></details>
			@MyPermissions(data.EffectiveRights, data.RightsTenant)
			<details class="note panel"><summary>Konto &amp; Berechtigungen
				@DisclosureChevron()
			</summary><div class="facts"><div class="chips">
				for _, item := range data.PermissionList {
					<span>{ item }</span>
				}
			</div><strong>Anmeldung</strong><div class="chips">
				for _, item := range data.AuthList {
					<span>{ item }</span>
				}
			</div><strong>Einheiten</strong>
				if len(data.Units) == 0 {
					<span>Keine Einheit verknüpft.</span>
				} else {
					for _, unit := range data.Units {
						<span><b>{ unit.Label }</b> · { unit.Relation } · { unit.Share }</span>
					}
				}
			</div></details>
		</aside></div>
	</div>
}

func settingsDirectoryStatus(optedIn bool) string {
	if optedIn { return "Derzeit freigegeben – Ihr Eintrag steht unter Kontakte." }
	return "Derzeit nicht freigegeben – Ihr Eintrag fehlt unter Kontakte."
}

templ NotificationSettingsPage(data NotificationSettingsPageData) {
	@SettingsFrame(data.Portal, "Benachrichtigungen", nil, NotificationSettingsContent(data))
}

templ NotificationSettingsContent(data NotificationSettingsPageData) {
	@PortalSectionLanding(
		PortalSectionLandingData{
			Portal: data.Portal,
			PageLabel: "Benachrichtigungen",
			Class: "settings-main",
			Identity: PortalSectionIdentityData{Label: "Einstellungen · Kommunikation", Icon: "announcement", URL: "/app/settings"},
		},
		PortalSectionTitle("Benachrichtigungen"),
		PortalSectionLede("Festlegen, welche E-Mails Sie erhalten möchten. Die Auswahl gilt nur für Ihr Postfach."),
		nil,
		nil,
		nil,
		NotificationSettingsBody(data),
	)
}

templ NotificationSettingsBody(data NotificationSettingsPageData) {
	<div data-templ-notification-settings>
		<div class="two-column"><section class="panel form-card">
			if data.NotifyMsg != "" {
				<p class={ "flash", templ.KV("ok", data.NotifyOK) } role="status">{ data.NotifyMsg }</p>
			}
			<form class={ "notification-form", templ.KV("email-paused", !data.EmailNotificationsEnabled) } method="post" action="/app/settings/notifications" data-notification-form>
				<label class="master-switch"><span class="link-icon">@PortalIcon("announcement")</span><span><strong>E-Mails erhalten</strong><small data-notification-status>{ notificationStatus(data) }</small></span><span class="switch"><input type="checkbox" name="email_enabled" value="on" checked?={ data.EmailNotificationsEnabled } data-notification-master/><i></i></span></label>
				<header class="subhead"><div><h2>Wofür?</h2><p>Ihre Auswahl für einzelne Themen.</p></div><span data-notification-count>{ data.NotificationEnabledCount } von { data.NotificationEventCount } aktiv</span></header>
				<p class="paused-note">Die Themenauswahl bleibt gespeichert und gilt wieder, sobald Sie E-Mails aktivieren.</p>
				@NotificationGroup("Liegenschaft & Kommunikation", data.NotificationEvents, "announcement", "issue")
				@NotificationGroup("Entscheidungen & Unterlagen", data.NotificationEvents, "vote", "document")
				@NotificationGroup("Zahlung & Nutzung", data.NotificationEvents, "payment", "charging")
				<footer class="form-actions"><a class="button ghost" href="/app/settings">Abbrechen</a><button class="button primary" type="submit">Benachrichtigungen speichern</button></footer>
			</form>
		</section><aside class="aside-stack"><details class="note panel" open><summary>Empfängeradresse
			@DisclosureChevron()
		</summary><div><span class="readonly">{ data.Email }</span><p>Die Adresse ist zugleich Ihre Anmeldung und lässt sich hier nicht ändern.</p><a class="text-link" href="/app/settings/profile">Profil ansehen</a></div></details><details class="note panel"><summary>Grundregeln
			@DisclosureChevron()
		</summary><div><ul class="facts"><li><strong>Anmeldelinks</strong><span>Selbst angeforderte Links erhalten Sie immer.</span></li><li><strong>Keine Werbung</strong><span>Versendet wird ausschließlich, was diese Liegenschaft betrifft.</span></li><li><strong>Im Portal vollständig</strong><span>Alles bleibt im Portal sichtbar.</span></li></ul></div></details></aside></div>
	</div>
}

templ NotificationGroup(title string, options []view.NotificationEventOption, first, second string) {
	<section class="option-group"><h3>{ title }</h3>
		for _, option := range options {
			if option.Key == first || option.Key == second {
				<label><span><strong>{ option.Label }</strong><small>{ option.Description }</small></span><span class="switch"><input type="checkbox" name="events" value={ option.Key } checked?={ option.Checked } data-notification-topic/><i></i></span></label>
			}
		}
	</section>
}

func notificationStatus(data NotificationSettingsPageData) string {
	if !data.EmailNotificationsEnabled { return "Der Versand ist derzeit pausiert." }
	return "Aktuell zu " + strconv.Itoa(data.NotificationEnabledCount) + " von " + strconv.Itoa(data.NotificationEventCount) + " Themen."
}

templ BuildingSettingsPage(data BuildingSettingsPageData) {
	@SettingsFrame(data.Portal, "Gebäude & Einheiten", []string{"attachments.js", "building-settings.js"}, BuildingSettingsContent(data))
}

templ BuildingSettingsContent(data BuildingSettingsPageData) {
	@PortalSectionLanding(
		PortalSectionLandingData{
			Portal: data.Portal,
			PageLabel: "Gebäude & Einheiten",
			Class: "settings-main building",
			Identity: PortalSectionIdentityData{Label: "Einstellungen · Verwaltung", Icon: "home", URL: "/app/settings"},
		},
		PortalSectionTitle("Gebäude & Einheiten"),
		PortalSectionLede("Liegenschaftsdaten, Kontakte und Einheiten an einem Ort."),
		BuildingSettingsHeaderAction(),
		nil,
		nil,
		BuildingSettingsBody(data),
	)
}

templ BuildingSettingsHeaderAction() {
	<a class="button" href="/app/settings">Zurück zu Einstellungen</a>
}

templ BuildingSettingsBody(data BuildingSettingsPageData) {
	<div data-templ-building-settings>
		<nav class="section-tabs" aria-label="Bereiche">
			@BuildingTab("overview", "Stammdaten", data.BuildingSection)
			@BuildingTab("contacts", "Kontakte", data.BuildingSection)
			@BuildingTab("units", "Einheiten", data.BuildingSection)
			@BuildingTab("appearance", "Erscheinungsbild", data.BuildingSection)
		</nav>
		if data.BuildingSection == "overview" {
			@BuildingOverview(data)
		} else if data.BuildingSection == "contacts" {
			@BuildingContacts(data)
		} else if data.BuildingSection == "units" {
			@BuildingUnits(data)
		} else {
			@BuildingAppearance(data)
		}
	</div>
}

templ BuildingTab(section, label, active string) {
	<a href={ templ.SafeURL("/app/settings/building?section=" + section) } class={ templ.KV("active", section == active) } aria-current={ portalAriaCurrent(section == active) }>{ label }</a>
}

templ BuildingOverview(data BuildingSettingsPageData) {
	<section class="panel workspace"><header class="workspace-head"><div><h2>Stammdaten</h2><p>Name, Adresse und Kartenposition dieses Portals.</p></div></header>
		@SettingsFlash(data.BuildingMsg, data.BuildingOK)
		<form method="post" action="/app/settings/building" data-building-form>
			<div class="form-grid"><fieldset><legend>Hausadresse</legend><label>Name<input id="building-name" type="text" name="name" value={ data.Tenant.Name } maxlength="160" required/></label><label>Adresse<textarea id="building-address" name="address" maxlength="500" required>{ data.Tenant.Address }</textarea></label><button class="button ghost" type="button" data-geocode-address data-geocode-url="/app/settings/building/geocode">Standort aus Adresse ermitteln</button><span class="muted" data-geocode-status aria-live="polite">Nur bei Klick wird die Adresse an OpenStreetMap übermittelt.</span><div data-geocode-results hidden></div></fieldset>
			<fieldset><legend>Kartenposition</legend><div class="map-card" data-map-preview><span class="map-pin">@PortalIcon("home")</span><strong data-map-label>{ mapStatus(data.MapConfigured) }</strong><small data-map-coordinates>{ mapCoordinates(data) }</small></div><details class="inline-details"><summary>Koordinaten manuell eingeben
				@DisclosureChevron()
			</summary><label>Breitengrad, Längengrad<input id="building-map-position" type="text" name="map_position" value={ mapCoordinatesValue(data) } inputmode="decimal" placeholder="48.208200, 16.373800"/></label></details></fieldset></div>
			<footer class="form-actions"><a class="button ghost" href="/app/settings/building?section=overview">Verwerfen</a><button class="button primary" type="submit">Änderungen speichern</button></footer>
		</form>
	</section>
}

func mapStatus(configured bool) string { if configured { return "Standort hinterlegt" }; return "Kein Standort hinterlegt" }
func mapCoordinatesValue(data BuildingSettingsPageData) string { if data.MapConfigured { return strconv.FormatFloat(data.Tenant.MapLatitude, 'f', 6, 64) + ", " + strconv.FormatFloat(data.Tenant.MapLongitude, 'f', 6, 64) }; return "" }
func mapCoordinates(data BuildingSettingsPageData) string { if value := mapCoordinatesValue(data); value != "" { return value }; return "Die Karte wird nach der Auswahl aktualisiert." }

templ BuildingContacts(data BuildingSettingsPageData) {
	<section class="panel workspace"><header class="workspace-head"><div><h2>Kontakte der Liegenschaft</h2><p>Verwaltung, Notdienst und Hausmeister klar an einem Ort pflegen.</p></div><span class="scope personal">Im Portal sichtbar</span></header>
		@SettingsFlash(data.BuildingMsg, data.BuildingOK)
		<form method="post" action="/app/settings/building/contacts"><div class="contact-grid">
			<fieldset><legend>Hausverwaltung</legend><label>Name oder Firma<input name="contact_name" value={ data.Tenant.ContactName } maxlength="160"/></label><label>Anschrift<textarea name="contact_address" maxlength="500">{ data.Tenant.ContactAddress }</textarea></label><label>E-Mail<input type="email" name="contact_email" value={ data.Tenant.ContactEmail } maxlength="160" autocomplete="email"/></label><label>Telefon<input type="tel" name="contact_phone" value={ data.Tenant.ContactPhone } maxlength="80" autocomplete="tel"/></label></fieldset>
			<fieldset><legend>Notdienst</legend><label>Bezeichnung<input name="emergency_name" value={ data.Tenant.EmergencyName } maxlength="160" placeholder="Notdienst"/></label><label>Telefon<input type="tel" name="emergency_phone" value={ data.Tenant.EmergencyPhone } maxlength="80" autocomplete="tel"/></label></fieldset>
			<fieldset><legend>Hausmeister</legend><label>Name<input name="caretaker_name" value={ data.Tenant.CaretakerName } maxlength="160"/></label><label>E-Mail<input type="email" name="caretaker_email" value={ data.Tenant.CaretakerEmail } maxlength="160" autocomplete="email"/></label><label>Telefon<input type="tel" name="caretaker_phone" value={ data.Tenant.CaretakerPhone } maxlength="80" autocomplete="tel"/></label></fieldset>
		</div><footer class="form-actions"><a class="button ghost" href="/app/settings/building?section=contacts">Verwerfen</a><button class="button primary" type="submit">Kontakte speichern</button></footer></form>
	</section>
}

templ BuildingUnits(data BuildingSettingsPageData) {
	<section class="panel workspace"><header class="workspace-head"><div><h2>Einheiten</h2><p>Stammdaten, Zuordnungen und Zahlungsstatus je Einheit verwalten.</p></div><div class="head-actions"><a class="button ghost" href="/app/settings/payments/import">Bankdatei einlesen</a><a class="button primary" href="#unit-add">Einheit hinzufügen</a></div></header>
		<div class="metrics"><span><strong>{ data.UnitTotal }</strong><small>Einheiten gesamt</small></span><span><strong>{ data.BillableUnits } von { data.FairUseFreeUnits }</strong><small>{ data.BillableLabel } im inkludierten Rahmen</small></span></div>
		if data.FairUseExceeded {
			<p class="notice">Über dem inkludierten Rahmen von { data.FairUseFreeUnits } Wohneinheiten. Richtwert: 1 € pro Einheit und Monat.</p>
		}
		if data.HomeProfileSaved {
			@SettingsFlash("Der Anzeigename von „Mein Zuhause“ wurde gespeichert.", true)
		}
		if data.HasHomeProfile && !data.HasHomeProfileUnit {
			<aside class="notice"><strong>{ data.HomeProfileName }</strong> ist { homeProfileScope(data.HomeProfileType) }. <a href="/app/settings/home?from=building">Zuhause bearbeiten</a></aside>
		}
		@SettingsFlash(data.UnitMsg, data.UnitOK) @SettingsFlash(data.PaymentMsg, data.PaymentOK)
		if len(data.Units) == 0 {
			@SettingsEmpty(data.UnitsEmpty)
		} else {
			<div class="unit-list">
				for _, unit := range data.Units {
					@BuildingUnitRow(unit)
				}
			</div>
		}
		@BuildingUnitDialog(view.BuildingUnitView{}, data.NewUnitTypeOptions, data.NewUnitPaymentOptions, true)
		for _, unit := range data.Units {
			@BuildingUnitDialog(unit, unit.TypeOptions, unit.PaymentOptions, false)
		}
	</section>
}

func homeProfileScope(kind string) string { if kind == "apartment" { return "noch keiner offiziellen Einheit zugeordnet" }; return "als gesamte Liegenschaft angelegt" }

templ BuildingUnitRow(unit view.BuildingUnitView) {
	<article class="unit-card"><span class="unit-kind">@PortalIcon("home")</span><div class="unit-title"><strong>{ unit.Label }</strong><small>{ unit.UnitTypeLabel } · { unit.BillableLabel }</small>
		if unit.HasHomeDisplayName {
			<em>Mein Zuhause · { unit.HomeDisplayName }</em>
		}
	</div><div class="assignment"><small>Eigentümer</small><strong>{ unit.OwnerSummary }</strong>
		if unit.HasOwners {
			<small>{ unit.OwnerEmails }</small>
		}
		<small>Mieter</small><strong>{ unit.RenterSummary }</strong>
		if unit.HasRenters {
			<small>{ unit.RenterEmails }</small>
		}
	</div><div><strong>{ unit.Share }</strong><small>{ unit.MembersLabel }</small></div><div><span class={ "pill", unit.PaymentStatusClass }>{ unit.PaymentStatus }</span><small>{ paymentUpdated(unit) }</small></div><a class="icon-button" href={ templ.SafeURL("#unit-" + unit.ID) } aria-label={ unit.Label + " bearbeiten" }>✎</a></article>
}

func paymentUpdated(unit view.BuildingUnitView) string { if unit.PaymentHasUpdated { return unit.PaymentUpdatedAt }; return "Manuell" }

templ BuildingUnitDialog(unit view.BuildingUnitView, types, payments []view.SelectOption, add bool) {
	<section class="anchor-dialog unit-dialog-shell" id={ unitDialogID(unit, add) } role="dialog" aria-modal="true" aria-labelledby={ unitDialogID(unit, add) + "-title" } tabindex="-1"><a class="dialog-backdrop" href="?section=units" aria-label="Dialog schließen" data-unit-dialog-close></a><div class="dialog-card"><header><div><h2 id={ unitDialogID(unit, add) + "-title" }>{ unitDialogTitle(add) }</h2><p>{ unitDialogDetail(unit, add) }</p></div><a class="icon-button" href="?section=units" aria-label="Dialog schließen" data-unit-dialog-close>×</a></header><form id={ unitDialogID(unit, add) + "-form" } method="post" action="/app/settings/building/units">
		if !add {
			<input type="hidden" name="orig_id" value={ unit.ID }/><input type="hidden" name="id" value={ unit.ID }/>
		}
		<fieldset><legend>Stammdaten</legend><label>Offizielle Bezeichnung<input name="label" value={ unit.Label } maxlength="120" required placeholder="Top 1"/></label><label>Typ<select name="unit_type">
			for _, option := range types {
				<option value={ option.Value } selected?={ option.Selected }>{ option.Label }</option>
			}
		</select></label><label>Miteigentumsanteil<input type="number" name="miteigentumsanteil" min="0" max="1000000" step="1" value={ unitShareValue(unit, add) } inputmode="numeric"/></label></fieldset>
		<fieldset><legend>Personen &amp; Zuordnung</legend><label>Eigentümer E-Mails<input name="owner_emails" value={ unit.OwnerEmails } placeholder="name@example.com, zweite@example.com"/></label><label>Mieter E-Mails<input name="renter_emails" value={ unit.RenterEmails } placeholder="name@example.com"/></label></fieldset>
		<fieldset><legend>Zahlungsstatus</legend><label>Status<select name="payment_status">
			for _, option := range payments {
				<option value={ option.Value } selected?={ option.Selected }>{ option.Label }</option>
			}
		</select></label></fieldset>
	</form><footer>
		if !add {
			<form method="post" action="/app/settings/building/units/delete" data-confirm={ unit.DeleteConfirmLabel + "?" }><input type="hidden" name="id" value={ unit.ID }/><button class="button ghost" type="submit">Einheit löschen</button></form>
		}
		<a class="button ghost" href="?section=units">Abbrechen</a><button class="button primary" type="submit" form={ unitDialogID(unit, add) + "-form" }>{ unitDialogButton(add) }</button></footer></div></section>
}

func unitDialogID(unit view.BuildingUnitView, add bool) string { if add { return "unit-add" }; return "unit-" + unit.ID }
func unitDialogTitle(add bool) string { if add { return "Einheit hinzufügen" }; return "Einheit bearbeiten" }
func unitDialogButton(add bool) string { if add { return "Einheit anlegen" }; return "Änderungen speichern" }
func unitDialogDetail(unit view.BuildingUnitView, add bool) string { if add { return "Stammdaten und Zuordnungen an einem Ort erfassen." }; return unit.Label + " · " + unit.UnitTypeLabel }
func unitShareValue(unit view.BuildingUnitView, add bool) string { if add { return "0" }; return unit.ShareValue }

templ BuildingAppearance(data BuildingSettingsPageData) {
	<section class="panel workspace"><header class="workspace-head"><div><h2>Erscheinungsbild</h2><p>Portal-Kennung und Titelbild gestalten.</p></div></header>@SettingsFlash(data.BuildingMsg, data.BuildingOK) @SettingsFlash(data.HeroMsg, data.HeroOK)
		<div class="appearance-grid" data-appearance-workspace><div class="aside-stack"><form class="panel inset" method="post" action="/app/settings/building/appearance"><fieldset><legend>Portal-Symbol</legend><input type="hidden" name="brand_icon" value={ data.Tenant.BrandIcon } data-brand-icon-value/><div class="brand-grid" role="radiogroup" aria-label="Portal-Symbol">
			for _, option := range data.BrandIconOptions {
				<label class="brand-icon-choice"><input type="radio" name="brand_icon_choice" value={ option.Value } checked?={ option.Selected }/><span>@PortalIcon(brandPreviewIcon(option.Value))</span><strong>{ option.Label }</strong></label>
			}
		</div></fieldset><section class="icon-search"><label>Weitere Symbole aus Lucide<input type="search" placeholder="Symbol suchen" autocomplete="off" data-brand-icon-search/></label><div data-brand-icon-results hidden></div>
			<p data-brand-icon-result-note hidden?={ !data.BrandIconIsLucide }>
				if data.BrandIconIsLucide {
					Aktuell ausgewählt: { data.BrandIconLabel }
				}
			</p>
		</section><label>Kurzkennung<input id="brand-abbreviation" name="brand_abbreviation" value={ data.Tenant.BrandAbbreviation } maxlength="12" placeholder="HAUS"/><span data-abbreviation-count>{ len(data.Tenant.BrandAbbreviation) } / 12</span></label><button class="button primary" type="submit">Portal-Kennung speichern</button></form>
			<section class="panel inset"><h3>Titelbild</h3><img class="hero-preview" src={ templ.SafeURL(data.Tenant.HeroImageURL) } alt="Aktuelles Titelbild" data-hero-preview/><p data-hero-file-name>{ heroLabel(data.HasCustomHero) }</p><form method="post" action="/app/settings/building/hero" enctype="multipart/form-data"><label>Neues Titelbild<input id="hero-image" type="file" name="hero_image" accept="image/jpeg,image/png,image/webp" required/></label><button class="button" type="submit">Titelbild übernehmen</button></form>
				if data.HasCustomHero {
					<form method="post" action="/app/settings/building/hero/delete" data-confirm="Titelbild entfernen und Standardbild verwenden?"><button class="button ghost" type="submit">Standardbild verwenden</button></form>
				}
			</section></div>
			<aside class="preview panel"><span class="eyebrow">Live-Vorschau</span><img src={ templ.SafeURL(data.Tenant.HeroImageURL) } alt="" data-hero-stage/><div><span class="preview-mark" data-brand-preview-mark>@PortalIcon("home")</span><strong data-brand-preview-abbreviation>{ data.Tenant.BrandAbbreviation }</strong><small>{ data.Tenant.Name }</small></div><h3>Alles Wichtige für Ihr Zuhause.</h3><span class="button primary">Anmelden</span><p>Änderungen erscheinen nach dem Speichern im Portal.</p></aside></div>
		<script id="brand-lucide-icon-names" type="application/json">@templ.Raw(data.LucideIconNamesJSON)</script>
	</section>
}

func brandPreviewIcon(value string) string { if value == "parking" { return "parking" }; return "home" }
func heroLabel(custom bool) string { if custom { return "Individuelles Titelbild" }; return "HAUSV Standardbild" }

templ SettingsFlash(message string, ok bool) {
	if message != "" {
		<p class={ "flash", templ.KV("ok", ok), templ.KV("bad", !ok) } role="status">{ message }</p>
	}
}

templ SettingsEmpty(empty view.EmptyStateView) {
	<section class="empty"><h2>{ empty.Title }</h2><p>{ empty.Message }</p>
		if empty.HasAction {
			<a class="button" href={ templ.SafeURL(empty.ActionURL) }>{ empty.ActionLabel }</a>
		}
	</section>
}

templ SettingsStyles() {
	<style>a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible{outline:2px solid var(--gold-light);outline-offset:2px}h1,h2,h3,p{margin:0}h1,h2,h3{font-family:var(--font-serif);font-weight:600}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.nav-icon svg{display:block;width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
		.settings-main{min-width:0;padding:42px clamp(var(--space-5),4vw,56px) 64px}.settings-main>*{max-width:1180px;margin-inline:auto}.settings-main>*+*{margin-top:var(--space-5)}.eyebrow{color:var(--gold-ink);font-size:11px;font-weight:900;letter-spacing:.11em;text-transform:uppercase}.panel{border:1px solid var(--line);border-radius:var(--radius-md);background:var(--panel);box-shadow:var(--shadow-panel)}.button.primary{background:var(--gold);color:var(--panel)}.button.ghost{border-color:var(--line);color:var(--muted)}.text-link{color:var(--gold-ink);font-weight:800;text-decoration:underline;text-underline-offset:3px}.muted{color:var(--muted)}
		.identity-card{display:grid;grid-template-columns:58px minmax(0,1fr) auto;align-items:center;gap:var(--space-4);padding:var(--space-4)}.identity-card p{overflow-wrap:anywhere}.identity-icon,.link-icon,.unit-kind{display:grid;place-items:center;background:var(--panel-soft);border:1px solid var(--line);color:var(--gold-ink);border-radius:var(--radius-sm)}.identity-icon{width:58px;height:58px;background:var(--ink);color:var(--panel)}.identity-icon svg{width:28px}.identity-card h2{font-size:23px}.identity-card p{margin-top:3px;color:var(--muted);font-size:13px}.pill,.scope{display:inline-flex;align-items:center;width:max-content;white-space:nowrap;padding:4px 10px;border-radius:var(--radius-pill);background:var(--panel-soft);border:1px solid var(--line);color:var(--muted);font-size:11px;font-weight:800}.scope.personal{background:rgba(47,107,74,.08);color:var(--leaf)}.scope.management{background:rgba(200,153,63,.12);color:var(--gold-ink)}.settings-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-4)}.span-all{grid-column:1/-1}.settings-group{overflow:hidden}.settings-group>header{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px var(--space-3);align-items:start;padding:var(--space-4)}.settings-group h2{font-size:21px}.settings-group header p{margin-top:4px;color:var(--muted);font-size:12px}.settings-links{display:grid}.settings-links a{min-height:72px;display:grid;grid-template-columns:42px minmax(0,1fr) 16px;align-items:center;gap:var(--space-3);padding:var(--space-3) var(--space-4);border-top:1px solid var(--line)}.settings-links a:hover{background:var(--panel-soft)}.settings-links .link-icon{width:42px;height:42px}.link-icon svg,.unit-kind svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:1.8}.settings-links strong,.settings-links small{display:block}.settings-links strong{font-family:var(--font-serif);font-size:17px}.settings-links small{margin-top:3px;color:var(--muted);font-size:12px}.settings-links b{color:var(--gold-ink);font-size:22px}.management-links{grid-template-columns:repeat(2,minmax(0,1fr))}.management-links a:nth-child(even){border-left:1px solid var(--line)}
		.two-column{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:var(--space-4);align-items:start}.form-card{padding:var(--space-4)}.form-card form,.workspace form,.user-dialog form{display:grid;gap:var(--space-4)}fieldset{min-width:0;display:grid;gap:var(--space-3);margin:0;padding:var(--space-4);border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel-soft)}legend{padding-inline:var(--space-2);font-family:var(--font-serif);font-size:19px;font-weight:700}fieldset>p{color:var(--muted);font-size:12px}.form-grid,.contact-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-3)}.form-grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}.contact-grid{grid-template-columns:repeat(3,minmax(0,1fr))}label{display:grid;gap:6px;color:var(--gold-ink);font-size:11px;font-weight:800}label small{color:var(--soft);font-weight:600}input,select,textarea,.readonly{width:100%;min-height:42px;padding:9px 11px;border:1px solid var(--line);border-radius:var(--radius-xs);background:var(--panel);color:var(--ink)}textarea{min-height:92px;resize:vertical}.readonly{display:flex;align-items:center;overflow-wrap:anywhere}.check-card{min-height:64px;display:grid;grid-template-columns:20px minmax(0,1fr);align-items:start;gap:var(--space-3);padding:var(--space-3);border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel)}.check-card input{width:19px;min-height:19px;margin:1px 0 0;accent-color:var(--leaf)}.check-card span{display:grid;gap:3px;color:var(--ink);font-size:13px}.check-card small{color:var(--muted);font-size:12px;line-height:1.4}.form-actions,.dialog-card>footer{display:flex;justify-content:flex-end;align-items:center;flex-wrap:wrap;gap:var(--space-2)}.aside-stack{display:grid;gap:var(--space-3)}.note{overflow:hidden}.note>summary{min-height:52px;display:flex;align-items:center;padding:0 var(--space-4);cursor:pointer;font-weight:850;list-style:none}.note>summary::-webkit-details-marker{display:none}.note>div{display:grid;gap:var(--space-3);padding:0 var(--space-4) var(--space-4);color:var(--muted);font-size:12px}.facts{display:grid;gap:var(--space-2);margin:0;padding:0;list-style:none}.facts li{display:grid;gap:2px}.facts li+li{padding-top:var(--space-2);border-top:1px solid var(--line)}.facts strong{color:var(--ink);font-size:13px}.chips{display:flex;flex-wrap:wrap;gap:5px}.chips span{display:inline-flex;padding:3px 8px;border:1px solid var(--line);border-radius:var(--radius-pill);background:var(--panel-soft);color:var(--muted);font-size:11px}.flash,.notice{padding:var(--space-3);border:1px solid var(--line);border-radius:var(--radius-sm);background:rgba(200,153,63,.09);color:var(--gold-ink);font-size:12px;line-height:1.45}.flash.ok{background:rgba(47,107,74,.08);color:var(--leaf)}.flash.bad{border-color:#8c3434;background:rgba(140,52,52,.07);color:#8c3434}
		.notification-form{display:grid;gap:var(--space-4)}.master-switch{display:grid;grid-template-columns:48px minmax(0,1fr) auto;align-items:center;gap:var(--space-3);padding:var(--space-3);border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel-soft);color:var(--ink)}.master-switch .link-icon{width:48px;height:48px}.master-switch strong,.master-switch small{display:block}.master-switch strong{font-family:var(--font-serif);font-size:18px}.master-switch small{margin-top:3px;color:var(--muted);font-size:12px}.switch{position:relative;width:46px;height:27px}.switch input{position:absolute;opacity:0}.switch i{position:absolute;inset:0;border-radius:var(--radius-pill);background:var(--line);box-shadow:inset 0 0 0 1px rgba(32,37,31,.08)}.switch i::after{content:"";position:absolute;top:3px;left:3px;width:21px;height:21px;border-radius:50%;background:var(--panel);box-shadow:0 2px 5px rgba(32,37,31,.18);transition:.16s}.switch input:checked+i{background:var(--leaf)}.switch input:checked+i::after{transform:translateX(19px)}.subhead{display:flex;flex-wrap:wrap;align-items:end;justify-content:space-between;gap:var(--space-3)}.subhead>div{min-width:0}.subhead h2{font-size:21px}.subhead p,.subhead>span{color:var(--muted);font-size:12px}.option-group{overflow:hidden;border:1px solid var(--line);border-radius:var(--radius-sm)}.option-group h3{padding:9px var(--space-3);background:var(--panel-soft);color:var(--gold-ink);font-family:var(--font-sans);font-size:11px;text-transform:uppercase;letter-spacing:.08em}.option-group>label{min-height:62px;display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:var(--space-3);padding:var(--space-3);border-top:1px solid var(--line);color:var(--ink)}.option-group strong,.option-group small{display:block}.option-group small{margin-top:3px;color:var(--muted);font-size:12px}.paused-note{display:none}.email-paused .paused-note{display:block}.email-paused .option-group{opacity:.7}
