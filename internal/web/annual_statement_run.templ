package web

import "strconv"
import "net/url"

type AnnualStatementRunView struct {
 ManagementAddressMissing bool
 Approved bool
 ApprovedAt string
 ApproveAction string
 AushangURL string
	Year            int
	Ready           bool
	Issues          []string
	IssueTargets []string
	BlockingSection string
	Message         string
	MessageOK       bool
	ID              string
	Revision        int
	CreatedAt       string
	CreatedBy       string
	Total           string
	Excluded        string
	Units           []AnnualStatementRunUnitView
	Vacancy         []AnnualStatementRunUnitView
	History         []AnnualStatementRunLinkView
	AllPDFURL       string
	ArchiveAction   string
	ArchiveURL      string
	ArchivedAt      string
	SendAction      string
	SendIssue       string
	MailMode        string
	DeliverySummary string
	Deliveries      []AnnualStatementDeliveryView
	ArchiveCount    int
}
type AnnualStatementDeliveryView struct {
	Party, Recipient, Time, Status, Error string
}

type AnnualStatementRunLinkView struct {
	ID       string
	Label    string
	Selected bool
}
type AnnualStatementRunUnitView struct {
	Label     string
	Allocated string
	Prepaid   string
	Balance   string
	Costs     []AnnualStatementRunCostView
	PDFs      []AnnualStatementRunPDFView
}
type AnnualStatementRunPDFView struct {
	Period, Allocated, Prepaid, Balance string
	Label      string
	URL        string
	ArchiveURL string
}
type AnnualStatementRunCostView struct {
	Name   string
	Key    string
	Share  string
	Amount string
}

templ AnnualStatementRunPanel(data AnnualStatementRunView) {
	<section class="panel workspace annual-run-panel" id="abrechnungslauf">
		<style>
			.annual-run-panel {
				min-width: 0;
			}
			.annual-run-panel .subhead {
				margin-top: var(--space-4);
			}
			.annual-run-panel .subhead > div {
				min-width: 0;
				overflow-wrap: anywhere;
			}
			.annual-history {
				display: flex;
				flex-wrap: wrap;
				gap: var(--space-2);
			}
			.settings-links.annual-history a {
				display: flex;
				min-height: 44px;
				border: 1px solid var(--line);
				border-radius: var(--radius-sm);
				white-space: nowrap;
			}
			.annual-actions {
				display: flex;
				gap: var(--space-3);
				flex-wrap: wrap;
				align-items: center;
				margin-block: var(--space-4);
				font-size: 12px;
			}
			.annual-actions > * {
				min-width: 0;
				max-width: 100%;
			}
			.annual-actions .button {
				white-space: normal;
				text-align: center;
			}
			.annual-run-details {
				margin-block: var(--space-3);
				overflow-wrap: anywhere;
			}
			.annual-run-details summary {
				cursor: pointer;
				color: var(--gold-ink);
			}
			@media (min-width: 1051px) {
				.annual-unit-value {
					display: flex;
					align-items: center;
					min-height: 44px;
				}
				.annual-money > .annual-unit-value {
					justify-content: flex-end;
				}
			}
			.annual-units {
				width: 100%;
				margin-top: var(--space-5);
				border-collapse: collapse;
				font-size: 12px;
			}
			.annual-units caption {
				text-align: left;
				font-weight: 700;
				font-size: 18px;
				padding-block: var(--space-3);
			}
			.annual-units th,
			.annual-units td {
				padding: 6px var(--space-2);
				text-align: left;
				vertical-align: top;
			}
			.annual-units thead {
				background: var(--panel-soft);
				color: var(--muted);
			}
			.annual-unit-row {
				border-top: 1px solid var(--line);
			}
			.annual-units .annual-money {
				text-align: right;
				font-variant-numeric: tabular-nums;
			}
            .annual-party-name { display: block; }
            .annual-party-period { display: block; color: var(--muted); font-size: 11px; }
            .annual-unit-group + .annual-unit-group { border-top: 2px solid var(--line); }
            .annual-units { overflow-wrap: normal; word-break: normal; hyphens: none; }
            .annual-unit-row .annual-money .annual-unit-value { white-space: normal; }
            .annual-pdf { flex-wrap: wrap; column-gap: var(--space-3); row-gap: 0; }
			.annual-party {
				min-height: 44px;
			}
			.annual-party,
			.annual-pdf {
				display: flex;
				align-items: center;
				min-height: 44px;
			}
			.annual-pdf {
				gap: var(--space-3);
			}
			.annual-pdf a {
				display: inline-flex;
				align-items: center;
				min-height: 44px;
				color: var(--gold-ink);
				text-decoration: underline;
				text-underline-offset: 3px;
				white-space: nowrap;
			}
			.annual-cost-row[hidden] { display: none; }
			.annual-details-toggle:not([hidden]) {
				display: inline-flex;
				align-items: center;
				gap: 6px;
                white-space: nowrap;
                flex-shrink: 0;
				min-height: 44px;
				min-width: 44px;
				padding: 0 6px;
				border: 0;
				background: transparent;
				color: var(--gold-ink);
				font: inherit;
				cursor: pointer;
			}
			.annual-details-toggle[aria-expanded="true"] .disclosure-chevron svg { transform: rotate(180deg); }
			body[data-authenticated-app] .annual-details-toggle .disclosure-chevron { position: static; transform: none; flex: none; }
			.annual-details-toggle:focus-visible { outline: 2px solid var(--gold-ink); outline-offset: 2px; }
			.annual-details-cell { width: 90px; min-width: 90px; }
			.annual-costs summary[hidden] { display: none; }
			.annual-costs summary {
				cursor: pointer;
				color: var(--gold-ink);
				padding-bottom: var(--space-2);
			}
			.annual-cost-table {
				width: 100%;
				table-layout: fixed;
				border-collapse: collapse;
				margin-bottom: var(--space-2);
			}
			.annual-cost-table th,
			.annual-cost-table td {
				overflow-wrap: normal;
				padding: var(--space-3);
			}
			.annual-cost-table thead th:first-child {
				width: 34%;
			}
			.annual-cost-table tbody tr {
				border-bottom: 1px solid var(--line);
			}
			.annual-cost-table .annual-cost-amount {
				text-align: right;
				font-variant-numeric: tabular-nums;
			}
			@media (max-width: 1050px) {
				.annual-units,
				.annual-units tbody {
					display: block;
				}
				.annual-units caption {
					display: block;
				}
				.annual-units thead {
					position: absolute;
					width: 1px;
					height: 1px;
					overflow: hidden;
					clip-path: inset(50%);
					white-space: nowrap;
				}
				.annual-unit-row {
					display: grid;
					grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
					padding-top: var(--space-3);
				}
                .annual-unit-row { margin-block: var(--space-3); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: var(--space-2); background: var(--panel-soft); }
                .annual-unit-row .annual-details-cell { width: auto; grid-column: 1/-1; }
                .annual-unit-row .annual-unit-continuation, .annual-unit-row .annual-details-empty { display: none; }
                .annual-unit-row th {
					grid-column: 1/-1;
					font-size: 16px;
				}
				.annual-unit-row td {
                    min-width: 0;
                    overflow-wrap: normal;
                }
                .annual-unit-row td::before {
					content: attr(data-label);
					display: block;
					color: var(--muted);
					font-size: 11px;
					margin-bottom: var(--space-1);
				}
				.annual-units .annual-money {
					text-align: left;
				}
				.annual-unit-row .annual-parties {
                    grid-column: 1/-1;
				}
                .annual-unit-row .annual-documents { grid-column: 1/-1; }
                .annual-unit-row td[data-label="Saldo"] { grid-column: 1/-1; }
                .annual-unit-row .annual-money .annual-unit-value { white-space: nowrap; }
				.annual-cost-row,
				.annual-cost-row td,
				.annual-cost-table {
					display: block;
				}
				.annual-cost-table tbody tr {
					display: grid;
					grid-template-columns: repeat(2, minmax(0, 1fr));
					margin-bottom: var(--space-2);
					border: 1px solid var(--line);
					border-radius: var(--radius-sm);
					background: var(--panel-soft);
				}
				.annual-cost-table [data-label] {
					min-width: 0;
					text-align: left;
				}
				.annual-cost-table [data-label]::before {
					content: attr(data-label);
					display: block;
					margin-bottom: var(--space-1);
					font-size: 11px;
					font-weight: 400;
					color: var(--muted);
				}
			}
			@media (max-width: 760px) {
				.annual-cost-table tbody tr {
					grid-template-columns: minmax(0, 1fr);
				}
			}
			.annual-deliveries {
				max-width: 100%;
				min-width: 0;
				overflow-x: auto;
				margin-block: var(--space-4);
				border: 1px solid var(--line);
				border-radius: var(--radius-sm);
			}
			.annual-deliveries table {
				width: 100%;
				border-collapse: collapse;
				font-size: 12px;
			}
			.annual-deliveries caption {
				text-align: left;
				padding: var(--space-3);
				font-weight: 700;
			}
			.annual-deliveries th,
			.annual-deliveries td {
				padding: var(--space-3);
				text-align: left;
				vertical-align: top;
				border-top: 1px solid var(--line);
				overflow-wrap: anywhere;
			}
			.annual-deliveries th {
				background: var(--panel-soft);
				color: var(--muted);
			}
            .annual-run-panel .annual-lifecycle{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-4);padding:0;margin:var(--space-4) 0;list-style:none}
            .annual-run-panel .annual-lifecycle li{display:flex;flex-direction:column;align-items:flex-start;gap:var(--space-2);min-width:0;padding:var(--space-3);border:1px solid var(--line);border-radius:var(--radius-sm)}
            .annual-run-panel .annual-lifecycle form{margin:0;max-width:100%}
            .annual-run-panel .annual-lifecycle .button{white-space:normal}
            .annual-run-panel .annual-lifecycle .button:disabled{opacity:.62;cursor:not-allowed;border-color:var(--line);background:var(--panel-soft);color:var(--muted)}
            .annual-run-panel .annual-pdf .annual-download{color:var(--muted);font-size:12px}
            @media(max-width:1050px){.annual-run-panel .annual-lifecycle{grid-template-columns:1fr}}
		</style>
		<header class="workspace-head">
			<div><h2>Abrechnungslauf berechnen</h2><p>Eine Berechnung für alle Einheiten der gewählten Periode.</p></div>
			if data.Ready {
				<span class="scope personal">Bereit zur Berechnung</span>
			} else {
				<span class="scope management">Abrechnungslauf gesperrt</span>
			}
		</header>
		@SettingsFlash(data.Message, data.MessageOK)
		if !data.Approved && data.ManagementAddressMissing {
			<p class="muted" data-management-address-warning>Die Anschrift der Hausverwaltung fehlt — sie erscheint sonst nicht im Briefkopf. <a href="/app/verwaltung/einstellungen#hausverwaltung">In den Verwaltungseinstellungen ergänzen.</a>
				if data.ID != "" {
					<span> Danach einen neuen Abrechnungslauf berechnen, damit die Anschrift übernommen wird.</span>
				}
			</p>
		}
		<p>Der Lauf speichert Kostenanteile, Akontos und Salden gemeinsam mit den verwendeten Grundlagen. Er ist eine rechnerische Arbeitsfassung auf Ihren Einstellungen; eine rechtliche Prüfung nach WEG/MRG ist damit nicht verbunden.</p>
		if len(data.Issues)>0 {
			<div class="notice" role="status">
				<strong>Bitte vor der Berechnung ergänzen:</strong>
				<ul>
					for i,issue:=range data.Issues {
						<li>if i < len(data.IssueTargets) && data.IssueTargets[i] != "" {
<a href={ templ.SafeURL("#" + data.IssueTargets[i]) }>{ issue }</a>
} else {
{ issue }
}</li>
					}
				</ul>
			</div>
		}
		<form method="post" action="/app/settings/annual-statement/runs"><input type="hidden" name="year" value={ annualStatementYear(data.Year) }/><button class="button primary" type="submit" disabled?={ !data.Ready }>Für alle Einheiten berechnen</button></form>
	</section>
	{ children... }
	if len(data.History) > 0 || data.ID != "" {
	<section class="panel workspace annual-run-panel" id="abrechnungsergebnis">
		if len(data.History)>0 {
			<header class="subhead"><div><h3>Gespeicherte Läufe</h3><p>Jeder Lauf hält seinen damaligen Stand fest. Nach Korrekturen können Sie einen weiteren Lauf berechnen.</p></div></header>
			<nav class="settings-links annual-history" aria-label="Abrechnungsläufe">
				for _,run:=range data.History {
					<a href={ templ.SafeURL("/app/settings/annual-statement?year=" + annualStatementYear(data.Year) + "&run=" + url.QueryEscape(run.ID) + "#abrechnungsergebnis") } aria-current={ portalAriaCurrent(run.Selected) }><strong>{ run.Label }</strong></a>
				}
			</nav>
		}
		if data.ID!="" {
			<article data-annual-statement-run={ data.ID }>
				<header class="subhead"><div><h3>Ergebnis · Lauf { strconv.Itoa(data.Revision) }</h3><p>{ data.CreatedAt } · { data.CreatedBy }</p></div>
if data.Approved {
 <span class="scope personal">Freigegeben am { data.ApprovedAt }</span>
} else {
 <span class="scope management">Gespeicherte Arbeitsfassung</span>
}
</header>
				<details class="annual-run-details">
					<summary>Details zum Abrechnungslauf</summary>
					<p>Kennung: <code>{ data.ID }</code></p>
				</details>
				<div class="metrics"><span><strong>{ data.Total }</strong><small>Verteilte Kosten</small></span><span><strong>{ data.Excluded }</strong><small>Nicht umlagefähige Belege</small></span></div>
				if data.AllPDFURL != "" {
					<div class="annual-actions">
						<a class="button ghost" href={ templ.SafeURL(annualPDFDownloadURL(data.AllPDFURL)) } download>Alle Dokumente (PDF)</a>
 if data.AushangURL != "" {
 <a class="button ghost" href={ templ.SafeURL(annualPDFDownloadURL(data.AushangURL)) } download>Aushang (PDF)</a>
 }
					</div>
				} else {
					<p class="notice">Für alle Dokumente fehlen gespeicherte Parteien. Bitte Parteien zuordnen und einen neuen Lauf berechnen.</p>
				}
                <ol class="annual-lifecycle" aria-label="Abrechnung freigeben, ablegen und versenden">
                    <li><strong>1 · Freigabe</strong>
                        if data.Approved {
                            <p class="mini">Freigegeben am { data.ApprovedAt }</p>
                        } else if data.ApproveAction != "" {
                            <form method="post" action={ templ.SafeURL(data.ApproveAction) }><button class="button primary" type="submit">Abrechnung freigeben</button></form>
                        } else {
                            <button class="button ghost" type="button" disabled>Abrechnung freigeben</button>
                            <p class="mini">Zuerst Parteien zuordnen.</p>
                        }
                    </li>
                    <li><strong>2 · Dokumentenarchiv</strong>
                        if data.ArchivedAt != "" {
                            <p class="mini" role="status">Archiviert am { data.ArchivedAt } · { strconv.Itoa(data.ArchiveCount) } Dokumente</p>
                            <a href={ templ.SafeURL(data.ArchiveURL) }>Im Dokumentenarchiv ansehen</a>
                        } else if data.Approved && data.ArchiveAction != "" {
                            <form method="post" action={ templ.SafeURL(data.ArchiveAction) }><button class="button" type="submit">Im Archiv ablegen</button></form>
                        } else {
                            <button class="button ghost" type="button" disabled aria-describedby="annual-archive-issue">Im Archiv ablegen</button>
                            <p class="mini" id="annual-archive-issue">Zuerst den Abrechnungslauf freigeben.</p>
                        }
                    </li>
                    if data.SendAction != "" {
                        <li><strong>3 · E-Mail-Versand</strong>
                            <form method="post" action={ templ.SafeURL(data.SendAction) }><button class={ "button", templ.KV("ghost", data.SendIssue != "") } type="submit" disabled?={ data.SendIssue != "" } aria-describedby="annual-send-issue">Per E-Mail senden</button></form>
                            <p class="mini" id="annual-send-issue">
if data.SendIssue != "" {
{ data.SendIssue }
} else {
{ data.MailMode }
}
</p>
                        </li>
                    }
                </ol>
                <p class="mini">Nach „Im Archiv ablegen“ finden Sie die Abrechnungen unter Dokumente. Sichtbar nur für die Verwaltung.</p>
                if data.SendAction != "" {
                    <header class="subhead"><div><h3>Versand</h3><p>{ data.MailMode }</p></div></header>
                    <p>Jede Partei erhält ihr archiviertes PDF je Einheit. Bereits gesendete Dokumente werden übersprungen; fehlgeschlagene Sendungen werden erneut versucht.</p>
					if data.DeliverySummary != "" {
						<p role="status">{ data.DeliverySummary }</p>
					}
					if len(data.Deliveries)>0 {
						<div class="annual-deliveries">
							<table>
								<caption>Versandprotokoll</caption><thead role="rowgroup"><tr role="row"><th role="columnheader" scope="col">Partei</th><th role="columnheader" scope="col">Adresse</th><th role="columnheader" scope="col">Zeit</th><th role="columnheader" scope="col">Status</th><th role="columnheader" scope="col">Fehler</th></tr></thead>
								<tbody role="rowgroup">
									for _, delivery := range data.Deliveries {
										<tr><td>{ delivery.Party }</td><td>{ delivery.Recipient }</td><td>{ delivery.Time }</td><td>{ delivery.Status }</td><td>{ delivery.Error }</td></tr>
									}
								</tbody>
							</table>
						</div>
					}
				}
				<table class="annual-units" role="table">
					<caption>Ergebnis je Einheit</caption>
					<thead role="rowgroup"><tr role="row"><th role="columnheader" scope="col">Einheit</th><th role="columnheader" scope="col">Partei</th><th role="columnheader" scope="col" class="annual-money">Kostenanteil</th><th role="columnheader" scope="col" class="annual-money">Akonto</th><th role="columnheader" scope="col" class="annual-money">Saldo</th><th role="columnheader" scope="col">PDF / Archiv</th><th role="columnheader" scope="col"><span class="sr-only">Kostenarten</span></th></tr></thead>
                    for unitIndex,unit:=range data.Units {
                        <tbody class="annual-unit-group" role="rowgroup" aria-label={ unit.Label }>
                            for partyIndex, document := range annualStatementPartyRows(unit) {
                                <tr class="annual-unit-row" role="row">
                                    if partyIndex == 0 {
                                        <th scope="row" role="rowheader"><span class="annual-unit-value">{ unit.Label }</span></th>
                                    } else {
                                        <td role="cell" class="annual-unit-continuation"><span class="sr-only">{ unit.Label }</span></td>
                                    }
                                    <td role="cell" class="annual-parties" data-label="Partei">
                                        <span class="annual-party"><span><span class="annual-party-name">{ document.Label }</span><span class="annual-party-period">{ document.Period }</span></span></span>
                                    </td>
                                    <td role="cell" class="annual-money" data-label="Kostenanteil"><span class="annual-unit-value">{ document.Allocated }</span></td>
                                    <td role="cell" class="annual-money" data-label="Akonto"><span class="annual-unit-value">{ document.Prepaid }</span></td>
                                    <td role="cell" class="annual-money" data-label="Saldo"><strong class="annual-unit-value">{ document.Balance }</strong></td>
                                    <td role="cell" class="annual-documents" data-label="PDF / Archiv">
                                        if document.URL != "" {
                                        <div class="annual-pdf">
                                            <a href={ templ.SafeURL(document.URL) } aria-label={ "PDF für " + document.Label + " · " + unit.Label }>PDF</a>
                                            <a class="annual-download" href={ templ.SafeURL(annualPDFDownloadURL(document.URL)) } aria-label={ "Herunterladen für " + document.Label + " · " + unit.Label } download>Herunterladen</a>
                                            if document.ArchiveURL != "" {
                                                <a href={ templ.SafeURL(document.ArchiveURL) } aria-label={ "Archiv für " + document.Label + " · " + unit.Label }>Archiv</a>
                                            }
                                        </div>
                                        }
                                    </td>
                                    if partyIndex == 0 {
                                        <td role="cell" class="annual-details-cell" data-label="Kostenarten der Einheit">
                                            <button type="button" class="annual-details-toggle" aria-label={ "Details · " + unit.Label } aria-expanded="false" aria-controls={ "annual-costs-" + strconv.Itoa(unitIndex) } hidden>
                                                Details
                                                @DisclosureChevron()
                                            </button>
                                        </td>
                                    } else {
                                        <td role="cell" class="annual-details-empty"></td>
                                    }
                                </tr>
                            }
							<tr class="annual-cost-row" role="row">
								<td role="cell" colspan="7">
									<details class="annual-costs" id={ "annual-costs-" + strconv.Itoa(unitIndex) }>
										<summary>Kostenarten und Anteile<span class="sr-only"> · { unit.Label }</span>
											@DisclosureChevron()
										</summary>
										<table class="annual-cost-table" role="table" aria-label={ "Kostenarten und Anteile · " + unit.Label }>
											<thead role="rowgroup"><tr role="row"><th role="columnheader" scope="col">Kostenart</th><th role="columnheader" scope="col">Verteilerschlüssel</th><th role="columnheader" scope="col">Anteil</th><th role="columnheader" scope="col" class="annual-cost-amount">Betrag</th></tr></thead>
											<tbody role="rowgroup">
												for _,cost:=range unit.Costs {
													<tr role="row"><th role="rowheader" scope="row" data-label="Kostenart">{ cost.Name }</th><td role="cell" data-label="Verteilerschlüssel">{ cost.Key }</td><td role="cell" data-label="Anteil">{ cost.Share }</td><td role="cell" data-label="Betrag" class="annual-cost-amount"><strong>{ cost.Amount }</strong></td></tr>
												}
											</tbody>
										</table>
									</details>
								</td>
							</tr>
						</tbody>
                    }
                    <tbody role="rowgroup">
						for _, line := range data.Vacancy {
							<tr class="annual-unit-row" role="row" data-vacancy-owner>
								<th scope="row" role="rowheader"><span class="annual-unit-value">Leerstand – Eigentümeranteil</span></th>
								<td role="cell" class="annual-parties" data-label="Partei"><span class="annual-party"><span class="annual-party-name">{ line.Label }</span></span></td>
								<td role="cell" class="annual-money" data-label="Kostenanteil"><span class="annual-unit-value">{ line.Allocated }</span></td>
								<td role="cell" class="annual-money" data-label="Akonto"><span class="annual-unit-value">{ line.Prepaid }</span></td>
								<td role="cell" class="annual-money" data-label="Saldo"><strong class="annual-unit-value">{ line.Balance }</strong></td>
								<td role="cell" class="annual-documents" data-label="PDF / Archiv"></td>
								<td role="cell" class="annual-details-cell" data-label="Kostenarten"></td>
							</tr>
						}
					</tbody>
				</table>
			</article>
		}
	</section>
	}
}

// Keep an explicit attachment URL for secondary downloads and shared links.
func annualPDFDownloadURL(raw string) string {
    target, err := url.Parse(raw)
    if err != nil { return raw }
    query := target.Query()
    query.Set("download", "1")
    target.RawQuery = query.Encode()
    return target.String()
}

// Older runs can predate saved recipients. Keep their unit amounts visible.
func annualStatementPartyRows(unit AnnualStatementRunUnitView) []AnnualStatementRunPDFView {
    if len(unit.PDFs) > 0 { return unit.PDFs }
    return []AnnualStatementRunPDFView{{Label: "Keine Partei zugeordnet", Allocated: unit.Allocated, Prepaid: unit.Prepaid, Balance: unit.Balance}}
}
