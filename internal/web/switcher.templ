package web

import "fmt"

// ScopeContext is shared by both shells. Entries are bounded before rendering;
// the complete authorised directory stays on the server.
type ScopeContext struct {
	Ready bool
	CanUseSettings bool
	DisplayName, Initials, AvatarURL, Role string
	Segments []string
	Switcher LiegenschaftSwitcherData
	SupportView *SupportViewData
	SupportURL string
	Preview *RolePreviewState
	PreviewChoices []RolePreviewChoice
}

type LiegenschaftEntry struct {
	Key string `json:"key"`
	Tenant string `json:"tenant"`
	Name string `json:"name"`
	Address string `json:"address"`
	Role string `json:"role"`
	Group string `json:"group"`
	Open int `json:"open"`
	Current bool `json:"current"`
}

type LiegenschaftSwitcherData struct {
	StorageKey, SearchURL, PortfolioURL string
	Count int
	Current *LiegenschaftEntry
	Entries []LiegenschaftEntry
}

// Each surface uses the same disclosure and bounded panel, including every
// breadcrumb. Native details and the GET form also work without JavaScript.
templ LiegenschaftSwitcher(data LiegenschaftSwitcherData, id, label, place, surface, eyebrow, icon string) {
	<details class="liegenschaft-switcher house-picker" id={ id } data-switcher data-house-picker data-house-picker-shell={ surface } data-search-url={ data.SearchURL } data-storage-key={ data.StorageKey }>
		<summary class="house-header-card" aria-label={ switcherSummaryLabel(surface, label) } title={ label }>
			if !switcherIsScope(surface) {
				<span class="house-header-eyebrow">{ eyebrow }</span>
				<span class="nav-icon switcher-building">@PortalAssetIcon(icon)</span>
			}
   if switcherIsScope(surface) {
    <span class="context-house-icon nav-icon" aria-hidden="true">@PortalAssetIcon("house")</span>
   }
			<span class={ "house-header-copy", templ.KV("side-address-label", !switcherIsScope(surface)) } lang="de-AT"><strong>{ label }</strong><small>{ place }</small></span>
			@DisclosureChevron()
		</summary>
		<div class="switcher-panel" role="group" aria-label="Liegenschaft wechseln">
			<template data-switcher-forward-icon>@PortalAssetIcon("chevron-right")</template><template data-switcher-check-icon>@PortalAssetIcon("check")</template>
			<header class="switcher-heading"><h2>Liegenschaft wechseln</h2><span>{ switcherCountLabel(data.Count) }</span></header>
			if data.Current != nil {
				<section aria-label="Aktueller Kontext" data-switcher-current={ data.Current.Key }>
					<p class="switcher-label">Aktuell</p>
					@LiegenschaftRow(*data.Current)
				</section>
			}
			<form method="get" action={ templ.SafeURL(data.SearchURL) } class="switcher-search">
				<label for={ id + "-search" }>Liegenschaft suchen</label>
				<div><input id={ id + "-search" } type="search" name="q" placeholder="Name, Adresse, Ort, Kennzeichen" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls={ id + "-results" } data-switcher-search/><button type="submit">Suchen</button></div>
			</form>
			<p class="switcher-status" role="status" aria-live="polite" data-switcher-status></p>
			<div id={ id + "-results" } role="listbox" aria-label="Suchtreffer" data-switcher-results></div>
			<section hidden data-switcher-recent-section><p class="switcher-label">Zuletzt geöffnet</p><div data-switcher-recent></div></section>
			<div data-switcher-initial>
				@LiegenschaftGroups(data.Entries)
			</div>
			<p class="switcher-explanation">Verwaltung: verwaltete Liegenschaften. Persönlich: eigene Rollen und private Home-Portale. Ein Wechsel öffnet das Portal in der angegebenen Rolle.</p>
			<a class="switcher-portfolio" href={ templ.SafeURL(data.PortfolioURL) }>{ fmt.Sprintf("Alle Liegenschaften (%d)", data.Count) } <span aria-hidden="true">→</span></a>
			<p class="switcher-hints">↑↓ navigieren · ↵ auswählen · Esc schließen</p>
		</div>
	</details>
}

templ LiegenschaftGroups(entries []LiegenschaftEntry) {
	for _, group := range []string{"Verwaltung", "Persönlich"} {
		if switcherHasGroup(entries, group) {
			<section aria-label={ group }><p class="switcher-label">{ group }</p>
				for _, entry := range entries {
					if entry.Group == group {
						@LiegenschaftRow(entry)
					}
				}
			</section>
		}
	}
}

func switcherHasGroup(entries []LiegenschaftEntry, group string) bool {
	for _, entry := range entries { if entry.Group == group { return true } }
	return false
}

templ LiegenschaftRow(entry LiegenschaftEntry) {
	<form class={ "switcher-row", templ.KV("current", entry.Current) } method="post" action="/app/context" data-switcher-entry={ entry.Key }>
		<input type="hidden" name="tenant" value={ entry.Tenant }/><input type="hidden" name="role" value={ entry.Role }/>
		<button type="submit" disabled?={ entry.Current }>
			<span class="switcher-row-copy"><strong title={ entry.Name }>{ entry.Name }</strong><small>{ entry.Address }</small><small>{ entry.Group } · { entry.Role }</small></span>
			<span class="switcher-row-badge">{ fmt.Sprintf("%d offen", entry.Open) }</span>
			if entry.Current {
				<span class="switcher-row-mark nav-icon is-current" aria-label="aktuell" title="aktuell">@PortalAssetIcon("check")</span>
			} else {
				<span class="switcher-row-mark nav-icon" aria-hidden="true">@PortalAssetIcon("chevron-right")</span>
			}
		</button>
	</form>
}

// One DOM header is shared by desktop, mobile, role preview and support.
templ Kontextleiste(data ScopeContext, mobile bool, navigation templ.Component) {
 <header class="context-bar unified-context-bar" data-context-bar>
  @ContextAccount(data, "context", false)
  <div class="context-scope" aria-label="Aktuelle Liegenschaft">
   @LiegenschaftSwitcher(data.Switcher, "context-property", scopePropertyLabel(data), scopePropertyAddress(data), "scope", "", "house")
  </div>
  <div class="context-view-slot">@ContextPreview(data, "context")</div>
  if navigation != nil {
   <details class="menu context-navigation"><summary aria-label="Navigation öffnen"><span class="hamburger" aria-hidden="true"></span></summary><div class="menu-panel" data-navigation-surface="mobile">@navigation</div></details>
  }
 </header>
}

templ ContextAccount(data ScopeContext, id string, mobile bool) {
 <details class="context-account" data-context-account>
  <summary aria-label={ "Konto von " + data.DisplayName }><span class="avatar" aria-hidden="true">@PortalAvatarBadge(data.AvatarURL, data.Initials)</span><span class="context-person" title={ data.DisplayName }>{ data.DisplayName }</span><span class="context-role">{ data.Role }</span></summary>
  <div class="context-account-menu">
   <strong>{ data.DisplayName }</strong><small>{ data.Role }</small>
   if data.CanUseSettings {
    <a href="/app/settings/profile">Profil</a><a href="/app/settings">Einstellungen</a>
   }
   <form method="post" action="/auth/logout"><button type="submit"><span class="nav-icon">@PortalIcon("logout")</span> Abmelden</button></form>
  </div>
 </details>
}

templ ContextPreview(data ScopeContext, id string) {
 if data.SupportView != nil {
  @SupportViewBanner(*data.SupportView)
 } else if data.Preview != nil {
  <div class="context-view" data-preview-role={ data.Preview.RoleLabel } aria-label="Aktive Rollenansicht">
   <div class="context-view-copy"><strong title={ "Vorschau: " + data.Preview.RoleLabel + "-Sicht" }>Vorschau: { data.Preview.RoleLabel }-Sicht</strong><span><span class="nav-icon" aria-hidden="true">@PortalAssetIcon("lock")</span> Schreibgeschützt · endet in { data.Preview.EndsInMinutes } Min</span></div>
   <form method="post" action={ templ.SafeURL(data.Preview.EndPath) }><button class="context-action" type="submit">Ansicht verlassen</button></form>
  </div>
 } else if len(data.PreviewChoices) > 0 {
  @RolePreviewChooser(id + "-preview", data.PreviewChoices, data.SupportURL) {
   <span class="context-action">Ansicht als …</span>
  }
 }
}

templ SidebarResizeHandle() {
	<div class="sidebar-resize" role="separator" aria-label="Sidebar-Breite" aria-orientation="vertical" aria-valuemin="240" aria-valuemax="420" aria-valuenow="280" tabindex="0" title="Ziehen oder Pfeiltasten · Doppelklick: Standard" data-sidebar-resize></div>
}

templ LiegenschaftenPage(portal PortalPageData, entries []LiegenschaftEntry, query, previous, next string, total, page int) {
	@PortalDocument("Meine Liegenschaften", portalAssetVersion(), nil, PortalStyles(), templ.Attributes{"data-templ-liegenschaften":true}) {
		@PortalShell(portal, "Liegenschaften", liegenschaftenBody(entries, query, previous, next, total, page))
	}
}

templ liegenschaftenBody(entries []LiegenschaftEntry, query, previous, next string, total, page int) {
	<main id="main-content" class="portal-section-landing" tabindex="-1" data-skip-target>
		@PortalSectionHeader(PortalSectionIdentityData{Label:"Liegenschaften", Icon:"building"}, PortalSectionTitle("Meine Liegenschaften"), nil, nil)
		<div class="portal-section-content">
			<form class="switcher-search" method="get"><label for="directory-q">Liegenschaft suchen</label><div><input id="directory-q" name="q" type="search" value={ query } placeholder="Name, Adresse, Ort, Kennzeichen"/><button type="submit">Suchen</button></div></form>
			<p>{ fmt.Sprintf("%d Kontexte · Seite %d", total, page) }</p>
			@LiegenschaftGroups(entries)
			<nav class="portfolio-pagination" aria-label="Ergebnisseiten">
				if previous != "" {
					<a href={ templ.SafeURL(previous) }>← Zurück</a>
				}
				if next != "" {
					<a href={ templ.SafeURL(next) }>Weiter →</a>
				}
			</nav>
		</div>
	</main>
}
