package web

import "strconv"

// OnboardingPageData carries the five-step home setup wizard. The legacy
// template read a map that never contained IsActiveMode, IsShadowMode or
// Tariff, so its energy mode strip always rendered the observing state. The
// typed page keeps that contract: setup never claims the house is switching
// anything, and the only control offered is the same deliberate test run.
type OnboardingPageData struct {
	Portal PortalPageData

	Step         int
	Progress     int
	ProfileReset bool

	HouseholdName       string
	HomeType            string
	HomeTypeLabel       string
	HomeTypeDescription string
	HomeTypeLocked      bool

	HasHomeUnit    bool
	HomeUnitID     string
	HomeUnitLabel  string
	HasUnitOptions bool
	UnitOptions    []OnboardingUnitOption

	AssetOptions []OnboardingAssetOption

	MappingSlots        []OnboardingMappingSlot
	MappingAssetOptions []OnboardingOption

	ConnectorMessage     string
	Candidates           []OnboardingCandidate
	HasCandidates        bool
	RecommendedCount     int
	AdditionalCandidates []OnboardingCandidate
	HasAdditional        bool

	FinishRecommendation OnboardingRecommendation

	CanControlEnergy bool
}

type OnboardingUnitOption struct {
	Value    string
	Label    string
	Selected bool
}

type OnboardingAssetOption struct {
	Kind    string
	Label   string
	Checked bool
}

type OnboardingOption struct {
	Value string
	Label string
}

type OnboardingMappingSlot struct {
	Key     string
	Label   string
	Purpose string
	Status  string
	Detail  string
	Tone    string
}

type OnboardingCandidate struct {
	EntityID    string
	DisplayName string
	SourceName  string
	MetricLabel string
	Checked     bool
}

type OnboardingRecommendation struct {
	Title  string
	Reason string
}

templ OnboardingPage(data OnboardingPageData) {
	@PortalDocument(data.Portal.Title, portalAssetVersion(), nil, OnboardingStyles(), templ.Attributes{"data-templ-onboarding": true}) {
		@PortalShell(data.Portal, "Einrichtung", OnboardingContent(data))
	}
}

templ OnboardingContent(data OnboardingPageData) {
	<main class="onboarding-main" id="main-content" tabindex="-1">
		@OnboardingModeStrip(data)
		<div class="onboarding-page">
			if data.ProfileReset {
				<div class="onboarding-notice"><strong>Das Energieprofil wurde gelöscht.</strong> Hausname, Anlagen, Zuordnungen, Messverlauf und Auswertungen sind entfernt. Unabhängige Anliegen und das Sicherheitsprotokoll bleiben nach ihren eigenen Fristen bestehen.</div>
			}
			<div class="onboarding-progress" aria-label="Einrichtungsfortschritt">
				<div class="onboarding-progress-head"><span>Einrichtung Ihres Zuhauses</span><span>Schritt { data.Step } von 5</span></div>
				<div class="onboarding-progress-track"><span style={ onboardingProgressStyle(data.Progress) }></span></div>
			</div>
			<section class="onboarding-card">
				switch data.Step {
					case 1:
						@OnboardingStepIntro()
					case 2:
						@OnboardingStepIdentity(data)
					case 3:
						@OnboardingStepAssets(data)
					case 4:
						@OnboardingStepMappings(data)
					default:
						@OnboardingStepFinish(data)
				}
			</section>
		</div>
	</main>
}

// OnboardingModeStrip mirrors the legacy energyModeStrip for this route. The
// onboarding handler never passes an operating mode, so the observing state is
// the whole contract here; the test run stays behind the same capability gate.
templ OnboardingModeStrip(data OnboardingPageData) {
	<section class="energy-mode-strip" aria-label="Energiemodus">
		<div class="energy-mode-state">
			<span class="energy-mode-icon" aria-hidden="true">@OnboardingGlyph("check")</span>
			<div class="energy-mode-copy">
				<strong>Nur beobachten</strong>
				<span title="HAUSV liest und empfiehlt, steuert aber kein Gerät.">Keine Steuerung</span>
			</div>
		</div>
		if data.CanControlEnergy {
			<details class="energy-mode-control">
				<summary class="energy-mode-action" aria-label="Wirkungslosen Testlauf bewusst starten" title="Wirkungslosen Testlauf bewusst starten"><span aria-hidden="true">@OnboardingGlyph("play")</span><span class="energy-mode-action-full">Testlauf</span><span class="energy-mode-action-compact" aria-hidden="true">Testlauf</span></summary>
				<form class="energy-mode-popover" method="post" action="/app/energie/mode">
					<h3>Wirkungslosen Testlauf starten?</h3>
					<p>HAUSV protokolliert nur, welche Entscheidungen seine Regeln treffen würden. Es wird kein Gerät geschaltet. Aktive Steuerung ist erst nach einer späteren, gerätespezifischen Freigabe möglich.</p>
					<label><input type="checkbox" name="confirm" value="yes" required/><span>Ich bin Eigentümer oder Hausadministrator und möchte diesen wirkungslosen Testlauf für diese Liegenschaft bewusst starten.</span></label>
					<label><span>Zur Bestätigung <strong>TESTLAUF</strong> eingeben</span></label>
					<input type="text" name="confirmation_text" autocomplete="off" placeholder="TESTLAUF" required/>
					<input type="hidden" name="mode" value="active"/>
					<button class="button primary" type="submit">Testlauf starten</button>
				</form>
			</details>
		} else {
			<span class="energy-mode-capability">Freigabe nur für Eigentümer oder Hausadministration</span>
		}
	</section>
}

templ OnboardingStepIntro() {
	<header class="onboarding-card-head">
		<span class="eyebrow">Ganz ohne Technikstress</span>
		<h1>Womit möchten Sie beginnen? Mit Ihrem Zuhause.</h1>
		<p>Wir lernen zuerst kennen, was schon da ist. PV, Batterie oder Home Assistant sind keine Voraussetzung.</p>
	</header>
	<form class="onboarding-body" method="post" action="/app/zuhause/onboarding">
		<div class="onboarding-explain">
			<article><strong>1 · Verstehen</strong><p>Welche großen Verbraucher gibt es und was lässt sich zeitlich verschieben?</p></article>
			<article><strong>2 · Messen</strong><p>Bestehende Messwerte lesen. Home Assistant ist hilfreich, aber keine Voraussetzung.</p></article>
			<article><strong>3 · Verbessern</strong><p>HAUSV zeigt kleine, nachvollziehbare Schritte. Sie behalten die Kontrolle.</p></article>
		</div>
		<div class="onboarding-trust"><span aria-hidden="true">✓</span><div><strong>Standard bleibt „Nur beobachten“</strong><p>Während der gesamten Einrichtung wird nichts geschaltet. Eine spätere Freigabe ist separat, dauerhaft sichtbar und nur für Eigentümer oder Hausadministration möglich.</p></div></div>
		<div class="onboarding-actions"><a class="button" href="/app">Später</a><button class="button primary" type="submit" name="action" value="understand">Verstanden, weiter</button></div>
	</form>
}

templ OnboardingStepIdentity(data OnboardingPageData) {
	<header class="onboarding-card-head"><span class="eyebrow">Ihr Zuhause</span><h1>Was richten wir gemeinsam ein?</h1><p>Ein Name und die Art des Zuhauses genügen. Technische Details kommen erst, wenn sie wirklich helfen.</p></header>
	<form class="onboarding-body onboarding-form" method="post" action="/app/zuhause/onboarding">
		<label><span>Anzeigename für „Mein Zuhause“</span><input type="text" name="household_name" value={ data.HouseholdName } placeholder="z. B. Dachwohnung oder Mein Zuhause" required maxlength="100"/></label>
		if data.HomeTypeLocked {
			<div class="home-identity-field"><span>Art</span><input type="hidden" name="home_type" value={ data.HomeType }/><div class="home-identity-readonly"><strong>{ data.HomeTypeLabel }</strong><small>Durch die zugeordnete Wohneinheit festgelegt</small></div></div>
		} else {
			<label><span>Art</span><select name="home_type" data-home-type-select aria-describedby="home-type-explanation">
				<option value="apartment" data-label="Wohnung" data-description="Ein einzelner Haushalt in einem Mehrparteienhaus. Der Überblick konzentriert sich auf Ihre Wohnung und Ihre eigenen Geräte." selected?={ data.HomeType == "apartment" }>Wohnung</option>
				<option value="house" data-label="Einfamilienhaus" data-description="Ein Haushalt mit eigenem Gebäude. Haus-, Heiz- und Energietechnik können gemeinsam betrachtet werden." selected?={ data.HomeType == "house" }>Einfamilienhaus</option>
				<option value="community" data-label="Hausgemeinschaft" data-description="Mehrere Parteien und gemeinsam genutzte Anlagen. Der Überblick richtet sich an Eigentümergemeinschaft oder Hausverwaltung." selected?={ data.HomeType == "community" }>Hausgemeinschaft</option>
			</select></label>
		}
		if data.HasHomeUnit {
			<div class="home-identity-field"><span>Zugeordnete offizielle Wohnung</span><input type="hidden" name="unit_id" value={ data.HomeUnitID }/><div class="home-identity-readonly"><strong>{ data.HomeUnitLabel }</strong><small>Diesem Hausprofil zugeordnet</small></div><small class="home-identity-field-help">Die Sichtbarkeit folgt dieser Wohnung; technische Freigaben bleiben separat.</small></div>
		} else if data.HasUnitOptions {
			<div class="home-identity-field" data-home-unit-field><label><span>Zugeordnete offizielle Wohnung</span><select name="unit_id" required aria-describedby="home-onboarding-unit-help">
				for _, option := range data.UnitOptions {
					<option value={ option.Value } selected?={ option.Selected }>{ option.Label }</option>
				}
			</select></label><small class="home-identity-field-help" id="home-onboarding-unit-help">Die Auswahl legt fest, welche Wohnung den Überblick sieht. Technische Freigaben bleiben separat.</small></div>
		} else {
			<input type="hidden" name="unit_id" value=""/>
		}
		<div class="home-type-explanation" id="home-type-explanation" data-home-type-explanation role="status" aria-live="polite">
			<span class="home-type-explanation-icon" aria-hidden="true">⌂</span>
			<div>
				<strong data-home-type-label>{ onboardingHomeTypeLabel(data.HomeType) }</strong>
				<p data-home-type-copy>{ data.HomeTypeDescription }</p>
				<small>{ onboardingHomeTypeHint(data.HomeTypeLocked) } „Nur beobachten“ bleibt unverändert.</small>
			</div>
		</div>
		<div class="onboarding-actions"><button class="button" type="submit" name="action" value="back">Zurück</button><button class="button primary" type="submit" name="action" value="profile">Weiter zu den Verbrauchern</button></div>
	</form>
}

templ OnboardingStepAssets(data OnboardingPageData) {
	<header class="onboarding-card-head"><span class="eyebrow">Bestandsaufnahme</span><h1>Was gibt es bereits?</h1><p>Wählen Sie nur, was Sie sicher wissen. Fehlende Details können jederzeit ergänzt werden.</p></header>
	<form class="onboarding-body onboarding-form" method="post" action="/app/zuhause/onboarding">
		<fieldset><legend class="onboarding-legend">Anlagen und größere Verbraucher</legend>
			<div class="onboarding-choice-grid">
				for _, option := range data.AssetOptions {
					<label class="onboarding-choice"><input type="checkbox" name="assets" value={ option.Kind } checked?={ option.Checked }/><span><strong>{ option.Label }</strong><small>Vorhanden oder regelmäßig genutzt</small></span></label>
				}
			</div>
		</fieldset>
		<div class="onboarding-actions"><button class="button" type="submit" name="action" value="back">Zurück</button><button class="button primary" type="submit" name="action" value="assets">Weiter zu den Messwerten</button></div>
	</form>
}

templ OnboardingStepMappings(data OnboardingPageData) {
	<header class="onboarding-card-head"><span class="eyebrow">Datenquelle</span><h1>Wie kommen Messwerte herein?</h1><p>{ data.ConnectorMessage }</p></header>
	<form class="onboarding-body onboarding-form" method="post" action="/app/zuhause/onboarding">
		<section class="energy-mapping-guide" aria-labelledby="energy-mapping-guide-title">
			<header><div><span class="onboarding-legend">Messwert-Setup</span><h2 id="energy-mapping-guide-title">Was bedeutet welcher Wert?</h2></div><small>Alles bleibt nur gelesen.</small></header>
			<div class="energy-mapping-slots">
				for _, slot := range data.MappingSlots {
					<article class={ "energy-mapping-slot", slot.Tone } data-mapping-slot={ slot.Key }>
						<div><strong>{ slot.Label }</strong><span>{ slot.Purpose }</span></div>
						<p><b>{ slot.Status }</b><small>{ slot.Detail }</small></p>
					</article>
				}
			</div>
		</section>
		if data.HasCandidates {
			<fieldset class="onboarding-recommended"><legend class="onboarding-legend">Empfohlen</legend><div class="onboarding-candidates">
				for _, candidate := range data.Candidates {
					<label class="onboarding-candidate"><input type="checkbox" name="entities" value={ candidate.EntityID } checked?={ candidate.Checked }/><span><strong>{ candidate.DisplayName }</strong><small>{ candidate.SourceName }</small></span><span class="onboarding-readonly">Nur lesen</span></label>
				}
			</div></fieldset>
		} else {
			<div class="onboarding-trust"><span aria-hidden="true">i</span><div><strong>Ohne Verbindung fortfahren</strong><p>Sie können das Haus-Cockpit bereits nutzen und Home Assistant später ergänzen. Es werden keine Zugangsdaten im Portal angezeigt oder gespeichert.</p></div></div>
		}
		if data.HasAdditional {
			<details class="onboarding-disclosure onboarding-additional"><summary>Weitere technische Treffer anzeigen <span>{ len(data.AdditionalCandidates) } optional</span></summary><div class="onboarding-candidates">
				for _, candidate := range data.AdditionalCandidates {
					<label class="onboarding-candidate"><input type="checkbox" name="entities" value={ candidate.EntityID } checked?={ candidate.Checked }/><span><strong>{ candidate.MetricLabel }</strong><small>{ candidate.SourceName }</small><code>{ candidate.EntityID }</code></span><span class="onboarding-readonly">Nur lesen</span></label>
				}
			</div></details>
		}
		<details class="onboarding-disclosure"><summary>Messwert selbst zuordnen <span>nur falls nötig</span></summary><div class="optional-grid">
			<label><span>Sensor-ID</span><input type="text" name="manual_entity_id" placeholder="sensor.netzbezug"/></label>
			<label><span>Bedeutung</span><select name="manual_metric"><option value="grid-import-power">Netzbezug Leistung</option><option value="grid-import-energy">Netzbezug Energie</option><option value="grid-export-power">Netzeinspeisung</option><option value="pv-power">PV-Leistung</option><option value="battery-power">Batterie-Nettoleistung</option><option value="battery-charge-power">Batterie-Ladeleistung</option><option value="battery-discharge-power">Batterie-Entladeleistung</option><option value="battery-soc">Batterie-Ladestand</option><option value="load-power">Hausverbrauch</option></select></label>
			<label><span>Verständlicher Name</span><input type="text" name="manual_name" placeholder="Netzbezug gesamt"/></label>
			<label><span>Einheit</span><input type="text" name="manual_unit" placeholder="W oder kW"/></label>
			<label><span>Gehört zu</span><select name="manual_asset_id"><option value="">Gesamtes Haus</option>
				for _, option := range data.MappingAssetOptions {
					<option value={ option.Value }>{ option.Label }</option>
				}
			</select></label>
		</div></details>
		<div class="onboarding-actions"><button class="button" type="submit" name="action" value="back">Zurück</button>
			if data.HasCandidates {
				<button class="button ghost onboarding-skip" type="submit" name="action" value="skip-mappings">Ohne Verbindung starten</button><button class="button primary" type="submit" name="action" value="mappings">{ data.RecommendedCount } Messwerte übernehmen</button>
			} else {
				<button class="button primary" type="submit" name="action" value="skip-mappings">Ohne Verbindung starten</button>
			}
		</div>
	</form>
}

templ OnboardingStepFinish(data OnboardingPageData) {
	<header class="onboarding-card-head" data-home-identity="onboarding-summary" { onboardingSummaryLabel(data)... }><span class="eyebrow">Ihr Zuhause ist startklar</span><h1 data-home-display-name>{ data.HouseholdName }</h1>
		if data.HasHomeUnit {
			<span class="onboarding-home-unit" data-home-unit-label>{ data.HomeUnitLabel }</span>
		}
		<p>Alles bleibt im sicheren Beobachtungsmodus. Sie gehen in Ihrem Tempo weiter.</p>
	</header>
	<form class="onboarding-body" method="post" action="/app/zuhause/onboarding">
		<div class="onboarding-trust"><span aria-hidden="true">→</span><div><strong>Als Nächstes: { data.FinishRecommendation.Title }</strong><p>{ data.FinishRecommendation.Reason }</p></div></div>
		<div class="onboarding-trust"><span aria-hidden="true">✓</span><div><strong>Zwölf Monate voller Produktumfang kostenlos</strong><p>Danach gilt nach heutigem Modell: 1 € pro Monat, jährlich als 12 € verrechnet. Noch gibt es keine Zahlung und keine versteckte Einschränkung.</p></div></div>
		<div class="onboarding-actions"><button class="button" type="submit" name="action" value="back">Noch einmal prüfen</button><button class="button primary" type="submit" name="action" value="finish">Mein Zuhause öffnen</button></div>
	</form>
}

templ OnboardingGlyph(kind string) {
	<svg viewBox="0 0 24 24" aria-hidden="true">
		switch kind {
			case "play":
				<path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"></path>
			default:
				<path d="M20 6 9 17l-5-5"></path>
		}
	</svg>
}

func onboardingProgressStyle(progress int) string {
	if progress < 0 {
		progress = 0
	}
	if progress > 100 {
		progress = 100
	}
	return "width:" + strconv.Itoa(progress) + "%"
}

func onboardingHomeTypeLabel(homeType string) string {
	switch homeType {
	case "house":
		return "Einfamilienhaus"
	case "community":
		return "Hausgemeinschaft"
	default:
		return "Wohnung"
	}
}

func onboardingHomeTypeHint(locked bool) string {
	if locked {
		return "Die Art ist mit der Wohnung verbunden."
	}
	return "Die Auswahl kann Geltungsbereich und Sichtbarkeit ändern."
}

// onboardingSummaryLabel keeps the summary heading announced as one unit when a
// friendly name and an official unit label sit next to each other.
func onboardingSummaryLabel(data OnboardingPageData) templ.Attributes {
	if !data.HasHomeUnit {
		return templ.Attributes{}
	}
	return templ.Attributes{"aria-label": data.HouseholdName + ", offizielle Einheit " + data.HomeUnitLabel}
}

templ OnboardingStyles() {
	<style>.energy-mode-strip,.energy-page,.onboarding-page,.energy-data-page,.home-identity-page{--soft:#716d62;--gold-ink:#705c22;--energy-focus-ring:#ad862c}
		a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:2px solid var(--gold-light);outline-offset:2px}h1,h2,h3,p{margin:0}h1,h2,h3{font-family:var(--font-serif);font-weight:600}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.nav-icon svg{display:block;width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.onboarding-main{min-width:0;display:flex;flex-direction:column}.button.primary{background:var(--gold);color:var(--panel);border-color:var(--gold)}.button.ghost{border-color:var(--line);color:var(--muted)}
		.energy-mode-strip{position:sticky;z-index:40;top:0;min-height:60px;display:flex;align-items:center;gap:var(--space-3);padding:var(--space-2) clamp(var(--space-5),4vw,40px);background:var(--panel);border-bottom:1px solid var(--line);box-shadow:var(--shadow-panel)}.energy-mode-state{min-height:46px;display:inline-flex;align-items:center;gap:var(--space-3);padding:var(--space-2) var(--space-5) var(--space-2) var(--space-2);border:1px solid var(--line);border-radius:var(--radius-md);background:var(--panel-soft)}.energy-mode-icon{width:34px;height:34px;display:grid;place-items:center;border-radius:var(--radius-pill);background:rgba(47,107,74,.11);color:var(--leaf)}.energy-mode-icon svg,.energy-mode-action svg{display:block;width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.energy-mode-copy{min-width:0;display:grid;gap:2px}.energy-mode-copy strong{font-family:var(--font-serif);font-size:18px;line-height:1.05}.energy-mode-copy span{color:var(--muted);font-size:12px;line-height:1.3}.energy-mode-control{position:relative;margin-left:auto}.energy-mode-control>summary{list-style:none}.energy-mode-control>summary::-webkit-details-marker{display:none}.energy-mode-action{min-height:44px;display:inline-flex;align-items:center;gap:var(--space-2);padding:var(--space-2) var(--space-3);border:1px solid var(--line);border-radius:var(--radius-xs);background:var(--panel);color:var(--ink);font-size:12px;font-weight:800;line-height:1.2;cursor:pointer}.energy-mode-action:hover{border-color:var(--gold)}.energy-mode-action-compact{display:none}.energy-mode-capability{margin-left:auto;max-width:220px;color:var(--muted);font-size:12px;font-weight:750;line-height:1.3;text-align:right}.energy-mode-popover{position:absolute;z-index:2;right:0;top:calc(100% + 10px);width:min(410px,calc(100vw - 32px));max-height:calc(100dvh - 86px);display:grid;gap:var(--space-4);overflow:auto;padding:var(--space-5);border:1px solid var(--line);border-radius:var(--radius-md);background:var(--panel);color:var(--ink);box-shadow:var(--shadow-dialog)}.energy-mode-popover h3{font-size:19px}.energy-mode-popover p{color:var(--muted);font-size:14px;line-height:1.45}.energy-mode-popover label{display:grid;grid-template-columns:auto minmax(0,1fr);gap:9px;align-items:start;font-size:13px;line-height:1.4}.energy-mode-popover input[type="text"]{width:100%;min-height:44px;padding:9px 11px;border:1px solid var(--line);border-radius:var(--radius-xs);background:var(--panel);color:var(--ink)}
		.onboarding-page{width:min(940px,100%);margin:0 auto;padding:28px clamp(var(--space-4),4vw,44px) 64px;display:grid;align-content:start;gap:18px}.onboarding-notice{padding:var(--space-4);border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel-soft);color:var(--muted);font-size:13px;line-height:1.5}.onboarding-notice strong{color:var(--ink)}
		.onboarding-progress{display:grid;gap:var(--space-2)}.onboarding-progress-head{display:flex;justify-content:space-between;gap:var(--space-3);color:var(--muted);font-size:12px;font-weight:750}.onboarding-progress-track{height:5px;overflow:hidden;border-radius:var(--radius-pill);background:var(--line)}.onboarding-progress-track span{display:block;height:100%;background:var(--gold)}
		.onboarding-card{overflow:hidden;border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--panel);box-shadow:var(--shadow-md)}.onboarding-card-head{display:grid;gap:9px;padding:clamp(var(--space-6),4vw,38px);border-bottom:1px solid var(--line)}.onboarding-card-head h1{font-size:clamp(34px,5vw,50px);line-height:1.02}.onboarding-card-head p{max-width:660px;color:var(--muted);font-size:14px;line-height:1.55}.eyebrow{color:var(--gold-ink);font-size:10px;font-weight:900;letter-spacing:.11em;text-transform:uppercase}.onboarding-home-unit{margin-top:-4px;color:var(--muted);font-size:13px;font-weight:650;line-height:1.35}
		.onboarding-body{display:grid;gap:22px;padding:clamp(var(--space-6),4vw,38px)}.onboarding-explain{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-3)}.onboarding-explain article{min-height:142px;padding:18px;border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel-soft)}.onboarding-explain strong{display:block;margin-bottom:var(--space-2);font-size:15px}.onboarding-explain p{color:var(--muted);font-size:13px;line-height:1.45}
		.onboarding-form{gap:18px}.onboarding-form label>span,.onboarding-legend,.onboarding-form .home-identity-field>span,.onboarding-form .home-identity-field>label>span{display:block;margin-bottom:7px;color:var(--gold-ink);font-size:11px;font-weight:850;letter-spacing:.09em;text-transform:uppercase}.onboarding-form input[type="text"],.onboarding-form select{width:100%;min-height:48px;padding:10px var(--space-3);border:1px solid var(--line);border-radius:var(--radius-xs);background:var(--panel);color:var(--ink)}.onboarding-form fieldset{margin:0;padding:0;border:0}
		.home-type-explanation{display:grid;grid-template-columns:36px minmax(0,1fr);gap:var(--space-3);align-items:start;margin-top:-6px;padding:13px var(--space-4);border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel-soft);color:var(--ink)}.home-type-explanation-icon{width:34px;height:34px;display:grid;place-items:center;border-radius:var(--radius-pill);background:rgba(47,107,74,.11);color:var(--leaf);font-size:18px;line-height:1}.home-type-explanation strong{display:block;font-size:14px;line-height:1.3}.home-type-explanation p{margin-top:3px;color:var(--muted);font-size:13px;line-height:1.45}.home-type-explanation small{display:block;margin-top:6px;color:var(--soft);font-size:12px;line-height:1.4}
		.onboarding-form .home-identity-readonly{min-height:50px;display:flex;align-items:center;justify-content:space-between;gap:var(--space-3);padding:var(--space-3) var(--space-4);border:1px solid var(--line);border-radius:var(--radius-xs);background:var(--panel-soft)}.onboarding-form .home-identity-readonly small{color:var(--muted);font-size:12px}.onboarding-form .home-identity-field-help{display:block;margin-top:6px;color:var(--muted);font-size:12px;font-weight:600;line-height:1.45;letter-spacing:normal;text-transform:none}
		.onboarding-choice-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.onboarding-choice{min-height:64px;display:grid;grid-template-columns:auto minmax(0,1fr);gap:10px;align-items:center;padding:var(--space-3) var(--space-4);border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel);cursor:pointer}.onboarding-choice:has(input:checked){border-color:var(--gold);background:rgba(200,153,63,.12)}.onboarding-choice small{display:block;margin-top:2px;color:var(--muted);font-size:11px}
		.onboarding-recommended{display:grid;gap:10px}.onboarding-recommended .onboarding-legend{margin-bottom:0}.onboarding-candidates{display:grid;gap:var(--space-2)}.onboarding-candidate{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:var(--space-3);align-items:center;padding:var(--space-3) var(--space-4);border:1px solid var(--line);border-radius:var(--radius-xs);background:var(--panel)}.onboarding-candidate:has(input:checked){border-color:var(--leaf);background:rgba(47,107,74,.08)}.onboarding-candidate strong{display:block;font-size:14px}.onboarding-candidate small{display:block;margin-top:2px;color:var(--muted);font-size:11px}.onboarding-readonly{padding:5px 9px;border-radius:var(--radius-pill);background:rgba(47,107,74,.11);color:var(--leaf);font-size:11px;font-weight:800;white-space:nowrap}
		.energy-mapping-guide{display:grid;gap:var(--space-3)}.energy-mapping-guide>header{display:flex;justify-content:space-between;gap:18px;align-items:end}.energy-mapping-guide>header h2{font-size:25px}.energy-mapping-guide>header small{color:var(--muted);font-size:12px}.energy-mapping-slots{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-2)}.energy-mapping-slot{min-width:0;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:var(--space-4);align-items:center;padding:13px var(--space-4);border:1px solid var(--line);border-radius:var(--radius-xs);background:var(--panel)}.energy-mapping-slot>div{min-width:0}.energy-mapping-slot strong,.energy-mapping-slot span,.energy-mapping-slot small{display:block}.energy-mapping-slot span{margin-top:3px;color:var(--muted);font-size:12px;line-height:1.35}.energy-mapping-slot p{min-width:118px;text-align:right}.energy-mapping-slot b{color:var(--muted);font-size:12px}.energy-mapping-slot small{margin-top:3px;max-width:190px;color:var(--soft);font-size:11px;line-height:1.3}.energy-mapping-slot.good b{color:var(--leaf)}.energy-mapping-slot.warning{border-color:var(--gold);background:rgba(200,153,63,.09)}.energy-mapping-slot.warning b{color:var(--gold-ink)}.energy-mapping-slot.quiet{background:var(--panel-soft)}
		.onboarding-disclosure{overflow:hidden;border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel-soft)}.onboarding-disclosure>summary{min-height:48px;display:flex;align-items:center;gap:9px;padding:11px var(--space-4);color:var(--ink);cursor:pointer;list-style:none;font-size:13px;font-weight:750}.onboarding-disclosure>summary::-webkit-details-marker{display:none}.onboarding-disclosure>summary::after{content:"+";margin-left:auto;color:var(--gold-ink);font-size:18px;font-weight:500}.onboarding-disclosure[open]>summary::after{content:"−"}.onboarding-disclosure>summary span{color:var(--muted);font-size:11px;font-weight:650}.onboarding-disclosure .onboarding-candidates,.onboarding-disclosure .optional-grid{display:grid;gap:var(--space-2);padding:var(--space-3);border-top:1px solid var(--line)}.onboarding-disclosure .optional-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.onboarding-additional code{display:block;margin-top:3px;overflow-wrap:anywhere;color:var(--muted);font-size:10px}
		.onboarding-actions{display:flex;justify-content:space-between;align-items:center;gap:var(--space-3);padding-top:4px}.onboarding-actions .button{min-height:48px}.onboarding-skip{margin-left:auto}
		.onboarding-trust{display:grid;grid-template-columns:auto minmax(0,1fr);gap:11px;align-items:start;padding:15px;border:1px solid var(--leaf);border-radius:var(--radius-sm);background:rgba(47,107,74,.08)}.onboarding-trust>span{color:var(--leaf);font-weight:800}.onboarding-trust strong{display:block;margin-bottom:3px}.onboarding-trust p{color:var(--muted);font-size:13px;line-height:1.4}
		@media(max-width:1050px){.energy-mapping-slots{grid-template-columns:1fr}}
		@media(max-width:760px){.menu>summary{width:42px;height:42px;display:grid;place-content:center;list-style:none;cursor:pointer}.menu>summary::-webkit-details-marker{display:none}
			.energy-mode-strip{position:static;flex-wrap:wrap;gap:var(--space-2);padding:var(--space-2) var(--space-4)}.energy-mode-capability{margin-left:0;max-width:none;text-align:left}.energy-mode-control{margin-left:0}.energy-mode-popover{position:static;width:100%;margin-top:var(--space-2)}
			.onboarding-page{padding:18px var(--space-4) 48px}.onboarding-explain,.onboarding-choice-grid{grid-template-columns:1fr}.energy-mapping-guide>header{align-items:start;flex-direction:column;gap:5px}.energy-mapping-slot{grid-template-columns:1fr;gap:7px}.energy-mapping-slot p{min-width:0;text-align:left}.energy-mapping-slot small{max-width:none}.onboarding-actions{align-items:stretch;flex-direction:column-reverse}.onboarding-actions .button{width:100%}.onboarding-candidate{grid-template-columns:auto minmax(0,1fr)}.onboarding-readonly{grid-column:2;justify-self:start}.onboarding-disclosure .optional-grid{grid-template-columns:1fr}.onboarding-skip{margin-left:0}}
	</style>
}
