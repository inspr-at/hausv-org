package web

import (
	"fmt"
	"strconv"

	"github.com/inspr-at/hausv-org/internal/view"
)

type DocumentGuideEntry struct {
	Category string
	Detail   string
}

type DocumentsPageData struct {
	Portal                PortalPageData
	AssetVersion          string
	CanManageDocuments    bool
	DocumentSections      []view.DocumentCategoryView
	HasDocuments          bool
	HasAnyDocuments       bool
	DocumentsEmpty        view.EmptyStateView
	DocumentGuide         []DocumentGuideEntry
	DocumentCountLabel    string
	DocumentMessage       string
	DocumentMessageOK     bool
	SearchQuery           string
	HasSearchQuery        bool
	SortOptions           []view.SelectOption
	CategoryOptions       []view.SelectOption
	VisibilityOptions     []view.SelectOption
	UnitOptions           []view.SelectOption
	MaxDocumentSize       string
}

templ DocumentsPage(data DocumentsPageData) {
	@PortalDocument(data.Portal.Title, data.AssetVersion, []string{"announcements.js", "attachments.js"}, DocumentsStyles(), templ.Attributes{"data-templ-documents": true}) {
			@PortalShell(data.Portal, "Dokumente", DocumentsContent(data))
			if data.CanManageDocuments {
				@DocumentUploadDialog(data)
			}
	}
}

templ DocumentsStyles() {
	<style>a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:2px solid var(--gold-light);outline-offset:2px}h1,h2,h3,p{margin:0}h1,h2,h3{font-family:var(--font-serif);font-weight:600}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.nav-icon svg{display:block;width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
		.documents-main{min-width:0;padding:var(--space-6)}.page{max-width:1180px;margin:var(--space-5) auto 0}.button.primary{background:var(--gold);color:var(--panel)}.button.ghost{border-color:var(--line);color:var(--muted)}.button.small{min-height:34px;padding:var(--space-1) var(--space-3)}.button svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.9}.flash{margin-top:var(--space-4);padding:var(--space-3) var(--space-4);border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel-soft);font-size:13px}.flash.ok{border-color:var(--gold)}
		.panel{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius-md);box-shadow:var(--shadow-panel)}.document-library{display:grid;gap:var(--space-5);margin-top:var(--space-5);padding:var(--space-5)}.library-head{display:flex;align-items:end;justify-content:space-between;gap:var(--space-4);padding-bottom:var(--space-3);border-bottom:1px solid var(--line)}.kicker{color:var(--gold-ink);font-size:10px;font-weight:850;letter-spacing:.13em;text-transform:uppercase}.mini{margin-top:var(--space-1);color:var(--muted);font-size:11px}.pill{display:inline-flex;align-items:center;min-height:24px;padding:3px var(--space-2);border:1px solid var(--line);border-radius:var(--radius-pill);background:var(--panel-soft);color:var(--muted);font-size:10px;font-weight:750}.document-toolbar{display:grid;grid-template-columns:minmax(240px,1fr) minmax(170px,.3fr) auto;overflow:hidden;border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel)}.document-search{position:relative;min-width:0}.document-search svg{position:absolute;top:50%;left:var(--space-3);width:20px;height:20px;transform:translateY(-50%);fill:none;stroke:var(--muted);stroke-width:1.8;pointer-events:none}.document-search input,.document-sort select{width:100%;min-height:50px;border:0;background:transparent;color:var(--ink)}.document-search input{padding:var(--space-3) var(--space-3) var(--space-3) 42px}.document-sort{border-left:1px solid var(--line)}.document-sort select{padding:var(--space-3);font-weight:750}.document-toolbar .button,.document-reset{min-height:50px;border-width:0 0 0 1px;border-radius:0}.document-reset{display:inline-flex;align-items:center;justify-content:center;padding-inline:var(--space-3);border-left:1px solid var(--line);background:var(--panel-soft);color:var(--gold-ink);font-size:12px;font-weight:800}.document-sections{display:grid;gap:var(--space-5)}.document-section{display:grid;gap:var(--space-2)}.document-section h2{display:flex;align-items:center;gap:var(--space-2);font-size:19px}.section-count{padding:3px var(--space-2);border:1px solid var(--line);border-radius:var(--radius-pill);background:var(--panel-soft);color:var(--gold-ink);font-family:var(--font-sans);font-size:10px}.document-list{display:grid;gap:var(--space-2)}.document-row{display:grid;grid-template-columns:50px minmax(0,1fr) minmax(150px,auto);align-items:center;gap:var(--space-3) var(--space-4);padding:var(--space-4);border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel);scroll-margin-top:82px}.document-icon{width:48px;height:56px;display:grid;place-items:center;border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel-soft);color:var(--gold-ink)}.document-icon svg{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:1.7}.document-copy{min-width:0}.document-copy>strong{display:block;font-family:var(--font-serif);font-size:18px;overflow-wrap:anywhere}.document-meta{display:flex;flex-wrap:wrap;align-items:center;gap:6px var(--space-2);margin-top:var(--space-2);color:var(--muted);font-size:11px}.document-party-address{overflow-wrap:anywhere;min-width:0}.document-meta-secondary{color:var(--soft)}.file-details{margin-top:var(--space-1);color:var(--soft);font-size:11px}.file-details summary,.admin-tools>summary,.versions>summary{min-height:40px;display:flex;align-items:center;cursor:pointer;font-weight:800}.document-file{display:block;overflow-wrap:anywhere}.document-actions{min-width:150px;display:grid;gap:var(--space-2)}.document-actions .button{width:100%}.admin-tools,.versions{grid-column:2/-1;padding-top:var(--space-2);border-top:1px solid var(--line)}.admin-tools>summary,.versions>summary{color:var(--gold-ink);font-size:12px}.admin-body{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-2);margin-top:var(--space-2)}.version-list{display:grid;gap:var(--space-2);margin-top:var(--space-2)}.version-row{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:var(--space-2);color:var(--muted);font-size:11px}
		.document-empty{min-height:210px;display:grid;place-items:center;padding:var(--space-6);border:1px dashed var(--line);border-radius:var(--radius-sm);background:var(--panel-soft);text-align:center}.document-empty svg{width:42px;height:42px;fill:none;stroke:var(--gold-ink);stroke-width:1.5}.document-empty h2{margin-top:var(--space-3);font-size:24px}.document-empty p{max-width:52ch;margin-top:var(--space-2);color:var(--muted);font-size:13px;line-height:1.5}.document-empty .button{margin-top:var(--space-4)}.doc-blank{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(270px,.85fr);gap:var(--space-4);margin-top:var(--space-5)}.doc-blank-main{min-height:350px;display:grid;align-content:center;gap:var(--space-5);padding:var(--space-6);border:1px dashed var(--line);border-radius:var(--radius-md);background:var(--panel)}.doc-blank-lead{display:grid;justify-items:start;gap:var(--space-3)}.doc-blank-icon{width:52px;height:52px;display:grid;place-items:center;border:1px solid var(--line);border-radius:var(--radius-md);background:var(--panel-soft);color:var(--gold-ink)}.doc-blank-icon svg{width:26px;height:26px;fill:none;stroke:currentColor;stroke-width:1.5}.doc-blank-main h2{font-size:30px}.doc-blank-main p{max-width:54ch;color:var(--muted);font-size:14px;line-height:1.55}.doc-blank-actions{display:flex;flex-wrap:wrap;gap:var(--space-2)}.doc-guide{align-self:start;overflow:hidden;border:1px solid var(--line);border-radius:var(--radius-md);background:var(--panel)}.doc-guide>summary{min-height:60px;display:flex;align-items:center;justify-content:space-between;gap:var(--space-3);padding:var(--space-4);cursor:pointer;list-style:none}.doc-guide>summary::-webkit-details-marker{display:none}.doc-guide[open]>summary{border-bottom:1px solid var(--line)}.doc-guide>summary span{display:grid;gap:2px}.doc-guide>summary small{color:var(--gold-ink);font-size:9px;font-weight:850;letter-spacing:.1em;text-transform:uppercase}.doc-guide-body{display:grid;gap:var(--space-3);padding:var(--space-4)}.doc-guide-list{display:grid;gap:var(--space-2);margin:0;padding:0;list-style:none}.doc-guide-list li{display:grid;gap:2px;padding-top:var(--space-2);border-top:1px solid var(--line)}.doc-guide-list li:first-child{padding-top:0;border-top:0}.doc-guide-list strong{font-size:12px}.doc-guide-list span{color:var(--muted);font-size:11px;line-height:1.4}.doc-notes{display:grid;gap:var(--space-2)}.doc-note{display:grid;gap:2px;padding:var(--space-3);border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel-soft)}.doc-note strong{font-size:12px}.doc-note span{color:var(--muted);font-size:11px;line-height:1.4}
		.dialog{width:min(680px,calc(100vw - 28px));max-height:calc(100dvh - 28px);padding:0;overflow:hidden;border:1px solid var(--line);border-radius:var(--radius-md);background:var(--panel);color:var(--ink);box-shadow:var(--shadow-dialog)}.dialog::backdrop{background:var(--portal-backdrop);-webkit-backdrop-filter:var(--portal-backdrop-filter);backdrop-filter:var(--portal-backdrop-filter)}.dialog form{display:grid;grid-template-rows:auto minmax(0,1fr) auto;max-height:inherit}.dialog-head{display:flex;align-items:center;justify-content:space-between;gap:var(--space-3);padding:var(--space-5);border-bottom:1px solid var(--line)}.dialog-head h2{font-size:25px}.dialog-close{width:44px;height:44px;border:1px solid var(--line);border-radius:var(--radius-xs);background:var(--panel-soft);color:var(--ink);font-size:22px}.dialog-body{min-height:0;display:grid;gap:var(--space-4);padding:var(--space-5);overflow:auto}.dialog-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-3)}.dialog-grid .full{grid-column:1/-1}.dialog label{display:grid;gap:var(--space-2);color:var(--muted);font-size:12px;font-weight:700}.dialog input,.dialog select{width:100%;min-height:44px;border:1px solid var(--line);border-radius:var(--radius-xs);padding:var(--space-2) var(--space-3);background:var(--panel);color:var(--ink)}.dialog-optional{border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel-soft)}.dialog-optional>summary{min-height:44px;padding:var(--space-3);cursor:pointer;font-size:12px;font-weight:800}.dialog-optional-grid{display:grid;gap:var(--space-3);padding:var(--space-3);border-top:1px solid var(--line)}.file-control{position:relative;min-height:44px;display:flex;align-items:center;border:1px solid var(--line);border-radius:var(--radius-xs);padding:var(--space-2) var(--space-3);background:var(--panel)}.file-control input{position:absolute;inset:0;opacity:0;cursor:pointer}.file-control span{color:var(--gold-ink)}.dialog-footer{display:flex;justify-content:flex-end;padding:var(--space-4) var(--space-5);border-top:1px solid var(--line);background:var(--panel)}.dialog-footer .button{min-height:44px}.dialog-intro{color:var(--muted);font-size:12px;line-height:1.5}.replace-context{display:grid;gap:var(--space-1);padding:var(--space-3);border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel-soft)}.replace-context strong{font-family:var(--font-serif);font-size:17px}.attachment-lightbox{position:fixed;inset:0;z-index:300;display:none;grid-template-columns:48px minmax(0,1fr) 48px;grid-template-rows:48px minmax(0,1fr) auto;align-items:center;gap:var(--space-3);padding:var(--space-4);background:var(--nav);color:var(--panel)}.attachment-lightbox.open{display:grid}.attachment-lightbox figure{grid-column:2;grid-row:2;display:grid;place-items:center;gap:var(--space-3);min-width:0;min-height:0;margin:0}.attachment-lightbox img{max-width:100%;max-height:calc(100vh - 150px);object-fit:contain;border-radius:var(--radius-sm);background:var(--nav-2)}.attachment-lightbox figcaption{text-align:center;font-size:12px;overflow-wrap:anywhere}.lightbox-close,.lightbox-prev,.lightbox-next{border:1px solid var(--muted);border-radius:var(--radius-xs);background:var(--nav-2);color:var(--panel)}.lightbox-close{grid-column:3;grid-row:1;width:44px;height:44px}.lightbox-prev,.lightbox-next{width:46px;height:70px;font-size:26px}.lightbox-prev{grid-column:1;grid-row:2}.lightbox-next{grid-column:3;grid-row:2}.menu>summary{list-style:none}.menu>summary::-webkit-details-marker{display:none}@media(max-width:1050px){}@media(max-width:760px){.menu>summary{width:42px;height:48px;display:grid;place-content:center;cursor:pointer}.documents-main{padding:var(--space-4)}.page{margin-top:0}.document-toolbar{grid-template-columns:1fr auto}.document-search{grid-column:1/-1;border-bottom:1px solid var(--line)}.document-sort{border-left:0}.document-row{grid-template-columns:44px minmax(0,1fr);padding:var(--space-3)}.document-icon{width:42px;height:49px}.document-actions{grid-column:1/-1;min-width:0;grid-template-columns:1fr 1fr}.document-actions .primary{grid-column:1/-1}.document-actions .button:only-child{grid-column:1/-1}.admin-tools,.versions{grid-column:1/-1}.doc-blank{grid-template-columns:minmax(0,1fr)}.doc-blank-main{min-height:0}}@media(max-width:520px){.document-library{padding:var(--space-3)}.document-icon{display:none}.document-row{grid-template-columns:minmax(0,1fr)}.document-actions{grid-column:1}.admin-tools,.versions{grid-column:1}.doc-blank-actions{display:grid}.doc-blank-actions .button{width:100%}.dialog-grid{grid-template-columns:minmax(0,1fr)}.dialog-grid .full{grid-column:1}.dialog-footer .button{width:100%}}
		.documents-main .button.primary{color:var(--nav)}
		.document-library{padding:24px;gap:16px}.library-head{padding-bottom:16px}.document-toolbar{grid-template-columns:minmax(0,1fr) minmax(160px,.28fr) auto;gap:8px;border:0;overflow:visible}.document-search,.document-sort{border:1px solid var(--line);border-radius:8px}.document-search input,.document-sort select{min-height:48px}.document-toolbar .button,.document-reset{min-height:48px;border:1px solid var(--line);border-radius:8px}.document-reset{grid-column:1/-1;justify-self:start}.document-search input{font-weight:400}
		.document-categories{display:flex;flex-wrap:wrap;gap:8px}.document-categories a{display:inline-flex;align-items:center;gap:8px;min-height:40px;padding:8px 16px;border:1px solid var(--line);border-radius:var(--radius-pill);background:var(--paper);font-size:12px;font-weight:700}.document-categories a:hover,.document-categories a:focus-visible{border-color:var(--gold);color:var(--gold-ink)}.document-categories span{color:var(--muted);font-variant-numeric:tabular-nums}.document-section{scroll-margin-top:88px}.document-section:target h2{color:var(--gold-ink)}.document-section h2{font-size:24px}.document-sections{gap:24px}.document-list{gap:8px}
		.document-row{grid-template-columns:56px minmax(0,1fr) 160px;gap:0 16px;padding:16px;align-items:start}.document-icon{width:56px;height:64px;gap:0;align-content:center}.document-icon small{font-size:9px;font-weight:700}.document-copy>strong{font-size:22px;line-height:1.2}.document-meta{margin-top:8px;font-size:12px}.document-actions{gap:8px}.file-details{grid-column:2/-1;margin-top:16px;border-top:1px solid var(--line);font-size:12px}.file-details summary,.admin-tools>summary,.versions>summary{min-height:40px}.admin-tools,.versions{padding-top:0}.document-file{padding:8px 0;line-height:1.5}
		@media(max-width:760px){.document-library{padding:16px}.document-toolbar{grid-template-columns:minmax(0,1fr) auto}.document-search{grid-column:1/-1}.document-row{grid-template-columns:48px minmax(0,1fr);gap:16px}.document-icon{width:48px;height:56px}.document-copy>strong{font-size:20px}.document-actions{grid-column:1/-1;grid-template-columns:repeat(2,minmax(0,1fr))}.document-actions .primary{grid-column:auto}.file-details,.admin-tools,.versions{grid-column:1/-1;margin-top:0}.document-categories a{min-height:48px}.file-details summary,.admin-tools>summary,.versions>summary{min-height:48px}}
		@media(max-width:520px){.document-icon{display:grid}.document-row{grid-template-columns:40px minmax(0,1fr);gap:8px 16px}.document-icon{width:40px;height:48px}.document-icon svg{width:20px;height:20px}}
		.document-archive-group{border:1px solid var(--line);border-radius:8px;background:var(--panel)}.document-archive-group>summary{min-height:48px;display:flex;align-items:center;gap:12px;padding:12px 16px;cursor:pointer;list-style:none}.document-archive-group>summary::-webkit-details-marker{display:none}.document-archive-label{font-family:var(--font-serif);font-size:18px;font-weight:600}.document-archive-count{margin-left:auto;color:var(--muted);font-size:13px;font-weight:650;font-variant-numeric:tabular-nums}.document-archive-list{display:grid;border-top:1px solid var(--line)}.document-archive-list .document-row{border:0;border-radius:0;border-top:1px solid var(--line);padding:10px 16px;background:transparent;grid-template-columns:40px minmax(0,1fr) auto}.document-archive-list .document-row:first-child{border-top:0}.document-archive-list .document-icon{width:36px;height:42px}.document-archive-list .document-copy>strong{font-size:16px}.document-archive-list .document-meta{margin-top:4px}.document-archive-list .file-details{margin-top:4px}@media(max-width:760px){.document-archive-group>summary{min-height:48px;align-items:flex-start;padding-top:12px;padding-bottom:12px}.document-archive-count{white-space:nowrap}.document-archive-list .document-row{grid-template-columns:40px minmax(0,1fr)}}
		.documents-screen.documents-main{padding:0}
		.documents-screen .document-library{display:flex;flex-direction:column;gap:12px;margin-top:0;padding:8px 16px 12px}
		.documents-screen .library-head{padding-bottom:8px}
		.documents-screen .document-sections{display:block;margin-top:20px}
		.documents-screen .document-section{display:block;margin:0;padding:0;border:0;background:transparent;box-shadow:none}
		.documents-screen .document-section + .document-section{margin-top:32px}
		.documents-screen .document-section h2{display:flex;align-items:baseline;gap:8px;margin:0 0 12px;font-size:20px;line-height:1.2}
		.documents-screen .section-count{align-self:baseline}
		.documents-screen .document-list{display:block}
		.documents-screen .document-row,.documents-screen .document-archive-group>summary{display:grid;grid-template-columns:28px minmax(0,1fr) 36px max-content;align-items:center;column-gap:8px;min-height:40px;margin:0;padding:0;border:0;border-bottom:1px solid var(--line);border-radius:0;background:transparent;box-shadow:none;scroll-margin-top:82px}
		.documents-screen .document-icon{width:28px;height:28px;display:grid;place-items:center;border:0;border-radius:0;background:transparent;color:var(--gold-ink)}
		.documents-screen .document-icon svg{width:20px;height:20px}
		.documents-screen .document-icon small{display:none}
		.documents-screen .document-copy{min-width:0}
		.documents-screen .document-title{display:block;color:var(--ink);font-family:var(--font-sans);font-size:14px;font-weight:650;line-height:1.25;overflow-wrap:anywhere;white-space:normal;text-decoration:none}
		.documents-screen .document-title:hover{text-decoration:underline;text-underline-offset:2px}
		.documents-screen .document-meta{display:flex;flex-wrap:wrap;align-items:center;gap:1px 6px;margin:0;color:var(--muted);font-size:12px;line-height:1.25}
		.documents-screen .document-meta .pill{min-height:18px;padding:0 6px;font-size:10px;line-height:1.4}
		.documents-screen .document-meta-dot{color:var(--soft)}
		.documents-screen .document-download{display:grid;place-items:center;width:36px;height:36px;border-radius:8px;color:var(--muted)}
		.documents-screen .document-download svg{width:18px;height:18px;display:block}
		.documents-screen .document-download:hover{background:var(--panel-soft);color:var(--ink)}
		.documents-screen .document-more{position:relative}
		body[data-authenticated-app] .documents-screen .document-more>summary{display:inline-flex;align-items:center;min-height:36px;padding-inline:8px 28px;border:0;border-radius:8px;background:transparent;color:var(--muted);font:inherit;font-size:13px;font-weight:650;cursor:pointer}
		.documents-screen .document-more>summary:hover{background:var(--panel-soft);color:var(--ink)}
		.documents-screen .document-more[open]{z-index:4}
		.documents-screen .document-more:not([open])>.document-more-panel{display:none}
		.documents-screen .document-more[open]>.document-more-panel{position:absolute;z-index:5;right:0;top:calc(100% + 4px);display:grid;gap:10px;width:min(380px,calc(100vw - 32px));padding:12px;border:1px solid var(--line);border-radius:8px;background:var(--panel);box-shadow:var(--shadow-dialog)}
		.documents-screen .document-more-panel .button{min-height:44px}
		.documents-screen .document-file{color:var(--muted);font-size:12px;line-height:1.45;overflow-wrap:anywhere}
		.documents-screen .document-more-facts{display:flex;flex-wrap:wrap;gap:6px}
		.documents-screen .admin-body{display:flex;flex-wrap:wrap;align-items:center;gap:8px}
		.documents-screen .version-list{display:grid;gap:8px}
		.documents-screen .version-row{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px;color:var(--muted);font-size:12px}
		.documents-screen .version-row a{color:var(--gold-ink);font-weight:650}
		.documents-screen .document-archive-group{border:0;border-radius:0;background:transparent}
		body[data-authenticated-app] .documents-screen .document-archive-group>summary{padding-inline-end:0}
		.documents-screen .document-archive-spacer{width:44px;height:44px}
		.documents-screen .document-row:has(.document-more[open]),.documents-screen .document-archive-group[open]{position:relative;z-index:4}
		body[data-authenticated-app] .documents-screen .document-archive-group>summary>.disclosure-chevron{position:static;top:auto;right:auto;transform:none;width:44px;height:44px;margin:0;border:0;border-radius:8px;background:transparent;opacity:.7}
		body[data-authenticated-app] .documents-screen .document-archive-group[open]>summary>.disclosure-chevron{opacity:1;background:transparent}
		.documents-screen .document-archive-list{display:block;margin:0;padding:0 0 0 28px;border:0}
		.documents-screen .document-archive-list .document-row{grid-template-columns:28px minmax(0,1fr) 44px max-content;padding:2px 0;background:transparent}
		.documents-screen .document-title:focus-visible,.documents-screen .document-download:focus-visible,.documents-screen .document-more>summary:focus-visible,.documents-screen .document-archive-group>summary:focus-visible{outline:2px solid var(--gold-light);outline-offset:2px}
		@media(max-width:760px){.documents-screen .document-library{padding:8px 12px 12px}.documents-screen .document-row,.documents-screen .document-archive-group>summary,.documents-screen .document-archive-list .document-row{grid-template-columns:24px minmax(0,1fr) 44px max-content;min-height:44px}.documents-screen .document-download{width:44px;height:44px}body[data-authenticated-app] .documents-screen .document-more>summary{min-height:44px}.documents-screen .document-icon{display:grid;width:24px;height:24px}.documents-screen .document-title{font-size:15px;line-height:1.3}}
		@media(max-width:520px){.documents-screen .document-icon{display:grid}.documents-screen .document-row,.documents-screen .document-archive-group>summary,.documents-screen .document-archive-list .document-row{grid-template-columns:22px minmax(0,1fr) 44px max-content}}

        /* Keep compact rows readable when titles and metadata wrap. */
        .documents-screen .document-library{padding:16px}
        .documents-screen :is(.document-row,.document-archive-list .document-row){grid-template-columns:28px minmax(0,1fr) 44px max-content;min-height:64px;padding:8px 0;row-gap:4px}
        .documents-screen .document-title{min-height:44px;display:flex;align-items:center;overflow-wrap:normal;line-height:1.45}
        .documents-screen .document-meta{gap:4px 6px;line-height:1.5}
        .documents-screen .document-meta>span{min-width:0}
        .documents-screen .document-download{width:44px;height:44px}
        body[data-authenticated-app] .documents-screen .document-more>summary{min-height:44px}
        body[data-authenticated-app] .documents-screen .button,.documents-screen .document-categories a{min-height:44px}
        .documents-screen .document-more-panel .version-row a{display:inline-flex;align-items:center;min-height:44px}
        @media(max-width:760px){
            .documents-screen :is(.document-row,.document-archive-list .document-row){grid-template-columns:24px minmax(0,1fr) 44px max-content;align-items:start;padding:12px 0}
            .documents-screen .document-row>.document-icon{margin-top:8px}
            .documents-screen .document-row>.document-copy{grid-column:2/-1}
            .documents-screen .document-download{grid-column:3}
            .documents-screen .document-more{grid-column:4}
            .documents-screen .document-archive-list{padding-left:8px}
            .documents-screen .document-more[open]>.document-more-panel{max-width:calc(100vw - 72px)}
        }

	</style>
}

templ DocumentsContent(data DocumentsPageData) {
	@PortalSectionLanding(
		PortalSectionLandingData{
			Portal: data.Portal,
			PageLabel: "Dokumente",
			Class: "documents-main documents-screen",
			Identity: PortalSectionIdentityData{Label: "Ablage der Liegenschaft", Icon: "document"},
		},
		PortalSectionTitle("Dokumente"),
		PortalSectionLede("Die freigegebenen Unterlagen der Liegenschaft – schnell finden, ansehen und herunterladen."),
		DocumentsHeaderAction(data),
		nil,
		nil,
		DocumentsBody(data),
	)
}

templ DocumentsHeaderAction(data DocumentsPageData) {
	if data.CanManageDocuments && (data.HasAnyDocuments || data.HasSearchQuery) {
		<a class="button" href="/app/dokumente/rechnungen/import" aria-label="E-Rechnung einlesen">E-Rechnung</a>
		<button class="button" type="button" data-dialog="document-upload" aria-haspopup="dialog" aria-controls="document-upload" aria-label="Dokument hochladen"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>Hochladen</button>
	}
}

templ DocumentsBody(data DocumentsPageData) {
	if data.DocumentMessage != "" {
		<p class={ "flash", templ.KV("ok", data.DocumentMessageOK) }>{ data.DocumentMessage }</p>
	}
	if data.HasAnyDocuments || data.HasSearchQuery {
		@DocumentLibrary(data)
	} else {
		@DocumentsBlank(data)
	}
}

templ DocumentUploadButton() {
	<button class="button" type="button" data-dialog="document-upload" aria-haspopup="dialog" aria-controls="document-upload" aria-label="Dokument hochladen"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>Hochladen</button>
}

templ DocumentLibrary(data DocumentsPageData) {
	<section class="panel document-library">
		<header class="library-head"><div><p class="kicker">Ablage der Liegenschaft</p>
			if data.HasSearchQuery {
				<p class="mini">Ergebnis für „{ data.SearchQuery }“</p>
			}
		</div>
		if data.HasAnyDocuments {
			<span class="pill">{ data.DocumentCountLabel }</span>
		}
		</header>
		<form class="document-toolbar" method="get" action="/app/dokumente" role="search">
			<label class="document-search" for="document-search"><span class="sr-only">Dokumente durchsuchen</span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m16.5 16.5 4 4"></path></svg><input id="document-search" name="q" value={ data.SearchQuery } placeholder="Dokument suchen"/></label>
			<label class="document-sort" for="document-sort"><span class="sr-only">Sortierung</span><select id="document-sort" name="sort">
				for _, option := range data.SortOptions {
					<option value={ option.Value } selected?={ option.Selected }>{ option.Label }</option>
				}
			</select></label>
			<button class="button" type="submit">Anzeigen</button>
			if data.HasSearchQuery {
				<a class="document-reset" href="/app/dokumente">Zurücksetzen</a>
			}
		</form>
		if data.HasDocuments {
			<nav class="document-categories" aria-label="Dokumentkategorien">
				for index, section := range data.DocumentSections {
					<a href={ templ.SafeURL("#document-category-" + strconv.Itoa(index)) }>{ section.Category }<span>{ len(section.Documents) }</span></a>
				}
			</nav>
			<div class="document-sections">
				for index, section := range data.DocumentSections {
					<section class="document-section" id={ "document-category-" + strconv.Itoa(index) }><h2>{ section.Category }<span class="section-count">{ len(section.Documents) }</span></h2><div class="document-list">
						for _, block := range documentBlocks(section.Documents) {
							if block.Grouped {
								<details class="document-archive-group">
									<summary>
										<span class="document-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 3h7l3 3v15H7z"></path><path d="M14 3v4h4"></path><path d="M9 12h6M9 16h6"></path></svg></span>
										<span class="document-copy"><span class="document-title">{ block.Label }</span><span class="document-meta"><span>{ documentArchiveCount(block.Count) }</span>
											if block.Date != "" {
												<span class="document-meta-dot" aria-hidden="true">·</span><span>{ block.Date }</span>
											}
											if block.ManagerOnly {
												<span class="document-meta-dot" aria-hidden="true">·</span><span class="pill role-admin">Nur Verwaltung</span>
											}
										</span></span>
										<span class="document-archive-spacer" aria-hidden="true"></span>
										@DisclosureChevron()
									</summary>
									<div class="document-archive-list">
										for _, document := range block.Documents {
											@DocumentRow(document, data.CanManageDocuments)
										}
									</div>
								</details>
							} else {
								@DocumentRow(block.Documents[0], data.CanManageDocuments)
							}
						}
					</div></section>
				}
			</div>
		} else {
			<div class="document-empty"><div><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l3 3v15H7z"></path><path d="M14 3v4h4"></path><circle cx="10" cy="14" r="3.5"></circle><path d="m12.5 16.5 3 3"></path></svg><h2>Keine Dokumente gefunden</h2><p>Versuchen Sie einen anderen Suchbegriff oder zeigen Sie wieder alle Dokumente.</p><a class="button" href="/app/dokumente">Alle Dokumente zeigen</a></div></div>
		}
	</section>
}

templ DocumentRow(document view.DocumentView, canManage bool) {
	<article class="document-row" id={ "document-" + document.ID }>
		<span class="document-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 3h7l3 3v15H7z"></path><path d="M14 3v4h4"></path><path d="M9 12h6M9 16h6"></path></svg></span>
		<div class="document-copy">
			@DocumentTitleLink(document)
			<p class="document-meta">
				if document.Visibility != "" {
					<span class={ "pill", document.VisibilityClass }>{ document.Visibility }</span>
				}
				for i, part := range documentMetaParts(document) {
					if document.Visibility != "" || i > 0 {
						<span class="document-meta-dot" aria-hidden="true">·</span>
					}
					<span>{ part }</span>
				}
			</p>
		</div>
		<a class="document-download" href={ templ.SafeURL(document.DownloadURL) } aria-label="Herunterladen">@PortalAssetIcon("download")</a>
		<details class="document-more">
			<summary>Mehr
				@DisclosureChevron()
			</summary>
			<div class="document-more-panel">
				<p class="document-file">{ document.FileKind } · { document.Filename } · hochgeladen { document.UploadedAt }</p>
				if document.Archived || document.ArchiveParty != "" || document.HasUnit {
					<div class="document-more-facts">
						if document.Archived {
							<span class="pill">Archiviert · unveränderlich</span>
						}
						if document.ArchiveParty != "" {
							if document.ArchiveParty == document.ArchivePartyEmail {
								<span class="pill">Partei ohne gespeicherten Namen</span><span class="document-party-address">{ document.ArchivePartyEmail }</span>
							} else {
								<span class="pill" title={ document.ArchivePartyEmail }>Für { document.ArchiveParty }</span>
							}
						}
						if document.HasUnit {
							<span class="pill">@UnitLabel("Einheit " + document.UnitLabel)</span>
						}
					</div>
				}
				if canManage && !document.Archived {
					<div class="admin-tools"><div class="admin-body"><button class="button small ghost" type="button" data-dialog={ document.ReplaceDialogID } aria-haspopup="dialog" aria-controls={ document.ReplaceDialogID }>Neue Version hochladen</button><span class="mini">Kategorie, Sichtbarkeit und Einheit bleiben dabei erhalten.</span></div></div>
				}
				if document.HasVersions {
					<div class="versions"><p class="mini">Versionsverlauf</p><div class="version-list">
						for _, version := range document.Versions {
							<div class="version-row"><span>{ version.Version } · { version.UploadedAt } · { version.Size } · { version.Filename }</span><a href={ templ.SafeURL(version.DownloadURL) }>Herunterladen</a></div>
						}
					</div></div>
				}
			</div>
		</details>
	</article>
	if canManage && !document.Archived {
		@DocumentReplaceDialog(document)
	}
}

templ DocumentTitleLink(document view.DocumentView) {
	if document.CanPreview && document.IsImage {
		<a class="document-title" href={ templ.SafeURL(document.PreviewURL) } data-lightbox-src={ document.PreviewURL } data-lightbox-caption={ document.Filename } aria-label={ "Vorschau: " + document.Title }>{ document.Title }</a>
	} else if document.CanPreview {
		<a class="document-title" href={ templ.SafeURL(document.PreviewURL) } target="_blank" rel="noopener" aria-label={ "Vorschau: " + document.Title }>{ document.Title }</a>
	} else {
		<a class="document-title" href={ templ.SafeURL(document.DownloadURL) }>{ document.Title }</a>
	}
}

templ DocumentReplaceDialog(document view.DocumentView) {
	<dialog id={ document.ReplaceDialogID } class="dialog" aria-labelledby={ document.ReplaceDialogID + "-title" }><form method="post" action="/app/dokumente/replace" enctype="multipart/form-data"><input type="hidden" name="id" value={ document.ID }/><div class="dialog-head"><h2 id={ document.ReplaceDialogID + "-title" }>Neue Version speichern</h2><button class="dialog-close" type="button" data-close-dialog aria-label="Schließen">×</button></div><div class="dialog-body"><div class="replace-context"><strong>{ document.Title }</strong><span class="mini">Aktuell { document.VersionLabel } · { document.Visibility }
		if document.HasUnit {
			<span>{ " · " }
				@UnitLabel("Einheit " + document.UnitLabel)
			</span>
		}
	</span></div><div class="dialog-grid"><label class="full" for={ document.ReplaceDialogID + "-file" }>Neue Datei<span class="file-control"><input id={ document.ReplaceDialogID + "-file" } type="file" name="document" accept="application/pdf,image/jpeg,image/png,image/webp" required/><span>PDF oder Bild auswählen</span></span></label></div></div><footer class="dialog-footer"><button class="button primary" type="submit">Neue Version speichern</button></footer></form></dialog>
}

templ DocumentsBlank(data DocumentsPageData) {
	<section class="doc-blank" aria-labelledby="doc-blank-title"><div class="doc-blank-main"><div class="doc-blank-lead"><span class="doc-blank-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 3h7l3 3v15H7z"></path><path d="M14 3v4h4"></path><circle cx="10" cy="14" r="3.5"></circle><path d="m12.5 16.5 3 3"></path></svg></span><h2 id="doc-blank-title">{ data.DocumentsEmpty.Title }</h2>
		if data.CanManageDocuments {
			<p>Erste Unterlage hochladen, einordnen und für die passende Gruppe freigeben.</p>
		} else {
			<p>{ data.DocumentsEmpty.Message }</p>
		}
	</div><div class="doc-blank-actions">
		if data.CanManageDocuments {
			@DocumentUploadButton()<a class="button ghost" href="/app/dokumente/rechnungen/import" aria-label="E-Rechnung einlesen">E-Rechnung</a>
		} else {
			<a class="button primary" href="/app/anliegen?new=1">Unterlage anfragen</a><a class="button ghost" href="/app/kontakte">Verwaltung im Kontaktverzeichnis</a>
		}
	</div></div><details class="doc-guide"><summary><span><small>Orientierung</small><strong>Was hier abgelegt wird</strong></span>
		@DisclosureChevron()
	</summary><div class="doc-guide-body"><ul class="doc-guide-list">
		for _, entry := range data.DocumentGuide {
			<li><strong>{ entry.Category }</strong><span>{ entry.Detail }</span></li>
		}
	</ul><div class="doc-notes"><p class="doc-note"><strong>Freigaben</strong><span>Jede Person sieht nur die für sie bestimmten Unterlagen.</span></p><p class="doc-note"><strong>Versionen</strong><span>Frühere Fassungen bleiben im Verlauf abrufbar.</span></p></div></div></details></section>
}

templ DocumentUploadDialog(data DocumentsPageData) {
	<dialog id="document-upload" class="dialog" aria-labelledby="document-upload-title"><form method="post" action="/app/dokumente" enctype="multipart/form-data"><div class="dialog-head"><h2 id="document-upload-title">Dokument hochladen</h2><button class="dialog-close" type="button" data-close-dialog aria-label="Schließen">×</button></div><div class="dialog-body"><p class="dialog-intro">Die Freigabe legt fest, wer die Unterlage sieht. Erlaubt sind PDF oder Bild bis { data.MaxDocumentSize }.</p><div class="dialog-grid"><label class="full" for="document-title">Titel<input id="document-title" name="title" required maxlength="160" autocomplete="off" placeholder="Zum Beispiel Hausordnung 2026"/></label><label for="document-category">Kategorie<select id="document-category" name="category" required>
		for _, option := range data.CategoryOptions {
			<option value={ option.Value } selected?={ option.Selected } disabled?={ option.Value == "" }>{ option.Label }</option>
		}
	</select></label><label for="document-visibility">Sichtbarkeit<select id="document-visibility" name="visibility" required>
		for _, option := range data.VisibilityOptions {
			<option value={ option.Value } selected?={ option.Selected }>{ option.Label }</option>
		}
	</select></label><label class="full" for="document-file">Datei<span class="file-control"><input id="document-file" type="file" name="document" accept="application/pdf,image/jpeg,image/png,image/webp" required/><span>PDF oder Bild auswählen</span></span></label><details class="dialog-optional full"><summary>Optional: bestimmte Einheit
		@DisclosureChevron()
	</summary><div class="dialog-optional-grid"><label class="full" for="document-unit">Einheit <span class="mini">gilt bei „Nur Eigentümer“</span><select id="document-unit" name="unit_id">
		for _, option := range data.UnitOptions {
			<option value={ option.Value } selected?={ option.Selected }>{ option.Label }</option>
		}
	</select></label></div></details></div></div><footer class="dialog-footer"><button class="button primary" type="submit">Hochladen</button></footer></form></dialog>
}

type documentBlock struct {
	Grouped     bool
	Label       string
	Count       int
	Date        string
	ManagerOnly bool
	Documents   []view.DocumentView
}

func documentBlocks(docs []view.DocumentView) []documentBlock {
	blocks := make([]documentBlock, 0, len(docs))
	for i := 0; i < len(docs); {
		doc := docs[i]
		if doc.Archived && doc.ArchiveRunID != "" {
			j := i + 1
			for j < len(docs) && docs[j].Archived && docs[j].ArchiveRunID == doc.ArchiveRunID {
				j++
			}
			group := docs[i:j]
			blocks = append(blocks, documentBlock{
				Grouped:     true,
				Label:       documentArchiveLabel(doc),
				Count:       len(group),
				Date:        group[0].UploadedDate,
				ManagerOnly: documentGroupManagerOnly(group),
				Documents:   group,
			})
			i = j
			continue
		}
		blocks = append(blocks, documentBlock{Documents: []view.DocumentView{doc}})
		i++
	}
	return blocks
}

func documentArchiveLabel(doc view.DocumentView) string {
	if doc.ArchiveYear > 0 && doc.ArchiveRevision > 0 {
		return fmt.Sprintf("Jahresabrechnung %d · Lauf %d", doc.ArchiveYear, doc.ArchiveRevision)
	}
	if doc.ArchiveYear > 0 {
		return fmt.Sprintf("Jahresabrechnung %d", doc.ArchiveYear)
	}
	return "Archivierte Jahresabrechnung"
}

func documentMetaParts(document view.DocumentView) []string {
	parts := make([]string, 0, 3)
	if document.VersionLabel != "" {
		parts = append(parts, document.VersionLabel)
	}
	if document.UploadedDate != "" {
		parts = append(parts, document.UploadedDate)
	}
	if document.Size != "" {
		parts = append(parts, document.Size)
	}
	return parts
}

func documentGroupManagerOnly(group []view.DocumentView) bool {
	if len(group) == 0 {
		return false
	}
	for _, doc := range group {
		if doc.Visibility != "Nur Verwaltung" {
			return false
		}
	}
	return true
}

func documentArchiveCount(count int) string {
	if count == 1 {
		return "1 Dokument"
	}
	return fmt.Sprintf("%d Dokumente", count)
}
