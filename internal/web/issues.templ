package web

import (
	"strconv"

	"github.com/inspr-at/hausv-org/internal/view"
)

type IssuesPageData struct {
	Portal            PortalPageData
	AssetVersion      string
	CalendarFeedURL   string
	CanManageIssues   bool
	CanCreateIssue    bool
	IsServiceProvider bool
	Issues            []view.IssueView
	IssuesEmpty       view.EmptyStateView
	Message           string
	MessageOK         bool
	OpenIssueCreate   bool
}

templ IssuesPage(data IssuesPageData) {
	@PortalDocument(data.Portal.Title, data.AssetVersion, []string{"attachments.js", "issues.js"}, IssuesStyles(), templ.Attributes{"data-templ-issues": true}) {
			<a class="skip-link" href="#main-content">Zum Inhalt springen</a>
			<div class="issues-shell">
				@PortalSidebar(data.Portal)
				@IssuesContent(data)
			</div>
			@PortalMobileHeader(data.Portal, "Anliegen")
	}
}

templ IssuesStyles() {
	<style>
		:root{--ink:#20251f;--muted:#6b6f63;--soft:#9a9485;--line:#e7e0d2;--paper:#f7f3ea;--panel:#fffefb;--panel-soft:#fbf8f0;--gold:#c8993f;--gold-ink:#8a7b3f;--gold-light:#e7c574;--leaf:#2f6b4a;--nav:#172019;--nav-2:#20291f;--font-sans:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;--font-serif:ui-serif,Georgia,Cambria,"Times New Roman",serif;--space-1:4px;--space-2:8px;--space-3:12px;--space-4:16px;--space-5:20px;--space-6:24px;--radius-xs:7px;--radius-sm:8px;--radius-md:10px;--radius-lg:12px;--radius-xl:14px;--radius-pill:999px;--shadow-panel:0 12px 30px rgba(32,37,31,.04);--shadow-dialog:0 28px 70px rgba(0,0,0,.34);--shadow-md:0 18px 44px rgba(32,37,31,.08);font-family:var(--font-sans)}button,input,select,textarea{font:inherit}button{cursor:pointer}a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible{outline:2px solid var(--gold-light);outline-offset:2px}h1,h2,h3,p{margin:0}h1,h2,h3{font-family:var(--font-serif);font-weight:600}.skip-link{position:fixed;top:var(--space-2);left:var(--space-2);z-index:300;padding:var(--space-2) var(--space-3);background:var(--panel);border-radius:var(--radius-sm);transform:translateY(-160%)}
		.issues-shell{min-height:100vh;display:grid;grid-template-columns:240px minmax(0,1fr)}.sidebar{position:sticky;top:0;height:100vh;display:flex;flex-direction:column;padding:var(--space-5) var(--space-4) var(--space-4);background:var(--nav);color:var(--panel);overflow:auto}.context-menu button,.context-current{width:100%;display:grid;padding:var(--space-2);border:0;background:transparent;color:var(--panel);text-align:left}.nav-icon svg{display:block;width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.logout-form button{padding:4px;border:0;background:transparent;color:var(--soft)}.release-panel{position:fixed;z-index:250;left:var(--space-6);bottom:72px;width:min(520px,calc(100vw - 48px));max-height:70vh;overflow:auto;padding:var(--space-5);background:var(--panel);color:var(--ink);border:1px solid var(--line);border-radius:var(--radius-md);box-shadow:var(--shadow-dialog)}
		.issues-main{min-width:0;padding:42px clamp(var(--space-5),4vw,56px) 64px}.page-head{display:flex;align-items:end;justify-content:space-between;gap:var(--space-5);max-width:1120px;margin:0 auto var(--space-5)}.eyebrow{color:var(--gold-ink);font-size:9px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.page-head h1{margin-top:var(--space-1);font-size:42px;line-height:1}.lede{max-width:62ch;margin-top:var(--space-2);color:var(--muted);font-size:13px;line-height:1.5}.page-actions{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:var(--space-2)}.button{min-height:40px;display:inline-flex;align-items:center;justify-content:center;gap:var(--space-2);padding:var(--space-2) var(--space-4);border:1px solid var(--gold);border-radius:var(--radius-sm);background:transparent;color:var(--gold-ink);font-size:12px;font-weight:800}.button.primary{background:var(--gold);color:var(--panel)}.button.ghost{border-color:var(--line);color:var(--muted)}.issues-dashboard{max-width:1120px;margin:0 auto;display:grid;gap:var(--space-4)}.flash{padding:var(--space-3) var(--space-4);border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel-soft);font-size:13px}.flash.ok{border-color:var(--leaf);color:var(--leaf)}.panel{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius-md);box-shadow:var(--shadow-panel)}.issues-panel{padding:var(--space-5)}.section-head{display:flex;align-items:start;justify-content:space-between;gap:var(--space-4);padding-bottom:var(--space-4)}.section-head h2{margin-top:var(--space-1);font-size:26px}.section-head p{margin-top:var(--space-2);color:var(--muted);font-size:12px}.count{color:var(--muted);font-size:11px;white-space:nowrap}
		.issue-list{display:grid;gap:var(--space-3)}.issue-card{display:grid;gap:var(--space-3);padding:var(--space-4);border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel)}.issue-card-head{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:var(--space-3);align-items:start}.issue-card h3{font-size:20px;overflow-wrap:anywhere}.issue-location{margin-top:var(--space-1);color:var(--muted);font-size:12px}.issue-meta{display:flex;flex-wrap:wrap;justify-content:flex-end;align-items:center;gap:var(--space-2);color:var(--soft);font-size:11px}.pill{display:inline-flex;align-items:center;min-height:24px;padding:3px var(--space-2);border:1px solid var(--line);border-radius:var(--radius-pill);background:var(--panel-soft);color:var(--muted);font-size:10px;font-weight:750}.pill.status-open{color:var(--gold-ink)}.pill.status-progress,.pill.status-done{color:var(--leaf)}.issue-progress{height:5px;overflow:hidden;border-radius:var(--radius-pill);background:var(--line)}.issue-progress-fill{display:block;width:24%;height:100%;border-radius:inherit;background:var(--gold)}.issue-progress-fill.status-progress{width:66%;background:var(--leaf)}.issue-progress-fill.status-done,.issue-progress-fill.status-closed{width:100%;background:var(--leaf)}.issue-next-step,.issue-proposal,.issue-safety-note,.issue-estimate{padding:var(--space-3);border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel-soft);font-size:12px;line-height:1.45}.issue-proposal{color:var(--leaf)}.issue-detail-link{min-height:44px;display:flex;align-items:center;justify-content:space-between;gap:var(--space-3);padding-top:var(--space-2);border-top:1px solid var(--line);color:var(--muted);font-size:12px}.issue-detail-link strong{color:var(--gold-ink)}.issue-card-details{border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel-soft);overflow:hidden}.issue-card-details>summary{min-height:44px;display:flex;align-items:center;padding:var(--space-2) var(--space-3);cursor:pointer;font-size:12px;font-weight:800}.issue-card-details-body{display:grid;gap:var(--space-3);padding:var(--space-3);border-top:1px solid var(--line)}.issue-description{display:grid;gap:var(--space-1)}.issue-description strong{color:var(--gold-ink);font-size:10px;letter-spacing:.08em;text-transform:uppercase}.issue-description p,.muted{color:var(--muted);font-size:12px;line-height:1.5}
		.issue-create-panel{overflow:hidden}.issue-create-panel>summary{min-height:72px;display:flex;align-items:center;justify-content:space-between;gap:var(--space-3);padding:var(--space-4) var(--space-5);cursor:pointer;list-style:none}.issue-create-panel>summary::-webkit-details-marker{display:none}.issue-create-panel>summary h2,.issue-create-head h2{font-size:24px}.issue-create-panel>summary p,.issue-create-head p{margin-top:var(--space-1);color:var(--muted);font-size:12px}.issue-create-panel>summary::after{content:"Öffnen";color:var(--gold-ink);font-size:12px;font-weight:800}.issue-create-panel[open]>summary{border-bottom:1px solid var(--line)}.issue-create-panel[open]>summary::after{content:"Schließen"}.issue-create-head{padding:var(--space-4) var(--space-5);border-bottom:1px solid var(--line);background:var(--panel-soft)}.issue-create-body{padding:var(--space-5)}.issue-form{display:grid;gap:var(--space-5);max-width:860px;margin:0 auto}.issue-wizard-step{display:grid;gap:var(--space-4);min-width:0;padding:0;border:0}.issue-wizard-step[hidden]{display:none}.issue-wizard-heading{display:grid;gap:var(--space-1)}.issue-wizard-progress{color:var(--gold-ink);font-size:11px;font-weight:800}.issue-wizard-heading h3{font-size:30px}.issue-wizard-heading p{color:var(--muted);font-size:13px}.issue-safety-note a{color:var(--gold-ink);font-weight:800;text-decoration:underline}.issue-form label{display:grid;gap:var(--space-2);color:var(--gold-ink);font-size:11px;font-weight:800}.issue-form input,.issue-form textarea,.issue-form select,.issue-actions input,.issue-actions select,.comment-form textarea{width:100%;min-height:42px;padding:var(--space-2) var(--space-3);border:1px solid var(--line);border-radius:var(--radius-xs);background:var(--panel);color:var(--ink)}.issue-form textarea,.comment-form textarea{min-height:110px;resize:vertical}.hint{color:var(--soft);font-size:11px;font-weight:600}.issue-field-error{color:var(--gold-ink);font-size:12px}.issue-field-error[hidden]{display:none}.issue-category{display:grid;gap:var(--space-2)}.issue-category-options,.issue-location-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-2)}.issue-category-options{grid-template-columns:repeat(4,minmax(0,1fr))}.issue-category-choice,.issue-location-choice{position:relative;min-height:58px;display:grid!important;place-content:center;padding:var(--space-3);border:1px solid var(--line);border-radius:var(--radius-sm);color:var(--ink)!important;text-align:center}.issue-location-choice span{color:var(--muted);font-size:11px}.issue-category-choice input,.issue-location-choice input{position:absolute;width:1px;height:1px;opacity:0}.issue-category-choice:has(input:checked),.issue-location-choice:has(input:checked){border-color:var(--gold);background:var(--panel-soft)}.issue-file-row{display:flex;align-items:center;flex-wrap:wrap;gap:var(--space-3)}.file-control{position:relative;min-height:44px;display:flex;align-items:center;padding:var(--space-2) var(--space-3);border:1px dashed var(--line);border-radius:var(--radius-xs);background:var(--panel)}.file-control input{position:absolute;inset:0;opacity:0;cursor:pointer}.issue-review{display:grid;margin:0;border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel-soft)}.issue-review-enhanced{display:none}.issue-form.is-enhanced .issue-review-enhanced{display:grid}.issue-review-row{display:grid;grid-template-columns:120px minmax(0,1fr);gap:var(--space-3);padding:var(--space-3)}.issue-review-row+.issue-review-row{border-top:1px solid var(--line)}.issue-review-row dt{color:var(--muted);font-size:11px}.issue-review-row dd{margin:0;font-size:12px;overflow-wrap:anywhere}.issue-title-option{border-top:1px solid var(--line);padding-top:var(--space-2)}.issue-title-option>summary{min-height:44px;display:flex;align-items:center;cursor:pointer;font-size:12px;font-weight:800}.issue-title-option>label{margin-top:var(--space-2)}.issue-wizard-actions{display:flex;align-items:center;justify-content:space-between;gap:var(--space-3)}.issue-form button,.issue-actions button,.comment-form button{min-height:42px;padding:var(--space-2) var(--space-3);border:1px solid var(--ink);border-radius:var(--radius-xs);background:var(--ink);color:var(--panel);font-weight:800}.issue-form .wizard-only{display:none}.issue-form.is-enhanced .wizard-only{display:inline-flex;align-items:center;justify-content:center}.wizard-exit,.wizard-cancel,.wizard-back{color:var(--gold-ink);font-size:12px}.wizard-next,.wizard-submit{min-width:180px}.issue-start{display:grid}.issue-start .issue-create-panel{width:min(860px,100%);justify-self:center}
		.attachment-strip{display:grid;grid-template-columns:repeat(auto-fill,minmax(112px,1fr));gap:var(--space-2)}.attachment-item{position:relative;min-width:0}.attachment-open{width:100%;min-height:100%;display:grid;gap:6px;padding:7px;border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel);color:var(--ink);text-align:left}.attachment-open img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:var(--radius-xs);background:var(--line)}.attachment-file-icon{width:100%;aspect-ratio:4/3;display:grid;place-items:center;border-radius:var(--radius-xs);background:var(--panel-soft);color:var(--gold-ink);font-size:11px;font-weight:900}.attachment-name{min-width:0;color:var(--muted);font-size:10px;overflow-wrap:anywhere}.attachment-delete{position:absolute;top:var(--space-1);right:var(--space-1);margin:0}.attachment-delete button{width:30px;height:30px;border:1px solid var(--line);border-radius:var(--radius-xs);background:var(--panel);color:var(--ink)}.attachment-picker{display:none}.attachment-picker.has-files{display:grid}.attachment-lightbox{position:fixed;inset:0;z-index:300;display:none;grid-template-columns:48px minmax(0,1fr) 48px;grid-template-rows:48px minmax(0,1fr) auto;align-items:center;gap:var(--space-3);padding:var(--space-4);background:var(--nav);color:var(--panel)}.attachment-lightbox.open{display:grid}.attachment-lightbox figure{grid-column:2;grid-row:2;display:grid;place-items:center;gap:var(--space-3);min-width:0;min-height:0;margin:0}.attachment-lightbox img{max-width:100%;max-height:calc(100vh - 150px);object-fit:contain;border-radius:var(--radius-sm)}.lightbox-close,.lightbox-prev,.lightbox-next{border:1px solid var(--muted);border-radius:var(--radius-xs);background:var(--nav-2);color:var(--panel)}.lightbox-close{grid-column:3;grid-row:1;width:42px;height:42px}.lightbox-prev,.lightbox-next{width:46px;height:70px;font-size:26px}.lightbox-prev{grid-column:1;grid-row:2}.lightbox-next{grid-column:3;grid-row:2}
		.issue-estimate{display:grid;gap:var(--space-2)}.issue-estimate-head{display:flex;align-items:center;justify-content:space-between;gap:var(--space-3)}.comment-thread{display:grid;gap:var(--space-2)}.comment{display:grid;gap:var(--space-2);padding:var(--space-3);border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel)}.comment-head{display:flex;align-items:center;justify-content:space-between;gap:var(--space-2)}.comment-meta{color:var(--muted);font-size:11px}.comment p{font-size:12px;line-height:1.5}.comment-delete button{border:0;background:transparent;color:var(--gold-ink);font-size:11px}.comment-form{display:grid;gap:var(--space-2)}.comment-upload{display:grid;gap:var(--space-1)}.issue-actions{display:flex;flex-wrap:wrap;align-items:end;gap:var(--space-2)}.issue-actions label{display:grid;flex:1 1 170px;gap:var(--space-1);color:var(--gold-ink);font-size:10px;font-weight:800}.issue-actions form{margin:0}.issue-actions .ghost{background:transparent;color:var(--ink);border-color:var(--line)}
		.mobile-head{display:none}.menu>summary{list-style:none}.menu>summary::-webkit-details-marker{display:none}
		@media(max-width:900px){.issues-shell{grid-template-columns:210px minmax(0,1fr)}.issue-card-head{grid-template-columns:minmax(0,1fr)}.issue-meta{justify-content:flex-start}}
		@media(max-width:700px){.issues-shell{display:block}.sidebar{display:none}.mobile-head{position:sticky;z-index:100;top:0;min-height:76px;display:grid;grid-template-columns:42px 1fr 42px;align-items:center;gap:var(--space-3);padding:0 var(--space-4);background:var(--nav);color:var(--panel)}.mobile-identity strong,.mobile-identity small{display:block}.mobile-identity strong{font-family:var(--font-serif);font-size:21px}.mobile-identity small{margin-top:4px;color:var(--soft);font-size:10px}.mobile-head>.avatar{width:40px;height:40px}.menu>summary{width:42px;height:48px;display:grid;place-content:center;cursor:pointer}.hamburger,.hamburger::before,.hamburger::after{width:22px;height:2px;display:block;background:var(--panel);border-radius:var(--radius-pill)}.hamburger{position:relative}.hamburger::before,.hamburger::after{content:"";position:absolute;left:0}.hamburger::before{top:-7px}.hamburger::after{top:7px}.menu-panel{position:absolute;top:76px;left:0;right:0;max-height:calc(100vh - 76px);overflow:auto;padding:var(--space-3) var(--space-4) var(--space-5);background:var(--nav);box-shadow:var(--shadow-dialog)}.menu-panel .nav{grid-template-columns:1fr 1fr;margin-top:0}.menu-panel .nav a{min-height:44px;display:flex;margin:0;padding:0 var(--space-3)}.menu-panel .nav-label{grid-column:1/-1}.menu-panel .release-notes{padding:var(--space-3)}.menu-panel .logout-form button{min-height:44px}.issues-main{padding:var(--space-5) var(--space-4) 48px}.page-head{align-items:start;display:grid}.page-head h1{font-size:34px}.page-actions{justify-content:flex-start}.issues-panel,.issue-create-body{padding:var(--space-4)}.issue-category-options{grid-template-columns:repeat(2,minmax(0,1fr))}.issue-location-options{grid-template-columns:minmax(0,1fr)}.issue-review-row{grid-template-columns:minmax(0,1fr)}.issue-wizard-actions{align-items:stretch;display:grid}.wizard-next,.wizard-submit{width:100%}.release-panel{left:var(--space-3);bottom:var(--space-3);width:calc(100vw - 24px)}}
	</style>
}

templ IssuesContent(data IssuesPageData) {
	<main class="issues-main" id="main-content" tabindex="-1">
		<header class="page-head">
			<div><p class="eyebrow">Hausgemeinschaft</p><h1>Anliegen</h1><p class="lede">Mängel, Fragen und Vorschläge direkt an die Verwaltung melden.</p></div>
			if data.CanManageIssues || (data.IsServiceProvider && data.CalendarFeedURL != "") {
				<div class="page-actions">
					if data.IsServiceProvider && data.CalendarFeedURL != "" {
						<a class="button" href={ templ.SafeURL(data.CalendarFeedURL) }>Kalender abonnieren</a>
					}
					if data.CanManageIssues {
						<a class="button primary" href="/app/anliegen/board">Triage-Board</a>
					}
				</div>
			}
		</header>
		<div class="issues-dashboard">
			if data.Message != "" {
				<p class={ "flash", templ.KV("ok", data.MessageOK) }>{ data.Message }</p>
			}
			if len(data.Issues) > 0 {
				@IssuesList(data)
			}
			if data.CanCreateIssue {
				@IssueCreatePanel(data)
			} else if len(data.Issues) == 0 {
				<section class="panel issues-panel"><h2>{ data.IssuesEmpty.Title }</h2><p class="muted">{ data.IssuesEmpty.Message }</p></section>
			}
		</div>
	</main>
}

templ IssuesList(data IssuesPageData) {
	<section class="panel issues-panel" id="issue-own" aria-labelledby="issue-own-title">
		<header class="section-head"><div><p class="eyebrow">Verlauf</p><h2 id="issue-own-title">{ issuesListTitle(data) }</h2><p>Status und nächster Schritt auf einen Blick.</p></div><span class="count">{ len(data.Issues) } { issuesCountWord(len(data.Issues)) }</span></header>
		<div class="issue-list">
			for _, issue := range data.Issues {
				@IssueCard(issue)
			}
		</div>
	</section>
}

templ IssueCard(issue view.IssueView) {
	<article class="issue-card" id={ "issue-" + issue.ID }>
		<header class="issue-card-head"><div><h3>{ issue.Title }</h3><p class="issue-location">{ issue.Location }
			if issue.HasAssignee {
				<span> · Zuständig: { issue.AssigneeEmail }</span>
			}
		</p></div><div class="issue-meta"><span class={ "pill", issue.StatusClass }>{ issue.Status }</span><span class="pill">{ issue.Category }</span><span class="pill">{ issue.Priority }</span><span>{ issue.CreatedAt }</span></div></header>
		<div class="issue-progress" aria-label="Bearbeitungsfortschritt"><span class={ "issue-progress-fill", issue.StatusClass }></span></div>
		<p class="issue-next-step">{ issue.NextStep }</p>
		if issue.HasServiceAppointment {
			<p class="issue-proposal"><strong>Termin:</strong> { issue.ServiceAppointment }</p>
		}
		if issue.HasServiceProposal {
			<p class="issue-proposal"><strong>Hinweis:</strong> { issue.ServiceProposal }</p>
		}
		if issue.CanServiceUpdate {
			@IssueInlineDetails(issue)
		} else {
			<a class="issue-detail-link" href={ templ.SafeURL(issue.DetailURL) }><span>{ issueDetailLabel(issue) }</span><strong>{ issue.DetailAction } ›</strong></a>
		}
	</article>
}

templ IssueInlineDetails(issue view.IssueView) {
	<details class="issue-card-details"><summary>{ issueDetailsSummary(issue) }</summary><div class="issue-card-details-body">
		<div class="issue-description"><strong>Beschreibung</strong><p>{ issue.Body }</p></div>
		@IssueEstimate(issue)
		@IssueAttachments(issue.Attachments)
		if issue.HasComments {
			<div class="comment-thread">
				for _, comment := range issue.Comments {
					@IssueComment(comment)
				}
			</div>
		} else {
			<p class="muted">Noch keine Rückmeldung. Der aktuelle Status steht oben.</p>
		}
		if issue.CanComment {
			@IssueCommentForm(issue.ID)
		}
		@IssueServiceWorkflow(issue)
		@IssueResidentTransitions(issue)
	</div></details>
}

templ IssueEstimate(issue view.IssueView) {
	if issue.HasEstimate || issue.HasEstimateAttachments {
		<div class="issue-estimate"><div class="issue-estimate-head"><strong>Kostenvoranschlag</strong>
			if issue.EstimateAmount != "" {
				<span class="pill">{ issue.EstimateAmount }</span>
			}
		</div>
		if issue.EstimateNote != "" {
			<p>{ issue.EstimateNote }</p>
		}
		@IssueAttachments(issue.EstimateAttachments)
		<p class="muted">Orientierung für die Bearbeitung, keine Rechnung und kein Zahlungsstatus.</p></div>
	}
	if issue.CanEditEstimate {
		<form class="issue-actions" method="post" action="/app/anliegen/workflow" enctype="multipart/form-data"><input type="hidden" name="id" value={ issue.ID }/><input type="hidden" name="status" value={ issue.Status }/>
			if !issue.CanServiceUpdate {
				<input type="hidden" name="priority" value={ issue.Priority }/><input type="hidden" name="assignee_email" value={ issue.AssigneeEmail }/>
			}
			<label>Kostenschätzung<input type="text" name="estimate_amount" value={ issue.EstimateAmountValue } inputmode="decimal" placeholder="z. B. 240,00"/></label><label>Notiz<input type="text" name="estimate_note" value={ issue.EstimateNote } maxlength="240" placeholder="Kurz einordnen, kein Rechnungsstatus"/></label><label><span class="file-control"><input type="file" name="estimate_attachment" accept="image/jpeg,image/png,image/webp,image/gif,application/pdf"/><span>Kostenvoranschlag anhängen</span></span></label><button type="submit">Kostenvoranschlag speichern</button>
		</form>
	}
}

templ IssueComment(comment view.IssueCommentView) {
	<div class="comment" id={ "comment-" + comment.ID }><div class="comment-head"><span class="comment-meta">
		if comment.KindLabel != "" {
			<strong>{ comment.KindLabel }</strong><span> · </span>
		}
		{ comment.Author } · { comment.CreatedAt }</span>
		if comment.CanDelete {
			<form class="comment-delete" method="post" action={ templ.SafeURL(comment.DeleteURL) } data-confirm="Diesen Kommentar löschen?"><input type="hidden" name="comment_id" value={ comment.ID }/><button type="submit">Löschen</button></form>
		}
	</div><p>{ comment.Body }</p>@IssueAttachments(comment.Attachments)</div>
}

templ IssueCommentForm(issueID string) {
	<form class="comment-form" method="post" action="/app/anliegen/comment" enctype="multipart/form-data"><input type="hidden" name="id" value={ issueID }/><textarea name="body" maxlength="3000" placeholder="Kommentar oder Ergänzung schreiben" aria-label="Kommentar oder Ergänzung"></textarea><label class="comment-upload"><span class="file-control"><input type="file" name="attachments" accept="image/jpeg,image/png,image/webp,image/gif,application/pdf" multiple/><span>Anhang hinzufügen</span></span><span class="hint">Nur nötige Unterlagen teilen; keine Gesundheitsdaten oder Ausweiskopien.</span></label><button type="submit">Kommentar senden</button></form>
}

templ IssueServiceWorkflow(issue view.IssueView) {
	if issue.CanServiceUpdate {
		<form class="issue-actions" method="post" action="/app/anliegen/workflow"><input type="hidden" name="id" value={ issue.ID }/><label>Status<select name="status">
			for _, option := range issue.ServiceStatusOptions {
				<option value={ option.Value } selected?={ option.Selected }>{ option.Label }</option>
			}
		</select></label><label>Termin (Start)<input type="datetime-local" name="service_start" value={ issue.ServiceStartInput }/></label><label>Termin (Ende, optional)<input type="datetime-local" name="service_end" value={ issue.ServiceEndInput }/></label><label>Hinweis (optional)<input type="text" name="service_proposal" value={ issue.ServiceProposal } maxlength="180" placeholder="z. B. Zugang über Hinterhof"/></label><button type="submit">Status senden</button></form>
	}
}

templ IssueResidentTransitions(issue view.IssueView) {
	if issue.CanClose || issue.CanReopen {
		<div class="issue-actions">
			if issue.CanClose {
				<form method="post" action="/app/anliegen/workflow"><input type="hidden" name="id" value={ issue.ID }/><input type="hidden" name="status" value="Erledigt"/><button class="ghost" type="submit">Als erledigt melden</button></form>
			}
			if issue.CanReopen {
				<form method="post" action="/app/anliegen/workflow"><input type="hidden" name="id" value={ issue.ID }/><input type="hidden" name="status" value="Neu"/><button class="ghost" type="submit">Wieder öffnen</button></form>
			}
		</div>
	}
}

templ IssueAttachments(attachments []view.AttachmentView) {
	if len(attachments) > 0 {
		<div class="attachment-strip" aria-label="Anhänge">
			for _, attachment := range attachments {
				<div class="attachment-item">
					if attachment.IsImage {
						<button class="attachment-open" type="button" data-lightbox-src={ attachment.PreviewURL } data-lightbox-full={ attachment.URL } data-lightbox-caption={ attachment.Filename }><img src={ attachment.ThumbURL } alt={ attachment.Filename } loading="lazy" decoding="async"/><span class="attachment-name">{ attachment.Filename }</span></button>
					} else {
						<a class="attachment-open" href={ templ.SafeURL(attachment.URL) } target="_blank" rel="noopener"><span class="attachment-file-icon">{ attachmentKind(attachment) }</span><span class="attachment-name">{ attachment.Filename }</span></a>
					}
					if attachment.CanDelete {
						<form class="attachment-delete" method="post" action={ templ.SafeURL(attachment.DeleteURL) } data-confirm="Diesen Anhang entfernen?"><input type="hidden" name="id" value={ attachment.ID }/>
							if attachment.DeleteRedirect != "" {
								<input type="hidden" name="redirect" value={ attachment.DeleteRedirect }/>
							}
							<button type="submit" aria-label="Anhang entfernen">×</button></form>
					}
				</div>
			}
		</div>
	}
}

templ IssueCreatePanel(data IssuesPageData) {
	if len(data.Issues) > 0 {
		<details class="panel issue-create-panel" id="issue-new" open?={ data.OpenIssueCreate }><summary><div><h2>Neues Anliegen</h2><p>In zwei kurzen Schritten verständlich melden.</p></div></summary><div class="issue-create-body">@IssueCreateForm(true)</div></details>
	} else {
		<div class="issue-start"><section class="panel issue-create-panel" id="issue-new"><div class="issue-create-head"><h2>Erstes Anliegen melden</h2><p>In zwei kurzen Schritten verständlich melden.</p></div><div class="issue-create-body">@IssueCreateForm(false)</div></section></div>
	}
}

templ IssueCreateForm(hasIssues bool) {
	<form class="issue-form" id="issue-create-form" method="post" action="/app/anliegen" enctype="multipart/form-data" data-issue-wizard>
		<fieldset class="issue-wizard-step" data-issue-step="describe"><div class="issue-wizard-heading"><span class="issue-wizard-progress" data-issue-progress>Schritt 1 von 2</span><h3>Was ist passiert?</h3><p>Kurz beschreiben, einordnen und bei Bedarf ein Foto ergänzen.</p></div><p class="issue-safety-note">Akute Gefahr? 112 anrufen. Bei Wasseraustritt zuerst die <a href="/app/kontakte">Hauskontakte</a> öffnen. Erst danach hier melden.</p><label for="issue-body">Kurze Beschreibung<textarea id="issue-body" name="body" maxlength="4000" required aria-describedby="issue-body-error" placeholder="Zum Beispiel: Das Licht im Keller funktioniert nicht mehr."></textarea><span class="issue-field-error" id="issue-body-error" role="alert" hidden></span></label>
			<div class="issue-category"><span id="issue-category-label">Art des Anliegens</span><div class="issue-category-options" role="radiogroup" aria-labelledby="issue-category-label" aria-describedby="issue-category-error"><label class="issue-category-choice"><input type="radio" name="category" value="Reparatur" required checked/><span>Reparatur</span></label><label class="issue-category-choice"><input type="radio" name="category" value="Frage" required/><span>Frage</span></label><label class="issue-category-choice"><input type="radio" name="category" value="Vorschlag" required/><span>Vorschlag</span></label><label class="issue-category-choice"><input type="radio" name="category" value="Sonstiges" required/><span>Sonstiges</span></label></div><p class="issue-field-error" id="issue-category-error" role="alert" hidden></p></div>
			<div class="issue-location-options" role="radiogroup" aria-label="Bereich" aria-describedby="issue-location-error"><label class="issue-location-choice"><input type="radio" name="location_type" value="common" required checked/><strong>Gemeinschaftsbereich</strong><span>Stiegenhaus, Keller oder Garage</span></label><label class="issue-location-choice"><input type="radio" name="location_type" value="own-unit" required/><strong>Eigene Einheit</strong><span>Wohnung oder eigener Nebenraum</span></label></div><p class="issue-field-error" id="issue-location-error" role="alert" hidden></p><label for="issue-location-detail">Wo genau? <span class="hint">Optional</span><input id="issue-location-detail" type="text" name="location_detail" maxlength="160" placeholder="Zum Beispiel: Vorraum oder neben dem Fahrradraum"/></label><div class="issue-file-row"><label><span class="file-control"><input type="file" name="attachments" accept="image/jpeg,image/png,image/webp,image/gif,application/pdf" multiple/><span>Foto oder Datei hinzufügen</span></span></label><span class="hint">Optional · bis zu 10 Dateien, jeweils 10 MB</span></div><p class="hint">Keine Gesundheitsdaten, Ausweiskopien oder unnötig abgebildete Personen.</p><div class="issue-wizard-actions">
				if hasIssues {
					<button class="wizard-cancel wizard-only" type="button">Abbrechen</button>
				} else {
					<a class="wizard-exit" href="/app">Abbrechen</a>
				}
				<button class="wizard-next wizard-only" type="button" data-issue-next>Weiter</button></div>
		</fieldset>
		<fieldset class="issue-wizard-step" data-issue-step="review"><div class="issue-wizard-heading"><span class="issue-wizard-progress" data-issue-progress>Schritt 2 von 2</span><h3>Prüfen &amp; senden</h3><p>Ein kurzer Blick, dann ist die Verwaltung informiert.</p></div><dl class="issue-review issue-review-enhanced" aria-label="Zusammenfassung"><div class="issue-review-row"><dt>Art</dt><dd data-issue-summary="category">Reparatur</dd></div><div class="issue-review-row"><dt>Beschreibung</dt><dd class="issue-review-copy"><span class="issue-review-copy-text" data-issue-summary="body">—</span><button class="issue-review-expand" type="button" data-issue-review-expand aria-expanded="false" hidden>Vollständig lesen</button></dd></div><div class="issue-review-row"><dt>Ort</dt><dd data-issue-summary="location">Gemeinschaftsbereich</dd></div><div class="issue-review-row"><dt>Dateien</dt><dd data-issue-summary="files">Keine</dd></div></dl><details class="issue-title-option"><summary>Titel ändern <span class="hint">Optional</span></summary><label for="issue-title">Eigener Titel<input id="issue-title" type="text" name="title" maxlength="140" placeholder="Kurzer, passender Titel"/><span class="hint">Ohne Eingabe wird ein kurzer Titel aus der Beschreibung gebildet.</span></label></details><div class="issue-wizard-actions"><button class="wizard-back wizard-only" type="button" data-issue-back>Zurück</button><button class="wizard-submit" type="submit" data-busy-label="Meldung wird gesendet…">Anliegen melden</button></div></fieldset>
	</form>
}

func issuesListTitle(data IssuesPageData) string {
	if data.CanManageIssues { return "Meine eigenen Anliegen" }
	if data.Portal.Role == "Beirat" { return "Anliegen im Haus" }
	return "Meine letzten Anliegen"
}

func issuesCountWord(count int) string {
	if count == 1 { return "Anliegen" }
	return "Anliegen"
}

func issueDetailLabel(issue view.IssueView) string {
	switch issue.ResidentState {
	case "question": return "Ihre Antwort wird gebraucht"
	case "resolution": return "Ist das Anliegen erledigt?"
	default: return "Details und Verlauf"
	}
}

func issueDetailsSummary(issue view.IssueView) string {
	label := "Details & Verlauf"
	if issue.HasComments {
		label += " · " + strconv.Itoa(len(issue.Comments))
		if len(issue.Comments) == 1 { return label + " Beitrag" }
		return label + " Beiträge"
	}
	if issue.HasPhotos {
		label += " · " + strconv.Itoa(issue.PhotoCount) + " Foto"
		if issue.PhotoCount != 1 { label += "s" }
		return label
	}
	if issue.HasAttachments { return label + " · Anhänge" }
	return label
}
