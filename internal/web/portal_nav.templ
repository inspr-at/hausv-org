package web

import (
	"fmt"
	"strings"
)

// PortalSectionHeader is the compact counterpart to PortalSidebar for detail
// routes. Keeping its menu here ensures desktop and mobile use the same gated
// PortalNavigation instead of letting each route grow a second navigation.

templ PortalNavigation(data PortalPageData, icons bool, renderHouseHeader bool) {
	{{ shell := portalShellData(data) }}
	<nav class="nav" aria-label="Bereiche" data-two-level={ portalBool(shell.IsOrganisationMember) } data-tenant-slug={ data.TenantSlug } { portalNavAttrs(icons)... }>
		if shell.IsOrganisationMember {
			<span class="nav-group nav-level-label">Organisation</span>
			<span class="nav-organisation" data-navigation-block="organisation">
				@PortalNavItem("home", "Portfolio", "/app/verwaltung", data.Overview && data.Organisation.Active == "portfolio", 0, icons)
				if shell.ShowInboxNav {
					@PortalNavItem("issue", "Posteingang", "/app/verwaltung/posteingang", data.Overview && data.Organisation.Active == "inbox", shell.InboxOpenCount, icons)
				}
				if shell.CanManageOrganisationSettings {
					@PortalNavItem("document", "Textbausteine", "/app/verwaltung/textbausteine", data.Overview && data.Organisation.Active == "textbausteine", 0, icons)
					@PortalNavItem("users", "Rechte", "/app/verwaltung/rechte", data.Overview && data.Organisation.Active == "rechte", 0, icons)
					@PortalNavItem("settings", "Einstellungen", "/app/verwaltung/einstellungen", data.Overview && data.Organisation.Active == "settings", 0, icons)
				}
			</span>
		}
		<span class="nav-group nav-level-label nav-house-label">{ portalHouseGroupLabel(shell) }</span>
		if renderHouseHeader {
			@PortalSideMapHero(data)
		}
		<span class="nav-house-items" data-navigation-block="house-navigation">
			if data.CanUseResidentAreas {
				@PortalHouseNavItem(data, "home", "Hausüberblick", "/app", portalNavActive(data, "home"), 0, icons)
			}
			if data.CanUseResidentAreas && data.CanViewEnergy {
				@PortalEnergyNavItem(data, icons, portalIdentityScope(icons))
			}
			if data.CanUseResidentAreas && data.Modules.Announcements {
				@PortalHouseNavItem(data, "announcement", "Aushang", "/app/announcements", portalNavActive(data, "announcements"), data.UnreadAnnouncements, icons)
			}
			if data.CanUseResidentAreas && data.Modules.Events {
				@PortalHouseNavItem(data, "calendar", "Termine", "/app/events", portalNavActive(data, "events"), 0, icons)
			}
			if data.CanUseResidentAreas && data.Modules.Contacts {
				@PortalHouseNavItem(data, "contact", "Kontakte", "/app/kontakte", portalNavActive(data, "contacts"), 0, icons)
			}
			if data.CanUseResidentAreas && data.Modules.Documents {
				@PortalHouseNavItem(data, "document", "Dokumente", "/app/dokumente", portalNavActive(data, "documents"), 0, icons)
			}
			if data.Modules.Issues {
				if data.CanManageIssues {
					@PortalHouseNavItem(data, "issue", "Anliegen", "/app/anliegen/board", portalNavActive(data, "issues"), len(data.Issues), icons)
				} else {
					@PortalHouseNavItem(data, "issue", "Anliegen", "/app/anliegen", portalNavActive(data, "issues"), len(data.Issues), icons)
				}
			}
			if data.CanUseResidentAreas && data.Modules.Votes {
				@PortalHouseNavItem(data, "vote", "Abstimmungen", "/app/abstimmungen", portalNavActive(data, "votes"), 0, icons)
			}
			if data.CanUseResidentAreas && ((data.Modules.Parking && data.CanSeeParking) || (data.Modules.Handovers && data.CanManageHandovers) || (data.Modules.Users && data.CanManageUsers)) {
				<span class="nav-group">Verwaltung</span>
			}
			if data.CanUseResidentAreas && data.Modules.Parking && data.CanSeeParking {
				@PortalHouseNavItem(data, "parking", "Parkplatznutzung", "/app/parking", portalNavActive(data, "parking"), 0, icons)
			}
			if data.CanUseResidentAreas && data.Modules.Handovers && data.CanManageHandovers {
				@PortalHouseNavItem(data, "handover", "Übergaben", "/app/uebergaben", portalNavActive(data, "handovers"), 0, icons)
			}
			if data.CanUseResidentAreas && data.Modules.Users && data.CanManageUsers {
				@PortalHouseNavItem(data, "users", "Benutzer & Rechte", "/app/settings/users", portalNavActive(data, "users"), 0, icons)
			}
			if data.CanUseResidentAreas && data.Modules.Audit && data.CanViewAudit {
				@PortalHouseNavItem(data, "audit", "Verlauf", "/app/audit", portalNavActive(data, "audit"), 0, icons)
			}
			if data.CanUseResidentAreas {
				@PortalHouseNavItem(data, "settings", "Einstellungen", "/app/settings", portalNavActive(data, "settings"), 0, icons)
			}
			if data.Modules.Help {
				@PortalHouseNavItem(data, "help", "Hilfe", "/app/hilfe", portalNavActive(data, "help"), 0, icons)
			}
		</span>
	</nav>
}

func portalNavActive(data PortalPageData, page string) bool {
 if data.Overview { return false }
	if data.ActivePage == "" {
		return page == "home"
	}
	return data.ActivePage == page
}

templ PortalEnergyNavItem(data PortalPageData, icons bool, scope string) {
 if data.NavigationTenant != "" {
  @PortalHouseNavItem(data, "energy", portalHomeDisplayName(data), "/app/energie", false, 0, icons)
 } else {
	<a
		href="/app/energie"
		class={ "nav-item", templ.KV("active", portalNavActive(data, "energy")) }
		aria-current={ portalAriaCurrent(portalNavActive(data, "energy")) }
		data-home-identity={ scope }
		aria-label={ portalEnergyNavAria(data) }
	>
		if icons {
			<span class="nav-icon">@PortalIcon("energy")</span>
		}
		<span class="nav-label"><span class="nav-home-identity">
			<strong data-home-display-name>{ portalHomeDisplayName(data) }</strong>
			if data.HomeIdentity.HasUnit {
				<small data-home-unit-label>@UnitLabel(data.HomeIdentity.UnitLabel)</small>
			}
		</span></span>
	</a>
 }
}

// The navigation is rendered twice — sidebar and mobile menu — so the identity
// scopes must differ. With both called "nav", a locator taking the first match
// resolved to the copy inside a closed <details>.
// Only the sidebar copy is the addressable navigation; the mobile menu renders
// the same component and must not duplicate the id.
func portalNavAttrs(sidebar bool) templ.Attributes {
	if sidebar {
		return templ.Attributes{"id": "portal-navigation"}
	}
	return templ.Attributes{}
}

func portalIdentityScope(sidebar bool) string {
	if sidebar {
		return "nav"
	}
	return "mobile-menu"
}

func portalHomeDisplayName(data PortalPageData) string {
	if name := strings.TrimSpace(data.HomeIdentity.DisplayName); name != "" {
		return name
	}
	return "Mein Zuhause"
}

func portalEnergyNavAria(data PortalPageData) string {
	if strings.TrimSpace(data.HomeIdentity.AriaLabel) != "" {
		return data.HomeIdentity.AriaLabel
	}
	return "Mein Zuhause"
}

templ PortalNavItem(kind, label, url string, active bool, badge int, icons bool) {
	<a href={ templ.SafeURL(url) } class={ "nav-item", templ.KV("active", active) } aria-current={ portalAriaCurrent(active) }>
		if icons {
			<span class="nav-icon">@PortalIcon(kind)</span>
		}
		<span class="nav-label">{ label }</span>
		if badge > 0 {
			<span class="nav-badge">{ badge }</span>
		}
	</a>
}

func portalAriaCurrent(active bool) string {
	if active {
		return "page"
	}
	return "false"
}

templ PortalIcon(kind string) {
	if kind == "map-pin" {
		@PortalAssetIcon("map-pin")
	} else if kind == "building" {
		@PortalAssetIcon("building")
	} else if kind == "logout" {
		@PortalAssetIcon("log-out")
	} else {
		<svg viewBox="0 0 24 24" aria-hidden="true">
			switch kind {
				case "home": <path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10.5V20h13v-9.5"></path><path d="M9.5 20v-5h5v5"></path>
				case "energy": <path d="M4 13h5l2-7 3 12 2-5h4"></path><path d="M5 20h14"></path>
				case "announcement": <path d="M4 5h16v13H7l-3 3z"></path><path d="M8 9h8M8 13h6"></path>
				case "calendar": <path d="M7 3v4M17 3v4"></path><path d="M4.5 6h15v14h-15z"></path><path d="M4.5 10h15"></path>
				case "contact": <path d="M16 4h2.5A1.5 1.5 0 0 1 20 5.5v13A1.5 1.5 0 0 1 18.5 20h-13A1.5 1.5 0 0 1 4 18.5v-13A1.5 1.5 0 0 1 5.5 4H8"></path><path d="M8.5 3.5h7v4h-7z"></path><path d="M9 13a3 3 0 1 0 6 0"></path><path d="M7.5 18a4.5 4.5 0 0 1 9 0"></path>
				case "document": <path d="M7 3h7l3 3v15H7z"></path><path d="M14 3v4h4"></path><path d="M9 13h6M9 17h6"></path>
				case "issue": <path d="M5 18.5V6.5A2.5 2.5 0 0 1 7.5 4h9A2.5 2.5 0 0 1 19 6.5v6A2.5 2.5 0 0 1 16.5 15H10l-5 3.5z"></path>
				case "vote": <path d="M5 19V9M12 19V5M19 19v-7"></path><path d="M3.5 19h17"></path>
				case "parking": <path d="M5 16h14"></path><path d="m7 16 1.5-5h7L17 16"></path><path d="M7 16v3M17 16v3"></path><path d="M7 19h1M16 19h1"></path>
				case "handover": <path d="M7 4h10v16H7z"></path><path d="M9.5 8h5M9.5 12h4"></path><path d="m9.5 16 1.5 1.5 3.5-4"></path>
				case "users": <path d="M8.5 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"></path><path d="M3.5 20a5 5 0 0 1 10 0"></path><path d="M16 11.5a2.5 2.5 0 1 0 0-5"></path><path d="M17 15a4 4 0 0 1 3.5 4"></path>
				case "audit": <path d="M5 4h14v16H5z"></path><path d="M8 8h8M8 12h8M8 16h5"></path>
				case "settings": <path d="M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7z"></path><path d="M19 12a7 7 0 0 0-.1-1l2-1.5-2-3.5-2.4 1a7 7 0 0 0-1.8-1L14.4 3h-4.8L9.3 6a7 7 0 0 0-1.8 1l-2.4-1-2 3.5 2 1.5A7 7 0 0 0 5 12a7 7 0 0 0 .1 1l-2 1.5 2 3.5 2.4-1a7 7 0 0 0 1.8 1l.3 3h4.8l.3-3a7 7 0 0 0 1.8-1l2.4 1 2-3.5-2-1.5a7 7 0 0 0 .1-1z"></path>
				case "help": <circle cx="12" cy="12" r="9"></circle><path d="M9.7 9a2.5 2.5 0 1 1 3.2 2.4c-.7.3-.9.8-.9 1.6"></path><path d="M12 17h.01"></path>
				default: <path d="M5 4h14v16H5z"></path>
			}
		</svg>
	}
}

// PortalMobileHeader is the compact shell used by portal sub-pages. Keeping it
// in the shared portal template means every route uses the same permission-gated
// PortalNavigation instead of growing a second mobile navigation tree.


// Usually a house link stays in the authenticated session. Resuming a house
// after a private Home uses the same validated POST as the switcher, with a
// bounded continuation path. This also works without JavaScript.
templ PortalHouseNavItem(data PortalPageData, icon, label, url string, active bool, badge int, icons bool) {
 if data.NavigationTenant == "" {
  @PortalNavItem(icon, label, url, active, badge, icons)
 } else {
  <form method="post" action="/app/context" class="nav-resume-house">
   <input type="hidden" name="tenant" value={ data.NavigationTenant }/>
   <input type="hidden" name="role" value={ data.NavigationRole }/>
   <input type="hidden" name="next" value={ url }/>
   <button class="nav-item" type="submit">
    if icons {
 <span class="nav-icon">@PortalIcon(icon)</span>
 }
    <span class="nav-label">{ label }</span>
    if badge > 0 {
 <span class="nav-badge">{ fmt.Sprint(badge) }</span>
 }
   </button>
  </form>
 }
}
