package web

// Locally served typeface for the approved portal screen designs.
templ PortalSourceSerifStyles() {
	<style>
		@font-face{font-family:"Source Serif 4";font-style:normal;font-weight:600;font-display:swap;src:url("/assets/source-serif-4-semibold.woff2") format("woff2")}
		:root{--font-serif:"Source Serif 4",Georgia,serif}
	</style>
}
