package web

import (
	"fmt"

	"github.com/inspr-at/hausv-org/internal/version"
)

type VerwaltungShell struct {
	OrganisationName string
	RoleLabel        string
	DisplayName      string
	Initials         string
	Active           string
	InboxOpenCount   int
	ShowInboxNav     bool
	CanManageSettings bool
	Houses           []VerwaltungHouse
	Contexts         []PortalContext
	DisplayVersion   string
	ReleaseNotes     []version.Note
}

type VerwaltungHouse struct {
	Slug    string
	Name    string
	Address string
	Role    string
}

func PortalVerwaltungPage(shell VerwaltungShell, title string, body templ.Component) templ.Component {
	return portalVerwaltungPage(shell, title, nil, body)
}

// PortalVerwaltungPageWithScripts is PortalVerwaltungPage for a page that needs a
// script of its own next to the shell's. The portal CSP forbids inline scripts,
// so page behaviour reaches the browser only as a same-origin asset loaded here.
func PortalVerwaltungPageWithScripts(shell VerwaltungShell, title string, scripts []string, body templ.Component) templ.Component {
	return portalVerwaltungPage(shell, title, scripts, body)
}

templ portalVerwaltungPage(shell VerwaltungShell, title string, scripts []string, body templ.Component) {
	@PortalDocument(title + " · " + shell.OrganisationName, portalAssetVersion(), scripts, VerwaltungPageStyles(), templ.Attributes{"class": "verwaltung-page", "data-templ-verwaltung": true}) {
		<a class="skip-link" href="#main-content">Zum Inhalt springen</a>
		@VerwaltungMobileHeader(shell, title)
		<div class="shell verwaltung-shell" data-portal-shell>
			@VerwaltungSidebar(shell)
			<div class="portal-shell-content">
				<main id="main-content" class="portal-section-landing verwaltung-main" tabindex="-1" data-skip-target>
					@PortalSectionHeader(
						PortalSectionIdentityData{Label: "Verwaltung", Icon: "settings"},
						PortalSectionTitle(title),
						nil,
						nil,
					)
					<div class="portal-section-content">
						@body
					</div>
				</main>
			</div>
		</div>
		@ReleaseHistoryDialog(shell.ReleaseNotes)
	}
}

templ VerwaltungPageStyles() {
	@PortalStyles()
	<style>
		.verwaltung-page .verwaltung-houses>summary{display:flex}.verwaltung-page .verwaltung-houses .nav-label{flex:1}.verwaltung-house-count{min-width:22px;padding:2px 6px;border:1px solid var(--soft);border-radius:var(--radius-pill);color:var(--line);font-size:10px;text-align:center}.verwaltung-house-chevron{flex:0 0 auto;color:var(--soft);font-size:16px;transition:transform .16s}.verwaltung-houses[open] .verwaltung-house-chevron{transform:rotate(180deg)}.verwaltung-houses-empty{margin:0;padding:var(--space-2);color:var(--soft);font-size:10px}
		.verwaltung-page .portfolio-page,.verwaltung-page .portfolio-layout,.verwaltung-page .portfolio-houses,.verwaltung-page .portfolio-desktop-table,.verwaltung-page .portfolio-row-form,.verwaltung-page .portfolio-house-row>span{min-width:0}.verwaltung-page .portfolio-table-head,.verwaltung-page .portfolio-house-row{min-width:0;grid-template-columns:12px minmax(128px,1.35fr) 36px 58px 62px minmax(96px,.9fr) minmax(84px,.72fr)}.verwaltung-page .portfolio-house-copy strong{overflow:visible;text-overflow:clip;white-space:normal;overflow-wrap:anywhere}.verwaltung-page .portfolio-house-row>span:last-child{overflow-wrap:anywhere}.verwaltung-page .portfolio-quiet>summary{justify-content:center;margin-top:var(--space-2);padding:var(--space-2) var(--space-3);border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel-soft);color:var(--ink);font-weight:750;text-decoration:none}
		/* Column priority for the Häuser table (HAUSV-637). The card is 600px wide at
		   1440 and 520px at 1280; an inner scroller hid the Zuständig column there
		   without a visible bar. Drop Zuständig (≤1260), Nächster Termin (≤1120)
		   and Ältestes (≤950) as the card narrows — never scroll sideways inside
		   the card. The card itself is under 300px below ~900, which is the
		   two-column layout's problem, not the table's. */
		@media(max-width:1365px) and (min-width:761px){.verwaltung-page .portfolio-table-head,.verwaltung-page .portfolio-house-row{gap:var(--space-2);grid-template-columns:12px minmax(112px,1.35fr) 36px 58px 56px minmax(88px,.9fr) minmax(76px,.72fr)}}
		@media(max-width:1260px) and (min-width:1024px){.verwaltung-page .portfolio-table-head,.verwaltung-page .portfolio-house-row{grid-template-columns:12px minmax(90px,1.3fr) 36px 58px 56px minmax(80px,.9fr)}.verwaltung-page .portfolio-table-head>span:last-child,.verwaltung-page .portfolio-house-row>span:last-child{display:none}}
		@media(max-width:1120px) and (min-width:1024px){.verwaltung-page .portfolio-table-head,.verwaltung-page .portfolio-house-row{grid-template-columns:12px minmax(90px,1.3fr) 36px 58px 56px}.verwaltung-page .portfolio-table-head>span:nth-child(6),.verwaltung-page .portfolio-house-row>span:nth-child(6){display:none}}
		/* Tablet portrait (HAUSV-640): below 1024px the Häuser card stacks above the side cards
		   and is as wide as the page again (450px inside at 761px, 541px at 860px), so the
		   column drops keyed to the two-column band stop at 1024px. The house column gets
		   150px so "Münzgrabenstraße" no longer breaks mid-word: six columns from 761px,
		   all seven from 860px. */
		@media(max-width:859px) and (min-width:761px){.verwaltung-page .portfolio-table-head,.verwaltung-page .portfolio-house-row{grid-template-columns:12px minmax(150px,1.3fr) 36px 58px 56px minmax(80px,.9fr)}.verwaltung-page .portfolio-table-head>span:last-child,.verwaltung-page .portfolio-house-row>span:last-child{display:none}}
		@media(max-width:1023px) and (min-width:860px){.verwaltung-page .portfolio-table-head,.verwaltung-page .portfolio-house-row{grid-template-columns:12px minmax(150px,1.35fr) 36px 58px 56px minmax(88px,.9fr) minmax(76px,.72fr)}}
	</style>
}

templ VerwaltungSidebar(shell VerwaltungShell) {
	<aside class="sidebar verwaltung-sidebar" aria-label="Verwaltungsnavigation">
		<header class="organisation-identity"><strong>{ shell.OrganisationName }</strong><small>{ shell.RoleLabel }</small></header>
		@VerwaltungNavigation(shell, true)
		@VerwaltungPortalSwitch(shell.Contexts, false)
		<footer class="account"><span class="avatar" aria-hidden="true">{ shell.Initials }</span><span><strong>{ shell.DisplayName }</strong><small>{ shell.RoleLabel }</small>@VerwaltungReleaseNotes(shell)</span><form class="logout-form" method="post" action="/auth/logout"><button type="submit" aria-label="Abmelden" title="Abmelden">↪</button></form></footer>
	</aside>
}

templ VerwaltungMobileHeader(shell VerwaltungShell, pageLabel string) {
	<header class="mobile-head verwaltung-mobile-head">
		<details class="menu"><summary aria-label="Navigation öffnen"><span class="hamburger" aria-hidden="true"></span></summary><div class="menu-panel">
			@VerwaltungNavigation(shell, false)
			@VerwaltungPortalSwitch(shell.Contexts, true)
			@VerwaltungReleaseNotes(shell)
			<form class="logout-form" method="post" action="/auth/logout"><button type="submit">Als { shell.DisplayName } abmelden</button></form>
		</div></details>
		<a class="mobile-identity" href="/app/verwaltung"><strong>{ shell.OrganisationName }</strong><small>{ pageLabel }</small></a>
		<span class="avatar" aria-hidden="true">{ shell.Initials }</span>
	</header>
}

templ VerwaltungNavigation(shell VerwaltungShell, icons bool) {
	<nav class="nav verwaltung-nav" aria-label="Bereiche">
		@PortalNavItem("home", "Portfolio", "/app/verwaltung", shell.Active == "portfolio", 0, icons)
		if shell.ShowInboxNav {
			@PortalNavItem("issue", "Posteingang", "/app/verwaltung/posteingang", shell.Active == "inbox", shell.InboxOpenCount, icons)
		}
		<details class="verwaltung-houses">
			<summary class={ templ.KV("active", shell.Active == "houses") }>
				if icons {
					<span class="nav-icon">@PortalIcon("home")</span>
				}
				<span class="nav-label">Häuser</span><span class="verwaltung-house-count" aria-label={ fmt.Sprintf("%d verwaltete Häuser", len(shell.Houses)) }>{ fmt.Sprint(len(shell.Houses)) }</span><span class="verwaltung-house-chevron" aria-hidden="true">⌄</span>
			</summary>
			<div class="context-menu">
				if len(shell.Houses) == 0 {
					<p class="verwaltung-houses-empty">Keine verwalteten Häuser.</p>
				} else {
					for _, house := range verwaltungPortalHouses(shell.Houses) {
						@HousePickerRow(house, "")
					}
				}
			</div>
		</details>
		if shell.CanManageSettings {
			@PortalNavItem("document", "Textbausteine", "/app/verwaltung/textbausteine", shell.Active == "textbausteine", 0, icons)
			@PortalNavItem("users", "Rechte", "/app/verwaltung/rechte", shell.Active == "rechte", 0, icons)
			@PortalNavItem("settings", "Einstellungen", "/app/verwaltung/einstellungen", shell.Active == "settings", 0, icons)
		}
	</nav>
}

func verwaltungPortalHouses(houses []VerwaltungHouse) []PortalHouse {
	out := make([]PortalHouse, 0, len(houses))
	for _, house := range houses {
		out = append(out, PortalHouse{Slug: house.Slug, Name: house.Name, Address: house.Address, Role: house.Role})
	}
	return out
}

templ VerwaltungPortalSwitch(contexts []PortalContext, mobile bool) {
	if len(contexts) > 1 {
		<details class={ "context-switch", "verwaltung-portal-switch", templ.KV("mobile-context-switch", mobile) }><summary aria-label="Portal wechseln">Portal wechseln<span class="context-switch-chevron" aria-hidden="true">⌄</span></summary><div class="context-menu">
			for _, context := range contexts {
				if context.Current {
					<span class="context-current"><strong>{ context.HouseName }</strong><small>Aktives Portal</small></span>
				} else {
					<form method="post" action="/app/context"><input type="hidden" name="tenant" value={ context.TenantSlug }/><input type="hidden" name="role" value={ context.Role }/><button type="submit"><strong>{ context.HouseName }</strong></button></form>
				}
			}
		</div></details>
	}
}

// VerwaltungReleaseNotes renders the footer trigger; the notes live in the one
// ReleaseHistoryDialog the Verwaltung shell renders next to .shell.
templ VerwaltungReleaseNotes(shell VerwaltungShell) {
	@ReleaseNotesTrigger(shell.DisplayVersion)
}

templ VerwaltungPlaceholder() {
	<div class="card verwaltung-placeholder"><p>Dieser Bereich wird gerade gebaut.</p></div>
}
