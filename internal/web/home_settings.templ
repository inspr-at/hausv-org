package web

import "github.com/inspr-at/hausv-org/internal/view"

type HomeSettingsPageData struct {
	Portal              PortalPageData
	HomeIdentity        view.HomeIdentityView
	HouseholdName       string
	HomeType            string
	HomeTypeLabel       string
	HomeTypeDescription string
	HomeTypeLocked      bool
	HomeUnitLabel       string
	HomeUnitID          string
	HasHomeUnit         bool
	OfficialUnitTitle   string
	OfficialUnitSummary string
	UnitOptions         []view.SelectOption
	HasUnitOptions      bool
	From                string
	BackURL             string
	BackLabel           string
	Saved               bool
	Invalid             bool
}

templ HomeSettingsPage(data HomeSettingsPageData) {
	@SettingsFrame(data.Portal, "Zuhause", nil, HomeSettingsContent(data))
}

templ HomeSettingsContent(data HomeSettingsPageData) {
	@PortalSectionLanding(
		PortalSectionLandingData{
			Portal: data.Portal,
			PageLabel: "Zuhause",
			Class: "settings-main home-identity",
			Identity: PortalSectionIdentityData{Label: "Einstellungen · Mein Zuhause", Icon: "home", URL: "/app/settings"},
		},
		HomeSettingsTitle(data),
		HomeSettingsLede(data),
		HomeSettingsHeaderAction(data),
		nil,
		nil,
		HomeSettingsBody(data),
	)
}

templ HomeSettingsTitle(data HomeSettingsPageData) {
	<div data-home-identity="editor-heading" aria-label={ data.HomeIdentity.AriaLabel }>
		<h1 data-home-display-name>{ data.HouseholdName }</h1>
		if data.HasHomeUnit {
			<p class="home-unit" data-home-unit-label>{ data.HomeUnitLabel }</p>
		}
	</div>
}

templ HomeSettingsLede(_ HomeSettingsPageData) {
	<p>Anzeigename, Art und Zuordnung an einem Ort.</p>
}

templ HomeSettingsHeaderAction(data HomeSettingsPageData) {
	<a class="button" href={ templ.SafeURL(data.BackURL) }>{ data.BackLabel }</a>
}

templ HomeSettingsBody(data HomeSettingsPageData) {
	<div data-templ-home-settings>
		if data.Saved {
			@SettingsFlash("Der Anzeigename von „Mein Zuhause“ wurde gespeichert.", true)
		}
		if data.Invalid {
			@SettingsFlash("Bitte einen Namen und eine gültige Zuhause-Art auswählen.", false)
		}

		<section class="panel workspace"><header class="workspace-head"><div><span class="home-form-kicker">Ihr Zuhause</span><h2>Zuhause bearbeiten</h2><p>{ homeFormLede(data) }</p></div></header>
			<form method="post" action="/app/settings/home">
				<input type="hidden" name="from" value={ data.From }/>
				<div class="form-grid">
					<fieldset class="home-name-field"><legend>Anzeigename</legend><label>Anzeigename für „Mein Zuhause“<input type="text" name="household_name" value={ data.HouseholdName } placeholder="z. B. Dachwohnung" required maxlength="100"/></label></fieldset>
					<fieldset class="home-assignment-fields"><legend>Art &amp; Zuordnung</legend>
						if data.HomeTypeLocked {
							<label>Art des Zuhauses<input type="hidden" name="home_type" value={ data.HomeType }/><span class="readonly home-readonly"><strong>{ data.HomeTypeLabel }</strong><small>Durch die zugeordnete Wohneinheit festgelegt</small></span></label>
						} else {
							<label>Art des Zuhauses<select name="home_type" data-home-type-select aria-describedby="home-settings-type-explanation">
								@HomeTypeOption("apartment", "Wohnung", "Ein einzelner Haushalt in einem Mehrparteienhaus. Der Überblick konzentriert sich auf die Wohnung und ihre eigenen Geräte.", data.HomeType)
								@HomeTypeOption("house", "Einfamilienhaus", "Ein Haushalt mit eigenem Gebäude. Haus-, Heiz- und Energietechnik können gemeinsam betrachtet werden.", data.HomeType)
								@HomeTypeOption("community", "Hausgemeinschaft", "Mehrere Parteien und gemeinsam genutzte Anlagen. Der Überblick richtet sich an Eigentümergemeinschaft oder Hausverwaltung.", data.HomeType)
							</select></label>
						}
						if data.HasHomeUnit {
							<div><label>Zugeordnete offizielle Wohnung<input type="hidden" name="unit_id" value={ data.HomeUnitID }/><span class="readonly home-readonly"><strong>{ data.HomeUnitLabel }</strong><small>Diesem Hausprofil zugeordnet</small></span></label><small class="home-field-help">Die Sichtbarkeit folgt dieser Wohnung; ausdrücklich freigeschaltete technische Betreuung bleibt möglich.</small></div>
						} else if data.HasUnitOptions {
							<div data-home-unit-field><label>Zugeordnete offizielle Wohnung<select name="unit_id" required aria-describedby="home-settings-unit-help">
								for _, option := range data.UnitOptions {
									<option value={ option.Value } selected?={ option.Selected }>{ option.Label }</option>
								}
							</select></label><small class="home-field-help" id="home-settings-unit-help">Die Auswahl legt fest, welche Wohnung den Überblick sieht. Technische Freigaben bleiben separat.</small></div>
						} else {
							<input type="hidden" name="unit_id" value=""/>
						}
					</fieldset>
				</div>
				<div class="home-type-explanation" id="home-settings-type-explanation" data-home-type-explanation role="status" aria-live="polite"><span class="home-type-explanation-icon" aria-hidden="true">@PortalIcon("home")</span><div><strong data-home-type-label>{ data.HomeTypeLabel }</strong><p data-home-type-copy>{ data.HomeTypeDescription }</p><small>{ homeTypeScopeNote(data.HomeTypeLocked) } „Nur beobachten“ bleibt unverändert.</small></div></div>
				<div class="home-note"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 10v6M12 7h.01"></path></svg><div><strong>Was bleibt gleich?</strong><p>{ homeUnchangedNote(data) }</p></div></div>
				<footer class="form-actions"><a class="button ghost" href={ templ.SafeURL(data.BackURL) }>Abbrechen</a><button class="button primary" type="submit">Änderungen speichern</button></footer>
			</form>
		</section>
		<section class="panel home-map" aria-label="Namensbereiche">
			<div class="home-scope"><span>Liegenschaft</span><strong>{ data.Portal.HouseName }</strong><small>{ homeScopeAddress(data) }</small></div>
			<div class="home-scope current" data-home-identity="editor-summary" aria-label={ data.HomeIdentity.AriaLabel }><span>Mein Zuhause</span><strong data-home-display-name>{ data.HouseholdName }</strong>
				if data.HasHomeUnit {
					<small class="home-scope-unit" data-home-unit-label>{ data.HomeUnitLabel }</small>
				}
			<small class="home-scope-meta">{ homeScopeMeta(data) }</small></div>
			<div class="home-scope"><span>{ data.OfficialUnitTitle }</span><strong>{ data.OfficialUnitSummary }</strong><small>{ homeScopeUnitHint(data.HasHomeUnit) }</small></div>
		</section>
	</div>
}

templ HomeTypeOption(value, label, description, selected string) {
	<option value={ value } data-label={ label } data-description={ description } selected?={ value == selected }>{ label }</option>
}

func homeScopeAddress(data HomeSettingsPageData) string {
	if data.Portal.HouseName == data.Portal.Address {
		return "Name und Adresse der Liegenschaft"
	}
	return data.Portal.Address
}

func homeScopeMeta(data HomeSettingsPageData) string {
	if data.HasHomeUnit {
		return data.HomeTypeLabel
	}
	return data.HomeTypeLabel + " · Hausprofil"
}

func homeScopeUnitHint(hasUnit bool) string {
	if hasUnit {
		return "Diesem Hausprofil zugeordnet."
	}
	return "Legt fest, wem dieses Hausprofil gehört."
}

func homeFormLede(data HomeSettingsPageData) string {
	if data.HasHomeUnit {
		return "„" + data.HouseholdName + "“ ist der freundliche Name. „" + data.HomeUnitLabel + "“ bleibt die offizielle Einheit und wird hier eindeutig zugeordnet."
	}
	return "Der freundliche Name erscheint im Energie- und Wartungsbereich; die Stammdaten der Liegenschaft bleiben unverändert."
}

func homeTypeScopeNote(locked bool) string {
	if locked {
		return "Die Art ist mit der Wohnung verbunden."
	}
	return "Die Auswahl kann Geltungsbereich und Sichtbarkeit ändern."
}

func homeUnchangedNote(data HomeSettingsPageData) string {
	if data.HasHomeUnit {
		return "Name und Adresse der Liegenschaft sowie die offizielle Bezeichnung „" + data.HomeUnitLabel + "“ werden hier nicht umbenannt."
	}
	return "Name und Adresse der Liegenschaft werden hier nicht umbenannt."
}
