package web

import (
	"fmt"
	"strings"
	"github.com/inspr-at/hausv-org/internal/version"
	"github.com/inspr-at/hausv-org/internal/view"
)

type PortalModules struct {
	Energy, Announcements, Events, Contacts, Documents, Issues bool
	Votes, Parking, Handovers, Users, Audit, Help                bool
}

type PortalContext struct {
	TenantSlug, HouseName, Address, Role string
	Current                              bool
}

type PortalHouse struct {
	Slug, Name, Address, Role string
	OpenIssueCount            int
	Current                   bool
}

type PortalShellData struct {
	Context ScopeContext
	Ready                        bool
	OrganisationName             string
	RoleLabel                    string
	ManagedHouses                []PortalHouse
	PortalContexts               []PortalContext
	IsOrganisationMember         bool
	IsVerwaltung                 bool
	CanManageOrganisationSettings bool
	ShowInboxNav                 bool
	InboxOpenCount               int
	CurrentHousePosition         int
	// AvatarURL is the signed-in person's profile picture, empty when they have
	// none. It is assembled once in the server's portalShellData, so every page
	// that renders the shell shows the same tile (HAUSV-675).
	AvatarURL                    string
}

type PortalArea struct {
	Label, URL string
}

type PortalEnergy struct {
	Ready                            bool
	HomeName, Message                string
	ActionLabel, ActionURL           string
}

type PortalMapTile struct {
	URL, Style string
}

type PortalMap struct {
	Configured bool
	Tiles      []PortalMapTile
}

type PortalPageData struct {
	Organisation VerwaltungShell
	Overview bool
	NavigationTenant, NavigationRole string
	Title, TenantSlug, HouseName, Address, MapURL     string
	GreetingName, Today, DisplayName, Initials, Role  string
	DisplayVersion, ActivePage, HeroImageURL          string
	BrandIcon, BrandMarkSVG                           string
	Dense, CanUseResidentAreas, CanViewEnergy         bool
	CanManageIssues, CanCreateResidentIssue           bool
	CanSeeParking, CanManageHandovers, CanManageUsers bool
	CanViewAudit, HasPrimary, HasEnergy               bool
	Modules                                           PortalModules
	Primary                                           view.DashboardDigestItem
	Issues                                            []view.IssueView
	Events                                            []view.HouseEventView
	Announcements                                     []view.AnnouncementView
	UnreadAnnouncements                               int
	Energy                                            PortalEnergy
	HomeIdentity                                      view.HomeIdentityView
	Map                                               PortalMap
	Areas                                             []PortalArea
	Contexts                                          []PortalContext
	ReleaseNotes                                      []version.Note
	ShowVerwaltungNav                                 bool
	ShowInboxNav                                      bool
	InboxOpenCount                                    int
	RolePreview                                       *RolePreviewState
	RolePreviewChoices                                []RolePreviewChoice
	Flash                                             string
	Shell                                             PortalShellData
}

type PortalSectionIdentityData struct {
	Label, Icon, URL string
}

type PortalSectionLandingData struct {
	Portal    PortalPageData
	PageLabel string
	Class     string
	Hero      bool
	Wide      bool
	Identity  PortalSectionIdentityData
}

templ PortalDocument(title, assetVersion string, extraScripts []string, styles templ.Component, bodyAttributes templ.Attributes) {
	<!doctype html>
	<html lang="de-AT">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<title>{ title }</title>
			<link rel="preload" href={ portalSourceSerifURL(assetVersion) } as="font" type="font/woff2" crossorigin="anonymous"/>
			<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
			<script src={ "/assets/app.js?v=" + assetVersion } defer></script>
			// The house picker belongs to the shell, so it ships with every portal page
			// rather than being repeated inline (the app forbids inline scripts).
			<script src={ "/assets/switcher.js?v=" + assetVersion } defer></script>
			for _, script := range extraScripts {
				<script src={ "/assets/" + script + "?v=" + assetVersion } defer></script>
			}
			@PortalSourceSerifStyles(assetVersion)
			@PortalBaseStyles()
			<style>
				@media(max-width:400px){.verwaltung-mobile-head .mobile-identity strong{display:-webkit-box;overflow:hidden;font-size:18px;line-height:1.05;text-overflow:clip;white-space:normal;-webkit-box-orient:vertical;-webkit-line-clamp:2}.verwaltung-mobile-head .mobile-identity small{margin-top:2px}}
			</style>
			@styles
			<link rel="stylesheet" href={ "/assets/portal-shell.css?v=" + assetVersion }/>
		</head>
		<body data-authenticated-app { bodyAttributes... }>
			{ children... }
		</body>
	</html>
}

templ PortalShell(data PortalPageData, pageLabel string, content templ.Component) {
	<a class="skip-link" href="#main-content">Zum Inhalt springen</a>
	@PortalMobileHeader(data, pageLabel)
	<div class="shell" data-portal-shell>
		@PortalSidebar(data)
		<div class="portal-shell-content">
			@content
		</div>
	</div>
	@ReleaseHistoryDialog(data.ReleaseNotes)
}

templ PortalSectionLanding(data PortalSectionLandingData, title, lede, action, status, context, content templ.Component) {
	<main
		id="main-content"
		class={ "portal-section-landing", data.Class, templ.KV("has-hero", data.Hero), templ.KV("portal-section-wide", data.Wide), templ.KV("has-status", status != nil) }
		tabindex="-1"
		data-skip-target
		data-portal-section-landing
		data-portal-hero={ portalBool(data.Hero) }
	>
		if status != nil {
			@status
		}
		if data.Portal.Flash != "" {
			<div class="portal-flash" role="status">{ data.Portal.Flash }</div>
		}

		if data.Hero {
			@PortalSectionHero(data.Portal, PortalSectionHeader(data.Identity, title, lede, action))
		} else {
			@PortalSectionHeader(data.Identity, title, lede, action)
		}
		if context != nil {
			<div class="portal-section-context">
				@context
			</div>
		}
		<div class="portal-section-content">
			@content
		</div>
	</main>
}

templ PortalSectionHero(data PortalPageData, header templ.Component) {
	<section class="portal-section-hero" data-portal-section-hero>
		if data.HeroImageURL != "" {
			<img class="portal-section-hero-image" src={ templ.SafeURL(data.HeroImageURL) } alt=""/>
		}
		<div class="portal-section-hero-inner">
			@header
		</div>
	</section>
}

templ PortalSectionHeader(identity PortalSectionIdentityData, title, lede, action templ.Component) {
	<header class="portal-section-header" data-portal-section-header>
		<div class="portal-section-header-copy">
			if identity.Label != "" {
				@PortalSectionIdentity(identity)
			}
			<div class="portal-section-title">
				@title
			</div>
			if lede != nil {
				<div class="portal-section-lede">
					@lede
				</div>
			}
		</div>
		if action != nil {
			<div class="portal-section-header-action">
				@action
			</div>
		}
	</header>
}

templ PortalSectionIdentity(data PortalSectionIdentityData) {
	<div class="portal-section-identity">
		if data.Icon != "" {
			<span class="portal-section-identity-icon">@PortalIcon(data.Icon)</span>
		}
		if data.URL != "" {
			<a href={ templ.SafeURL(data.URL) }>{ data.Label }</a>
		} else {
			<span>{ data.Label }</span>
		}
	</div>
}

templ PortalSectionTitle(title string) {
	<h1>{ title }</h1>
}

templ PortalSectionLede(lede string) {
	<p>{ lede }</p>
}

templ PortalBaseStyles() {
	<style>
		*{box-sizing:border-box}html,body{min-height:100%;margin:0}body{min-width:320px;background:var(--paper);color:var(--ink);font-family:var(--font-sans)}a{color:inherit;text-decoration:none}.skip-link:focus{transform:translateY(0)}.side-map{position:absolute;inset:0;width:100%;height:100%;overflow:hidden;border:0;border-radius:0;background:#d8d2c4;color:inherit;isolation:isolate}.side-map::after{content:"";position:absolute;inset:0;z-index:2;pointer-events:none;background:linear-gradient(180deg,rgba(247,243,234,.08) 0%,rgba(23,32,25,.06) 48%,rgba(23,32,25,.48) 73%,rgba(23,32,25,.93) 94%,var(--nav) 100%);box-shadow:inset 0 -18px 28px rgba(23,32,25,.42)}.side-map-tiles{position:absolute;inset:0;z-index:1;pointer-events:none;filter:saturate(.54) sepia(.1) contrast(.86) brightness(.97)}.side-map-tile{position:absolute;width:256px;height:256px;max-width:none;display:block;user-select:none;pointer-events:none}.side-map-fallback{position:absolute;inset:0;z-index:1;display:grid;place-items:center;padding-bottom:72px;color:rgba(23,32,25,.68);background:linear-gradient(135deg,rgba(255,255,255,.3),transparent 55%),#d9d5c9;font-size:10.5px;font-weight:750;letter-spacing:.03em}.side-map-pin{position:absolute;left:50%;top:50%;z-index:4;width:44px;height:56px;color:var(--gold-light);filter:drop-shadow(0 6px 7px rgba(23,32,25,.38));transform:translate(-50%,-100%)}.side-map-pin-shape{position:absolute;inset:0;width:100%;height:100%;display:block;overflow:visible;fill:var(--nav);stroke:rgba(231,216,177,.88);stroke-width:1.25;stroke-linejoin:round}.side-map-pin-mark{position:absolute;left:50%;top:9px;width:25px;height:22px;display:grid;place-items:center;transform:translateX(-50%)}.side-map-pin-mark svg{width:25px;height:21px;display:block;stroke:currentColor;stroke-width:2.2;fill:none;stroke-linecap:round;stroke-linejoin:round}.side-address-label{min-width:0;display:grid;gap:2px;justify-self:start;color:inherit;font-family:var(--font-sans);line-height:1.2;text-decoration:none}.side-address-label small{overflow:hidden;color:rgba(255,255,255,.6);font-size:10.5px;font-weight:550;text-overflow:ellipsis;white-space:nowrap}.side-address-label:hover small{color:rgba(255,255,255,.86)}@media(min-width:761px) and (max-height:800px){.side-map-hero{height:168px}.side-map-pin{width:35px;height:45px}.side-map-pin-mark{top:7px;width:20px;height:18px}.side-map-pin-mark svg{width:20px;height:17px}}.context-menu{display:grid;gap:var(--space-2)}.context-menu small{color:var(--soft)}.nav{margin-top:var(--space-5);display:grid;gap:2px}.nav a{min-height:31px;display:grid;grid-template-columns:22px 1fr auto;align-items:center;gap:var(--space-2);margin-inline:calc(var(--space-2)*-1);padding:5px var(--space-2);border-radius:var(--radius-xs);color:var(--line);font-size:12px}.nav a:hover,.nav a.active{background:var(--nav-2)}.nav a.active{color:var(--panel);font-weight:700}.nav a.active svg{color:var(--gold)}.nav-badge{min-width:19px;padding:2px 5px;text-align:center;background:var(--gold);color:var(--nav);border-radius:var(--radius-pill);font-size:10px}.nav-group{margin:var(--space-3) 0 var(--space-1) 2px;color:var(--gold);font-size:9px;font-weight:800;letter-spacing:.15em;text-transform:uppercase}.nav-label{min-width:0;overflow:hidden;text-overflow:ellipsis}.account{margin-top:auto;padding-top:var(--space-4);border-top:1px solid var(--nav-2);display:grid;grid-template-columns:34px 1fr auto;align-items:center;gap:var(--space-3)}.avatar{display:inline-grid;place-items:center;width:34px;height:34px;overflow:hidden;background:var(--gold);color:var(--panel);border-radius:var(--radius-pill);font-size:12px}.avatar-image{width:100%;height:100%;display:block;object-fit:cover;border-radius:inherit}.account strong,.account small{display:block}.account strong{font-size:12px}.account small{margin-top:2px;color:var(--soft);font-size:10px}.release-trigger{min-height:20px;display:inline-flex;align-items:center;margin-top:2px;padding:0;border:0;background:transparent;color:var(--soft);cursor:pointer;font:inherit;font-size:10px;text-align:left}.release-trigger:hover,.release-trigger:focus-visible{color:var(--line);text-decoration:underline}.release-entry{padding-top:var(--space-4)}.release-entry:first-child{padding-top:0}.release-entry+.release-entry{margin-top:var(--space-4);border-top:1px solid var(--line)}.release-entry>small{color:var(--muted)}.release-entry>strong{display:block;margin-top:var(--space-1);font-family:var(--font-serif)}.release-entry p,.release-entry li{margin-top:var(--space-2);color:var(--muted);font-size:11px}.release-entry ul{padding-left:var(--space-5)}:root{--ink:#20251f;--muted:#6b6f63;--soft:#9a9485;--line:#e7e0d2;--paper:#f7f3ea;--panel:#fffefb;--panel-soft:#fbf8f0;--gold:#c8993f;--gold-ink:#8a7b3f;--gold-light:#e7c574;--leaf:#2f6b4a;--nav:#172019;--nav-2:#20291f;--font-sans:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;--font-serif:"Source Serif 4",ui-serif,Georgia,Cambria,"Times New Roman",serif;--space-1:4px;--space-2:8px;--space-3:12px;--space-4:16px;--space-5:20px;--space-6:24px;--radius-xs:7px;--radius-sm:8px;--radius-md:10px;--radius-lg:12px;--radius-xl:14px;--radius-pill:999px;--shadow-panel:0 12px 30px rgba(32,37,31,.04);--shadow-dialog:0 28px 70px rgba(0,0,0,.34);--shadow-md:0 18px 44px rgba(32,37,31,.08);font-family:var(--font-sans)}button,input,select,textarea{font:inherit}button{cursor:pointer}.skip-link{position:fixed;top:var(--space-2);left:var(--space-2);z-index:300;padding:var(--space-2) var(--space-3);background:var(--panel);border-radius:var(--radius-sm);transform:translateY(-160%)}.context-menu button,.context-current{width:100%;display:grid;padding:var(--space-2);border:0;background:transparent;color:var(--panel);text-align:left}.logout-form button{padding:4px;border:0;background:transparent;color:var(--soft)}.release-dialog{width:min(560px,calc(100vw - 32px));max-width:none;max-height:min(80vh,720px);margin:auto;padding:0;overflow:hidden;background:var(--panel);color:var(--ink);border:1px solid var(--line);border-radius:var(--radius-md);box-shadow:var(--shadow-dialog)}.release-dialog::backdrop{background:var(--portal-backdrop);-webkit-backdrop-filter:var(--portal-backdrop-filter);backdrop-filter:var(--portal-backdrop-filter)}.release-dialog-head{flex:0 0 auto;display:flex;align-items:center;justify-content:space-between;gap:var(--space-4);padding:var(--space-3) var(--space-3) var(--space-3) var(--space-5);border-bottom:1px solid var(--line)}.release-dialog-head h2{margin:0;font-family:var(--font-serif);font-size:20px;font-weight:600}.release-dialog-close{flex:0 0 auto;width:44px;height:44px;display:grid;place-items:center;padding:0;border:1px solid var(--line);border-radius:var(--radius-xs);background:var(--panel-soft);color:var(--ink);font-size:22px;line-height:1;text-decoration:none}.release-dialog-close:hover{background:var(--line)}.release-dialog-close-nojs{display:none}.release-dialog-body{flex:1 1 auto;min-height:0;overflow:auto;overscroll-behavior:contain;padding:var(--space-4) var(--space-5) var(--space-5)}.release-dialog:not([open]):target{position:fixed;z-index:400;top:50%;right:auto;bottom:auto;left:50%;display:flex;flex-direction:column;transform:translate(-50%,-50%);box-shadow:var(--shadow-dialog),0 0 0 100vmax rgba(23,32,25,.55)}.release-dialog:not([open]):target .release-dialog-close{display:none}.release-dialog:not([open]):target .release-dialog-close-nojs{display:grid}.button{min-height:40px;display:inline-flex;align-items:center;justify-content:center;gap:var(--space-2);padding:10px 18px;border:1px solid var(--gold);border-radius:var(--radius-sm);background:transparent;color:var(--gold-ink);font-size:12px;font-weight:800}.nav-home-identity{display:grid;gap:1px;line-height:1.08;min-width:0}.nav-home-identity strong,.nav-home-identity small{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.nav-home-identity small{color:var(--soft);font-size:10px}[hidden]{display:none!important}dialog[open]{display:flex;flex-direction:column}dialog[open]>form{display:flex;flex-direction:column;min-height:0;flex:1 1 auto}dialog[open] .dialog-head,dialog[open] .dialog-footer{flex:0 0 auto}dialog[open] .dialog-body{flex:1 1 auto;min-height:0;max-height:none;overflow:auto}@media(max-width:760px){.button,.button.small{min-height:44px!important}.dialog-close{min-width:44px!important;min-height:44px!important}details>summary{min-height:44px}}
				</style>
	<style>

		/* The navigation keeps a real box around every house item. The sidebar,
		   not this landmark, is the short-viewport scroll container. */
		.sidebar>.nav{display:grid;min-height:max-content}
		.portal-organisation-identity{display:grid;gap:3px;padding-bottom:14px;border-bottom:1px solid var(--nav-2)}
		.portal-organisation-identity strong{overflow:hidden;font-family:var(--font-serif);font-size:15px;line-height:1.15;text-overflow:ellipsis;white-space:nowrap}
		.portal-organisation-identity small{color:var(--soft);font-size:10px}
		.nav{margin-top:12px;gap:2px}
		.nav-level-label{margin:6px 0 4px;color:var(--gold);font-size:9px;letter-spacing:.16em}
		.nav-house-label{margin-top:14px;padding-top:12px;border-top:1px solid var(--nav-2)}
		.nav-organisation,.nav-house-items{display:grid;gap:2px}
		.nav>.house-picker,.nav>.house-header-card{grid-column:1/-1}
		.nav a.active{background:var(--gold-light);color:var(--nav);font-weight:800}
		.nav a.active svg{color:var(--nav)}
		.house-picker{position:relative;min-width:0;margin-bottom:5px}
		.house-picker>summary{list-style:none}
		.house-picker>summary::-webkit-details-marker{display:none}
		.house-header-card{min-height:56px;display:grid;grid-template-columns:minmax(0,1fr) 18px;align-items:center;gap:12px;margin-bottom:4px;padding:8px;border:1px solid var(--soft);border-radius:var(--radius-md);background:var(--nav-2);color:var(--panel)}
		.house-header-static{grid-template-columns:minmax(0,1fr)}
		.house-header-card:hover{border-color:var(--line)}
		.house-header-copy{min-width:0;display:grid;gap:4px}
		.house-header-copy strong{display:-webkit-box;overflow:hidden;overflow-wrap:anywhere;font-family:var(--font-serif);font-size:18px;line-height:1.05;-webkit-box-orient:vertical;-webkit-line-clamp:2}
		.house-header-copy small{overflow:hidden;color:var(--soft);font-size:10px;text-overflow:ellipsis;white-space:nowrap}
		.house-header-chevron{color:var(--line);font-size:19px;transition:transform .16s}
		.house-picker[open] .house-header-chevron{transform:rotate(180deg)}
		/* The hero bleeds exactly to the sidebar edge; both surfaces use
		   the same --sidebar-pad-x. */
		.side-map-hero{position:relative;min-width:0;height:208px;margin:8px calc(var(--sidebar-pad-x,18px)*-1) 8px;overflow:hidden}
		.nav .side-map-hero a.side-map{display:block;min-height:0;margin:0;padding:0;border-radius:0}
		.side-map-hero-empty{height:72px}
		.house-map-pin{left:50%;top:50%;right:auto;bottom:auto;width:26px;height:34px;color:var(--gold-light);transform:translate(-50%,-74%)}
		.house-map-pin .side-map-pin-mark{top:5px;width:15px;height:14px}
		.house-map-pin .side-map-pin-mark svg{width:15px;height:13px}
		/* The compact house card must preserve a usable map link without competing
		   with the picker trigger. Its copy is deliberately allowed two complete
		   lines; a clipped address makes the current house ambiguous. */
		.portal-organisation-identity strong{overflow:visible;overflow-wrap:anywhere;text-overflow:clip;white-space:normal}
		.house-header-card{grid-template-columns:minmax(0,1fr) 18px}
		.house-header-copy strong{overflow:visible;overflow-wrap:anywhere;hyphens:manual;-webkit-line-clamp:unset}
		.house-header-copy small{overflow:visible;text-overflow:clip;white-space:nowrap}
		@media(max-width:1050px) and (min-width:761px){.side-map-hero{height:176px}}
		@media(max-width:760px){
			.menu-panel{display:grid;padding:16px 18px 24px}
			.menu-panel .portal-organisation-identity{margin-bottom:10px}
			.menu-panel .nav-organisation,.menu-panel .nav-house-items,.menu-panel .nav-level-label,.menu-panel .house-picker{grid-column:1/-1}
			.menu-panel .nav a{padding:0 10px}
			.house-header-card{min-height:80px}

			/* The drawer clips its panel while closed; the card must stay a real tap target. */
			.menu-panel .house-header-card{min-width:44px;min-height:44px}
		}
	</style>
}


templ PortalPage(data PortalPageData) {
	@PortalDocument(data.Title, portalAssetVersion(), nil, PortalStyles(), templ.Attributes{"class": templ.Classes(templ.KV("dense", data.Dense), templ.KV("calm", !data.Dense)).String(), "data-templ-portal": true}) {
		@PortalContent(data)
	}
}

templ PortalStyles() {
			<style>a:focus-visible,button:focus-visible,summary:focus-visible{outline:2px solid var(--gold-light);outline-offset:2px}h1,h2,h3,p{margin:0}h1,h2,h3{font-family:var(--font-serif);font-weight:600}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.nav-icon svg{display:block;width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.greeting h1{font-size:34px;line-height:1.1;letter-spacing:-.02em}.greeting p{margin-top:var(--space-2);color:var(--muted);font-size:12px}.card{min-width:0;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius-md);box-shadow:var(--shadow-panel)}.card-head{min-height:34px;display:flex;align-items:baseline;gap:var(--space-3)}.card-head h2{font-size:23px;line-height:1}.card-head .count-label{color:var(--muted);font-size:11px}.all-link{margin-left:auto;color:var(--muted);font-size:11px;text-decoration:underline;text-underline-offset:3px}.empty{padding:var(--space-5);color:var(--muted);font-size:12px}.top-actions{display:flex;align-items:center;gap:var(--space-5)}.metrics{display:flex}.metric{min-width:92px;padding:0 var(--space-4);text-align:center;border-left:1px solid var(--line)}.metric:first-child{border-left:0}.metric strong{display:block;font-family:var(--font-serif);font-size:29px;font-weight:500;line-height:1}.metric:first-child strong{color:var(--gold)}.metric span{display:block;margin-top:var(--space-2);color:var(--muted);font-size:8px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.working-grid{min-height:0;display:grid;grid-template-columns:minmax(0,1.58fr) minmax(320px,1fr);gap:var(--space-5)}.issues-card{padding:var(--space-4) var(--space-5) var(--space-3);overflow:auto}table{width:100%;border-collapse:collapse;font-size:11px}th{height:31px;padding:0 8px;color:var(--muted);font-size:8px;letter-spacing:.1em;text-align:left;text-transform:uppercase}td{min-height:44px;padding:11px 8px;border-top:1px solid var(--line);vertical-align:middle}th:first-child,td:first-child{width:100px}th:nth-child(2),td:nth-child(2){min-width:0}th:nth-child(3),td:nth-child(3){min-width:0}th:nth-child(4),td:nth-child(4){width:120px}th:nth-child(5),td:nth-child(5){width:85px}th:nth-child(6),td:nth-child(6){width:100px;text-align:right}.status{display:inline-flex;align-items:center;gap:5px;min-width:0;color:var(--muted);font-size:9px;white-space:nowrap}.dot{display:inline-block;width:8px;height:8px;background:var(--soft);border-radius:var(--radius-pill)}.dot.gold{background:var(--gold)}.dot.green{background:var(--leaf)}.subject{display:block;overflow:hidden;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.place,.age{color:var(--muted)}.place{min-width:0;word-break:break-word;hyphens:auto}.side-stack{min-height:0;display:grid;grid-template-rows:1fr 1fr;gap:var(--space-4)}.agenda-card,.board-card{padding:var(--space-4) var(--space-5);overflow:auto}.agenda,.board-list{margin:var(--space-2) 0 0;padding:0;list-style:none}.agenda li+li,.board-list li+li{border-top:1px solid var(--line)}.agenda a{min-height:55px;display:grid;grid-template-columns:44px 1fr;align-items:center;gap:var(--space-3)}.date-chip{width:42px;height:42px;display:grid;place-content:center;background:var(--leaf);color:var(--panel);border-radius:var(--radius-sm);text-align:center}.date-chip strong{font-family:var(--font-serif);font-size:20px;font-weight:500;line-height:.8}.date-chip span{margin-top:5px;font-size:7px;font-weight:800}.item-copy strong,.item-copy span{display:block}.item-copy strong{overflow:hidden;font-size:11px;text-overflow:ellipsis;white-space:nowrap}.item-copy span{margin-top:3px;color:var(--muted);font-size:9px;white-space:normal;overflow-wrap:anywhere}.board-list a{min-height:48px;display:grid;grid-template-columns:8px 1fr;align-items:center;gap:var(--space-3)}.home-strip{display:grid;grid-template-columns:180px 1fr auto;align-items:center;padding:0 var(--space-5);background:var(--panel-soft);border:1px solid var(--line);border-radius:var(--radius-sm)}.home-strip h2{font-size:20px}.home-strip p{padding-left:var(--space-5);border-left:1px solid var(--line);color:var(--muted);font-size:11px}.home-strip a{color:var(--gold-ink);font-size:11px;font-weight:700}.utility-links{display:flex;align-items:center;flex-wrap:wrap;gap:var(--space-3);padding-top:var(--space-2);border-top:1px solid var(--line);color:var(--muted);font-size:9px}.utility-links a+a::before{content:"·";margin-right:var(--space-3);color:var(--soft)}.calm-column{width:min(700px,100%);min-height:calc(100vh - 76px);margin:0 auto;display:flex;flex-direction:column}.answer{margin-top:60px;font-size:30px;line-height:1.15}.disclosures{margin-top:var(--space-6);display:grid;gap:var(--space-3)}details.module{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius-md)}details.module>summary{min-height:62px;display:grid;grid-template-columns:12px 1fr auto 18px;align-items:center;gap:var(--space-3);padding:0 var(--space-5);cursor:pointer;list-style:none}details.module>summary::-webkit-details-marker,details.more>summary::-webkit-details-marker{display:none}details.module>summary::after{content:"⌄";color:var(--muted);font-size:19px}details.module[open]>summary::after{transform:rotate(180deg)}summary h3{font-size:19px}.summary-count{color:var(--muted);font-size:11px}.module-body{margin:0 var(--space-5) var(--space-4);padding:0 var(--space-4);background:var(--panel-soft);border:1px solid var(--line);border-radius:var(--radius-sm)}.rows{margin:0;padding:0;list-style:none}.row+.row{border-top:1px solid var(--line)}.row a{min-height:44px;display:grid;grid-template-columns:minmax(0,1fr) 110px 90px;align-items:center;gap:var(--space-3);font-size:11px}.row strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.row span,.row time{color:var(--muted)}.row time{text-align:right}details.more{border-top:1px solid var(--line)}details.more>summary{min-height:40px;display:flex;align-items:center;color:var(--muted);cursor:pointer;font-size:11px;list-style:none;text-decoration:underline;text-underline-offset:3px}.events .row a{grid-template-columns:48px minmax(0,1fr) 150px}.events .row time:first-child{width:39px;height:34px;display:grid;place-content:center;background:var(--leaf);color:var(--panel);border-radius:var(--radius-xs);text-align:center}.events .row time strong{font-family:var(--font-serif);font-size:15px;font-weight:500}.announcements .row a{grid-template-columns:9px minmax(0,1fr) 140px}.quiet-home{margin-top:auto;padding-top:64px;text-align:center;color:var(--muted);font-size:11px}.quiet-home a{text-decoration:underline}
				.issues-card table{table-layout:fixed}.issues-card tbody tr{cursor:pointer}.issues-card tbody tr:hover{background:var(--panel-soft)}.issues-card th:nth-child(3),.issues-card td:nth-child(3){width:auto}.place-text{display:-webkit-box;overflow:hidden;overflow-wrap:normal;word-break:normal;hyphens:auto;-webkit-box-orient:vertical;-webkit-line-clamp:2}.description{min-width:0;color:var(--muted)}.description-text{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
				/* Column priority for the dense Anliegen table (HAUSV-637). Fixed layout with
				   405px of fixed columns left Betreff and Beschreibung 62px at 1280 and 0px
				   below 1100, and headers painted over their neighbours. Headers clip,
				   Betreff wraps to two lines, and the low-priority columns leave first. */
				.issues-card th{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.issues-card th:first-child,.issues-card td:first-child{width:104px}.issues-card .status-label{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.issues-card th:nth-child(2),.issues-card td:nth-child(2){width:min(34ch,38%);white-space:nowrap}.issues-card th:nth-child(4),.issues-card td:nth-child(4){width:18%}.issues-card th:nth-child(5),.issues-card td:nth-child(5){width:82px}.issues-card th:nth-child(6),.issues-card td:nth-child(6){width:88px}.issues-card .subject{display:block;max-width:34ch;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
				@media(max-width:1399px){.issues-card th:nth-child(3),.issues-card td:nth-child(3){display:none}}
				@media(max-width:1150px){.issues-card th:nth-child(4),.issues-card td:nth-child(4){display:none}}
				@media(max-width:1000px){.issues-card th:nth-child(6),.issues-card td:nth-child(6){display:none}}
				@media(max-width:1050px) and (min-width:701px){.working-grid{grid-template-columns:minmax(0,1.4fr) minmax(290px,1fr);gap:var(--space-3)}.metric{min-width:72px;padding-inline:var(--space-2)}}
				/* Tablet portrait (HAUSV-640). Down to 1024px the side column keeps 290px and the
				   content column takes the rest: 146px for the Häuser card at 761px, 168px for the
				   Anliegen table at 768px. Below 1024px the side column stacks under the content
				   instead — content first, side cards after, two abreast where 320px each fit.
				   The phone layout (≤760px) swaps the whole body and is untouched. */
				@media(max-width:1023px) and (min-width:761px){.working-grid{grid-template-columns:minmax(0,1fr);gap:var(--space-4)}.side-stack{grid-template-rows:none;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr))}}
				@media(max-width:760px){body{padding-bottom:132px}.menu>summary{width:40px;height:48px;display:grid;place-content:center;cursor:pointer;list-style:none}.menu>summary::-webkit-details-marker{display:none}.menu-label{grid-column:1/-1;margin:var(--space-3) var(--space-3) var(--space-1);color:var(--gold);font-size:9px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.mobile-content{display:block;padding:var(--space-5) var(--space-4) var(--space-6)}.mobile-content .greeting h1{font-size:34px}.task-card{margin-top:var(--space-5);padding:var(--space-4);background:var(--panel);border:1px solid var(--line);border-radius:var(--radius-md);box-shadow:var(--shadow-panel)}.eyebrow{color:var(--gold-ink);font-size:9px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.task-card h2{margin-top:6px;font-size:24px;line-height:1.08}.task-card p{margin-top:var(--space-2);color:var(--muted);font-size:12px}.primary{min-height:48px;display:flex;align-items:center;justify-content:center;margin-top:var(--space-4);background:var(--gold);color:var(--panel);border-radius:var(--radius-sm);font-size:14px;font-weight:750}.counts{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-2);margin-top:var(--space-4)}.count-tile{min-height:72px;display:grid;place-content:center;text-align:center;background:var(--panel-soft);border:1px solid var(--line);border-radius:var(--radius-sm)}.count-tile strong{display:block;font-family:var(--font-serif);font-size:27px;font-weight:500;line-height:1}.count-tile span{display:block;margin-top:7px;color:var(--muted);font-size:7px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.mobile-section{margin-top:var(--space-5)}.mobile-section>h2{margin-bottom:var(--space-3);font-size:21px}.mobile-list{margin:0;padding:0;overflow:hidden;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius-sm);list-style:none}.mobile-list li+li{border-top:1px solid var(--line)}.mobile-event,.mobile-notice{min-height:63px;display:grid;grid-template-columns:42px 1fr 12px;align-items:center;gap:var(--space-3);padding:var(--space-2) var(--space-3)}.mobile-notice{grid-template-columns:9px 1fr 12px}.chevron{color:var(--muted);font-size:20px}.more-data{margin-top:var(--space-2)}.more-data>summary{min-height:34px;display:grid;place-content:center;color:var(--muted);cursor:pointer;font-size:11px;list-style:none;text-decoration:underline;text-underline-offset:3px}.more-data>summary::-webkit-details-marker{display:none}.more-data .mobile-list{margin-top:var(--space-2)}.thumb-zone{position:fixed;z-index:10;right:0;bottom:0;left:0;display:block;padding:var(--space-2) var(--space-3) max(var(--space-2),env(safe-area-inset-bottom));background:var(--paper)}.report{min-height:48px;display:flex;align-items:center;justify-content:center;gap:var(--space-2);background:var(--gold);color:var(--panel);border-radius:var(--radius-sm);font-size:14px;font-weight:800;box-shadow:var(--shadow-md)}.tabs{min-height:62px;display:grid;grid-template-columns:repeat(4,1fr);margin-top:var(--space-2);background:var(--panel);border:1px solid var(--line);border-radius:var(--radius-md);box-shadow:var(--shadow-panel)}.tabs>a,.bottom-more>summary{display:grid;place-content:center;gap:3px;text-align:center;color:var(--muted);font-size:9px;font-weight:700;list-style:none}.tabs>a.active{color:var(--gold)}.tab-icon svg{display:block;width:20px;height:20px;margin:auto;fill:none;stroke:currentColor;stroke-width:1.6}.bottom-more-panel{position:absolute;right:var(--space-3);bottom:72px;left:var(--space-3);display:grid;grid-template-columns:1fr 1fr;gap:var(--space-1);max-height:320px;overflow:auto;padding:var(--space-3);background:var(--nav);border:1px solid var(--nav-2);border-radius:var(--radius-md);box-shadow:var(--shadow-dialog)}.bottom-more-panel a{min-height:42px;display:flex;align-items:center;padding:0 var(--space-3);color:var(--line);font-size:11px}}
			</style>
}

templ PortalContent(data PortalPageData) {
	@PortalShell(data, data.Address, PortalHomeLanding(data))
}

func portalAssetVersion() string { return version.AssetVersion() }

func portalBool(value bool) string {
	if value {
		return "true"
	}
	return "false"
}

templ PortalSidebar(data PortalPageData) {
	{{ shell := portalShellData(data) }}
	<aside class="sidebar" aria-label="Navigation der Liegenschaft" data-navigation-surface="sidebar">
		@PortalOrganisationIdentity(shell)
		@PortalNavigation(data, true, true)
		<footer class="sidebar-release" data-navigation-block="release">@PortalReleaseNotes(data)</footer>
	</aside>
	@SidebarResizeHandle()
}

// PortalAvatarBadge fills the round account tile: the person's profile picture
// when they have one, their initials otherwise. The picture is decorative — the
// tile's own aria-label or the copy beside it already names the person — so the
// alt text stays empty rather than repeating the name to a screen reader.

templ PortalAvatarBadge(avatarURL string, initials string) {
	if avatarURL != "" {
		<img class="avatar-image" src={ avatarURL } alt="" width="34" height="34" decoding="async"/>
	} else {
		{ initials }
	}
}

templ PortalOrganisationIdentity(shell PortalShellData) {
	if shell.IsOrganisationMember {
		<header class="portal-organisation-identity" data-navigation-block="organisation-identity">
			<strong>{ shell.OrganisationName }</strong>
			<small>{ shell.RoleLabel }</small>
		</header>
	}
}

// PortalSectionHeader is the compact counterpart to PortalSidebar for detail
// routes. Keeping its menu here ensures desktop and mobile use the same gated
// PortalNavigation instead of letting each route grow a second navigation.

templ PortalNavigation(data PortalPageData, icons bool, renderHouseHeader bool) {
	{{ shell := portalShellData(data) }}
	<nav class="nav" aria-label="Bereiche" data-two-level={ portalBool(shell.IsOrganisationMember) } { portalNavAttrs(icons)... }>
		if shell.IsOrganisationMember {
			<span class="nav-group nav-level-label">Organisation</span>
			<span class="nav-organisation" data-navigation-block="organisation">
				@PortalNavItem("home", "Portfolio", "/app/verwaltung", data.Overview && data.Organisation.Active == "portfolio", 0, icons)
				if shell.ShowInboxNav {
					@PortalNavItem("issue", "Posteingang", "/app/verwaltung/posteingang", data.Overview && data.Organisation.Active == "inbox", shell.InboxOpenCount, icons)
				}
				if shell.CanManageOrganisationSettings {
					@PortalNavItem("document", "Textbausteine", "/app/verwaltung/textbausteine", data.Overview && data.Organisation.Active == "textbausteine", 0, icons)
					@PortalNavItem("users", "Rechte", "/app/verwaltung/rechte", data.Overview && data.Organisation.Active == "rechte", 0, icons)
					@PortalNavItem("settings", "Einstellungen", "/app/verwaltung/einstellungen", data.Overview && data.Organisation.Active == "settings", 0, icons)
				}
			</span>
		}
		<span class="nav-group nav-level-label nav-house-label">{ portalHouseGroupLabel(shell) }</span>
		if renderHouseHeader {
			@PortalHouseHeader(data, shell, icons)
		}
		if renderHouseHeader {
			@PortalSideMapHero(data)
		}
		<span class="nav-house-items" data-navigation-block="house-navigation">
			if data.CanUseResidentAreas {
				@PortalHouseNavItem(data, "home", "Hausüberblick", "/app", portalNavActive(data, "home"), 0, icons)
			}
			if data.CanUseResidentAreas && data.CanViewEnergy {
				@PortalEnergyNavItem(data, icons, portalIdentityScope(icons))
			}
			if data.CanUseResidentAreas && data.Modules.Announcements {
				@PortalHouseNavItem(data, "announcement", "Aushang", "/app/announcements", portalNavActive(data, "announcements"), data.UnreadAnnouncements, icons)
			}
			if data.CanUseResidentAreas && data.Modules.Events {
				@PortalHouseNavItem(data, "calendar", "Termine", "/app/events", portalNavActive(data, "events"), 0, icons)
			}
			if data.CanUseResidentAreas && data.Modules.Contacts {
				@PortalHouseNavItem(data, "contact", "Kontakte", "/app/kontakte", portalNavActive(data, "contacts"), 0, icons)
			}
			if data.CanUseResidentAreas && data.Modules.Documents {
				@PortalHouseNavItem(data, "document", "Dokumente", "/app/dokumente", portalNavActive(data, "documents"), 0, icons)
			}
			if data.Modules.Issues {
				if data.CanManageIssues {
					@PortalHouseNavItem(data, "issue", "Anliegen", "/app/anliegen/board", portalNavActive(data, "issues"), len(data.Issues), icons)
				} else {
					@PortalHouseNavItem(data, "issue", "Anliegen", "/app/anliegen", portalNavActive(data, "issues"), len(data.Issues), icons)
				}
			}
			if data.CanUseResidentAreas && data.Modules.Votes {
				@PortalHouseNavItem(data, "vote", "Abstimmungen", "/app/abstimmungen", portalNavActive(data, "votes"), 0, icons)
			}
			if data.CanUseResidentAreas && ((data.Modules.Parking && data.CanSeeParking) || (data.Modules.Handovers && data.CanManageHandovers) || (data.Modules.Users && data.CanManageUsers)) {
				<span class="nav-group">Verwaltung</span>
			}
			if data.CanUseResidentAreas && data.Modules.Parking && data.CanSeeParking {
				@PortalHouseNavItem(data, "parking", "Parkplatznutzung", "/app/parking", portalNavActive(data, "parking"), 0, icons)
			}
			if data.CanUseResidentAreas && data.Modules.Handovers && data.CanManageHandovers {
				@PortalHouseNavItem(data, "handover", "Übergaben", "/app/uebergaben", portalNavActive(data, "handovers"), 0, icons)
			}
			if data.CanUseResidentAreas && data.Modules.Users && data.CanManageUsers {
				@PortalHouseNavItem(data, "users", "Benutzer & Rechte", "/app/settings/users", portalNavActive(data, "users"), 0, icons)
			}
			if data.CanUseResidentAreas && data.Modules.Audit && data.CanViewAudit {
				@PortalHouseNavItem(data, "audit", "Verlauf", "/app/audit", portalNavActive(data, "audit"), 0, icons)
			}
			if data.CanUseResidentAreas {
				@PortalHouseNavItem(data, "settings", "Einstellungen", "/app/settings", portalNavActive(data, "settings"), 0, icons)
			}
			if data.Modules.Help {
				@PortalHouseNavItem(data, "help", "Hilfe", "/app/hilfe", portalNavActive(data, "help"), 0, icons)
			}
		</span>
	</nav>
}

// PortalMobileHeader is the shared compact shell for route-specific portal
// pages. Keeping its menu here ensures mobile and desktop use the same
// permission-gated navigation.
templ PortalMobileHeader(data PortalPageData, pageLabel string) {
	{{ scope := portalScopeContext(data) }}
	@Kontextleiste(scope, false, nil)
	@Kontextleiste(scope, true, PortalMobileNavigation(data))
}

templ PortalMobileNavigation(data PortalPageData) {
	@PortalOrganisationIdentity(portalShellData(data))
	@PortalNavigation(data, false, true)
	<footer class="sidebar-release" data-navigation-block="release">@PortalReleaseNotes(data)</footer>
}

func portalShellData(data PortalPageData) PortalShellData {
	if data.Shell.Ready {
		return data.Shell
	}
	shell := data.Shell
	shell.PortalContexts = data.Contexts
	shell.ShowInboxNav = data.ShowInboxNav
	shell.InboxOpenCount = data.InboxOpenCount
	seen := map[string]bool{}
	for _, context := range data.Contexts {
		if context.Role != "Admin" && context.Role != "Verwalter" || seen[context.TenantSlug] {
			continue
		}
		seen[context.TenantSlug] = true
		shell.ManagedHouses = append(shell.ManagedHouses, PortalHouse{
			Slug: context.TenantSlug, Name: context.HouseName, Address: context.Address,
			Role: context.Role, Current: context.Current,
		})
		if context.Current {
			shell.CurrentHousePosition = len(shell.ManagedHouses)
		}
	}
	shell.IsOrganisationMember = data.ShowVerwaltungNav || len(shell.ManagedHouses) > 1
	shell.IsVerwaltung = shell.IsOrganisationMember && (data.Role == "Admin" || len(shell.ManagedHouses) > 1)
	shell.CanManageOrganisationSettings = shell.IsOrganisationMember && data.Role == "Admin"
	if shell.IsOrganisationMember && strings.TrimSpace(shell.OrganisationName) == "" {
		shell.OrganisationName = "Verwaltung"
	}
	shell.RoleLabel = data.Role
	return shell
}

func portalHouseGroupLabel(shell PortalShellData) string {
	if len(shell.ManagedHouses) < 2 {
		return "Liegenschaft"
	}
	if !shell.IsOrganisationMember {
		return "Meine Liegenschaften"
	}
	position := shell.CurrentHousePosition
	if position < 1 {
		position = 1
	}
	return fmt.Sprintf("Liegenschaft · %d von %d", position, len(shell.ManagedHouses))
}

func portalHousePickerID(sidebar bool) string {
	if sidebar {
		return "portal-house-picker"
	}
	return "portal-house-picker-mobile"
}

func portalHousePickerShell(sidebar bool) string {
	if sidebar {
		return "sidebar"
	}
	return "mobile"
}

templ PortalHouseHeader(data PortalPageData, shell PortalShellData, sidebar bool) {
	<div class="nav-house-card" data-navigation-block="house-card">
  if data.Overview {
   @LiegenschaftSwitcher(portalScopeContext(data).Switcher, portalHousePickerID(sidebar), fmt.Sprintf("Alle Liegenschaften · %d", portalScopeContext(data).Switcher.Count), "Portfolio", portalHousePickerShell(sidebar))
  } else {
   @LiegenschaftSwitcher(portalScopeContext(data).Switcher, portalHousePickerID(sidebar), portalHouseTitle(data.HouseName, data.Address), portalHousePlace(data.Address), portalHousePickerShell(sidebar))
  }
 </div>
}

// PortalSideMapHero sits between the house selector and house navigation
// (HAUSV-680): full sidebar width, pin on the address, link to OpenStreetMap.
// Without coordinates it collapses to a short placeholder band.
templ PortalSideMapHero(data PortalPageData) {
 if data.Overview {
  <div class="side-map-hero side-map-portfolio" data-navigation-block="map" aria-label="Portfolioübersicht"><span>@PortalIcon("building")</span></div>
 } else {
	<div class={ "side-map-hero", templ.KV("side-map-hero-empty", !data.Map.Configured) } data-navigation-block="map">
	<a class="map side-map" href={ templ.SafeURL(data.MapURL) } target="_blank" rel="noopener noreferrer" aria-label={ data.Address + " in OpenStreetMap öffnen" } title={ data.Address + " in OpenStreetMap öffnen" } data-house-map-link>
		if data.Map.Configured {
			<span class="side-map-tiles">
				for _, tile := range data.Map.Tiles {
					<img class="side-map-tile" src={ templ.SafeURL(tile.URL) } style={ templ.SafeCSS(tile.Style) } width="256" height="256" alt="" draggable="false"/>
				}
			</span>
			<span class="side-map-pin">
				<svg class="side-map-pin-shape" viewBox="0 0 44 56" focusable="false"><path d="M22 55C18.7 49.2 4.5 36.7 4.5 22.2A17.5 17.5 0 1 1 39.5 22.2C39.5 36.7 25.3 49.2 22 55Z"></path></svg>
				if data.BrandMarkSVG != "" {
					<span class="side-map-pin-mark">@templ.Raw(data.BrandMarkSVG)</span>
				}
			</span>
		} else {
			<span class="side-map-fallback">Standort nicht hinterlegt</span>
		}
	</a>
	</div>
 }
}

func portalHousePlace(address string) string {
	parts := strings.Split(address, ",")
	return strings.TrimSpace(parts[len(parts)-1])
}

// portalHouseTitle keeps the house card from naming the place twice: a tenant
// without a display name falls back to its postal address (houseDisplayName),
// so "Janischhofweg 22, 8043 Graz" would sit above "8043 Graz". The strong
// line then carries the street only; the place stays in the small line.
func portalHouseTitle(name, address string) string {
	title := strings.TrimSpace(name)
	place := portalHousePlace(address)
	if place == "" || !strings.HasSuffix(title, place) || len(title) == len(place) {
		return title
	}
	street := strings.TrimSpace(strings.TrimSuffix(strings.TrimSpace(title[:len(title)-len(place)]), ","))
	if street == "" {
		return title
	}
	return street
}

func portalNavActive(data PortalPageData, page string) bool {
 if data.Overview { return false }
	if data.ActivePage == "" {
		return page == "home"
	}
	return data.ActivePage == page
}

templ PortalEnergyNavItem(data PortalPageData, icons bool, scope string) {
 if data.NavigationTenant != "" {
  @PortalHouseNavItem(data, "energy", portalHomeDisplayName(data), "/app/energie", false, 0, icons)
 } else {
	<a
		href="/app/energie"
		class={ "nav-item", templ.KV("active", portalNavActive(data, "energy")) }
		aria-current={ portalAriaCurrent(portalNavActive(data, "energy")) }
		data-home-identity={ scope }
		aria-label={ portalEnergyNavAria(data) }
	>
		if icons {
			<span class="nav-icon">@PortalIcon("energy")</span>
		}
		<span class="nav-label"><span class="nav-home-identity">
			<strong data-home-display-name>{ portalHomeDisplayName(data) }</strong>
			if data.HomeIdentity.HasUnit {
				<small data-home-unit-label>{ data.HomeIdentity.UnitLabel }</small>
			}
		</span></span>
	</a>
 }
}

// The navigation is rendered twice — sidebar and mobile menu — so the identity
// scopes must differ. With both called "nav", a locator taking the first match
// resolved to the copy inside a closed <details>.
// Only the sidebar copy is the addressable navigation; the mobile menu renders
// the same component and must not duplicate the id.
func portalNavAttrs(sidebar bool) templ.Attributes {
	if sidebar {
		return templ.Attributes{"id": "portal-navigation"}
	}
	return templ.Attributes{}
}

func portalIdentityScope(sidebar bool) string {
	if sidebar {
		return "nav"
	}
	return "mobile-menu"
}

func portalHomeDisplayName(data PortalPageData) string {
	if name := strings.TrimSpace(data.HomeIdentity.DisplayName); name != "" {
		return name
	}
	return "Mein Zuhause"
}

func portalEnergyNavAria(data PortalPageData) string {
	if strings.TrimSpace(data.HomeIdentity.AriaLabel) != "" {
		return data.HomeIdentity.AriaLabel
	}
	return "Mein Zuhause"
}

templ PortalNavItem(kind, label, url string, active bool, badge int, icons bool) {
	<a href={ templ.SafeURL(url) } class={ "nav-item", templ.KV("active", active) } aria-current={ portalAriaCurrent(active) }>
		if icons {
			<span class="nav-icon">@PortalIcon(kind)</span>
		}
		<span class="nav-label">{ label }</span>
		if badge > 0 {
			<span class="nav-badge">{ badge }</span>
		}
	</a>
}

func portalAriaCurrent(active bool) string {
	if active {
		return "page"
	}
	return "false"
}

templ PortalIcon(kind string) {
	if kind == "map-pin" {
		@PortalAssetIcon("map-pin")
	} else if kind == "building" {
		@PortalAssetIcon("building")
	} else if kind == "logout" {
		@PortalAssetIcon("log-out")
	} else {
		<svg viewBox="0 0 24 24" aria-hidden="true">
			switch kind {
				case "home": <path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10.5V20h13v-9.5"></path><path d="M9.5 20v-5h5v5"></path>
				case "energy": <path d="M4 13h5l2-7 3 12 2-5h4"></path><path d="M5 20h14"></path>
				case "announcement": <path d="M4 5h16v13H7l-3 3z"></path><path d="M8 9h8M8 13h6"></path>
				case "calendar": <path d="M7 3v4M17 3v4"></path><path d="M4.5 6h15v14h-15z"></path><path d="M4.5 10h15"></path>
				case "contact": <path d="M16 4h2.5A1.5 1.5 0 0 1 20 5.5v13A1.5 1.5 0 0 1 18.5 20h-13A1.5 1.5 0 0 1 4 18.5v-13A1.5 1.5 0 0 1 5.5 4H8"></path><path d="M8.5 3.5h7v4h-7z"></path><path d="M9 13a3 3 0 1 0 6 0"></path><path d="M7.5 18a4.5 4.5 0 0 1 9 0"></path>
				case "document": <path d="M7 3h7l3 3v15H7z"></path><path d="M14 3v4h4"></path><path d="M9 13h6M9 17h6"></path>
				case "issue": <path d="M5 18.5V6.5A2.5 2.5 0 0 1 7.5 4h9A2.5 2.5 0 0 1 19 6.5v6A2.5 2.5 0 0 1 16.5 15H10l-5 3.5z"></path>
				case "vote": <path d="M5 19V9M12 19V5M19 19v-7"></path><path d="M3.5 19h17"></path>
				case "parking": <path d="M5 16h14"></path><path d="m7 16 1.5-5h7L17 16"></path><path d="M7 16v3M17 16v3"></path><path d="M7 19h1M16 19h1"></path>
				case "handover": <path d="M7 4h10v16H7z"></path><path d="M9.5 8h5M9.5 12h4"></path><path d="m9.5 16 1.5 1.5 3.5-4"></path>
				case "users": <path d="M8.5 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"></path><path d="M3.5 20a5 5 0 0 1 10 0"></path><path d="M16 11.5a2.5 2.5 0 1 0 0-5"></path><path d="M17 15a4 4 0 0 1 3.5 4"></path>
				case "audit": <path d="M5 4h14v16H5z"></path><path d="M8 8h8M8 12h8M8 16h5"></path>
				case "settings": <path d="M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7z"></path><path d="M19 12a7 7 0 0 0-.1-1l2-1.5-2-3.5-2.4 1a7 7 0 0 0-1.8-1L14.4 3h-4.8L9.3 6a7 7 0 0 0-1.8 1l-2.4-1-2 3.5 2 1.5A7 7 0 0 0 5 12a7 7 0 0 0 .1 1l-2 1.5 2 3.5 2.4-1a7 7 0 0 0 1.8 1l.3 3h4.8l.3-3a7 7 0 0 0 1.8-1l2.4 1 2-3.5-2-1.5a7 7 0 0 0 .1-1z"></path>
				case "help": <circle cx="12" cy="12" r="9"></circle><path d="M9.7 9a2.5 2.5 0 1 1 3.2 2.4c-.7.3-.9.8-.9 1.6"></path><path d="M12 17h.01"></path>
				default: <path d="M5 4h14v16H5z"></path>
			}
		</svg>
	}
}


templ PortalHomeLanding(data PortalPageData) {
	@PortalSectionLanding(
		PortalSectionLandingData{
			Portal: data,
			PageLabel: data.Address,
			Class: portalHomeLandingClass(data),
			Hero: true,
			Identity: PortalSectionIdentityData{Label: "Hausüberblick · " + data.HouseName},
		},
		PortalHeroGreeting(data),
		nil,
		PortalHomeHeaderAction(data),
		nil,
		nil,
		PortalHomeBody(data),
	)
}

func portalHomeLandingClass(data PortalPageData) string {
	if data.Dense {
		return "portal-home-landing dense-main"
	}
	return "portal-home-landing calm-main"
}

templ PortalHeroGreeting(data PortalPageData) {
	<div class="greeting">
		if portalShellData(data).IsVerwaltung {
			<h1>{ data.HouseName }</h1>
		} else {
			<h1>Hallo { data.GreetingName }.</h1>
		}
		<p>{ portalHomeDateLine(data) }</p>
	</div>
}

func portalHomeDateLine(data PortalPageData) string {
	if strings.TrimSpace(data.Address) == "" {
		return data.Today
	}
	return data.Address + " · " + data.Today
}

templ PortalHomeHeaderAction(data PortalPageData) {
	<div class="top-actions">
		<div class="metrics" aria-label="Kennzahlen">
			if data.Modules.Issues {
				<a class="metric" href={ templ.SafeURL(portalIssuesURL(data)) }><strong>{ len(data.Issues) }</strong><span>offene Anliegen</span></a>
			}
			if data.Modules.Events {
				<a class="metric" href="/app/events"><strong>{ len(data.Events) }</strong><span>Termine</span></a>
			}
			if data.Modules.Announcements {
				<a class="metric" href="/app/announcements"><strong>{ data.UnreadAnnouncements }</strong><span>neue Beiträge</span></a>
			}
		</div>
		if data.Modules.Issues && data.CanCreateResidentIssue {
			<a class="button" href="/app/anliegen?new=1#issue-new">Anliegen melden</a>
		}
	</div>
}

templ PortalHomeBody(data PortalPageData) {
	<div class="portal-home-desktop">
		if data.Dense {
			@PortalDense(data)
		} else {
			@PortalCalm(data)
		}
	</div>
	@PortalMobile(data)
}

templ PortalDense(data PortalPageData) {
	<div class="dense-home-body">
		<section class="working-grid" aria-label="Arbeitsüberblick">
			if data.Modules.Issues {
				@DenseIssues(data)
			}
			<div class="side-stack">
				if data.Modules.Events {
					@DenseEvents(data)
				}
				if data.Modules.Announcements {
					@DenseAnnouncements(data)
				}
			</div>
		</section>
		if data.HasEnergy {
			<section class="home-strip" aria-labelledby="home-title"><h2 id="home-title">{ data.Energy.HomeName }</h2><p>{ data.Energy.Message }</p><a href={ templ.SafeURL(data.Energy.ActionURL) }>{ data.Energy.ActionLabel } →</a></section>
		}
		@PortalUtilities(data)
	</div>
}

templ DenseIssues(data PortalPageData) {
	<section class="card issues-card" aria-labelledby="issues-title"><header class="card-head"><h2 id="issues-title">Anliegen</h2><span class="count-label">{ len(data.Issues) } offen</span><a class="all-link" href={ templ.SafeURL(portalIssuesURL(data)) }>Alle anzeigen</a></header>
		if len(data.Issues) == 0 {
			<p class="empty">Nichts offen.</p>
		}
		if len(data.Issues) > 0 {
			<table><caption class="sr-only">Offene Anliegen mit Status, Betreff, Beschreibung, Ort, Alter und Zuständigkeit</caption><thead><tr><th>Status</th><th>Betreff</th><th>Beschreibung</th><th>Ort</th><th>Alter</th><th>Zuständig</th></tr></thead><tbody>
				for _, issue := range data.Issues {
					<tr data-href={ issue.DetailURL }><td><span class="status"><span class={ "dot", templ.KV("gold", issue.StatusLabel == "Neu"), templ.KV("green", issue.StatusLabel == "In Arbeit") }></span><span class="status-label">{ issue.StatusLabel }</span></span></td><td><a class="subject" href={ templ.SafeURL(issue.DetailURL) }>{ issue.Title }</a></td><td class="description"><span class="description-text" title={ issue.Body }>{ issue.Description }</span></td><td class="place"><span class="place-text" title={ issue.Location }>{ issue.Location }</span></td><td class="age">{ issue.CreatedAt }</td><td title={ issue.AssigneeEmail }>{ issue.AssigneeName }</td></tr>
				}
			</tbody></table>
		}
	</section>
}

templ DenseEvents(data PortalPageData) {
	<section class="card agenda-card"><header class="card-head"><h2>Nächste Termine</h2><span class="count-label">{ len(data.Events) }</span></header>
		if len(data.Events) == 0 {
			<p class="empty">Kein Termin eingetragen.</p>
		}
		if len(data.Events) > 0 {
			<ol class="agenda">
				for _, event := range data.Events {
					<li><a href="/app/events"><time class="date-chip"><strong>{ event.DateBadgeDay }</strong><span>{ event.DateBadgeMonth }</span></time><span class="item-copy"><strong>{ event.Title }</strong><span>{ event.TimeRange }
						if event.HasLocation {
							<span> · { event.Location }</span>
						}
					</span></span></a></li>
				}
			</ol>
		}
	</section>
}

templ DenseAnnouncements(data PortalPageData) {
	<section class="card board-card"><header class="card-head"><h2>Am Aushang</h2><span class="count-label">{ data.UnreadAnnouncements } neu</span></header>
		if len(data.Announcements) == 0 {
			<p class="empty">Der Aushang ist leer.</p>
		}
		if len(data.Announcements) > 0 {
			<ul class="board-list">
				for _, item := range data.Announcements {
					<li><a href="/app/announcements"><span class={ "dot", templ.KV("gold", item.Unread) }></span><span class="item-copy"><strong>{ item.Title }</strong><span>{ item.Category } · { item.PublishedAt }</span></span></a></li>
				}
			</ul>
		}
	</section>
}

templ PortalCalm(data PortalPageData) {
	<div class="calm-column">
		<h2 class="answer">{ calmAnswer(data) }</h2>
		<section class="disclosures" aria-label="Was Sie betrifft">
			if data.Modules.Issues {
				@CalmIssues(data)
			}
			if data.Modules.Events {
				@CalmEvents(data)
			}
			if data.Modules.Announcements {
				@CalmAnnouncements(data)
			}
		</section>
		if data.HasEnergy {
			<p class="quiet-home">{ data.Energy.Message } <a href={ templ.SafeURL(data.Energy.ActionURL) }>{ data.Energy.ActionLabel }</a></p>
		}
		@PortalUtilities(data)
	</div>
}

templ CalmIssues(data PortalPageData) {
	<details class="module" open><summary><span class="dot gold" aria-hidden="true"></span><h3>Anliegen</h3><span class="summary-count">{ len(data.Issues) } offen</span></summary><div class="module-body"><ol class="rows">
		for index, issue := range data.Issues {
			if index < 3 {
				<li class="row"><a href={ templ.SafeURL(issue.DetailURL) }><strong>{ issue.Title }</strong><span>{ issue.Location }</span><time>{ issue.CreatedAt }</time></a></li>
			}
		}
	</ol>
	if len(data.Issues) > 3 {
		<details class="more"><summary>Alle { len(data.Issues) } Anliegen anzeigen</summary><ol class="rows" start="4">
			for index, issue := range data.Issues {
				if index >= 3 {
					<li class="row"><a href={ templ.SafeURL(issue.DetailURL) }><strong>{ issue.Title }</strong><span>{ issue.Location }</span><time>{ issue.CreatedAt }</time></a></li>
				}
			}
		</ol></details>
	}
	if len(data.Issues) == 0 {
		<p class="empty">Nichts offen.</p>
	}
	</div></details>
}

templ CalmEvents(data PortalPageData) {
	<details class="module events"><summary><span class="dot green" aria-hidden="true"></span><h3>Termine</h3><span class="summary-count">{ len(data.Events) } Termine</span></summary><div class="module-body"><ol class="rows">
		for _, event := range data.Events {
			<li class="row"><a href="/app/events"><time><strong>{ event.DateBadgeDay }</strong><small>{ event.DateBadgeMonth }</small></time><strong>{ event.Title }</strong><span>{ event.TimeRange }
				if event.HasLocation {
					<span> · { event.Location }</span>
				}
			</span></a></li>
		}
	</ol>
	if len(data.Events) == 0 {
		<p class="empty">Kein Termin eingetragen.</p>
	}
	</div></details>
}

templ CalmAnnouncements(data PortalPageData) {
	<details class="module announcements"><summary><span class="dot" aria-hidden="true"></span><h3>Aushang</h3><span class="summary-count">{ data.UnreadAnnouncements } neue Beiträge</span></summary><div class="module-body"><ul class="rows">
		for _, item := range data.Announcements {
			<li class="row"><a href="/app/announcements"><span class={ "dot", templ.KV("gold", item.Unread) } aria-label={ templ.KV("ungelesen", item.Unread) }></span><strong>{ item.Title }</strong><span>{ item.Category } · { item.PublishedAt }</span></a></li>
		}
	</ul>
	if len(data.Announcements) == 0 {
		<p class="empty">Der Aushang ist leer.</p>
	}
	</div></details>
}

templ PortalUtilities(data PortalPageData) {
	<nav class="utility-links" aria-label="Weitere Bereiche">
		for _, area := range data.Areas {
			<a href={ templ.SafeURL(area.URL) }>{ area.Label }</a>
		}
		if data.Modules.Help {
			<a href="/app/hilfe">Hilfe</a>
		}
	</nav>
}

templ PortalMobile(data PortalPageData) {
	<div class="mobile-content">
		<article class="task-card"><p class="eyebrow">Jetzt zu erledigen</p>
			if data.HasPrimary {
				<h2>{ data.Primary.Title }</h2><p>{ data.Primary.Detail }</p><a class="primary" href={ templ.SafeURL(data.Primary.URL) }>{ data.Primary.ActionLabel }</a>
			} else {
				<h2>Alles im Blick</h2><p>Heute ist nichts zu erledigen.</p>
			}
		</article>
		<nav class="counts" aria-label="Kennzahlen">
			if data.Modules.Issues {
				<a class="count-tile" href={ templ.SafeURL(portalIssuesURL(data)) }><strong>{ len(data.Issues) }</strong><span>Anliegen</span></a>
			}
			if data.Modules.Events {
				<a class="count-tile" href="/app/events"><strong>{ len(data.Events) }</strong><span>Termine</span></a>
			}
			if data.Modules.Announcements {
				<a class="count-tile" href="/app/announcements"><strong>{ data.UnreadAnnouncements }</strong><span>Aushang</span></a>
			}
		</nav>
		if data.Modules.Events {
			<section class="mobile-section"><h2>Nächste Termine</h2><ol class="mobile-list">
				for index, event := range data.Events {
					if index < 2 {
						@PortalMobileEvent(event)
					}
				}
			</ol>
			if len(data.Events) > 2 {
				<details class="more-data"><summary>Alle { len(data.Events) } Termine</summary><ol class="mobile-list" start="3">
					for index, event := range data.Events {
						if index >= 2 {
							@PortalMobileEvent(event)
						}
					}
				</ol></details>
			}
			</section>
		}
		if data.Modules.Announcements {
			<section class="mobile-section"><h2>Am Aushang</h2><ul class="mobile-list">
				for index, item := range data.Announcements {
					if index == 0 {
						@PortalMobileAnnouncement(item)
					}
				}
			</ul>
			if len(data.Announcements) > 1 {
				<details class="more-data"><summary>Alle { len(data.Announcements) } Beiträge</summary><ul class="mobile-list">
					for index, item := range data.Announcements {
						if index > 0 {
							@PortalMobileAnnouncement(item)
						}
					}
				</ul></details>
			}
			</section>
		}
	</div>
	<div class="thumb-zone" aria-label="Schnellzugriff">
		if data.Modules.Issues && data.CanCreateResidentIssue {
			<a class="report" href="/app/anliegen?new=1#issue-new"><span aria-hidden="true">＋</span>Anliegen melden</a>
		}
		<nav class="tabs" aria-label="Hauptbereiche"><a class="active" href="/app" aria-current="page"><span class="tab-icon">@PortalIcon("home")</span><span>Liegenschaft</span></a>
			if data.CanUseResidentAreas && data.Modules.Announcements {
				<a href="/app/announcements"><span class="tab-icon">@PortalIcon("announcement")</span><span>Aushang</span></a>
			}
			if data.CanUseResidentAreas && data.Modules.Events {
				<a href="/app/events"><span class="tab-icon">@PortalIcon("calendar")</span><span>Termine</span></a>
			}
			<details class="bottom-more"><summary><span class="tab-icon">•••</span><span>Mehr</span></summary><div class="bottom-more-panel">
				for _, area := range data.Areas {
					<a href={ templ.SafeURL(area.URL) }>{ area.Label }</a>
				}
				if data.Modules.Help {
					<a href="/app/hilfe">Hilfe</a>
				}
			</div></details>
		</nav>
	</div>
}


// PortalReleaseNotes renders only the footer trigger. The notes themselves live
// in the single ReleaseHistoryDialog per page, so the shell no longer ships the
// full release history twice (sidebar and mobile menu) and the open panel is a
// real modal in the top layer instead of a box inside the scrolling sidebar.
templ PortalReleaseNotes(data PortalPageData) {
	@ReleaseNotesTrigger(data.DisplayVersion)
}

// ReleaseNotesTrigger is an anchor, not a button, so a browser without
// JavaScript still reaches the notes: the href targets the dialog and the
// :target rule in PortalBaseStyles shows it. With JavaScript app.js cancels the
// navigation and opens the same element with showModal().
templ ReleaseNotesTrigger(displayVersion string) {
	<a
		class="release-trigger"
		href="#release-history"
		data-dialog="release-history"
		aria-haspopup="dialog"
		aria-controls="release-history"
		aria-label={ "v" + displayVersion + " · Versionsverlauf öffnen" }
	>v{ displayVersion } · Versionsverlauf</a>
}

// ReleaseHistoryDialog is rendered once per portal page, outside the sidebar, so
// nothing clips or overlaps it.
templ ReleaseHistoryDialog(notes []version.Note) {
	if len(notes) > 0 {
		<dialog id="release-history" class="release-dialog" aria-labelledby="release-history-title" data-light-dismiss>
			<div class="release-dialog-head">
				<h2 id="release-history-title">Versionsverlauf</h2>
				<button class="release-dialog-close" type="button" data-close-dialog aria-label="Versionsverlauf schließen"><span aria-hidden="true">×</span></button>
				<a class="release-dialog-close release-dialog-close-nojs" href="#main-content" aria-label="Versionsverlauf schließen"><span aria-hidden="true">×</span></a>
			</div>
			<div class="release-dialog-body" tabindex="0">
				for _, note := range notes {
					<article class="release-entry"><small>v{ note.Version } · { note.Date } · { note.Kind }</small><strong>{ note.Headline }</strong><p>{ note.Intro }</p><ul>
						for _, item := range note.Items {
							<li><strong>{ item.Label }:</strong> { item.Text }</li>
						}
					</ul></article>
				}
			</div>
		</dialog>
	}
}

templ PortalMobileEvent(event view.HouseEventView) {
	<li><a class="mobile-event" href="/app/events"><time class="date-chip"><strong>{ event.DateBadgeDay }</strong><span>{ event.DateBadgeMonth }</span></time><span class="item-copy"><strong>{ event.Title }</strong><span>{ event.TimeRange }
		if event.HasLocation {
			<span> · { event.Location }</span>
		}
	</span></span><span class="chevron" aria-hidden="true">›</span></a></li>
}

templ PortalMobileAnnouncement(item view.AnnouncementView) {
	<li><a class="mobile-notice" href="/app/announcements"><span class={ "dot", templ.KV("gold", item.Unread) }></span><span class="item-copy"><strong>{ item.Title }</strong><span>{ item.Category } · { item.PublishedAt }</span></span><span class="chevron" aria-hidden="true">›</span></a></li>
}

func portalIssuesURL(data PortalPageData) string {
	if data.CanManageIssues {
		return "/app/anliegen/board"
	}
	return "/app/anliegen"
}

func calmAnswer(data PortalPageData) string {
	count := 0
	if data.Modules.Issues && len(data.Issues) > 0 { count++ }
	if data.Modules.Events && len(data.Events) > 0 { count++ }
	if data.Modules.Announcements && data.UnreadAnnouncements > 0 { count++ }
	if count == 0 { return "Heute wartet nichts auf Sie." }
	if count == 1 { return "Eine Sache wartet auf Sie." }
	if count == 2 { return "Zwei Dinge warten auf Sie." }
	return "Drei Dinge warten auf Sie."
}

// PortalMobileHeader is the compact shell used by portal sub-pages. Keeping it
// in the shared portal template means every route uses the same permission-gated
// PortalNavigation instead of growing a second mobile navigation tree.


// Usually a house link stays in the authenticated session. Resuming a house
// after a private Home uses the same validated POST as the switcher, with a
// bounded continuation path. This also works without JavaScript.
templ PortalHouseNavItem(data PortalPageData, icon, label, url string, active bool, badge int, icons bool) {
 if data.NavigationTenant == "" {
  @PortalNavItem(icon, label, url, active, badge, icons)
 } else {
  <form method="post" action="/app/context" class="nav-resume-house">
   <input type="hidden" name="tenant" value={ data.NavigationTenant }/>
   <input type="hidden" name="role" value={ data.NavigationRole }/>
   <input type="hidden" name="next" value={ url }/>
   <button class="nav-item" type="submit">
    if icons {
 <span class="nav-icon">@PortalIcon(icon)</span>
 }
    <span class="nav-label">{ label }</span>
    if badge > 0 {
 <span class="nav-badge">{ fmt.Sprint(badge) }</span>
 }
   </button>
  </form>
 }
}
