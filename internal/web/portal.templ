package web

import (
	"github.com/inspr-at/hausv-org/internal/version"
	"github.com/inspr-at/hausv-org/internal/view"
)

type PortalModules struct {
	Energy, Announcements, Events, Contacts, Documents, Issues bool
	Votes, Parking, Handovers, Users, Audit, Help                bool
}

type PortalContext struct {
	TenantSlug, HouseName, Address, Role string
	Current                              bool
}

type PortalArea struct {
	Label, URL string
}

type PortalEnergy struct {
	Ready                            bool
	HomeName, Message                string
	ActionLabel, ActionURL           string
}

type PortalPageData struct {
	Title, TenantSlug, HouseName, Address, MapURL     string
	GreetingName, Today, DisplayName, Initials, Role  string
	DisplayVersion, ActivePage                        string
	Dense, CanUseResidentAreas, CanViewEnergy         bool
	CanManageIssues, CanCreateResidentIssue           bool
	CanSeeParking, CanManageHandovers, CanManageUsers bool
	CanViewAudit, HasPrimary, HasEnergy               bool
	Modules                                           PortalModules
	Primary                                           view.DashboardDigestItem
	Issues                                            []view.IssueView
	Events                                            []view.HouseEventView
	Announcements                                     []view.AnnouncementView
	UnreadAnnouncements                               int
	Energy                                            PortalEnergy
	Areas                                             []PortalArea
	Contexts                                          []PortalContext
	ReleaseNotes                                      []version.Note
}

templ PortalDocument(title, assetVersion string, extraScripts []string, styles templ.Component, bodyAttributes templ.Attributes) {
	<!doctype html>
	<html lang="de-AT">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<title>{ title }</title>
			<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
			<script src={ "/assets/app.js?v=" + assetVersion } defer></script>
			for _, script := range extraScripts {
				<script src={ "/assets/" + script + "?v=" + assetVersion } defer></script>
			}
			@PortalBaseStyles()
			@styles
			@PortalShellStyles()
		</head>
		<body data-authenticated-app { bodyAttributes... }>
			{ children... }
		</body>
	</html>
}

templ PortalBaseStyles() {
	<style>
		*{box-sizing:border-box}html,body{min-height:100%;margin:0}body{min-width:320px;background:var(--paper);color:var(--ink);font-family:var(--font-sans)}a{color:inherit;text-decoration:none}.skip-link:focus{transform:translateY(0)}.house-name{display:block;font-family:var(--font-serif);font-size:27px;line-height:1}.house-address{display:block;margin-top:var(--space-2);color:var(--soft);font-size:12px}.map{display:block;height:74px;margin-top:var(--space-4);overflow:hidden;background:var(--nav-2);border:1px solid var(--muted);border-radius:var(--radius-md)}.map svg{display:block;width:100%;height:100%}.map-streets{fill:none;stroke:var(--muted);stroke-width:1;opacity:.42}.map-pin{fill:var(--gold-light);stroke:var(--gold)}.map-hole{fill:var(--nav)}.context-switch{margin-top:var(--space-3);font-size:11px}.context-switch summary{cursor:pointer;color:var(--gold-light)}.context-menu{display:grid;gap:var(--space-2);margin-top:var(--space-2);padding:var(--space-2);background:var(--nav-2);border-radius:var(--radius-sm)}.context-menu small{color:var(--soft)}.nav{margin-top:var(--space-5);display:grid;gap:2px}.nav a{min-height:31px;display:grid;grid-template-columns:22px 1fr auto;align-items:center;gap:var(--space-2);margin-inline:calc(var(--space-2)*-1);padding:5px var(--space-2);border-radius:var(--radius-xs);color:var(--line);font-size:12px}.nav a:hover,.nav a.active{background:var(--nav-2)}.nav a.active{color:var(--panel);font-weight:700}.nav a.active svg{color:var(--gold)}.nav-badge{min-width:19px;padding:2px 5px;text-align:center;background:var(--gold);color:var(--nav);border-radius:var(--radius-pill);font-size:10px}.nav-label{margin:var(--space-3) 0 var(--space-1) 2px;color:var(--gold);font-size:9px;font-weight:800;letter-spacing:.15em;text-transform:uppercase}.account{margin-top:auto;padding-top:var(--space-4);border-top:1px solid var(--nav-2);display:grid;grid-template-columns:34px 1fr auto;align-items:center;gap:var(--space-3)}.avatar{display:inline-grid;place-items:center;width:34px;height:34px;background:var(--gold);color:var(--panel);border-radius:var(--radius-pill);font-size:12px}.account strong,.account small{display:block}.account strong{font-size:12px}.account small{margin-top:2px;color:var(--soft);font-size:10px}.release-notes>summary{margin-top:2px;color:var(--soft);cursor:pointer;font-size:10px;list-style:none}.release-notes>summary::-webkit-details-marker{display:none}.release-panel h2{font-size:24px}.release-entry{padding-top:var(--space-4)}.release-entry+.release-entry{margin-top:var(--space-4);border-top:1px solid var(--line)}.release-entry>small{color:var(--muted)}.release-entry>strong{display:block;margin-top:var(--space-1);font-family:var(--font-serif)}.release-entry p,.release-entry li{margin-top:var(--space-2);color:var(--muted);font-size:11px}.release-entry ul{padding-left:var(--space-5)}:root{--ink:#20251f;--muted:#6b6f63;--soft:#9a9485;--line:#e7e0d2;--paper:#f7f3ea;--panel:#fffefb;--panel-soft:#fbf8f0;--gold:#c8993f;--gold-ink:#8a7b3f;--gold-light:#e7c574;--leaf:#2f6b4a;--nav:#172019;--nav-2:#20291f;--font-sans:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;--font-serif:ui-serif,Georgia,Cambria,"Times New Roman",serif;--space-1:4px;--space-2:8px;--space-3:12px;--space-4:16px;--space-5:20px;--space-6:24px;--radius-xs:7px;--radius-sm:8px;--radius-md:10px;--radius-lg:12px;--radius-xl:14px;--radius-pill:999px;--shadow-panel:0 12px 30px rgba(32,37,31,.04);--shadow-dialog:0 28px 70px rgba(0,0,0,.34);--shadow-md:0 18px 44px rgba(32,37,31,.08);font-family:var(--font-sans)}button,input,select,textarea{font:inherit}button{cursor:pointer}.skip-link{position:fixed;top:var(--space-2);left:var(--space-2);z-index:300;padding:var(--space-2) var(--space-3);background:var(--panel);border-radius:var(--radius-sm);transform:translateY(-160%)}.context-menu button,.context-current{width:100%;display:grid;padding:var(--space-2);border:0;background:transparent;color:var(--panel);text-align:left}.logout-form button{padding:4px;border:0;background:transparent;color:var(--soft)}.release-panel{position:fixed;z-index:250;left:var(--space-6);bottom:72px;width:min(520px,calc(100vw - 48px));max-height:70vh;overflow:auto;padding:var(--space-5);background:var(--panel);color:var(--ink);border:1px solid var(--line);border-radius:var(--radius-md);box-shadow:var(--shadow-dialog)}.button{min-height:40px;display:inline-flex;align-items:center;justify-content:center;gap:var(--space-2);padding:var(--space-2) var(--space-4);border:1px solid var(--gold);border-radius:var(--radius-sm);background:transparent;color:var(--gold-ink);font-size:12px;font-weight:800}
	</style>
}

templ PortalShellStyles() {
	<style>
		.mobile-context-switch{margin:0 0 var(--space-2);font-size:11px}.mobile-context-switch>summary{min-height:44px;display:flex;align-items:center;padding:0 var(--space-3);cursor:pointer;color:var(--gold-light)}.mobile-context-switch .context-menu{margin:0 0 var(--space-2)}.mobile-context-switch .context-menu button,.mobile-context-switch .context-current{min-height:44px}
	</style>
}

templ PortalPage(data PortalPageData) {
	@PortalDocument(data.Title, portalAssetVersion(), nil, PortalStyles(), templ.Attributes{"class": templ.Classes("portal-page", templ.KV("dense", data.Dense), templ.KV("calm", !data.Dense)).String(), "data-templ-portal": true}) {
		@PortalContent(data)
	}
}

templ PortalStyles() {
			<style>a:focus-visible,button:focus-visible,summary:focus-visible{outline:2px solid var(--gold-light);outline-offset:2px}h1,h2,h3,p{margin:0}h1,h2,h3{font-family:var(--font-serif);font-weight:600}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
				.shell{min-height:100vh;display:grid;grid-template-columns:240px minmax(0,1fr)}.sidebar{position:sticky;top:0;height:100vh;display:flex;flex-direction:column;padding:var(--space-5) var(--space-4) var(--space-4);background:var(--nav);color:var(--panel);overflow:auto}.nav-icon svg{display:block;width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
				.desktop-main{min-width:0}.mobile-head,.mobile-content,.thumb-zone{display:none}.greeting h1{font-size:34px;line-height:1.1;letter-spacing:-.02em}.greeting p{margin-top:var(--space-2);color:var(--muted);font-size:12px}.card{min-width:0;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius-md);box-shadow:var(--shadow-panel)}.card-head{min-height:34px;display:flex;align-items:baseline;gap:var(--space-3)}.card-head h2{font-size:23px;line-height:1}.card-head .count-label{color:var(--muted);font-size:11px}.all-link{margin-left:auto;color:var(--muted);font-size:11px;text-decoration:underline;text-underline-offset:3px}.empty{padding:var(--space-5);color:var(--muted);font-size:12px}
				.dense-main{height:100vh;padding:var(--space-5) var(--space-6) var(--space-4);overflow:hidden;display:grid;grid-template-rows:72px minmax(0,1fr) 58px 30px;gap:var(--space-3)}.topbar{display:flex;align-items:flex-start;justify-content:space-between;gap:var(--space-6)}.top-actions{display:flex;align-items:center;gap:var(--space-5)}.metrics{display:flex}.metric{min-width:92px;padding:0 var(--space-4);text-align:center;border-left:1px solid var(--line)}.metric:first-child{border-left:0}.metric strong{display:block;font-family:var(--font-serif);font-size:29px;font-weight:500;line-height:1}.metric:first-child strong{color:var(--gold)}.metric span{display:block;margin-top:var(--space-2);color:var(--muted);font-size:8px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.working-grid{min-height:0;display:grid;grid-template-columns:minmax(0,1.58fr) minmax(320px,1fr);gap:var(--space-5)}.issues-card{padding:var(--space-4) var(--space-5) var(--space-3);overflow:auto}table{width:100%;border-collapse:collapse;table-layout:fixed;font-size:11px}th{height:31px;padding:0 6px;color:var(--muted);font-size:8px;letter-spacing:.1em;text-align:left;text-transform:uppercase}td{height:34px;padding:0 6px;border-top:1px solid var(--line);vertical-align:middle}th:first-child,td:first-child{width:90px}th:nth-child(3),td:nth-child(3){width:112px}th:nth-child(4),td:nth-child(4){width:90px;text-align:right}.status{display:inline-flex;align-items:center;gap:5px;color:var(--muted);font-size:9px}.dot{display:inline-block;width:8px;height:8px;background:var(--soft);border-radius:var(--radius-pill)}.dot.gold{background:var(--gold)}.dot.green{background:var(--leaf)}.subject{display:block;overflow:hidden;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.place,.age{color:var(--muted)}.side-stack{min-height:0;display:grid;grid-template-rows:1fr 1fr;gap:var(--space-4)}.agenda-card,.board-card{padding:var(--space-4) var(--space-5);overflow:auto}.agenda,.board-list{margin:var(--space-2) 0 0;padding:0;list-style:none}.agenda li+li,.board-list li+li{border-top:1px solid var(--line)}.agenda a{min-height:55px;display:grid;grid-template-columns:44px 1fr;align-items:center;gap:var(--space-3)}.date-chip{width:42px;height:42px;display:grid;place-content:center;background:var(--leaf);color:var(--panel);border-radius:var(--radius-sm);text-align:center}.date-chip strong{font-family:var(--font-serif);font-size:20px;font-weight:500;line-height:.8}.date-chip span{margin-top:5px;font-size:7px;font-weight:800}.item-copy strong,.item-copy span{display:block}.item-copy strong{overflow:hidden;font-size:11px;text-overflow:ellipsis;white-space:nowrap}.item-copy span{margin-top:3px;color:var(--muted);font-size:9px}.board-list a{min-height:48px;display:grid;grid-template-columns:8px 1fr;align-items:center;gap:var(--space-3)}.home-strip{display:grid;grid-template-columns:180px 1fr auto;align-items:center;padding:0 var(--space-5);background:var(--panel-soft);border:1px solid var(--line);border-radius:var(--radius-sm)}.home-strip h2{font-size:20px}.home-strip p{padding-left:var(--space-5);border-left:1px solid var(--line);color:var(--muted);font-size:11px}.home-strip a{color:var(--gold-ink);font-size:11px;font-weight:700}.utility-links{display:flex;align-items:center;flex-wrap:wrap;gap:var(--space-3);padding-top:var(--space-2);border-top:1px solid var(--line);color:var(--muted);font-size:9px}.utility-links a+a::before{content:"·";margin-right:var(--space-3);color:var(--soft)}
				.calm-main{min-height:100vh;padding:50px var(--space-6) var(--space-6)}.calm-column{width:min(700px,100%);min-height:calc(100vh - 76px);margin:0 auto;display:flex;flex-direction:column}.calm-main .greeting h1{font-size:42px}.answer{margin-top:60px;font-size:30px;line-height:1.15}.disclosures{margin-top:var(--space-6);display:grid;gap:var(--space-3)}details.module{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius-md)}details.module>summary{min-height:62px;display:grid;grid-template-columns:12px 1fr auto 18px;align-items:center;gap:var(--space-3);padding:0 var(--space-5);cursor:pointer;list-style:none}details.module>summary::-webkit-details-marker,details.more>summary::-webkit-details-marker{display:none}details.module>summary::after{content:"⌄";color:var(--muted);font-size:19px}details.module[open]>summary::after{transform:rotate(180deg)}summary h3{font-size:19px}.summary-count{color:var(--muted);font-size:11px}.module-body{margin:0 var(--space-5) var(--space-4);padding:0 var(--space-4);background:var(--panel-soft);border:1px solid var(--line);border-radius:var(--radius-sm)}.rows{margin:0;padding:0;list-style:none}.row+.row{border-top:1px solid var(--line)}.row a{min-height:44px;display:grid;grid-template-columns:minmax(0,1fr) 110px 90px;align-items:center;gap:var(--space-3);font-size:11px}.row strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.row span,.row time{color:var(--muted)}.row time{text-align:right}details.more{border-top:1px solid var(--line)}details.more>summary{min-height:40px;display:flex;align-items:center;color:var(--muted);cursor:pointer;font-size:11px;list-style:none;text-decoration:underline;text-underline-offset:3px}.events .row a{grid-template-columns:48px minmax(0,1fr) 150px}.events .row time:first-child{width:39px;height:34px;display:grid;place-content:center;background:var(--leaf);color:var(--panel);border-radius:var(--radius-xs);text-align:center}.events .row time strong{font-family:var(--font-serif);font-size:15px;font-weight:500}.announcements .row a{grid-template-columns:9px minmax(0,1fr) 140px}.quiet-home{margin-top:auto;padding-top:64px;text-align:center;color:var(--muted);font-size:11px}.quiet-home a{text-decoration:underline}.calm-main .utility-links{justify-content:center;margin-top:var(--space-4)}
				@media(max-width:1100px) and (min-width:701px){.shell{grid-template-columns:210px minmax(0,1fr)}.dense-main{padding-inline:var(--space-4)}.working-grid{grid-template-columns:minmax(0,1.4fr) minmax(290px,1fr);gap:var(--space-3)}.metric{min-width:72px;padding-inline:var(--space-2)}}
				@media(max-width:700px){body{padding-bottom:132px}.shell{display:block}.sidebar,.desktop-main{display:none}.mobile-head{position:relative;z-index:5;height:82px;display:grid;grid-template-columns:40px 1fr 42px;align-items:center;gap:var(--space-3);padding:0 var(--space-4);background:var(--nav);color:var(--panel)}.mobile-identity strong,.mobile-identity small{display:block}.mobile-identity strong{font-family:var(--font-serif);font-size:22px}.mobile-identity small{margin-top:6px;color:var(--soft);font-size:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.menu>summary{width:40px;height:48px;display:grid;place-content:center;cursor:pointer;list-style:none}.menu>summary::-webkit-details-marker{display:none}.hamburger,.hamburger::before,.hamburger::after{width:22px;height:2px;display:block;background:var(--panel);border-radius:var(--radius-pill)}.hamburger{position:relative}.hamburger::before,.hamburger::after{content:"";position:absolute;left:0}.hamburger::before{top:-7px}.hamburger::after{top:7px}.menu-panel{position:absolute;top:82px;left:0;right:0;max-height:calc(100vh - 82px);overflow:auto;padding:var(--space-3) var(--space-4) var(--space-5);background:var(--nav);border-top:1px solid var(--nav-2);box-shadow:var(--shadow-dialog)}.menu-panel nav{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-1)}.menu-panel a,.menu-panel form button{width:100%;min-height:44px;display:flex;align-items:center;padding:0 var(--space-3);border:0;border-radius:var(--radius-sm);background:transparent;color:var(--line);font-size:12px;text-align:left}.menu-panel .active{background:var(--nav-2);color:var(--panel);font-weight:700}.menu-label{grid-column:1/-1;margin:var(--space-3) var(--space-3) var(--space-1);color:var(--gold);font-size:9px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.mobile-content{display:block;padding:var(--space-5) var(--space-4) var(--space-6)}.mobile-content .greeting h1{font-size:34px}.task-card{margin-top:var(--space-5);padding:var(--space-4);background:var(--panel);border:1px solid var(--line);border-radius:var(--radius-md);box-shadow:var(--shadow-panel)}.eyebrow{color:var(--gold-ink);font-size:9px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.task-card h2{margin-top:6px;font-size:24px;line-height:1.08}.task-card p{margin-top:var(--space-2);color:var(--muted);font-size:12px}.primary{min-height:48px;display:flex;align-items:center;justify-content:center;margin-top:var(--space-4);background:var(--gold);color:var(--panel);border-radius:var(--radius-sm);font-size:14px;font-weight:750}.counts{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-2);margin-top:var(--space-4)}.count-tile{min-height:72px;display:grid;place-content:center;text-align:center;background:var(--panel-soft);border:1px solid var(--line);border-radius:var(--radius-sm)}.count-tile strong{display:block;font-family:var(--font-serif);font-size:27px;font-weight:500;line-height:1}.count-tile span{display:block;margin-top:7px;color:var(--muted);font-size:7px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.mobile-section{margin-top:var(--space-5)}.mobile-section>h2{margin-bottom:var(--space-3);font-size:21px}.mobile-list{margin:0;padding:0;overflow:hidden;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius-sm);list-style:none}.mobile-list li+li{border-top:1px solid var(--line)}.mobile-event,.mobile-notice{min-height:63px;display:grid;grid-template-columns:42px 1fr 12px;align-items:center;gap:var(--space-3);padding:var(--space-2) var(--space-3)}.mobile-notice{grid-template-columns:9px 1fr 12px}.chevron{color:var(--muted);font-size:20px}.more-data{margin-top:var(--space-2)}.more-data>summary{min-height:34px;display:grid;place-content:center;color:var(--muted);cursor:pointer;font-size:11px;list-style:none;text-decoration:underline;text-underline-offset:3px}.more-data>summary::-webkit-details-marker{display:none}.more-data .mobile-list{margin-top:var(--space-2)}.thumb-zone{position:fixed;z-index:10;right:0;bottom:0;left:0;display:block;padding:var(--space-2) var(--space-3) max(var(--space-2),env(safe-area-inset-bottom));background:var(--paper)}.report{min-height:48px;display:flex;align-items:center;justify-content:center;gap:var(--space-2);background:var(--gold);color:var(--panel);border-radius:var(--radius-sm);font-size:14px;font-weight:800;box-shadow:var(--shadow-md)}.tabs{min-height:62px;display:grid;grid-template-columns:repeat(4,1fr);margin-top:var(--space-2);background:var(--panel);border:1px solid var(--line);border-radius:var(--radius-md);box-shadow:var(--shadow-panel)}.tabs>a,.bottom-more>summary{display:grid;place-content:center;gap:3px;text-align:center;color:var(--muted);font-size:9px;font-weight:700;list-style:none}.tabs>a.active{color:var(--gold)}.tab-icon svg{display:block;width:20px;height:20px;margin:auto;fill:none;stroke:currentColor;stroke-width:1.6}.bottom-more-panel{position:absolute;right:var(--space-3);bottom:72px;left:var(--space-3);display:grid;grid-template-columns:1fr 1fr;gap:var(--space-1);max-height:320px;overflow:auto;padding:var(--space-3);background:var(--nav);border:1px solid var(--nav-2);border-radius:var(--radius-md);box-shadow:var(--shadow-dialog)}.bottom-more-panel a{min-height:42px;display:flex;align-items:center;padding:0 var(--space-3);color:var(--line);font-size:11px}.mobile-head .avatar{width:40px;height:40px}}
			</style>
}

templ PortalContent(data PortalPageData) {
			<a class="skip-link" href="#main-content">Zum Inhalt springen</a>
			<div class="shell">
				@PortalSidebar(data)
				<div class="desktop-main">
					if data.Dense {
						@PortalDense(data)
					} else {
						@PortalCalm(data)
					}
				</div>
			</div>
			@PortalMobile(data)
}

func portalAssetVersion() string { return version.AssetVersion() }

templ PortalSidebar(data PortalPageData) {
	<aside class="sidebar" aria-label="Hausnavigation">
		<header>
			<a href="/app"><strong class="house-name">{ data.HouseName }</strong><span class="house-address">{ data.Address }</span></a>
			<a class="map" href={ templ.SafeURL(data.MapURL) } target="_blank" rel="noopener noreferrer" aria-label={ data.Address + " in OpenStreetMap öffnen" }>
				<svg viewBox="0 0 208 74" aria-hidden="true"><g class="map-streets"><path d="M-12 20 45 28 98 16 220 25"></path><path d="M-8 57 55 46 112 56 218 39"></path><path d="M31-8 50 22 66 79"></path><path d="M157-7 143 27 151 80"></path><path d="M92-7 104 22 96 80"></path></g><g transform="translate(121 34)"><path class="map-pin" d="M0-11a8 8 0 0 0-8 8c0 6 8 14 8 14S8 3 8-3a8 8 0 0 0-8-8z"></path><circle class="map-hole" cy="-3" r="2.5"></circle></g></svg>
			</a>
			if len(data.Contexts) > 1 {
				<details class="context-switch"><summary>Portal wechseln · { data.Role }</summary><div class="context-menu">
					for _, context := range data.Contexts {
						if context.Current {
							<span class="context-current"><strong>{ context.HouseName }</strong><small>{ context.Role } · aktiv</small></span>
						} else {
							<form method="post" action="/app/context"><input type="hidden" name="tenant" value={ context.TenantSlug }/><input type="hidden" name="role" value={ context.Role }/><button type="submit"><strong>{ context.HouseName }</strong><small>{ context.Role }</small></button></form>
						}
					}
				</div></details>
			}
		</header>
		@PortalNavigation(data, true)
		<footer class="account"><span class="avatar" aria-hidden="true">{ data.Initials }</span><span><strong>{ data.DisplayName }</strong><small>{ data.Role }</small>@PortalReleaseNotes(data)</span><form class="logout-form" method="post" action="/auth/logout"><button type="submit" aria-label="Abmelden" title="Abmelden">↪</button></form></footer>
	</aside>
}

// PortalSectionHeader is the compact counterpart to PortalSidebar for detail
// routes. Keeping its menu here ensures desktop and mobile use the same gated
// PortalNavigation instead of letting each route grow a second navigation.
templ PortalSectionHeader(data PortalPageData, section string) {
	<header class="mobile-head">
		<details class="mobile-menu"><summary aria-label="Navigation öffnen"><span class="hamburger" aria-hidden="true"></span></summary><div class="mobile-menu-panel">@PortalMobileContextSwitch(data)@PortalNavigation(data, false)@PortalReleaseNotes(data)<form class="logout-form" method="post" action="/auth/logout"><button type="submit">Als { data.DisplayName } abmelden</button></form></div></details>
		<a class="mobile-title" href="/app"><strong>{ data.HouseName }</strong><small>{ section } · { data.Role }</small></a>
		<a class="avatar" href="/app/settings" aria-label={ "Profil von " + data.DisplayName }>{ data.Initials }</a>
	</header>
}

templ PortalNavigation(data PortalPageData, icons bool) {
	<nav class="nav" aria-label="Bereiche">
		if data.CanUseResidentAreas {
			@PortalNavItem("home", "Hausüberblick", "/app", portalNavActive(data, "home"), 0, icons)
		}
		if data.CanUseResidentAreas && data.CanViewEnergy {
			@PortalNavItem("energy", "Mein Zuhause", "/app/energie", portalNavActive(data, "energy"), 0, icons)
		}
		if data.CanUseResidentAreas && data.Modules.Announcements {
			@PortalNavItem("announcement", "Aushang", "/app/announcements", portalNavActive(data, "announcements"), data.UnreadAnnouncements, icons)
		}
		if data.CanUseResidentAreas && data.Modules.Events {
			@PortalNavItem("calendar", "Termine", "/app/events", portalNavActive(data, "events"), 0, icons)
		}
		if data.CanUseResidentAreas && data.Modules.Contacts {
			@PortalNavItem("contact", "Kontakte", "/app/kontakte", portalNavActive(data, "contacts"), 0, icons)
		}
		if data.CanUseResidentAreas && data.Modules.Documents {
			@PortalNavItem("document", "Dokumente", "/app/dokumente", portalNavActive(data, "documents"), 0, icons)
		}
		if data.Modules.Issues {
			if data.CanManageIssues {
				@PortalNavItem("issue", "Anliegen", "/app/anliegen/board", portalNavActive(data, "issues"), len(data.Issues), icons)
			} else {
				@PortalNavItem("issue", "Anliegen", "/app/anliegen", portalNavActive(data, "issues"), len(data.Issues), icons)
			}
		}
		if data.CanUseResidentAreas && data.Modules.Votes {
			@PortalNavItem("vote", "Abstimmungen", "/app/abstimmungen", portalNavActive(data, "votes"), 0, icons)
		}
		if data.CanUseResidentAreas && ((data.Modules.Parking && data.CanSeeParking) || (data.Modules.Handovers && data.CanManageHandovers) || (data.Modules.Users && data.CanManageUsers)) {
			<span class="nav-label">Verwaltung</span>
		}
		if data.CanUseResidentAreas && data.Modules.Parking && data.CanSeeParking {
			@PortalNavItem("parking", "Parkplatznutzung", "/app/parking", portalNavActive(data, "parking"), 0, icons)
		}
		if data.CanUseResidentAreas && data.Modules.Handovers && data.CanManageHandovers {
			@PortalNavItem("handover", "Übergaben", "/app/uebergaben", portalNavActive(data, "handovers"), 0, icons)
		}
		if data.CanUseResidentAreas && data.Modules.Users && data.CanManageUsers {
			@PortalNavItem("users", "Benutzer & Rechte", "/app/settings/users", portalNavActive(data, "users"), 0, icons)
		}
		if data.CanUseResidentAreas && data.Modules.Audit && data.CanViewAudit {
			@PortalNavItem("audit", "Verlauf", "/app/audit", portalNavActive(data, "audit"), 0, icons)
		}
		if data.CanUseResidentAreas {
			@PortalNavItem("settings", "Einstellungen", "/app/settings", portalNavActive(data, "settings"), 0, icons)
		}
		if data.Modules.Help {
			@PortalNavItem("help", "Hilfe", "/app/hilfe", portalNavActive(data, "help"), 0, icons)
		}
	</nav>
}

// PortalMobileHeader is the shared compact shell for route-specific portal
// pages. Keeping its menu here ensures mobile and desktop use the same
// permission-gated navigation.
templ PortalMobileHeader(data PortalPageData, pageLabel string) {
	<header class="mobile-head">
		<details class="menu"><summary aria-label="Navigation öffnen"><span class="hamburger" aria-hidden="true"></span></summary><div class="menu-panel">@PortalMobileContextSwitch(data)@PortalNavigation(data, false)@PortalReleaseNotes(data)<form class="logout-form" method="post" action="/auth/logout"><button type="submit">Als { data.DisplayName } abmelden</button></form></div></details>
		<a class="mobile-identity" href="/app"><strong>{ data.HouseName }</strong><small>{ pageLabel } · { data.Role }</small></a>
		<a class="avatar" href="/app/settings" aria-label={ "Profil von " + data.DisplayName }>{ data.Initials }</a>
	</header>
}

templ PortalMobileContextSwitch(data PortalPageData) {
	if len(data.Contexts) > 1 {
		<details class="context-switch mobile-context-switch"><summary>Portal wechseln · { data.Role }</summary><div class="context-menu">
			for _, context := range data.Contexts {
				if context.Current {
					<span class="context-current"><strong>{ context.HouseName }</strong><small>{ context.Role } · aktiv</small></span>
				} else {
					<form method="post" action="/app/context"><input type="hidden" name="tenant" value={ context.TenantSlug }/><input type="hidden" name="role" value={ context.Role }/><button type="submit"><strong>{ context.HouseName }</strong><small>{ context.Role }</small></button></form>
				}
			}
		</div></details>
	}
}

func portalNavActive(data PortalPageData, page string) bool {
	if data.ActivePage == "" {
		return page == "home"
	}
	return data.ActivePage == page
}

templ PortalNavItem(kind, label, url string, active bool, badge int, icons bool) {
	<a href={ templ.SafeURL(url) } class={ templ.KV("active", active) } aria-current={ portalAriaCurrent(active) }>
		if icons {
			<span class="nav-icon">@PortalIcon(kind)</span>
		}
		<span>{ label }</span>
		if badge > 0 {
			<span class="nav-badge">{ badge }</span>
		}
	</a>
}

func portalAriaCurrent(active bool) string {
	if active {
		return "page"
	}
	return "false"
}

templ PortalIcon(kind string) {
	<svg viewBox="0 0 24 24" aria-hidden="true">
		switch kind {
			case "home": <path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10.5V20h13v-9.5"></path><path d="M9.5 20v-5h5v5"></path>
			case "energy": <path d="M4 13h5l2-7 3 12 2-5h4"></path><path d="M5 20h14"></path>
			case "announcement": <path d="M4 5h16v13H7l-3 3z"></path><path d="M8 9h8M8 13h6"></path>
			case "calendar": <path d="M7 3v4M17 3v4"></path><path d="M4.5 6h15v14h-15z"></path><path d="M4.5 10h15"></path>
			case "contact": <path d="M16 4h2.5A1.5 1.5 0 0 1 20 5.5v13A1.5 1.5 0 0 1 18.5 20h-13A1.5 1.5 0 0 1 4 18.5v-13A1.5 1.5 0 0 1 5.5 4H8"></path><path d="M8.5 3.5h7v4h-7z"></path><path d="M9 13a3 3 0 1 0 6 0"></path><path d="M7.5 18a4.5 4.5 0 0 1 9 0"></path>
			case "document": <path d="M7 3h7l3 3v15H7z"></path><path d="M14 3v4h4"></path><path d="M9 13h6M9 17h6"></path>
			case "issue": <path d="M5 18.5V6.5A2.5 2.5 0 0 1 7.5 4h9A2.5 2.5 0 0 1 19 6.5v6A2.5 2.5 0 0 1 16.5 15H10l-5 3.5z"></path>
			case "vote": <path d="M5 19V9M12 19V5M19 19v-7"></path><path d="M3.5 19h17"></path>
			case "parking": <path d="M5 16h14"></path><path d="m7 16 1.5-5h7L17 16"></path><path d="M7 16v3M17 16v3"></path><path d="M7 19h1M16 19h1"></path>
			case "handover": <path d="M7 4h10v16H7z"></path><path d="M9.5 8h5M9.5 12h4"></path><path d="m9.5 16 1.5 1.5 3.5-4"></path>
			case "users": <path d="M8.5 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"></path><path d="M3.5 20a5 5 0 0 1 10 0"></path><path d="M16 11.5a2.5 2.5 0 1 0 0-5"></path><path d="M17 15a4 4 0 0 1 3.5 4"></path>
			case "audit": <path d="M5 4h14v16H5z"></path><path d="M8 8h8M8 12h8M8 16h5"></path>
			case "settings": <path d="M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7z"></path><path d="M19 12a7 7 0 0 0-.1-1l2-1.5-2-3.5-2.4 1a7 7 0 0 0-1.8-1L14.4 3h-4.8L9.3 6a7 7 0 0 0-1.8 1l-2.4-1-2 3.5 2 1.5A7 7 0 0 0 5 12a7 7 0 0 0 .1 1l-2 1.5 2 3.5 2.4-1a7 7 0 0 0 1.8 1l.3 3h4.8l.3-3a7 7 0 0 0 1.8-1l2.4 1 2-3.5-2-1.5a7 7 0 0 0 .1-1z"></path>
			case "help": <circle cx="12" cy="12" r="9"></circle><path d="M9.7 9a2.5 2.5 0 1 1 3.2 2.4c-.7.3-.9.8-.9 1.6"></path><path d="M12 17h.01"></path>
			default: <path d="M5 4h14v16H5z"></path>
		}
	</svg>
}

templ PortalDense(data PortalPageData) {
	<main class="dense-main" id="main-content" tabindex="-1">
		<header class="topbar"><div class="greeting"><h1>Hallo { data.GreetingName }.</h1><p>{ data.Today }</p></div><div class="top-actions"><div class="metrics" aria-label="Kennzahlen">
			if data.Modules.Issues {
				<a class="metric" href={ templ.SafeURL(portalIssuesURL(data)) }><strong>{ len(data.Issues) }</strong><span>offene Anliegen</span></a>
			}
			if data.Modules.Events {
				<a class="metric" href="/app/events"><strong>{ len(data.Events) }</strong><span>Termine</span></a>
			}
			if data.Modules.Announcements {
				<a class="metric" href="/app/announcements"><strong>{ data.UnreadAnnouncements }</strong><span>neue Beiträge</span></a>
			}
		</div>
		if data.Modules.Issues && data.CanCreateResidentIssue {
			<a class="button" href="/app/anliegen?new=1#issue-new">Anliegen melden</a>
		}
		</div></header>
		<section class="working-grid" aria-label="Arbeitsüberblick">
			if data.Modules.Issues {
				@DenseIssues(data)
			}
			<div class="side-stack">
				if data.Modules.Events {
					@DenseEvents(data)
				}
				if data.Modules.Announcements {
					@DenseAnnouncements(data)
				}
			</div>
		</section>
		if data.HasEnergy {
			<section class="home-strip" aria-labelledby="home-title"><h2 id="home-title">{ data.Energy.HomeName }</h2><p>{ data.Energy.Message }</p><a href={ templ.SafeURL(data.Energy.ActionURL) }>{ data.Energy.ActionLabel } →</a></section>
		}
		@PortalUtilities(data)
	</main>
}

templ DenseIssues(data PortalPageData) {
	<section class="card issues-card" aria-labelledby="issues-title"><header class="card-head"><h2 id="issues-title">Anliegen</h2><span class="count-label">{ len(data.Issues) } offen</span><a class="all-link" href={ templ.SafeURL(portalIssuesURL(data)) }>Alle anzeigen</a></header>
		if len(data.Issues) == 0 {
			<p class="empty">Nichts offen.</p>
		}
		if len(data.Issues) > 0 {
			<table><caption class="sr-only">Offene Anliegen mit Status, Ort, Alter und Zuständigkeit</caption><thead><tr><th>Status</th><th>Betreff</th><th>Ort</th><th>Alter</th><th>Zuständig</th></tr></thead><tbody>
				for _, issue := range data.Issues {
					<tr><td><span class="status"><span class={ "dot", templ.KV("gold", issue.Status == "Neu"), templ.KV("green", issue.Status == "In Arbeit") }></span>{ issue.Status }</span></td><td><a class="subject" href={ templ.SafeURL(issue.DetailURL) }>{ issue.Title }</a></td><td class="place">{ issue.Location }</td><td class="age">{ issue.CreatedAt }</td><td>{ issue.AssigneeEmail }</td></tr>
				}
			</tbody></table>
		}
	</section>
}

templ DenseEvents(data PortalPageData) {
	<section class="card agenda-card"><header class="card-head"><h2>Nächste Termine</h2><span class="count-label">{ len(data.Events) }</span></header>
		if len(data.Events) == 0 {
			<p class="empty">Kein Termin eingetragen.</p>
		}
		if len(data.Events) > 0 {
			<ol class="agenda">
				for _, event := range data.Events {
					<li><a href="/app/events"><time class="date-chip"><strong>{ event.DateBadgeDay }</strong><span>{ event.DateBadgeMonth }</span></time><span class="item-copy"><strong>{ event.Title }</strong><span>{ event.TimeRange }
						if event.HasLocation {
							<span> · { event.Location }</span>
						}
					</span></span></a></li>
				}
			</ol>
		}
	</section>
}

templ DenseAnnouncements(data PortalPageData) {
	<section class="card board-card"><header class="card-head"><h2>Am Aushang</h2><span class="count-label">{ data.UnreadAnnouncements } neu</span></header>
		if len(data.Announcements) == 0 {
			<p class="empty">Der Aushang ist leer.</p>
		}
		if len(data.Announcements) > 0 {
			<ul class="board-list">
				for _, item := range data.Announcements {
					<li><a href="/app/announcements"><span class={ "dot", templ.KV("gold", item.Unread) }></span><span class="item-copy"><strong>{ item.Title }</strong><span>{ item.Category } · { item.PublishedAt }</span></span></a></li>
				}
			</ul>
		}
	</section>
}

templ PortalCalm(data PortalPageData) {
	<main class="calm-main" id="main-content" tabindex="-1"><div class="calm-column">
		<header class="greeting"><h1>Hallo { data.GreetingName }.</h1><p>{ data.Today }</p></header>
		<h2 class="answer">{ calmAnswer(data) }</h2>
		<section class="disclosures" aria-label="Was Sie betrifft">
			if data.Modules.Issues {
				@CalmIssues(data)
			}
			if data.Modules.Events {
				@CalmEvents(data)
			}
			if data.Modules.Announcements {
				@CalmAnnouncements(data)
			}
		</section>
		if data.HasEnergy {
			<p class="quiet-home">{ data.Energy.Message } <a href={ templ.SafeURL(data.Energy.ActionURL) }>{ data.Energy.ActionLabel }</a></p>
		}
		@PortalUtilities(data)
	</div></main>
}

templ CalmIssues(data PortalPageData) {
	<details class="module" open><summary><span class="dot gold" aria-hidden="true"></span><h3>Anliegen</h3><span class="summary-count">{ len(data.Issues) } offen</span></summary><div class="module-body"><ol class="rows">
		for index, issue := range data.Issues {
			if index < 3 {
				<li class="row"><a href={ templ.SafeURL(issue.DetailURL) }><strong>{ issue.Title }</strong><span>{ issue.Location }</span><time>{ issue.CreatedAt }</time></a></li>
			}
		}
	</ol>
	if len(data.Issues) > 3 {
		<details class="more"><summary>Alle { len(data.Issues) } Anliegen anzeigen</summary><ol class="rows" start="4">
			for index, issue := range data.Issues {
				if index >= 3 {
					<li class="row"><a href={ templ.SafeURL(issue.DetailURL) }><strong>{ issue.Title }</strong><span>{ issue.Location }</span><time>{ issue.CreatedAt }</time></a></li>
				}
			}
		</ol></details>
	}
	if len(data.Issues) == 0 {
		<p class="empty">Nichts offen.</p>
	}
	</div></details>
}

templ CalmEvents(data PortalPageData) {
	<details class="module events"><summary><span class="dot green" aria-hidden="true"></span><h3>Termine</h3><span class="summary-count">{ len(data.Events) } Termine</span></summary><div class="module-body"><ol class="rows">
		for _, event := range data.Events {
			<li class="row"><a href="/app/events"><time><strong>{ event.DateBadgeDay }</strong><small>{ event.DateBadgeMonth }</small></time><strong>{ event.Title }</strong><span>{ event.TimeRange }
				if event.HasLocation {
					<span> · { event.Location }</span>
				}
			</span></a></li>
		}
	</ol>
	if len(data.Events) == 0 {
		<p class="empty">Kein Termin eingetragen.</p>
	}
	</div></details>
}

templ CalmAnnouncements(data PortalPageData) {
	<details class="module announcements"><summary><span class="dot" aria-hidden="true"></span><h3>Aushang</h3><span class="summary-count">{ data.UnreadAnnouncements } neue Beiträge</span></summary><div class="module-body"><ul class="rows">
		for _, item := range data.Announcements {
			<li class="row"><a href="/app/announcements"><span class={ "dot", templ.KV("gold", item.Unread) } aria-label={ templ.KV("ungelesen", item.Unread) }></span><strong>{ item.Title }</strong><span>{ item.Category } · { item.PublishedAt }</span></a></li>
		}
	</ul>
	if len(data.Announcements) == 0 {
		<p class="empty">Der Aushang ist leer.</p>
	}
	</div></details>
}

templ PortalUtilities(data PortalPageData) {
	<nav class="utility-links" aria-label="Weitere Bereiche">
		for _, area := range data.Areas {
			<a href={ templ.SafeURL(area.URL) }>{ area.Label }</a>
		}
		if data.Modules.Help {
			<a href="/app/hilfe">Hilfe</a>
		}
	</nav>
}

templ PortalMobile(data PortalPageData) {
	@PortalMobileHeader(data, data.Address)
	<main class="mobile-content" id="mobile-main-content"><header class="greeting"><h1>Hallo { data.GreetingName }.</h1><p>{ data.Today }</p></header>
		<article class="task-card"><p class="eyebrow">Jetzt zu erledigen</p>
			if data.HasPrimary {
				<h2>{ data.Primary.Title }</h2><p>{ data.Primary.Detail }</p><a class="primary" href={ templ.SafeURL(data.Primary.URL) }>{ data.Primary.ActionLabel }</a>
			} else {
				<h2>Alles im Blick</h2><p>Heute ist nichts zu erledigen.</p>
			}
		</article>
		<nav class="counts" aria-label="Kennzahlen">
			if data.Modules.Issues {
				<a class="count-tile" href={ templ.SafeURL(portalIssuesURL(data)) }><strong>{ len(data.Issues) }</strong><span>Anliegen</span></a>
			}
			if data.Modules.Events {
				<a class="count-tile" href="/app/events"><strong>{ len(data.Events) }</strong><span>Termine</span></a>
			}
			if data.Modules.Announcements {
				<a class="count-tile" href="/app/announcements"><strong>{ data.UnreadAnnouncements }</strong><span>Aushang</span></a>
			}
		</nav>
		if data.Modules.Events {
			<section class="mobile-section"><h2>Nächste Termine</h2><ol class="mobile-list">
				for index, event := range data.Events {
					if index < 2 {
						@PortalMobileEvent(event)
					}
				}
			</ol>
			if len(data.Events) > 2 {
				<details class="more-data"><summary>Alle { len(data.Events) } Termine</summary><ol class="mobile-list" start="3">
					for index, event := range data.Events {
						if index >= 2 {
							@PortalMobileEvent(event)
						}
					}
				</ol></details>
			}
			</section>
		}
		if data.Modules.Announcements {
			<section class="mobile-section"><h2>Am Aushang</h2><ul class="mobile-list">
				for index, item := range data.Announcements {
					if index == 0 {
						@PortalMobileAnnouncement(item)
					}
				}
			</ul>
			if len(data.Announcements) > 1 {
				<details class="more-data"><summary>Alle { len(data.Announcements) } Beiträge</summary><ul class="mobile-list">
					for index, item := range data.Announcements {
						if index > 0 {
							@PortalMobileAnnouncement(item)
						}
					}
				</ul></details>
			}
			</section>
		}
	</main>
	<div class="thumb-zone" aria-label="Schnellzugriff">
		if data.Modules.Issues && data.CanCreateResidentIssue {
			<a class="report" href="/app/anliegen?new=1#issue-new"><span aria-hidden="true">＋</span>Anliegen melden</a>
		}
		<nav class="tabs" aria-label="Hauptbereiche"><a class="active" href="/app" aria-current="page"><span class="tab-icon">@PortalIcon("home")</span><span>Haus</span></a>
			if data.CanUseResidentAreas && data.Modules.Announcements {
				<a href="/app/announcements"><span class="tab-icon">@PortalIcon("announcement")</span><span>Aushang</span></a>
			}
			if data.CanUseResidentAreas && data.Modules.Events {
				<a href="/app/events"><span class="tab-icon">@PortalIcon("calendar")</span><span>Termine</span></a>
			}
			<details class="bottom-more"><summary><span class="tab-icon">•••</span><span>Mehr</span></summary><div class="bottom-more-panel">
				for _, area := range data.Areas {
					<a href={ templ.SafeURL(area.URL) }>{ area.Label }</a>
				}
				if data.Modules.Help {
					<a href="/app/hilfe">Hilfe</a>
				}
			</div></details>
		</nav>
	</div>
}


templ PortalReleaseNotes(data PortalPageData) {
	<details class="release-notes"><summary>v{ data.DisplayVersion } · Versionsverlauf</summary><div class="release-panel"><h2>Versionsverlauf</h2>
		for _, note := range data.ReleaseNotes {
			<article class="release-entry"><small>v{ note.Version } · { note.Date } · { note.Kind }</small><strong>{ note.Headline }</strong><p>{ note.Intro }</p><ul>
				for _, item := range note.Items {
					<li><strong>{ item.Label }:</strong> { item.Text }</li>
				}
			</ul></article>
		}
	</div></details>
}

templ PortalMobileEvent(event view.HouseEventView) {
	<li><a class="mobile-event" href="/app/events"><time class="date-chip"><strong>{ event.DateBadgeDay }</strong><span>{ event.DateBadgeMonth }</span></time><span class="item-copy"><strong>{ event.Title }</strong><span>{ event.TimeRange }
		if event.HasLocation {
			<span> · { event.Location }</span>
		}
	</span></span><span class="chevron" aria-hidden="true">›</span></a></li>
}

templ PortalMobileAnnouncement(item view.AnnouncementView) {
	<li><a class="mobile-notice" href="/app/announcements"><span class={ "dot", templ.KV("gold", item.Unread) }></span><span class="item-copy"><strong>{ item.Title }</strong><span>{ item.Category } · { item.PublishedAt }</span></span><span class="chevron" aria-hidden="true">›</span></a></li>
}

func portalIssuesURL(data PortalPageData) string {
	if data.CanManageIssues {
		return "/app/anliegen/board"
	}
	return "/app/anliegen"
}

func calmAnswer(data PortalPageData) string {
	count := 0
	if data.Modules.Issues && len(data.Issues) > 0 { count++ }
	if data.Modules.Events && len(data.Events) > 0 { count++ }
	if data.Modules.Announcements && data.UnreadAnnouncements > 0 { count++ }
	if count == 0 { return "Heute wartet nichts auf Sie." }
	if count == 1 { return "Eine Sache wartet auf Sie." }
	if count == 2 { return "Zwei Dinge warten auf Sie." }
	return "Drei Dinge warten auf Sie."
}

// PortalMobileHeader is the compact shell used by portal sub-pages. Keeping it
// in the shared portal template means every route uses the same permission-gated
// PortalNavigation instead of growing a second mobile navigation tree.
