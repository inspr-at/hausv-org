package web

import "strconv"

type AnnualStatementPeriodView struct {
	Year      int
	StartsOn  string
	EndsOn    string
	DateRange string
	Deadline  string
	Selected  bool
}

type AnnualStatementFollowupView struct {
	SourceYear int
	Year       int
	DateRange  string
	Deadline   string
	Available  bool
}

type AnnualStatementUnitView struct {
	ID            string
	Label         string
	TypeLabel     string
	OwnerSummary  string
	RenterSummary string
}

type AnnualStatementCostTypeView struct {
	Key           string
	Name          string
	Allocatable   bool
	AllocationKey string
}

type AnnualStatementAllocationKeyOption struct {
	Key   string
	Label string
}

type AnnualStatementUnitBasisView struct {
	ID         string
	Label      string
	Share      string
	UsableArea string
	Persons    string
}

type AnnualStatementUnitShareView struct {
	Label  string
	Basis  string
	Share  string
	Mapped bool
}

type AnnualStatementAllocationPreviewView struct {
	Key           string
	Label         string
	CostTypes     string
	Shares        []AnnualStatementUnitShareView
	Blocked       bool
	Sourceless    bool
	UnmappedUnits string
	TotalNotice   string
}

type AnnualStatementAllocationView struct {
	KeyOptions       []AnnualStatementAllocationKeyOption
	Bases            []AnnualStatementUnitBasisView
	Previews         []AnnualStatementAllocationPreviewView
	BlockedCount     int
	KeylessCostTypes string
	RunReady         bool
}

type AnnualStatementReceiptDocumentView struct {
	ID    string
	Label string
}

type AnnualStatementReceiptView struct {
	ID            string
	DocumentTitle string
	Amount        string
	AmountValue   string
	InvoiceDate   string
	CostTypeName  string
}

type AnnualStatementReceiptSuggestionView struct {
	DocumentID       string
	Amount           string
	AmountCents      string
	InvoiceDate      string
	InvoiceDateValue string
	CostTypeKey      string
	CostTypeName     string
	Confirmed        bool
}

type AnnualStatementPrepaymentView struct {
	UnitID        string
	UnitLabel     string
	AmountValue   string
	Paid          string
	Allocated     string
	Balance       string
	Recorded      bool
}

type AnnualStatementPageData struct {
	Portal        PortalPageData
	EstateName    string
	EstateAddress string
	Periods       []AnnualStatementPeriodView
	HasPeriods    bool
	Year          int
	StructureYear int
	StartsOn      string
	EndsOn        string
	PeriodMsg     string
	PeriodOK      bool
	Followup      AnnualStatementFollowupView
	ImportMsg     string
	ImportOK      bool
	CostTypes     []AnnualStatementCostTypeView
	CostTypeCount int
	AllocatableCostTypeCount int
	CostTypeMsg   string
	CostTypeOK    bool
	ReceiptDocuments      []AnnualStatementReceiptDocumentView
	HasReceiptDocuments   bool
	ReceiptSuggesterReady bool
	ReceiptMsg            string
	ReceiptOK             bool
	ReceiptSuggestion     AnnualStatementReceiptSuggestionView
	HasReceiptSuggestion  bool
	Receipts              []AnnualStatementReceiptView
	HasReceipts           bool
	Units                  []AnnualStatementUnitView
	HasUnits               bool
	Allocation             AnnualStatementAllocationView
	BasesMsg               string
	BasesOK                bool
	Prepayments            []AnnualStatementPrepaymentView
	PrepaymentMsg          string
	PrepaymentOK           bool
	SettlementReady        bool
}

templ AnnualStatementPage(data AnnualStatementPageData) {
	@SettingsFrame(data.Portal, "Jahresabrechnung", nil, AnnualStatementContent(data))
}

templ AnnualStatementContent(data AnnualStatementPageData) {
	@PortalSectionLanding(
		PortalSectionLandingData{
			Portal: data.Portal,
			PageLabel: "Jahresabrechnung",
			Class: "settings-main",
			Identity: PortalSectionIdentityData{Label: "Einstellungen · Verwaltung", Icon: "document", URL: "/app/settings"},
		},
		PortalSectionTitle("Jahresabrechnung vorbereiten"),
		PortalSectionLede("Liegenschaft, Kostenarten, Einheiten, Parteien und Abrechnungsperiode vorbereiten."),
		AnnualStatementHeaderAction(),
		nil,
		nil,
		AnnualStatementBody(data),
	)
}

templ AnnualStatementHeaderAction() {
	<a class="button ghost" href="/app/settings">Zurück zu Einstellungen</a>
}

templ AnnualStatementBody(data AnnualStatementPageData) {
	<div data-templ-annual-statement>
		<section class="panel workspace" id="perioden"><header class="workspace-head"><div><h2>Liegenschaft &amp; Abrechnungsperiode</h2><p>Grunddaten ohne Belege, Schlüssel oder Berechnung.</p></div></header>
			@SettingsFlash(data.PeriodMsg, data.PeriodOK)
			<div class="form-grid"><fieldset><legend>Liegenschaft</legend><label>Name<span class="readonly"><strong>{ data.EstateName }</strong></span></label><label>Adresse<span class="readonly">{ data.EstateAddress }</span></label></fieldset>
				<form method="post" action="/app/settings/annual-statement/periods"><fieldset><legend>Abrechnungsperiode</legend><label>Abrechnungsjahr<input type="number" name="year" min="1" max="9999" value={ annualStatementYear(data.Year) } required/></label><div class="form-grid"><label>Von<input type="date" name="starts_on" value={ data.StartsOn } required/></label><label>Bis<input type="date" name="ends_on" value={ data.EndsOn } required/></label></div><button class="button primary" type="submit">Abrechnungsperiode speichern</button></fieldset></form>
			</div>
			if data.HasPeriods {
				<header class="subhead"><div><h3>Gespeicherte Abrechnungsjahre</h3><p>Für spätere Arbeitsschritte wiederverwendbar.</p></div></header><nav class="settings-links">
					for _, period := range data.Periods {
						<a href={ templ.SafeURL("/app/settings/annual-statement?year=" + annualStatementYear(period.Year)) } aria-current={ portalAriaCurrent(period.Selected) }><span class="link-icon">@PortalIcon("calendar")</span><span><strong>{ annualStatementYear(period.Year) }</strong><small>{ period.DateRange } · Erinnerung { period.Deadline }</small></span><b>›</b></a>
					}
				</nav>
			}
			if data.Followup.Available {
				<article class="inline-details"><header class="subhead"><div><h3>Folgejahr { annualStatementYear(data.Followup.Year) } vorbereiten</h3><p>{ data.Followup.DateRange }</p></div><span class="scope management">Vorlage</span></header>
					<p>Der Kostenartenkatalog, seine Verteilerschlüssel und Verteilerbasen werden als unabhängig bearbeitbare Vorlage übernommen. Einheiten und Parteien bleiben zentral gepflegt. Belege, Beträge, Vorauszahlungen und Abrechnungsergebnisse werden nicht kopiert.</p>
					<p class="notice"><strong>Abrechnungsfrist als Erinnerung: { data.Followup.Deadline }</strong><br/>Nach § 34 Abs. 1 WEG aus dem gespeicherten Periodenende mit sechs Monaten berechnet. Das ist eine Arbeitserinnerung und keine Rechtsberatung; Vereinbarungen und Einzelfall bitte prüfen.</p>
					<form method="post" action="/app/settings/annual-statement/periods/next"><input type="hidden" name="source_year" value={ annualStatementYear(data.Followup.SourceYear) }/><button class="button primary" type="submit">Folgejahr als Vorlage anlegen</button></form>
				</article>
			}
		</section>

		<section class="panel workspace"><header class="workspace-head"><div><h2>Kostenartenkatalog</h2><p>Wiederverwendbare Kostenarten mit eindeutigen Schlüsseln und Umlagefähigkeit.</p></div><span class="scope management">{ strconv.Itoa(data.CostTypeCount) } Kostenarten</span></header>
			@SettingsFlash(data.CostTypeMsg, data.CostTypeOK)
			<div class="metrics"><span><strong>{ strconv.Itoa(data.AllocatableCostTypeCount) }</strong><small>umlagefähig</small></span><span><strong>{ strconv.Itoa(data.CostTypeCount - data.AllocatableCostTypeCount) }</strong><small>nicht umlagefähig</small></span></div>
			<p class="notice">Die Umlagefähigkeit ist eine Arbeitseinstellung für diese Liegenschaft und keine rechtliche Beurteilung.</p>
			<div class="cost-type-list">
				for _, costType := range data.CostTypes {
					<form class="cost-type-card" method="post" action="/app/settings/annual-statement/cost-types"><input type="hidden" name="period_year" value={ annualStatementYear(data.StructureYear) }/><input type="hidden" name="key" value={ costType.Key }/><label>Bezeichnung<input name="name" value={ costType.Name } maxlength="120" required/></label><label>Schlüssel<span class="readonly"><code>{ costType.Key }</code></span></label><label>Umlagefähigkeit<select name="allocation" required><option value="allocatable" selected?={ costType.Allocatable }>Umlagefähig</option><option value="not_allocatable" selected?={ !costType.Allocatable }>Nicht umlagefähig</option></select></label><label>Verteilerschlüssel<select name="allocation_key"><option value="" selected?={ costType.AllocationKey == "" }>Kein Schlüssel</option>
						for _, option := range data.Allocation.KeyOptions {
							<option value={ option.Key } selected?={ option.Key == costType.AllocationKey }>{ option.Label }</option>
						}
					</select></label><button class="button ghost" type="submit">Speichern</button></form>
				}
			</div>
			<details class="inline-details"><summary>Weitere Kostenart hinzufügen</summary><form method="post" action="/app/settings/annual-statement/cost-types"><input type="hidden" name="period_year" value={ annualStatementYear(data.StructureYear) }/><p>Der Schlüssel bleibt eindeutig und wird später zur technischen Zuordnung verwendet.</p><div class="form-grid"><label>Bezeichnung<input name="name" maxlength="120" placeholder="z. B. Wasser und Abwasser" required/></label><label>Schlüssel <small>Kleinbuchstaben ohne Leerzeichen</small><input name="key" maxlength="64" pattern="[a-z0-9][a-z0-9_-]{0,63}" placeholder="wasser_abwasser" required/></label><label>Umlagefähigkeit<select name="allocation" required><option value="allocatable">Umlagefähig</option><option value="not_allocatable">Nicht umlagefähig</option></select></label><label>Verteilerschlüssel<select name="allocation_key">
					for _, option := range data.Allocation.KeyOptions {
						<option value={ option.Key }>{ option.Label }</option>
					}
				</select></label></div><div class="form-actions"><button class="button primary" type="submit">Kostenart hinzufügen</button></div></form></details>
		</section>

		<section class="panel workspace" id="verteilerschluessel"><header class="workspace-head"><div><h2>Verteilerschlüssel</h2><p>Jede umlagefähige Kostenart wird nach genau einem Schlüssel auf die Einheiten verteilt. Die Vorschau zeigt die Anteile vor dem Abrechnungslauf.</p></div>
			if data.Allocation.RunReady {
				<span class="scope personal">Lauf möglich</span>
			} else {
				<span class="scope management">Lauf blockiert</span>
			}
		</header>
			@SettingsFlash(data.BasesMsg, data.BasesOK)
			<p class="notice">Nutzwert, Nutzfläche und Personen sind für das gewählte Abrechnungsjahr eingefroren; beim ersten Anlegen stammen sie aus den Einheiten und das System erfindet keinen Wert. Verbrauch folgt aus den Messwerten in einem eigenen Arbeitsschritt. Eine Einheit ohne Wert blockiert den Lauf für diesen Schlüssel.</p>
			if data.Allocation.KeylessCostTypes != "" {
				<p class="notice"><strong>Ohne Verteilerschlüssel:</strong> { data.Allocation.KeylessCostTypes }. Jede umlagefähige Kostenart braucht genau einen Schlüssel; bis dahin ist der Lauf blockiert.</p>
			}
			if data.HasUnits {
				<form method="post" action="/app/settings/annual-statement/allocation-bases"><input type="hidden" name="period_year" value={ annualStatementYear(data.StructureYear) }/><header class="subhead"><div><h3>Verteilerbasis je Einheit</h3><p>Leer bedeutet „nicht hinterlegt“ und blockiert den Schlüssel. 0 ist ein gültiger Wert mit Anteil 0 %, etwa 0 Personen oder 0 m² für einen Stellplatz.</p></div></header><div class="unit-list">
					for _, basis := range data.Allocation.Bases {
						<div class="allocation-row"><input type="hidden" name="unit_id" value={ basis.ID }/><label>Einheit<span class="readonly"><strong>{ basis.Label }</strong></span></label><label>Nutzwert (Miteigentumsanteil)<span class="readonly">{ basis.Share }</span></label><label>Nutzfläche <small>m²</small><input name="usable_area_m2" value={ basis.UsableArea } inputmode="decimal" pattern="[0-9]{0,5}([.,][0-9]{0,2})?" placeholder="z. B. 72,50"/></label><label>Personen<input type="number" name="persons" value={ basis.Persons } min="0" max="10000" step="1" inputmode="numeric"/></label></div>
					}
				</div><div class="form-actions"><button class="button primary" type="submit">Verteilerbasis speichern</button></div></form>
			} else {
				<section class="empty"><h3>Noch keine Einheiten</h3><p>Ohne Einheiten gibt es keine Anteile. Legen Sie Einheiten zuerst in den Gebäudeeinstellungen an.</p><a class="button" href="/app/settings/building?section=units#unit-add">Einheit hinzufügen</a></section>
			}
			if len(data.Allocation.Previews) > 0 {
				<header class="subhead"><div><h3>Vorschau der Anteile</h3><p>Je verwendetem Schlüssel. Intern wird auf Millionstel exakt verteilt; die Anzeige rundet auf zwei Nachkommastellen.</p></div></header>
				for _, preview := range data.Allocation.Previews {
					<article class="inline-details allocation-preview" data-allocation-key={ preview.Key }><header class="subhead"><div><strong>{ preview.Label }</strong><p>Kostenarten: { preview.CostTypes }</p></div>
						if preview.Blocked {
							<span class="scope management">Blockiert</span>
						} else {
							<span class="scope personal">Vollständig</span>
						}
					</header>
					if preview.Sourceless {
						<p class="notice"><strong>Noch keine Verbrauchswerte.</strong> Die Zuordnung aus Messwerten folgt in einem eigenen Arbeitsschritt; bis dahin blockiert dieser Schlüssel den Lauf.</p>
					} else if preview.Blocked && preview.UnmappedUnits != "" {
						<p class="notice"><strong>Ohne Wert:</strong> { preview.UnmappedUnits }. Der Abrechnungslauf ist für diesen Schlüssel blockiert, bis jede Einheit einen Wert hat.</p>
					} else if preview.Blocked {
						<p class="notice"><strong>Keine Basis:</strong> Für diesen Schlüssel ist nichts zu verteilen. Der Abrechnungslauf ist blockiert.</p>
					}
					if preview.TotalNotice != "" {
						<p class="notice"><strong>Hinweis:</strong> { preview.TotalNotice }</p>
					}
					<div class="unit-list">
						for _, share := range preview.Shares {
							<div class="allocation-row"><label>Einheit<span class="readonly"><strong>{ share.Label }</strong></span></label><label>Basis<span class="readonly">{ share.Basis }</span></label><label>Anteil<span class="readonly"><strong>{ share.Share }</strong></span></label>
								if share.Mapped {
									<span class="scope personal">zugeordnet</span>
								} else {
									<span class="scope management">fehlt</span>
								}
							</div>
						}
					</div></article>
				}
			} else {
				<p class="notice">Keine umlagefähige Kostenart verwendet derzeit einen Schlüssel.</p>
			}
		</section>

		<section class="panel workspace" id="vorauszahlungen"><header class="workspace-head"><div><h2>Vorauszahlungen &amp; Akonto</h2><p>Akonto je Einheit für die gewählte Abrechnungsperiode erfassen und mit den derzeit zugeteilten Belegen vergleichen.</p></div><span class="scope management">Arbeitsvorschau</span></header>
			@SettingsFlash(data.PrepaymentMsg, data.PrepaymentOK)
			<p class="notice">Die Zuordnung ist eine Arbeitsvorschau aus den derzeit erfassten Belegen und Verteilerschlüsseln. Der versionierte Abrechnungslauf folgt in einem eigenen Arbeitsschritt.</p>
			if data.HasPeriods && data.HasUnits {
				<div class="unit-list">
					for _, item := range data.Prepayments {
						<form class="inline-details" method="post" action="/app/settings/annual-statement/prepayments"><input type="hidden" name="year" value={ annualStatementYear(data.Year) }/><input type="hidden" name="unit_id" value={ item.UnitID }/><header class="subhead"><div><strong>{ item.UnitLabel }</strong><p>Akonto-Gesamtbetrag im Abrechnungsjahr { annualStatementYear(data.Year) }</p></div></header><div class="form-grid"><label>Akonto <small>Euro, Gesamtbetrag</small><input name="amount" value={ item.AmountValue } inputmode="decimal" pattern="[0-9]+([.,][0-9]{2})" placeholder="z. B. 1200,00" required/></label><label>Vorausgezahlt<span class="readonly"><strong>{ item.Paid }</strong></span></label><label>Zugeteilt<span class="readonly">
							if data.SettlementReady {
								<strong>{ item.Allocated }</strong>
							} else {
								<strong>noch nicht berechenbar</strong>
							}
						</span></label><label>Saldo<span class="readonly">
							if data.SettlementReady && item.Recorded {
								<strong>{ item.Balance }</strong>
							} else {
								<strong>—</strong>
							}
						</span></label></div><div class="form-actions"><button class="button ghost" type="submit">Akonto speichern</button></div></form>
					}
				</div>
			} else {
				<p class="notice">Legen Sie zuerst eine Abrechnungsperiode und Einheiten an.</p>
			}
		</section>

		<section class="panel workspace"><header class="workspace-head"><div><h2>Belegdaten vorschlagen</h2><p>Ein vorhandenes PDF oder Bild wird ausschließlich auf dem freigegebenen Host geprüft.</p></div><span class="scope management">Optional</span></header>
			@SettingsFlash(data.ReceiptMsg, data.ReceiptOK)
			<p class="notice">Vorschläge ändern keine Abrechnungsdaten. Erst eine ausdrückliche Bestätigung übernimmt die erkannten Werte in den nächsten Arbeitsschritt.</p>
			if !data.ReceiptSuggesterReady {
				<p class="notice"><strong>Automatische Erkennung derzeit geschlossen.</strong> Es ist kein freigegebener Inferenzdienst in Österreich oder der EU eingerichtet. Es werden keine Belegdaten versendet.</p>
			}
			if data.HasReceiptDocuments {
				<form method="post" action="/app/settings/annual-statement/receipts/suggest"><label>Beleg aus Dokumenten<select name="document_id" required>
					<option value="">Dokument auswählen</option>
					for _, document := range data.ReceiptDocuments {
						<option value={ document.ID } selected?={ document.ID == data.ReceiptSuggestion.DocumentID }>{ document.Label }</option>
					}
				</select></label><button class="button primary" type="submit" disabled?={ !data.ReceiptSuggesterReady }>Betrag, Datum und Kostenart vorschlagen</button></form>
			} else {
				<section class="empty"><h3>Noch kein geeigneter Beleg</h3><p>Legen Sie zuerst ein PDF oder Bild in den bestehenden Dokumenten ab.</p><a class="button" href="/app/dokumente">Zu den Dokumenten</a></section>
			}
			if data.HasReceiptSuggestion {
				<header class="subhead"><div><h3>Erkannte Angaben</h3><p>Bitte mit dem Originalbeleg vergleichen.</p></div></header>
				<div class="form-grid three"><label>Betrag<span class="readonly"><strong>{ data.ReceiptSuggestion.Amount }</strong></span></label><label>Rechnungsdatum<span class="readonly"><strong>{ data.ReceiptSuggestion.InvoiceDate }</strong></span></label><label>Kostenart<span class="readonly"><strong>{ data.ReceiptSuggestion.CostTypeName }</strong></span></label></div>
				if data.ReceiptSuggestion.Confirmed {
					<p class="notice"><strong>Beleg gespeichert.</strong> Die erkannten Angaben wurden dem Originaldokument zugeordnet.</p>
				} else {
					<form method="post" action="/app/settings/annual-statement/receipts/confirm"><input type="hidden" name="document_id" value={ data.ReceiptSuggestion.DocumentID }/><input type="hidden" name="amount_cents" value={ data.ReceiptSuggestion.AmountCents }/><input type="hidden" name="invoice_date" value={ data.ReceiptSuggestion.InvoiceDateValue }/><input type="hidden" name="cost_type_key" value={ data.ReceiptSuggestion.CostTypeKey }/><input type="hidden" name="year" value={ annualStatementYear(data.Year) }/><div class="form-actions"><button class="button primary" type="submit">Vorschlag ausdrücklich bestätigen und Beleg speichern</button></div></form>
				}
			}
		</section>

		<section class="panel workspace"><header class="workspace-head"><div><h2>Belege</h2><p>Originaldokumente mit Betrag, Rechnungsdatum, Kostenart und Abrechnungsperiode verknüpfen.</p></div><span class="scope management">Verwaltung</span></header>
			<p class="notice">Ein Beleg verwendet das Original aus Dokumente. Beim Entfernen der Zuordnung bleibt die Originaldatei in Dokumente erhalten.</p>
			if data.HasPeriods && len(data.CostTypes) > 0 {
				<form method="post" action="/app/settings/annual-statement/receipts" enctype="multipart/form-data"><fieldset><legend>Beleg erfassen</legend><div class="form-grid"><label>Vorhandenes Dokument<select name="document_id"><option value="">Dokument auswählen</option>
					for _, document := range data.ReceiptDocuments {
						<option value={ document.ID }>{ document.Label }</option>
					}
				</select></label><label>Oder neue Originaldatei<input type="file" name="receipt_file" accept=".pdf,.jpg,.jpeg,.png,.webp,application/pdf,image/jpeg,image/png,image/webp"/></label><label>Abrechnungsjahr<input type="hidden" name="year" value={ annualStatementYear(data.Year) }/><span class="readonly"><strong>{ annualStatementYear(data.Year) }</strong></span></label><label>Kostenart<select name="cost_type_key" required><option value="">Kostenart auswählen</option>
					for _, costType := range data.CostTypes {
						<option value={ costType.Key }>{ costType.Name }</option>
					}
				</select></label><label>Betrag <small>Euro, zwei Dezimalstellen</small><input name="amount" inputmode="decimal" pattern="[0-9]+([.,][0-9]{2})" placeholder="z. B. 128,40" required/></label><label>Rechnungsdatum<input type="date" name="invoice_date" required/></label></div><div class="form-actions"><button class="button primary" type="submit">Beleg speichern</button></div></fieldset></form>
			} else {
				<p class="notice">Legen Sie zuerst eine Abrechnungsperiode und eine Kostenart an.</p>
			}
			if data.HasReceipts {
				<header class="subhead"><div><h3>Belege im Abrechnungsjahr { annualStatementYear(data.Year) }</h3><p>Beträge können korrigiert werden, ohne die Originaldatei zu ersetzen.</p></div></header><div class="cost-type-list">
					for _, receipt := range data.Receipts {
						<article class="cost-type-card"><label>Dokument<span class="readonly"><strong>{ receipt.DocumentTitle }</strong></span></label><label>Betrag<span class="readonly"><strong>{ receipt.Amount }</strong></span></label><label>Rechnungsdatum<span class="readonly">{ receipt.InvoiceDate }</span></label><label>Kostenart<span class="readonly">{ receipt.CostTypeName }</span></label><form method="post" action="/app/settings/annual-statement/receipts/update-amount"><input type="hidden" name="id" value={ receipt.ID }/><input type="hidden" name="year" value={ annualStatementYear(data.Year) }/><label>Betrag korrigieren <small>Euro</small><input name="amount" value={ receipt.AmountValue } inputmode="decimal" pattern="[0-9]+([.,][0-9]{2})" required/></label><button class="button ghost" type="submit">Betrag korrigieren</button></form><form method="post" action="/app/settings/annual-statement/receipts/delete"><input type="hidden" name="id" value={ receipt.ID }/><input type="hidden" name="year" value={ annualStatementYear(data.Year) }/><button class="button ghost" type="submit">Zuordnung entfernen</button><small>Die Originaldatei bleibt in Dokumente.</small></form></article>
					}
				</div>
			} else {
				<section class="empty"><h3>Noch keine Belege zugeordnet</h3><p>Wählen Sie ein vorhandenes Original aus Dokumente oder laden Sie hier einen Beleg hoch.</p><a class="button ghost" href="/app/dokumente">Zu den Dokumenten</a></section>
			}
		</section>

		<section class="panel workspace"><header class="workspace-head"><div><h2>Einheiten und Parteien</h2><p>Wohnungseigentümer und Mietverhältnisse werden aus den bestehenden Einheiten wiederverwendet.</p></div><a class="button ghost" href="/app/settings/building?section=units">Einheiten verwalten</a></header>
			@SettingsFlash(data.ImportMsg, data.ImportOK)
			if data.HasUnits {
				<div class="unit-list">
					for _, unit := range data.Units {
						<article class="unit-card"><span class="unit-kind">@PortalIcon("home")</span><div class="unit-title"><strong>{ unit.Label }</strong><small>{ unit.TypeLabel }</small></div><div class="assignment"><small>Wohnungseigentümer</small><strong>{ unit.OwnerSummary }</strong><small>Mietverhältnis</small><strong>{ unit.RenterSummary }</strong></div><div></div><a class="icon-button" href={ templ.SafeURL("/app/settings/building?section=units#unit-" + unit.ID) } aria-label={ unit.Label + " bearbeiten" }>✎</a></article>
					}
				</div>
			} else {
				<section class="empty"><h3>Noch keine Einheiten</h3><p>Legen Sie Einheiten zuerst in den Gebäudeeinstellungen an. Ein Import erzeugt keine Einheiten.</p><a class="button" href="/app/settings/building?section=units#unit-add">Einheit hinzufügen</a></section>
			}
			<details class="inline-details"><summary>Parteien aus Tabelle übernehmen <small>CSV</small></summary><form method="post" action="/app/settings/annual-statement/parties/import" enctype="multipart/form-data"><p>Spalten: <strong>Einheit</strong>, <strong>Rolle</strong>, <strong>E-Mail</strong>. Als Rolle werden „Wohnungseigentümer“ und „Mietverhältnis“ akzeptiert.</p><p class="notice">Nur vorhandene Einheiten werden zugeordnet. Eine unbekannte Einheit bricht den gesamten Import ab.</p><label>CSV-Datei<input type="file" name="parties_file" accept=".csv,text/csv" required/></label><button class="button primary" type="submit">Parteien übernehmen</button></form></details>
		</section>
	</div>
}

func annualStatementYear(year int) string { return strconv.Itoa(year) }
