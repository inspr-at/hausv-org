package web

import "strconv"

type AnnualStatementPeriodView struct {
	Year      int
	StartsOn  string
	EndsOn    string
	DateRange string
	Selected  bool
}

type AnnualStatementUnitView struct {
	ID            string
	Label         string
	TypeLabel     string
	OwnerSummary  string
	RenterSummary string
}

type AnnualStatementPageData struct {
	Portal        PortalPageData
	EstateName    string
	EstateAddress string
	Periods       []AnnualStatementPeriodView
	HasPeriods    bool
	Year          int
	StartsOn      string
	EndsOn        string
	PeriodMsg     string
	PeriodOK      bool
	ImportMsg     string
	ImportOK      bool
	Units         []AnnualStatementUnitView
	HasUnits      bool
}

templ AnnualStatementPage(data AnnualStatementPageData) {
	@SettingsFrame(data.Portal, "Jahresabrechnung", nil, AnnualStatementContent(data))
}

templ AnnualStatementContent(data AnnualStatementPageData) {
	@PortalSectionLanding(
		PortalSectionLandingData{
			Portal: data.Portal,
			PageLabel: "Jahresabrechnung",
			Class: "settings-main",
			Identity: PortalSectionIdentityData{Label: "Einstellungen · Verwaltung", Icon: "document", URL: "/app/settings"},
		},
		PortalSectionTitle("Grunddaten der Jahresabrechnung"),
		PortalSectionLede("Liegenschaft, Einheiten, Parteien und Abrechnungsperiode vorbereiten."),
		AnnualStatementHeaderAction(),
		nil,
		nil,
		AnnualStatementBody(data),
	)
}

templ AnnualStatementHeaderAction() {
	<a class="button ghost" href="/app/settings">Zurück zu Einstellungen</a>
}

templ AnnualStatementBody(data AnnualStatementPageData) {
	<div data-templ-annual-statement>
		<section class="panel workspace"><header class="workspace-head"><div><h2>Liegenschaft &amp; Abrechnungsperiode</h2><p>Grunddaten ohne Belege, Schlüssel oder Berechnung.</p></div></header>
			@SettingsFlash(data.PeriodMsg, data.PeriodOK)
			<div class="form-grid"><fieldset><legend>Liegenschaft</legend><label>Name<span class="readonly"><strong>{ data.EstateName }</strong></span></label><label>Adresse<span class="readonly">{ data.EstateAddress }</span></label></fieldset>
				<form method="post" action="/app/settings/annual-statement/periods"><fieldset><legend>Abrechnungsperiode</legend><label>Abrechnungsjahr<input type="number" name="year" min="1" max="9999" value={ annualStatementYear(data.Year) } required/></label><div class="form-grid"><label>Von<input type="date" name="starts_on" value={ data.StartsOn } required/></label><label>Bis<input type="date" name="ends_on" value={ data.EndsOn } required/></label></div><button class="button primary" type="submit">Abrechnungsperiode speichern</button></fieldset></form>
			</div>
			if data.HasPeriods {
				<header class="subhead"><div><h3>Gespeicherte Abrechnungsjahre</h3><p>Für spätere Arbeitsschritte wiederverwendbar.</p></div></header><nav class="settings-links">
					for _, period := range data.Periods {
						<a href={ templ.SafeURL("/app/settings/annual-statement?year=" + annualStatementYear(period.Year)) } aria-current={ portalAriaCurrent(period.Selected) }><span class="link-icon">@PortalIcon("calendar")</span><span><strong>{ annualStatementYear(period.Year) }</strong><small>{ period.DateRange }</small></span><b>›</b></a>
					}
				</nav>
			}
		</section>

		<section class="panel workspace"><header class="workspace-head"><div><h2>Einheiten und Parteien</h2><p>Wohnungseigentümer und Mietverhältnisse werden aus den bestehenden Einheiten wiederverwendet.</p></div><a class="button ghost" href="/app/settings/building?section=units">Einheiten verwalten</a></header>
			@SettingsFlash(data.ImportMsg, data.ImportOK)
			if data.HasUnits {
				<div class="unit-list">
					for _, unit := range data.Units {
						<article class="unit-card"><span class="unit-kind">@PortalIcon("home")</span><div class="unit-title"><strong>{ unit.Label }</strong><small>{ unit.TypeLabel }</small></div><div class="assignment"><small>Wohnungseigentümer</small><strong>{ unit.OwnerSummary }</strong><small>Mietverhältnis</small><strong>{ unit.RenterSummary }</strong></div><div></div><a class="icon-button" href={ templ.SafeURL("/app/settings/building?section=units#unit-" + unit.ID) } aria-label={ unit.Label + " bearbeiten" }>✎</a></article>
					}
				</div>
			} else {
				<section class="empty"><h3>Noch keine Einheiten</h3><p>Legen Sie Einheiten zuerst in den Gebäudeeinstellungen an. Ein Import erzeugt keine Einheiten.</p><a class="button" href="/app/settings/building?section=units#unit-add">Einheit hinzufügen</a></section>
			}
			<details class="inline-details"><summary>Parteien aus Tabelle übernehmen <small>CSV</small></summary><form method="post" action="/app/settings/annual-statement/parties/import" enctype="multipart/form-data"><p>Spalten: <strong>Einheit</strong>, <strong>Rolle</strong>, <strong>E-Mail</strong>. Als Rolle werden „Wohnungseigentümer“ und „Mietverhältnis“ akzeptiert.</p><p class="notice">Nur vorhandene Einheiten werden zugeordnet. Eine unbekannte Einheit bricht den gesamten Import ab.</p><label>CSV-Datei<input type="file" name="parties_file" accept=".csv,text/csv" required/></label><button class="button primary" type="submit">Parteien übernehmen</button></form></details>
		</section>
	</div>
}

func annualStatementYear(year int) string { return strconv.Itoa(year) }
