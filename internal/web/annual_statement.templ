package web

import "github.com/inspr-at/hausv-org/internal/store"

import "strconv"
import "fmt"

type AnnualStatementPeriodView struct {
	Year      int
	StartsOn  string
	EndsOn    string
	DateRange string
	Deadline  string
	Selected  bool
}

type AnnualStatementFollowupView struct {
	SourceYear int
	Year       int
	DateRange  string
	Deadline   string
	Available  bool
}

type AnnualStatementUnitView struct {
	ID            string
	Label         string
	TypeLabel     string
	OwnerSummary  string
	RenterSummary string
}

type AnnualStatementCostTypeView struct {
	Key            string
	Name           string
	Allocatable    bool
	AllocationKey  string
	VATRatePercent int
}

type AnnualStatementAllocationKeyOption struct {
	Key   string
	Label string
}

type AnnualStatementUnitBasisView struct {
	ID         string
	Label      string
	Share      string
	UsableArea string
	Persons    string
	VacantFrom string
	VacantTo   string
}

type AnnualStatementUnitShareView struct {
	Label  string
	Basis  string
	Share  string
	Mapped bool
}

type AnnualStatementAllocationPreviewView struct {
	Key           string
	Label         string
	CostTypes     string
	Shares        []AnnualStatementUnitShareView
	Blocked       bool
	Sourceless    bool
	UnmappedUnits string
	TotalNotice   string
}

type AnnualStatementAllocationView struct {
	KeyOptions       []AnnualStatementAllocationKeyOption
	Bases            []AnnualStatementUnitBasisView
	Previews         []AnnualStatementAllocationPreviewView
	BlockedCount     int
	KeylessCostTypes string
	RunReady         bool
}

type AnnualStatementConsumptionRowView struct {
	Label string
	Value string
	Share string
	Explanation string
	Measured bool
}

type AnnualStatementConsumptionGroupView struct {
	Kind string
	Label string
	SourceLabel string
	Rows []AnnualStatementConsumptionRowView
	MeasuredCount int
	GapCount int
	Complete bool
}

type AnnualStatementConsumptionView struct {
	Groups []AnnualStatementConsumptionGroupView
}

type AnnualStatementReceiptDocumentView struct {
	ID    string
	Label string
}

type AnnualStatementReceiptView struct {
 Supplier string
 HeatingCategory string
	ID            string
	DocumentTitle string
	Amount        string
	AmountValue   string
	InvoiceDate   string
	CostTypeName  string
}

type AnnualStatementReceiptSuggestionView struct {
	DocumentID       string
	Amount           string
	AmountCents      string
	InvoiceDate      string
	InvoiceDateValue string
	CostTypeKey      string
	CostTypeName     string
	Confirmed        bool
}

type AnnualStatementPrepaymentView struct {
 Prefilled bool
	UnitID        string
	UnitLabel     string
	AmountValue   string
	Paid          string
	Allocated     string
	Balance       string
	Recorded      bool
}

type AnnualStatementReserveEntryView struct {
	Date     string
	Kind     string
	Amount   string
	Note     string
	Document string
}

type AnnualStatementReserveView struct {
	Entries       []AnnualStatementReserveEntryView
	Opening       string
	Contributions string
	Withdrawals   string
	Interest      string
	Closing       string
	MinimumHint   string
	Documents     []AnnualStatementReceiptDocumentView
}

type AnnualStatementPageData struct {
 Legal store.AnnualStatementLegalSettings
	Portal        PortalPageData
	EstateName    string
	EstateAddress string
	Periods       []AnnualStatementPeriodView
	HasPeriods    bool
	Year          int
	StructureYear int
	StartsOn      string
	EndsOn        string
	PeriodMsg     string
	PeriodOK      bool
	Followup      AnnualStatementFollowupView
	ImportMsg     string
	ImportOK      bool
	CostTypes     []AnnualStatementCostTypeView
	CostTypeCount int
	AllocatableCostTypeCount int
	CostTypeMsg   string
	CostTypeOK    bool
	ReceiptDocuments      []AnnualStatementReceiptDocumentView
	HasReceiptDocuments   bool
	ReceiptSuggesterReady bool
	ReceiptMsg            string
	ReceiptOK             bool
	ReceiptSuggestion     AnnualStatementReceiptSuggestionView
	HasReceiptSuggestion  bool
	Receipts              []AnnualStatementReceiptView
	HasReceipts           bool
	Units                  []AnnualStatementUnitView
	HasUnits               bool
	UnitDataNotice         string
	Allocation             AnnualStatementAllocationView
	Consumption            AnnualStatementConsumptionView
	BasesMsg               string
	BasesOK                bool
	Prepayments            []AnnualStatementPrepaymentView
	PrepaymentMsg          string
	PrepaymentOK           bool
	ShowReserve            bool
	Reserve                AnnualStatementReserveView
	ReserveMsg             string
	ReserveOK              bool
	Run AnnualStatementRunView
	SettlementReady        bool
}

templ AnnualStatementPage(data AnnualStatementPageData) {
	@SettingsFrame(data.Portal, "Jahresabrechnung", nil, AnnualStatementContent(data))
}

templ AnnualStatementContent(data AnnualStatementPageData) {
	@PortalSectionLanding(
		PortalSectionLandingData{
			Portal: data.Portal,
			PageLabel: "Jahresabrechnung",
			Class: "settings-main",
			Identity: PortalSectionIdentityData{Label: "Einstellungen · Verwaltung", Icon: "document", URL: "/app/settings"},
		},
		PortalSectionTitle("Jahresabrechnung vorbereiten"),
		PortalSectionLede("Liegenschaft, Kostenarten, Einheiten, Parteien und Abrechnungsperiode vorbereiten."),
		AnnualStatementHeaderAction(),
		nil,
		nil,
		AnnualStatementBody(data),
	)
}

templ AnnualStatementHeaderAction() {
	<a class="button ghost" href="/app/settings">Zurück zu Einstellungen</a>
}

templ AnnualStatementBody(data AnnualStatementPageData) {
	<div data-templ-annual-statement>
		@AnnualStatementRunPanel(data.Run) {
			@AnnualStatementPreparation(data)
		}
	</div>
}

templ AnnualStatementPreparation(data AnnualStatementPageData) {
		<style>.annual-preparation{margin-top:var(--space-4);min-width:0}.annual-preparation>summary{display:flex;align-items:center;justify-content:space-between;gap:var(--space-3);padding:var(--space-4);border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel-soft);cursor:pointer;font-weight:700;list-style:none}.annual-preparation>summary::-webkit-details-marker{display:none}.annual-preparation>summary small{display:block;margin-top:var(--space-1);font-size:12px;font-weight:400;color:var(--muted)}.annual-preparation>.workspace{margin-top:var(--space-4)}.annual-preparation :is(.annual-blocker,:target){outline:2px solid var(--gold);outline-offset:4px;scroll-margin-top:100px}.annual-preparation :is(#heizflaechen,#heizakontos)>summary{cursor:pointer;min-height:44px;padding:var(--space-3) 0;font-weight:600}</style>
		<details class="annual-preparation" open?={ !data.Run.Ready || data.PeriodMsg != "" || data.ImportMsg != "" || data.CostTypeMsg != "" || data.ReceiptMsg != "" || data.BasesMsg != "" || data.PrepaymentMsg != "" || data.ReserveMsg != "" || data.HasReceiptSuggestion } data-annual-blocking-section={ data.Run.BlockingSection }>
		<summary><span>Grundlagen und Belege prüfen oder bearbeiten · { annualStatementYear(data.Year) }<small>Kostenarten, Einheiten, Parteien, Periode</small></span>
			@DisclosureChevron()
		</summary>
 if data.StructureYear > 0 {
 <section class="panel workspace" id="rechtsgrundlage">
 <header class="workspace-head"><div><h2>Rechtsgrundlage</h2><p>Gilt für diese Liegenschaft und Periode. Nach Änderungen einen neuen Lauf berechnen; freigegebene Läufe bleiben erhalten.</p></div></header>
 <form method="post" action="/app/settings/annual-statement/legal">
 <input type="hidden" name="year" value={ annualStatementYear(data.StructureYear) }/>
 <label>Abrechnungsregime<select name="regime">
 <option value="weg" selected?={ data.Legal.Regime == "weg" }>WEG</option>
 <option value="mrg_voll" selected?={ data.Legal.Regime == "mrg_voll" }>MRG Vollanwendung</option>
 <option value="mrg_teil" selected?={ data.Legal.Regime == "mrg_teil" }>MRG Teilanwendung</option>
 <option value="ausnahme" selected?={ data.Legal.Regime == "ausnahme" }>MRG Ausnahme</option>
 </select></label>
 <label><input type="checkbox" name="heizkg_applies" checked?={ data.Legal.HeizKGApplies }/> HeizKG anwendbar</label>
 <label><input type="checkbox" name="show_vat" checked?={ data.Legal.ShowVAT }/> Umsatzsteuer ausweisen</label>
 <p>Aus bleibt die Abrechnung brutto wie bisher. An zeigt je Kostenart Netto, Steuersatz, Umsatzsteuer und Brutto. Heizung und Warmwasser sind 20 %, die übrigen Kostenarten 10 %, jeweils änderbar auf 0, 10 oder 20 %.</p>
 <fieldset><legend>HeizKG-Verteilung</legend>
 <label>Verbrauchsanteil der Energiekosten (%)<input type="number" name="heating_consumption_percent" min="55" max="85" value={ strconv.Itoa(data.Legal.HeatingConsumptionPercent) } required/></label>
 <p>55–85 %, üblicher Ausgangswert 70 %. Der Rest der Energiekosten und sämtliche sonstigen Betriebskosten folgen der versorgbaren Nutzfläche.</p>
 <details id="heizflaechen"><summary>Versorgbare Nutzflächen je Einheit erfassen</summary>
 for _, unit := range data.Units {
 <label>{ unit.Label } · versorgbare Nutzfläche (m²)<input name={ "heatable_area_"+unit.ID } value={ annualHeatableArea(data.Legal,unit.ID) } inputmode="decimal"/></label>
 }
 </details>
 <details id="heizakontos"><summary>Geleistete Heizungs- und Warmwasserakontos je Einheit erfassen</summary>
 for _, unit := range data.Units {
 for _, key := range []string{"heizung", "warmwasser"} {
 <label>{ unit.Label } · { key } · geleistetes Akonto (Euro)<input name={ "heating_prepayment_"+key+"_"+unit.ID } value={ annualHeatingPrepayment(data.Legal,unit.ID,key) } inputmode="decimal"/></label>
 }

 }
 </details>
 </fieldset>
 <fieldset><legend>Neue monatliche Vorauszahlungen</legend>
 <label>Gültig ab<input type="date" name="next_prepayment_on" value={ data.Legal.NextPrepaymentOn }/></label>
 <p>MRG Vollanwendung: Vorjahreskosten / 12; über +10 % erscheint ein Hinweis. WEG: manuelle Vorausschau. HeizKG: Vorperiodenanteil / 12.</p>
 <details><summary>Monatsbeträge je Einheit und Kostenart erfassen</summary>
 for _,unit:=range data.Units {
 for _,cost:=range data.CostTypes {
 if cost.Allocatable && !(data.Legal.HeizKGApplies && store.IsAnnualHeatingCost(cost.Key)) {
 <label>{ unit.Label } · { cost.Name } (Euro)<input name={ "monthly_proposal_"+cost.Key+"_"+unit.ID } value={ annualMonthlyProposal(data.Legal,unit.ID,cost.Key) } inputmode="decimal"/></label>
 }
 }
 }
 </details>
 </fieldset>
 <fieldset><legend>Einsicht in die Belege</legend>
 <label>Ort<input name="inspection_place" value={ data.Legal.InspectionPlace } maxlength="300"/></label>
 <label>Zeitraum und Öffnungszeiten<input name="inspection_period" value={ data.Legal.InspectionPeriod } maxlength="300"/></label>
 <label>Kontakt<input name="inspection_contact" value={ data.Legal.InspectionContact } maxlength="300"/></label>
 </fieldset>
 <div class="form-actions"><button class="button primary" type="submit">Rechtsgrundlage speichern</button></div>
 </form>
 </section>
 if data.ShowReserve {
 <section class="panel workspace" id="ruecklage" data-annual-reserve>
 <style>
 [data-annual-reserve] .reserve-summary{display:grid;grid-template-columns:repeat(auto-fit,minmax(9rem,1fr));gap:var(--space-3);margin:var(--space-4) 0}
 [data-annual-reserve] .reserve-summary div{padding:var(--space-3);border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--panel-soft);min-width:0}
 [data-annual-reserve] .reserve-summary span{display:block;color:var(--muted);font-size:12px}
 [data-annual-reserve] .reserve-list{display:flex;flex-direction:column;gap:var(--space-3);margin-bottom:var(--space-4)}
 [data-annual-reserve] .reserve-entry{display:grid;grid-template-columns:7rem 8rem 1fr;gap:var(--space-2);align-items:baseline}
 @media(max-width:640px){[data-annual-reserve] .reserve-entry{grid-template-columns:1fr}}
 </style>
 <header class="workspace-head"><div><h2>Rücklage</h2><p>Buchungen dieser WEG-Periode. Korrekturen sind weitere Buchungen; gespeicherte Zeilen bleiben stehen.</p></div></header>
 @SettingsFlash(data.ReserveMsg, data.ReserveOK)
 <div class="reserve-summary" data-reserve-closing={ data.Reserve.Closing }>
 <div><span>Anfangsstand</span><strong>{ data.Reserve.Opening }</strong></div>
 <div><span>Zuführungen</span><strong>{ data.Reserve.Contributions }</strong></div>
 <div><span>Entnahmen</span><strong>{ data.Reserve.Withdrawals }</strong></div>
 <div><span>Zinsen</span><strong>{ data.Reserve.Interest }</strong></div>
 <div><span>Endstand</span><strong>{ data.Reserve.Closing }</strong></div>
 </div>
 if data.Reserve.MinimumHint != "" {
 <p class="notice">{ data.Reserve.MinimumHint }</p>
 }
 if len(data.Reserve.Entries) > 0 {
 <div class="reserve-list">
 for _, entry := range data.Reserve.Entries {
 <article class="reserve-entry"><span>{ entry.Date }</span><strong>{ entry.Kind }</strong><span>{ entry.Amount }{ entry.Note }{ entry.Document }</span></article>
 }
 </div>
 }
 <form method="post" action="/app/settings/annual-statement/reserve"><fieldset><legend>Buchung hinzufügen</legend>
 <input type="hidden" name="year" value={ annualStatementYear(data.StructureYear) }/>
 <div class="form-grid">
 <label>Art<select name="kind" required>
 <option value="opening">Anfangsstand</option>
 <option value="contribution" selected>Zuführung</option>
 <option value="withdrawal">Entnahme</option>
 <option value="interest">Zinsen</option>
 <option value="closing_check">Endstand-Kontrolle</option>
 </select></label>
 <label>Datum<input type="date" name="entry_date" required/></label>
 <label>Betrag <small>Euro</small><input name="amount" inputmode="decimal" pattern="-?[0-9]+([.,][0-9]{2})" placeholder="0,00" required/></label>
 <label>Beleg bei Entnahme<select name="document_id"><option value="">Kein Beleg</option>
 for _, document := range data.Reserve.Documents {
 <option value={ document.ID }>{ document.Label }</option>
 }
 </select></label>
 <label>Notiz<input name="note" maxlength="500"/></label>
 </div>
 <div class="form-actions"><button class="button primary" type="submit">Buchung hinzufügen</button></div>
 </fieldset></form>
 </section>
 }
 }

		<section class="panel workspace" id="perioden"><header class="workspace-head"><div><h2>Liegenschaft &amp; Abrechnungsperiode</h2><p>Grunddaten ohne Belege, Schlüssel oder Berechnung.</p></div></header>
			@SettingsFlash(data.PeriodMsg, data.PeriodOK)
			<div class="form-grid"><fieldset><legend>Liegenschaft</legend><label>Name<span class="readonly"><strong>{ data.EstateName }</strong></span></label><label>Adresse<span class="readonly">{ data.EstateAddress }</span></label></fieldset>
				<form method="post" action="/app/settings/annual-statement/periods"><fieldset><legend>Abrechnungsperiode</legend><label>Abrechnungsjahr<input type="number" name="year" min="1" max="9999" value={ annualStatementYear(data.Year) } required/></label><div class="form-grid"><label>Von<input type="date" name="starts_on" value={ data.StartsOn } required/></label><label>Bis<input type="date" name="ends_on" value={ data.EndsOn } required/></label></div><button class="button primary" type="submit">Abrechnungsperiode speichern</button></fieldset></form>
			</div>
			if data.HasPeriods {
				<header class="subhead"><div><h3>Gespeicherte Abrechnungsjahre</h3><p>Für spätere Arbeitsschritte wiederverwendbar.</p></div></header><nav class="settings-links">
					for _, period := range data.Periods {
						<a href={ templ.SafeURL("/app/settings/annual-statement?year=" + annualStatementYear(period.Year)) } aria-current={ portalAriaCurrent(period.Selected) }><span class="link-icon">@PortalIcon("calendar")</span><span><strong>{ annualStatementYear(period.Year) }</strong><small>{ period.DateRange } · Erinnerung { period.Deadline }</small></span><b>›</b></a>
					}
				</nav>
			}
			if data.Followup.Available {
				<article class="inline-details"><header class="subhead"><div><h3>Folgejahr { annualStatementYear(data.Followup.Year) } vorbereiten</h3><p>{ data.Followup.DateRange }</p></div><span class="scope management">Vorlage</span></header>
					<p>Der Kostenartenkatalog, seine Verteilerschlüssel und Verteilerbasen werden als unabhängig bearbeitbare Vorlage übernommen. Einheiten und Parteien bleiben zentral gepflegt. Belege, Beträge, Vorauszahlungen und Abrechnungsergebnisse werden nicht kopiert.</p>
					<p class="notice"><strong>Abrechnungsfrist als Erinnerung: { data.Followup.Deadline }</strong><br/>Nach der gewählten Rechtsgrundlage: { data.Legal.Basis() }. Vereinbarungen und Einzelfall bitte prüfen.</p>
					<form method="post" action="/app/settings/annual-statement/periods/next"><input type="hidden" name="source_year" value={ annualStatementYear(data.Followup.SourceYear) }/><button class="button primary" type="submit">Folgejahr als Vorlage anlegen</button></form>
				</article>
			}
		</section>

		<section class="panel workspace" id="kostenarten"><header class="workspace-head"><div><h2>Kostenartenkatalog</h2><p>Wiederverwendbare Kostenarten mit eindeutigen Schlüsseln und Umlagefähigkeit.</p></div><span class="scope management">{ strconv.Itoa(data.CostTypeCount) } Kostenarten</span></header>
			@SettingsFlash(data.CostTypeMsg, data.CostTypeOK)
			<div class="metrics"><span><strong>{ strconv.Itoa(data.AllocatableCostTypeCount) }</strong><small>umlagefähig</small></span><span><strong>{ strconv.Itoa(data.CostTypeCount - data.AllocatableCostTypeCount) }</strong><small>nicht umlagefähig</small></span></div>
			<p class="notice">Die Umlagefähigkeit ist eine Arbeitseinstellung für diese Liegenschaft und keine rechtliche Beurteilung.</p>
			<div class="cost-type-list">
				for _, costType := range data.CostTypes {
					<form class="cost-type-card" method="post" action="/app/settings/annual-statement/cost-types"><input type="hidden" name="period_year" value={ annualStatementYear(data.StructureYear) }/><input type="hidden" name="key" value={ costType.Key }/><label>Bezeichnung<input name="name" value={ costType.Name } maxlength="120" required/></label><label>Schlüssel<span class="readonly"><code>{ costType.Key }</code></span></label><label>Umlagefähigkeit<select name="allocation" required><option value="allocatable" selected?={ costType.Allocatable }>Umlagefähig</option><option value="not_allocatable" selected?={ !costType.Allocatable }>Nicht umlagefähig</option></select></label><label>Verteilerschlüssel<select name="allocation_key"><option value="" selected?={ costType.AllocationKey == "" }>Kein Schlüssel</option>
						for _, option := range data.Allocation.KeyOptions {
							<option value={ option.Key } selected?={ option.Key == costType.AllocationKey }>{ option.Label }</option>
						}
					</select></label><label>USt-Satz<select name="vat_rate" required><option value="0" selected?={ costType.VATRatePercent == 0 }>0 %</option><option value="10" selected?={ costType.VATRatePercent == 10 }>10 %</option><option value="20" selected?={ costType.VATRatePercent == 20 }>20 %</option></select></label><button class="button ghost" type="submit">Speichern</button></form>
				}
			</div>
			<details class="inline-details"><summary>Weitere Kostenart hinzufügen
				@DisclosureChevron()
			</summary><form method="post" action="/app/settings/annual-statement/cost-types"><input type="hidden" name="period_year" value={ annualStatementYear(data.StructureYear) }/><p>Der Schlüssel bleibt eindeutig und wird später zur technischen Zuordnung verwendet.</p><div class="form-grid"><label>Bezeichnung<input name="name" maxlength="120" placeholder="z. B. Wasser und Abwasser" required/></label><label>Schlüssel <small>Kleinbuchstaben ohne Leerzeichen</small><input name="key" maxlength="64" pattern="[a-z0-9][a-z0-9_-]{0,63}" placeholder="wasser_abwasser" required/></label><label>Umlagefähigkeit<select name="allocation" required><option value="allocatable">Umlagefähig</option><option value="not_allocatable">Nicht umlagefähig</option></select></label><label>Verteilerschlüssel<select name="allocation_key">
					for _, option := range data.Allocation.KeyOptions {
						<option value={ option.Key }>{ option.Label }</option>
					}
				</select></label><label>USt-Satz<select name="vat_rate"><option value="" selected>Standard</option><option value="0">0 %</option><option value="10">10 %</option><option value="20">20 %</option></select></label></div><div class="form-actions"><button class="button primary" type="submit">Kostenart hinzufügen</button></div></form></details>
		</section>

		<section class="panel workspace" id="verteilerschluessel"><header class="workspace-head"><div><h2>Verteilerschlüssel</h2><p>Jede umlagefähige Kostenart wird nach genau einem Schlüssel auf die Einheiten verteilt. Die Vorschau zeigt die Anteile vor dem Abrechnungslauf.</p></div>
			if data.Allocation.RunReady {
				<span class="scope personal">Verteilung vollständig</span>
			} else {
				<span class="scope management">Verteilung blockiert</span>
			}
		</header>
			@SettingsFlash(data.BasesMsg, data.BasesOK)
			<p class="notice">Nutzwert, Nutzfläche und Personen sind für das gewählte Abrechnungsjahr eingefroren; beim ersten Anlegen stammen sie aus den Einheiten und das System erfindet keinen Wert. Verbrauch folgt aus den gespeicherten Anfangs- und Endmessungen der gewählten Periode. Eine Einheit ohne Wert blockiert den Lauf für diesen Schlüssel.</p>
			if data.Allocation.KeylessCostTypes != "" {
				<p class="notice"><strong>Ohne Verteilerschlüssel:</strong> { data.Allocation.KeylessCostTypes }. Jede umlagefähige Kostenart braucht genau einen Schlüssel; bis dahin ist die Verteilung blockiert.</p>
			}
			if data.UnitDataNotice != "" {
				<p class="notice" role="status">{ data.UnitDataNotice }</p>
			} else if data.HasUnits {
				<form method="post" action="/app/settings/annual-statement/allocation-bases"><input type="hidden" name="period_year" value={ annualStatementYear(data.StructureYear) }/><header class="subhead"><div><h3>Verteilerbasis je Einheit</h3><p>Leer bedeutet „nicht hinterlegt“ und blockiert den Schlüssel. 0 ist ein gültiger Wert mit Anteil 0 %, etwa 0 Personen oder 0 m² für einen Stellplatz.</p></div></header><div class="unit-list">
					for _, basis := range data.Allocation.Bases {
						<div class="allocation-row"><input type="hidden" name="unit_id" value={ basis.ID }/><label>Einheit<span class="readonly"><strong>{ basis.Label }</strong></span></label><label>Nutzwert (Miteigentumsanteil)<span class="readonly">{ basis.Share }</span></label><label>Nutzfläche <small>m²</small><input name="usable_area_m2" value={ basis.UsableArea } inputmode="decimal" pattern="[0-9]{0,5}([.,][0-9]{0,2})?" placeholder="z. B. 72,50"/></label><label>Personen<input type="number" name="persons" value={ basis.Persons } min="0" max="10000" step="1" inputmode="numeric"/></label><label>Leerstand von<input type="date" name="vacant_from" value={ basis.VacantFrom }/></label><label>Leerstand bis<input type="date" name="vacant_to" value={ basis.VacantTo }/></label></div>
					}
				</div><div class="form-actions"><button class="button primary" type="submit">Verteilerbasis speichern</button></div></form>
			} else {
				<section class="empty"><h3>Noch keine Einheiten</h3><p>Ohne Einheiten gibt es keine Anteile. Legen Sie Einheiten zuerst in den Gebäudeeinstellungen an.</p><a class="button" href="/app/settings/building?section=units#unit-add">Einheit hinzufügen</a></section>
			}
			if len(data.Allocation.Previews) > 0 {
				<header class="subhead"><div><h3>Vorschau der Anteile</h3><p>Je verwendetem Schlüssel. Intern wird auf Millionstel exakt verteilt; die Anzeige rundet auf zwei Nachkommastellen.</p></div></header>
				for _, preview := range data.Allocation.Previews {
					<article class="inline-details allocation-preview" data-allocation-key={ preview.Key }><header class="subhead"><div><strong>{ preview.Label }</strong><p>Kostenarten: { preview.CostTypes }</p></div>
						if preview.Blocked {
							<span class="scope management">Blockiert</span>
						} else {
							<span class="scope personal">Vollständig</span>
						}
					</header>
					if preview.Sourceless {
						<p class="notice"><strong>Noch keine Verbrauchswerte.</strong> Für diese Kostenart fehlen vollständige Periodenmessungen; bis dahin blockiert dieser Schlüssel den Lauf.</p>
					} else if preview.Blocked && preview.UnmappedUnits != "" {
						<p class="notice"><strong>Ohne Wert:</strong> { preview.UnmappedUnits }. Der Abrechnungslauf ist für diesen Schlüssel blockiert, bis jede Einheit einen Wert hat.</p>
					} else if preview.Blocked {
						<p class="notice"><strong>Keine Basis:</strong> Für diesen Schlüssel ist nichts zu verteilen. Der Abrechnungslauf ist blockiert.</p>
					}
					if preview.TotalNotice != "" {
						<p class="notice"><strong>Hinweis:</strong> { preview.TotalNotice }</p>
					}
					<div class="unit-list">
						for _, share := range preview.Shares {
							<div class="allocation-row"><label>Einheit<span class="readonly"><strong>{ share.Label }</strong></span></label><label>Basis<span class="readonly">{ share.Basis }</span></label><label>Anteil<span class="readonly"><strong>{ share.Share }</strong></span></label>
								if share.Mapped {
									if preview.Key == "verbrauch" {
										<span class="scope personal">gemessen</span>
									} else {
										<span class="scope personal">zugeordnet</span>
									}
								} else {
									<span class="scope management">fehlt</span>
								}
							</div>
						}
					</div></article>
				}
			} else {
				<p class="notice">Keine umlagefähige Kostenart verwendet derzeit einen Schlüssel.</p>
			}
		</section>

		if len(data.Consumption.Groups) > 0 {
		<section class="panel workspace" id="verbrauchswerte"><header class="workspace-head"><div><h2>Heizung &amp; Warmwasser aus Messwerten</h2><p>Gespeicherte HAUSV-Messnachweise je Einheit für die gewählte Abrechnungsperiode.</p></div></header>
			<p class="notice">Für die Berechnung sind Zählerstände exakt am Periodenbeginn und am Beginn des Folgetags nach Periodenende nötig (00:00 Uhr, Europe/Vienna). Ein üblicher Live-Zählerstand ersetzt diese Grenzmessungen nicht. Ohne ein bestätigtes Messkonzept zur Periodengrenze bleibt die Kostenart gesperrt. Eine fehlende Messung bleibt „nicht gemessen“ und wird nicht als 0 gerechnet. HAUSV schätzt keine Werte und legt keine gesetzliche Verteilungsregel fest. Die Eignung des Messkonzepts und des gewählten Schlüssels ist für die konkrete österreichische WEG-/MRG-Abrechnung zu klären.</p>
			<p>Zuordnung der Gerätetypen: Wärmepumpe (heat-pump) liefert die Messwerte für Heizung; Warmwassergerät (hot-water) und Durchlauferhitzer (instant-water-heater) liefern die Messwerte für Warmwasser.</p>
			for _, group := range data.Consumption.Groups {
				<article class="inline-details" data-consumption-kind={ group.Kind }><header class="subhead"><div><h3>{ group.Label }</h3><p>{ group.SourceLabel }</p></div>
					if group.Complete {
						<span class="scope personal">Vollständig gemessen</span>
					} else {
						<span class="scope management">Keine vollständige Verteilungsbasis</span>
					}
				</header>
				for _, row := range group.Rows {
					<div class="allocation-row"><label>Einheit<span class="readonly"><strong>{ row.Label }</strong></span></label><label>Gemessener Periodenverbrauch<span class="readonly">{ row.Value }</span></label><label>Anteil<span class="readonly">{ row.Share }</span></label>
						if row.Measured {
							<span class="scope personal">gemessen</span>
						} else {
							<span class="scope management">nicht gemessen</span>
						}
						<p>{ row.Explanation }</p>
					</div>
				}
				</article>
			}
		</section>
		}

		<section class="panel workspace" id="vorauszahlungen"><header class="workspace-head"><div><h2>Vorauszahlungen &amp; Akonto</h2><p>Akonto je Einheit für die gewählte Abrechnungsperiode erfassen und mit den derzeit zugeteilten Belegen vergleichen.</p></div><span class="scope management">Arbeitsvorschau</span></header>
			@SettingsFlash(data.PrepaymentMsg, data.PrepaymentOK)
			<p class="notice">Die Zuordnung ist eine Arbeitsvorschau aus den derzeit erfassten Belegen und Verteilerschlüsseln. Ein gespeicherter Abrechnungslauf hält den geprüften Stand für alle Einheiten fest.</p>
			if data.HasPeriods && data.HasUnits {
				<div class="unit-list">
					for _, item := range data.Prepayments {
						<form class="inline-details" method="post" action="/app/settings/annual-statement/prepayments"><input type="hidden" name="year" value={ annualStatementYear(data.Year) }/><input type="hidden" name="unit_id" value={ item.UnitID }/><header class="subhead"><div><strong>{ item.UnitLabel }</strong><p>Akonto-Gesamtbetrag im Abrechnungsjahr { annualStatementYear(data.Year) }</p></div></header><div class="form-grid">if item.Prefilled {
 <p>Vorschlag aus der freigegebenen Vorjahresabrechnung (12 Monatsbeträge). Tatsächlich geleistete Zahlungen prüfen und erst dann speichern.</p>
 }
 <label>Akonto <small>Euro, Gesamtbetrag</small><input name="amount" value={ item.AmountValue } inputmode="decimal" pattern="[0-9]+([.,][0-9]{2})" placeholder="z. B. 1200,00" required/></label><label>Vorausgezahlt<span class="readonly"><strong>{ item.Paid }</strong></span></label><label>Zugeteilt<span class="readonly">
							if data.SettlementReady {
								<strong>{ item.Allocated }</strong>
							} else {
								<strong>noch nicht berechenbar</strong>
							}
						</span></label><label>Saldo<span class="readonly">
							if data.SettlementReady && item.Recorded {
								<strong>{ item.Balance }</strong>
							} else {
								<strong>—</strong>
							}
						</span></label></div><div class="form-actions"><button class="button ghost" type="submit">Akonto speichern</button></div></form>
					}
				</div>
			} else {
				<p class="notice">Legen Sie zuerst eine Abrechnungsperiode und Einheiten an.</p>
			}
		</section>

		<section class="panel workspace"><header class="workspace-head"><div><h2>Belegdaten vorschlagen</h2><p>Ein vorhandenes PDF oder Bild wird ausschließlich auf dem freigegebenen Host geprüft.</p></div><span class="scope management">Optional</span></header>
			@SettingsFlash(data.ReceiptMsg, data.ReceiptOK)
			<p class="notice">Vorschläge ändern keine Abrechnungsdaten. Erst eine ausdrückliche Bestätigung übernimmt die erkannten Werte in den nächsten Arbeitsschritt.</p>
			if !data.ReceiptSuggesterReady {
				<p class="notice"><strong>Automatische Erkennung derzeit geschlossen.</strong> Es ist kein freigegebener Inferenzdienst in Österreich oder der EU eingerichtet. Es werden keine Belegdaten versendet.</p>
			}
			if data.HasReceiptDocuments {
				<form method="post" action="/app/settings/annual-statement/receipts/suggest"><input type="hidden" name="year" value={ annualStatementYear(data.Year) }/><label>Beleg aus Dokumenten<select name="document_id" required>
					<option value="">Dokument auswählen</option>
					for _, document := range data.ReceiptDocuments {
						<option value={ document.ID } selected?={ document.ID == data.ReceiptSuggestion.DocumentID }>{ document.Label }</option>
					}
				</select></label><button class="button primary" type="submit" disabled?={ !data.ReceiptSuggesterReady }>Betrag, Datum und Kostenart vorschlagen</button></form>
			} else {
				<section class="empty"><h3>Noch kein geeigneter Beleg</h3><p>Legen Sie zuerst ein PDF oder Bild in den bestehenden Dokumenten ab.</p><a class="button" href="/app/dokumente">Zu den Dokumenten</a></section>
			}
			if data.HasReceiptSuggestion {
				<header class="subhead"><div><h3>Erkannte Angaben</h3><p>Bitte mit dem Originalbeleg vergleichen.</p></div></header>
				<div class="form-grid three"><label>Betrag<span class="readonly"><strong>{ data.ReceiptSuggestion.Amount }</strong></span></label><label>Rechnungsdatum<span class="readonly"><strong>{ data.ReceiptSuggestion.InvoiceDate }</strong></span></label><label>Kostenart<span class="readonly"><strong>{ data.ReceiptSuggestion.CostTypeName }</strong></span></label></div>
				if data.ReceiptSuggestion.Confirmed {
					<p class="notice"><strong>Beleg gespeichert.</strong> Die erkannten Angaben wurden dem Originaldokument zugeordnet.</p>
				} else {
					<form method="post" action="/app/settings/annual-statement/receipts/confirm"><input type="hidden" name="document_id" value={ data.ReceiptSuggestion.DocumentID }/><input type="hidden" name="amount_cents" value={ data.ReceiptSuggestion.AmountCents }/><input type="hidden" name="invoice_date" value={ data.ReceiptSuggestion.InvoiceDateValue }/><input type="hidden" name="cost_type_key" value={ data.ReceiptSuggestion.CostTypeKey }/><input type="hidden" name="year" value={ annualStatementYear(data.Year) }/><div class="form-actions"><button class="button primary" type="submit">Vorschlag ausdrücklich bestätigen und Beleg speichern</button></div></form>
				}
			}
		</section>

		<section class="panel workspace" id="belege"><header class="workspace-head"><div><h2>Belege</h2><p>Originaldokumente mit Betrag, Rechnungsdatum, Kostenart und Abrechnungsperiode verknüpfen.</p></div><span class="scope management">Verwaltung</span></header>
			<p class="notice">Ein Beleg verwendet das Original aus Dokumente. Beim Entfernen der Zuordnung bleibt die Originaldatei in Dokumente erhalten.</p>
			if data.HasPeriods && len(data.CostTypes) > 0 {
				<form method="post" action="/app/settings/annual-statement/receipts" enctype="multipart/form-data"><fieldset><legend>Beleg erfassen</legend><div class="form-grid"><label>Vorhandenes Dokument<select name="document_id"><option value="">Dokument auswählen</option>
					for _, document := range data.ReceiptDocuments {
						<option value={ document.ID }>{ document.Label }</option>
					}
				</select></label><label>Oder neue Originaldatei<input type="file" name="receipt_file" accept=".pdf,.jpg,.jpeg,.png,.webp,application/pdf,image/jpeg,image/png,image/webp"/></label><label>Abrechnungsjahr<input type="hidden" name="year" value={ annualStatementYear(data.Year) }/><span class="readonly"><strong>{ annualStatementYear(data.Year) }</strong></span></label><label>Kostenart<select name="cost_type_key" required><option value="">Kostenart auswählen</option>
					for _, costType := range data.CostTypes {
						<option value={ costType.Key }>{ costType.Name }</option>
					}
				</select></label><label>Betrag <small>Euro, zwei Dezimalstellen</small><input name="amount" inputmode="decimal" pattern="[0-9]+([.,][0-9]{2})" placeholder="z. B. 128,40" required/></label><label>Rechnungsdatum<input type="date" name="invoice_date" required/></label><label>Lieferant<input name="supplier" maxlength="300"/></label>
 <label>Heizkostenbeleg<select name="heating_category"><option value="">Nicht zugeordnet</option><option value="energie">Energie</option><option value="sonstige_betriebskosten">Sonstige Betriebskosten</option></select></label></div><div class="form-actions"><button class="button primary" type="submit">Beleg speichern</button></div></fieldset></form>
			} else {
				<p class="notice">Legen Sie zuerst eine Abrechnungsperiode und eine Kostenart an.</p>
			}
			if data.HasReceipts {
				<header class="subhead"><div><h3>Belege im Abrechnungsjahr { annualStatementYear(data.Year) }</h3><p>Beträge können korrigiert werden, ohne die Originaldatei zu ersetzen.</p></div></header><div class="cost-type-list">
					for _, receipt := range data.Receipts {
						<article class="cost-type-card"><label>Dokument<span class="readonly"><strong>{ receipt.DocumentTitle }</strong></span></label><label>Betrag<span class="readonly"><strong>{ receipt.Amount }</strong></span></label><label>Rechnungsdatum<span class="readonly">{ receipt.InvoiceDate }</span></label><label>Kostenart<span class="readonly">{ receipt.CostTypeName }</span></label><form method="post" action="/app/settings/annual-statement/receipts/update-amount"><input type="hidden" name="id" value={ receipt.ID }/><input type="hidden" name="year" value={ annualStatementYear(data.Year) }/><label>Betrag korrigieren <small>Euro</small><input name="amount" value={ receipt.AmountValue } inputmode="decimal" pattern="[0-9]+([.,][0-9]{2})" required/></label><button class="button ghost" type="submit">Betrag korrigieren</button></form><form method="post" action="/app/settings/annual-statement/receipts/metadata">
 <input type="hidden" name="id" value={ receipt.ID }/>
 <label>Lieferant<input name="supplier" value={ receipt.Supplier } maxlength="300"/></label>
 <label>Heizkostenbeleg<select name="heating_category"><option value="">Nicht zugeordnet</option><option value="energie" selected?={ receipt.HeatingCategory == "energie" }>Energie</option><option value="sonstige_betriebskosten" selected?={ receipt.HeatingCategory == "sonstige_betriebskosten" }>Sonstige Betriebskosten</option></select></label>
 <button class="button ghost" type="submit">Belegangaben speichern</button>
 </form><form method="post" action="/app/settings/annual-statement/receipts/delete"><input type="hidden" name="id" value={ receipt.ID }/><input type="hidden" name="year" value={ annualStatementYear(data.Year) }/><button class="button ghost" type="submit">Zuordnung entfernen</button><small>Die Originaldatei bleibt in Dokumente.</small></form></article>
					}
				</div>
			} else {
				<section class="empty"><h3>Noch keine Belege zugeordnet</h3><p>Wählen Sie ein vorhandenes Original aus Dokumente oder laden Sie hier einen Beleg hoch.</p><a class="button ghost" href="/app/dokumente">Zu den Dokumenten</a></section>
			}
		</section>

		<section class="panel workspace" id="parteien"><header class="workspace-head"><div><h2>Einheiten und Parteien</h2><p>Wohnungseigentümer und Mietverhältnisse werden aus den bestehenden Einheiten wiederverwendet.</p></div><a class="button ghost" href="/app/settings/building?section=units">Einheiten verwalten</a></header>
			@SettingsFlash(data.ImportMsg, data.ImportOK)
			if data.UnitDataNotice != "" {
				<p class="notice" role="status">{ data.UnitDataNotice }</p>
			} else if data.HasUnits {
				<div class="unit-list">
					for _, unit := range data.Units {
						<article class="unit-card"><span class="unit-kind">@PortalIcon("home")</span><div class="unit-title"><strong>{ unit.Label }</strong><small>{ unit.TypeLabel }</small></div><div class="assignment"><small>Wohnungseigentümer</small><strong>{ unit.OwnerSummary }</strong><small>Mietverhältnis</small><strong>{ unit.RenterSummary }</strong></div><div></div><a class="icon-button" href={ templ.SafeURL("/app/settings/building?section=units#unit-" + unit.ID) } aria-label={ unit.Label + " bearbeiten" }>✎</a></article>
					}
				</div>
			} else {
				<section class="empty"><h3>Noch keine Einheiten</h3><p>Legen Sie Einheiten zuerst in den Gebäudeeinstellungen an. Ein Import erzeugt keine Einheiten.</p><a class="button" href="/app/settings/building?section=units#unit-add">Einheit hinzufügen</a></section>
			}
			<details class="inline-details"><summary>Parteien aus Tabelle übernehmen <small>CSV</small>
				@DisclosureChevron()
			</summary><form method="post" action="/app/settings/annual-statement/parties/import" enctype="multipart/form-data"><p>Spalten: <strong>Einheit</strong>, <strong>Rolle</strong>, <strong>E-Mail</strong>. Optional: <strong>Name</strong> und <strong>Anschrift</strong> für adressierte PDF-Entwürfe. Als Rolle werden „Wohnungseigentümer“ und „Mietverhältnis“ akzeptiert.</p><p class="notice">Nur vorhandene Einheiten werden zugeordnet. Eine unbekannte Einheit bricht den gesamten Import ab.</p><label>CSV-Datei<input type="file" name="parties_file" accept=".csv,text/csv" required/></label><button class="button primary" type="submit">Parteien übernehmen</button></form></details>
		</section>
		</details>
}

func annualStatementYear(year int) string { return strconv.Itoa(year) }

func annualHeatableArea(legal store.AnnualStatementLegalSettings, id string) string {
 area,ok:=legal.HeatableAreas[id]
 if !ok { return "" }
 return strconv.Itoa(area/100)+","+fmt.Sprintf("%02d",area%100)
}

func annualHeatingPrepayment(legal store.AnnualStatementLegalSettings,id,key string) string {
 value,ok:=legal.HeatingPrepayments[id][key]
 if !ok { return "" }
 return fmt.Sprintf("%d,%02d",value/100,value%100)
}

func annualMonthlyProposal(legal store.AnnualStatementLegalSettings,id,key string) string {
 value,ok:=legal.MonthlyProposals[id][key]
 if !ok { return "" }
 return fmt.Sprintf("%d,%02d",value/100,value%100)
}
