#!/usr/bin/env python3
"""Deterministic command doubles for scripts/test-deploy.sh."""

from __future__ import annotations

import base64
import binascii
import os
from pathlib import Path
import re
import shlex
import sys


HEAD = "a" * 40
ORIGIN_MISMATCH = "c" * 40
LIVE = "b" * 40
IMAGE_ID = "sha256:" + ("1" * 64)
LOCK_PREFIX = (
    "/run/current-system/sw/bin/flock -w 300 "
    "/run/lock/compose-hausv.lock /bin/sh -eu"
)
ACTIVATION_LOCK_PREFIX = (
    "/run/current-system/sw/bin/flock -E 41 -w 300 "
    "/run/lock/compose-hausv.lock /bin/sh -eu"
)
LOCKED_TRANSPORT = re.compile(
    r"^locked_script=\$\(/run/current-system/sw/bin/mktemp "
    r"/tmp/hausv-locked\.XXXXXX\)(?P<mktemp_guard> \|\| exit 40)?; "
    r"trap \"rm -f \$locked_script\" "
    r"EXIT HUP INT TERM; printf %s (?P<payload>[A-Za-z0-9+/=]+) \| "
    r"/run/current-system/sw/bin/base64 -d >\"\$locked_script\""
    r"(?P<decode_guard> \|\| exit 40)?; "
    r"(?P<lock>/run/current-system/sw/bin/flock "
    r"(?:-E 41 )?-w 300 /run/lock/compose-hausv\.lock /bin/sh -eu) "
    r"\"\$locked_script\"$"
)
CANONICAL_COMPOSE = (
    "docker compose --project-directory "
    "/srv/hausv/compose -p hausv "
    "-f /srv/hausv/compose/docker-compose.yml"
)


def required(name: str) -> str:
    value = os.environ.get(name, "")
    if not value:
        raise RuntimeError(f"{name} is required")
    return value


CASE = required("DEPLOY_FIXTURE_CASE")
STATE = Path(required("DEPLOY_FIXTURE_STATE"))
REPO = Path(required("DEPLOY_FIXTURE_REPO"))
LIVE_URL = required("HAUSV_DEPLOY_LIVE_URL")
CONTAINER = required("HAUSV_DEPLOY_CONTAINER")
# HAUSV-562: "" means the fixture left the setting out, "none" a SQLite-only
# host, anything else the PostgreSQL container the recovery point must dump.
POSTGRES = os.environ.get("HAUSV_DEPLOY_POSTGRES_CONTAINER", "")
APP_VERSION = (REPO / "VERSION").read_text(encoding="utf-8").strip()
STATE.mkdir(parents=True, exist_ok=True)


def log(command: str, args: list[str]) -> None:
    with (STATE / "commands.log").open("a", encoding="utf-8") as handle:
        handle.write(command + "\t" + shlex.join(args) + "\n")


def count(name: str) -> int:
    path = STATE / f"{name}.count"
    current = int(path.read_text(encoding="utf-8")) if path.exists() else 0
    current += 1
    path.write_text(str(current), encoding="utf-8")
    return current


def mock_git(args: list[str]) -> int:
    if args == ["rev-parse", "--show-toplevel"]:
        print(REPO)
    elif args == ["status", "--porcelain"]:
        if CASE == "dirty":
            print(" M VERSION")
    elif args == ["status", "--short"]:
        if CASE == "dirty":
            print(" M VERSION")
    elif args == ["fetch", "--quiet", "origin", "main"]:
        return 1 if CASE == "fetch_fail" else 0
    elif args == ["rev-parse", "HEAD"]:
        print(HEAD)
    elif args == ["rev-parse", "refs/remotes/origin/main"]:
        print(ORIGIN_MISMATCH if CASE == "origin_mismatch" else HEAD)
    elif args == ["rev-parse", "--short=7", "HEAD"]:
        print(HEAD[:7])
    elif args == ["show", "HEAD:.github/workflows/ci.yml"]:
        if CASE == "reusable_job":
            print(
                "name: CI\n"
                "jobs:\n"
                "  test:\n"
                "    runs-on: blacksmith-2vcpu-ubuntu-2404\n"
                "  delegated:\n"
                "    uses: ./.github/workflows/delegated.yml"
            )
            return 0
        runner = (
            "ubuntu-latest"
            if CASE == "non_blacksmith"
            else "blacksmith-2vcpu-ubuntu-2404"
        )
        print(
            "name: CI\n"
            "jobs:\n"
            "  test:\n"
            f"    runs-on: {runner}\n"
            "  docker:\n"
            "    runs-on: blacksmith-2vcpu-ubuntu-2404"
        )
    elif args == ["rev-parse", f"{LIVE[:7]}^{{commit}}"]:
        print(LIVE)
    elif len(args) >= 3 and args[:2] == ["diff", "--quiet"]:
        return 1 if "schema" in CASE else 0
    elif args == ["archive", "--format=tar", "HEAD"]:
        sys.stdout.buffer.write(b"deterministic-fixture-archive")
    else:
        print(f"unexpected git fixture call: {args}", file=sys.stderr)
        return 64
    return 0


def mock_gh(args: list[str]) -> int:
    if args[:2] != ["run", "list"]:
        print(f"unexpected gh fixture call: {args}", file=sys.stderr)
        return 64
    expected = {
        "--repo": "inspr-at/hausv-org",
        "--workflow": "CI",
        "--branch": "main",
        "--commit": HEAD,
        "--event": "push",
        "--limit": "10",
        "--json": "databaseId,headSha,headBranch,status,conclusion,url",
    }
    for flag, value in expected.items():
        if args.count(flag) != 1:
            print(f"gh fixture requires exactly one {flag}", file=sys.stderr)
            return 64
        index = args.index(flag)
        if index + 1 >= len(args) or args[index + 1] != value:
            print(f"gh fixture expected {flag} {value}", file=sys.stderr)
            return 64
    if args.count("--jq") != 1:
        print("gh fixture requires one --jq filter", file=sys.stderr)
        return 64
    jq_filter = args[args.index("--jq") + 1]
    for proof in (
        '.headBranch == "main"',
        '.status == "completed"',
        '.conclusion == "success"',
        ".headSha",
        "@tsv",
    ):
        if proof not in jq_filter:
            print(f"gh fixture filter is missing {proof}", file=sys.stderr)
            return 64
    if CASE == "ci_query_fail":
        return 1
    if CASE == "ci_missing":
        return 0
    result_head = "e" * 40 if CASE == "ci_wrong_head" else HEAD
    print(
        f"30485824014\t{result_head}\t"
        "https://example.invalid/actions/runs/30485824014"
    )
    return 0


def mock_curl(args: list[str]) -> int:
    url = args[-1]
    if url.endswith("/healthz"):
        call = count("health")
        if CASE == "live_health_fail" and call == 1:
            return 22
        if CASE == "post_health_fail" and call > 1:
            return 22
        print('{"service":"hausv-org","status":"ok"}')
        return 0

    call = count("page")
    if CASE == "live_unreadable" and call == 1:
        print("<html>")
        print("<body>version unavailable</body>")
        print("</html>")
        return 0
    if call == 1:
        live_version = (
            (REPO / "VERSION").read_text(encoding="utf-8").strip()
            if CASE == "same_version_different_commit"
            else "0.0.0"
        )
        print("<html>")
        print(f"<footer>{live_version} ({LIVE[:7]})</footer>")
        print("</html>")
        return 0
    version = (REPO / "VERSION").read_text(encoding="utf-8").strip()
    commit = "ddddddd" if CASE == "post_version_mismatch" else HEAD[:7]
    print("<html>")
    print(f"<footer>{version} ({commit})</footer>")
    print("</html>")
    return 0


def mock_base64(args: list[str]) -> int:
    payload = sys.stdin.buffer.read()
    if not args:
        encode_call = count("base64_encode")
        if CASE == "encoder_fail" and encode_call == 1:
            return 1
        if CASE == "schema_snapshot_recovery_encoder_fail" and encode_call == 3:
            return 1
        if CASE == "rollback_encoder_fail" and encode_call == 4:
            return 1
        sys.stdout.buffer.write(base64.encodebytes(payload))
        return 0
    if args == ["-d"]:
        try:
            sys.stdout.buffer.write(base64.b64decode(payload, validate=True))
        except binascii.Error:
            return 1
        return 0
    print(f"unexpected base64 fixture call: {args}", file=sys.stderr)
    return 64


def snapshot_path(remote: str) -> str:
    match = re.search(r"--snapshot[ \t]+([^ \t]+)", remote)
    if match is None:
        raise RuntimeError("snapshot path missing from remote command")
    return match.group(1)


def unwrap_remote_sh(remote: str) -> tuple[str, bool]:
    prefix = "/bin/sh -eu -c "
    if not remote.startswith(prefix):
        return remote, False
    escaped = remote[len(prefix) :]
    try:
        # `scripts/deploy.sh` quotes the script POSIX-style, including the
        # '\'' idiom for an embedded quote. hausv's login shell is fish, which
        # decodes that identically. shlex is the exact inverse; what matters is
        # the contract — the script must arrive as exactly ONE argument to
        # `/bin/sh -c` — not which shell formatted it.
        fields = shlex.split(escaped, posix=True)
    except ValueError:
        return escaped, True
    if len(fields) == 1:
        return fields[0], True
    return escaped, True


def require_remote_sh(wrapped: bool, operation: str) -> bool:
    if wrapped:
        return True
    print(f"{operation} did not use /bin/sh -eu -c", file=sys.stderr)
    return False


def unwrap_locked_transport(script: str) -> str:
    match = LOCKED_TRANSPORT.fullmatch(script)
    if match is None:
        return script
    try:
        decoded = base64.b64decode(
            match.group("payload"), validate=True
        ).decode("utf-8")
    except (binascii.Error, UnicodeDecodeError) as error:
        raise RuntimeError("invalid locked-script transport") from error
    guards = ""
    if match.group("mktemp_guard") and match.group("decode_guard"):
        guards = "activation-transport-setup-exit-40\n"
    return f"{guards}{match.group('lock')}\n{decoded}"


def mock_ssh(args: list[str]) -> int:
    remote = args[-1]
    script, wrapped = unwrap_remote_sh(remote)
    try:
        script = unwrap_locked_transport(script)
    except RuntimeError as error:
        print(str(error), file=sys.stderr)
        return 64

    if "--source /var/lib/hausv" in script:
        if not require_remote_sh(wrapped, "snapshot"):
            return 64
        if LOCK_PREFIX not in script:
            print("snapshot helper is not held under the hausv lock", file=sys.stderr)
            return 64
        if script.index(LOCK_PREFIX) >= script.index("sudo -n"):
            print("snapshot lock is acquired after the helper starts", file=sys.stderr)
            return 64
        for fragment in (
            "--compose-dir /srv/hausv/compose",
            "--compose-file /srv/hausv/compose/docker-compose.yml",
            "--compose-project hausv",
        ):
            if fragment not in script:
                print(f"snapshot command is missing {fragment}", file=sys.stderr)
                return 64
        if "def main() -> int:" not in script or "HAUSV_PREDEPLOY_PY" not in script:
            print("snapshot helper is not embedded in the locked body", file=sys.stderr)
            return 64
        if POSTGRES and POSTGRES != "none":
            expected_postgres = f"--postgres-container {POSTGRES} --postgres-user hausv_backup --postgres-db hausv"
        else:
            expected_postgres = "--postgres-container none"
        if expected_postgres not in script:
            print(f"snapshot command is missing {expected_postgres}", file=sys.stderr)
            return 64
        if script.count(IMAGE_ID) < 2 or script.index(IMAGE_ID) >= script.index("sudo -n"):
            print("snapshot did not revalidate the preflight image identity", file=sys.stderr)
            return 64
        if sys.stdin.buffer.read():
            print("snapshot helper unexpectedly used SSH stdin", file=sys.stderr)
            return 64
        if CASE in {
            "schema_snapshot_fail",
            "schema_snapshot_recovery_fail",
            "schema_snapshot_recovery_encoder_fail",
            "schema_snapshot_identity_drift",
        }:
            return 1
        print(f"snapshot-path={snapshot_path(script)}")
        print("snapshot-created=2026-07-30T12:00:00Z")
        print("snapshot-integrity=ok")
        if POSTGRES and POSTGRES != "none":
            print(f"postgres-dump={snapshot_path(script)}/postgres.pgdump")
            print("postgres-dump-bytes=4096")
            print("postgres-dump-sha256=" + "c" * 64)
            print("postgres-dump-tables=3")
        print("service-health=healthy")
        return 0

    if "log_file=" in script:
        if not require_remote_sh(wrapped, "start-log check"):
            return 64
        if f"docker logs {CONTAINER}" not in script:
            print("start-log check did not target the configured container", file=sys.stderr)
            return 64
        return 1 if CASE == "schema_startlog_fail" else 0

    if remote.startswith("docker inspect --format"):
        if not remote.endswith(f" {CONTAINER}"):
            print("health probe did not target the configured container", file=sys.stderr)
            return 64
        if CASE in {
            "schema_snapshot_recovery_fail",
            "schema_snapshot_recovery_encoder_fail",
        }:
            print("unhealthy")
            return 0
        print("healthy")
        return 0

    if "docker tag" in script and "prev-" in script and "release-" not in script:
        if not require_remote_sh(wrapped, "rollback image preservation"):
            return 64
        required = (
            "running_image_id=",
            "latest_image_id=",
            "previous_image_id=",
            "docker tag",
            "docker image inspect --format",
            LOCK_PREFIX,
            IMAGE_ID,
            f"docker inspect --format '{{{{.Image}}}}' {CONTAINER}",
        )
        if any(fragment not in script for fragment in required):
            print("rollback image preservation is incomplete", file=sys.stderr)
            return 64
        if not (
            script.index(LOCK_PREFIX)
            < script.index("running_image_id=")
            < script.index("docker tag")
        ):
            print("rollback image preservation is not one locked transition", file=sys.stderr)
            return 64
        return 1 if CASE in {"preserve_fail", "preserve_identity_drift"} else 0

    if "docker pull" in script:
        if not require_remote_sh(wrapped, "release pull"):
            return 64
        required_fragment = f"docker pull ghcr.io/inspr-at/hausv-org:release-{APP_VERSION}-aaaaaaa"
        if required_fragment not in script:
            print(f"release pull is missing: {required_fragment}", file=sys.stderr)
            return 64
        # Verify docker login is present
        if "docker login ghcr.io" not in script:
            print("release pull missing docker login", file=sys.stderr)
            return 64
        if "--password-stdin" not in script:
            print("docker login missing --password-stdin", file=sys.stderr)
            return 64
        # Verify token file check
        token_file_check = "if [ ! -r /run/agenix/csb1-hausv-ghcr-pull ]"
        if token_file_check not in script:
            print("pull script missing token file readability check", file=sys.stderr)
            return 64
        # Check that login is in a subshell to prevent token leakage
        if "( docker login" not in script:
            print("docker login not in subshell", file=sys.stderr)
            return 64
        # Simulate test-specific behaviors
        if CASE == "ghcr_token_missing":
            # Simulate the script detecting missing token file and echoing to stderr
            print("GHCR token file is not readable: /run/agenix/csb1-hausv-ghcr-pull", file=sys.stderr)
            return 1
        if CASE == "ghcr_login_fail":
            # Simulate docker login failure
            return 1
        if CASE == "build_fail":
            # Simulate docker pull failure after successful login
            return 1
        return 0

    if "docker tag" in script and "release-" in script:
        if not require_remote_sh(wrapped, "activation"):
            return 64
        required = (
            ACTIVATION_LOCK_PREFIX,
            "activation-transport-setup-exit-40",
            f"{CANONICAL_COMPOSE} up -d --force-recreate --no-deps hausv-org",
            "running_image_id=",
            "latest_image_id=",
            "previous_image_id=",
            "release_image_id=",
            '"$running_image_id" != "$latest_image_id"',
            '"$running_image_id" != "$previous_image_id"',
            "com.docker.compose.project",
            "com.docker.compose.service",
            "exit 42",
            IMAGE_ID,
            f"docker tag ghcr.io/inspr-at/hausv-org:release-{APP_VERSION}-aaaaaaa ghcr.io/inspr-at/hausv-org:latest || exit 43",
            f"{CANONICAL_COMPOSE} up -d --force-recreate --no-deps hausv-org || exit 43",
            f"docker inspect --format '{{{{.Image}}}}' {CONTAINER}",
        )
        if any(fragment not in script for fragment in required):
            print("activation is not one locked, revalidated transition", file=sys.stderr)
            return 64
        if not (
            script.index(ACTIVATION_LOCK_PREFIX)
            < script.index("running_image_id=")
            < script.index("docker tag")
            < script.index(f"{CANONICAL_COMPOSE} up")
        ):
            print("activation lock does not span revalidation, tag and up", file=sys.stderr)
            return 64
        if CASE == "activation_lock_timeout":
            return 41
        if CASE in {"activation_mktemp_fail", "activation_decode_fail"}:
            return 40
        if CASE == "activation_identity_drift":
            return 42
        if CASE == "activation_post_tag_raw_42":
            return 43
        return 1 if CASE in {"activation_fail", "rollback_encoder_fail"} else 0

    if "docker image inspect" in script and "config --services" in script:
        # Simulate the exact production failure mode: with hausv's fish login
        # shell, an early failure followed by a successful final command can be
        # reported as success. The explicit sh wrapper must preserve failure.
        if CASE == "remote_early_failure_masked":
            return 1 if wrapped else 0
        if not require_remote_sh(wrapped, "remote preflight"):
            return 64
        required = (
            "running_image_id=",
            "latest_image_id=",
            'test "$running_image_id" = "$latest_image_id"',
            "previous_image_id=",
            "docker image inspect --format",
            LOCK_PREFIX,
            f"{CANONICAL_COMPOSE} config --services",
            "test -d /run/lock",
            "test -f /srv/hausv/compose/docker-compose.yml",
            "com.docker.compose.project",
            "com.docker.compose.service",
            f"curl -fsS --max-time 10 {LIVE_URL}",
            'locked_open="$(printf "\\050")"',
            'locked_close="$(printf "\\051")"',
            'locked_build_marker="0.0.0 ${locked_open}bbbbbbb${locked_close}"',
            'grep -F "$locked_build_marker"',
            f"docker inspect --format '{{{{.Image}}}}' {CONTAINER}",
        )
        if "schema" in CASE and POSTGRES and POSTGRES != "none":
            required = required + (
                f"docker exec {POSTGRES} pg_isready -U hausv_backup -d hausv",
                f"docker inspect --format '{{{{.State.Running}}}}' {POSTGRES}",
            )
        elif "pg_isready" in script:
            print("preflight probed PostgreSQL although no schema release needs it", file=sys.stderr)
            return 64
        missing = [fragment for fragment in required if fragment not in script]
        if missing:
            print(
                f"remote image identity preflight is incomplete: {missing}",
                file=sys.stderr,
            )
            return 64
        if not (
            script.index(LOCK_PREFIX)
            < script.index("running_image_id=")
            < script.index(f"{CANONICAL_COMPOSE} config --services")
        ):
            print("preflight identity and compose resolution do not share one lock", file=sys.stderr)
            return 64
        if CASE in {
            "remote_preflight_fail",
            "retry_after_activation_fail",
            "rollback_tag_conflict",
            "lock_timeout",
            "missing_rendered_compose",
            "wrong_compose_identity",
            "preflight_visible_drift",
        }:
            return 1
        print(f"running-image-id={IMAGE_ID}")
        return 0

    print(f"unexpected ssh fixture call: {remote}", file=sys.stderr)
    return 64


def main() -> int:
    command = Path(sys.argv[0]).name
    args = sys.argv[1:]
    log(command, args)
    if command == "git":
        return mock_git(args)
    if command == "gh":
        return mock_gh(args)
    if command == "curl":
        return mock_curl(args)
    if command == "base64":
        return mock_base64(args)
    if command == "ssh":
        return mock_ssh(args)
    if command == "sleep":
        return 0
    print(f"unexpected fixture command: {command}", file=sys.stderr)
    return 64


raise SystemExit(main())
