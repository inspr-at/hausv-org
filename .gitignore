.DS_Store

# Studio-only private kernel. Never publish this gitlink.
/doctrine-private/
# Compiled binaries at the repo root. Anchored with a leading slash so the
# pattern does NOT also match the cmd/hausv-org package directory.
/hausv-org
/weg-portal
*.log
*.env
/deploy/demo/*.env
*.env.local
local-*.jpg
tmp/

# snapshot harness deps (system Chromium is used; no browser is downloaded)
scripts/snapshot/node_modules/

# 3D mark build deps (the bundle itself is committed)
scripts/mark3d/node_modules/

# direnv/nix dev shell cache
.direnv/
.gocache/

# Agent worktrees are per-machine; the command symlinks are shared wiring.
.claude/worktrees/

# Local handout build outputs; published PDFs live in internal/web/assets/downloads/.
/media/HAUSV-Professional_Handout-*.pdf
